load("@rules_python//python:defs.bzl", "py_binary")
load(":toys.bzl", "array_toy", "ohsched_toy")

# Array structures as toys, swept over depth and width, so the scope of
# what a generator should build, and where it starts to pay, is known
# before any real design is touched. Each toy is synthesised by yosys
# and, for the kinds generate_ram builds today, generated; the probe
# reads the period and area at floorplan. Every flow target is manual.

py_binary(
    name = "toys",
    srcs = ["toys.py"],
)

DEPTHS = [
    8,
    32,
    128,
    512,
]

WIDTHS = [
    8,
    32,
    128,
]

KINDS = [
    "rf1r1w",
    "rf4r2w",
    "masked",
    "fifo",
    "flags",
    "counter",
    "window",
    "cam",
]

[
    array_toy(kind, depth, width)
    for kind in KINDS
    for depth in DEPTHS
    for width in WIDTHS
]

# the age matrix is depth x depth: its width is not a parameter
[
    array_toy("agematrix", depth, 8)
    for depth in DEPTHS
]

# The ohsched toy (ohsched.py): a one-hot-addressed, broadcast-read,
# bank-filled array, a scheduler's or issue queue's shape. Can
# generate_ram's form beat yosys's flops on period, at no more area,
# with faster synthesis? 32 entries of 32 bits, filled a bank at a time
# or written by lanes. The two arms are co-simulated (seconds); the flows
# are manual.
py_binary(
    name = "ohsched",
    srcs = ["ohsched.py"],
)

[
    ohsched_toy(kind, 32, 32)
    for kind in [
        "fill",
        "lanes",
    ]
]
