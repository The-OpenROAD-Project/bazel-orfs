load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Is ORFS's -threads policy wrong? ORFS gives OpenROAD
# `-threads $(NUM_CORES)` and derives NUM_CORES from `nproc`, which
# counts hardware threads rather than cores (flow/scripts/variables.mk).
# On an SMT machine that is twice the core count.
#
# This package measures whether the second half of those threads pays
# for itself, per substep, across a spread of asap7 designs. There is no
# write-up in the tree: the pull request is the artifact, and report.py
# generates it from whatever the campaign has recorded.
#
# The campaign target is manual -- it runs ORFS stages for hours and
# needs an otherwise idle machine, so it must never be pulled into a
# wildcard build. The three unit tests are the only non-manual targets.
package(default_visibility = ["//visibility:private"])

# The one reader of what ORFS already writes into a substep log: wall
# time, CPU time, achieved parallelism, peak RSS, the ORD-0030 thread
# witness and ORFS's own hash of the substep result.
py_library(
    name = "elapsed",
    srcs = ["elapsed.py"],
    imports = ["."],
)

py_test(
    name = "elapsed_test",
    size = "small",
    srcs = ["elapsed_test.py"],
    deps = [":elapsed"],
)

# Which regions inside a substep spent its time. ORFS and OpenROAD
# already write the breakdown (`Took` lines, tool `Runtime:` lines,
# elapsed stamps); this only reads it.
py_library(
    name = "phases",
    srcs = ["phases.py"],
    imports = ["."],
)

py_test(
    name = "phases_test",
    size = "small",
    srcs = ["phases_test.py"],
    deps = [":phases"],
)

# Runs one arm: deploy a stage's inputs with bazel, then run that
# stage's substeps outside the sandbox at a given thread count.
py_binary(
    name = "campaign",
    srcs = ["campaign.py"],
    imports = ["."],
    tags = ["manual"],
    deps = [
        ":deployment",
        ":elapsed",
        ":phases",
        ":watchdog",
        ":witness",
    ],
)

# STAGE_SUBSTEPS is duplicated into campaign.py so the runner can drive
# `make do-<substep>` without a Starlark round trip; this asserts the
# copy against private/stages.bzl so it cannot drift from the flow.
py_test(
    name = "campaign_test",
    size = "small",
    srcs = ["campaign_test.py"],
    data = ["//private:stages.bzl"],
    deps = [":campaign"],
)

# Generates the PR body and the raw-sample comments from the results
# directory. Manual only because there is nothing to generate until a
# campaign has run.
py_binary(
    name = "report",
    srcs = ["report.py"],
    imports = ["."],
    tags = ["manual"],
)

py_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.py"],
    deps = [":report"],
)

# Where one arm's files are, as opposed to another's. The #968 harness
# found the results and logs directories by walking for the deepest one
# holding a .odb -- correct for the single variant a deployment ships
# with, and silently wrong once two arms run at once.
py_library(
    name = "deployment",
    srcs = ["deployment.py"],
    imports = ["."],
)

py_test(
    name = "deployment_test",
    size = "small",
    srcs = ["deployment_test.py"],
    deps = [":deployment"],
)

# What proves two arms produced the same thing: the .sdc bytes, the .odb
# bytes, and the subset of ORFS's own metrics a divergence would move.
# The subset is curated because comparing all of it reports identical
# work as divergent -- runtime and peak memory differ between two runs.
py_library(
    name = "witness",
    srcs = ["witness.py"],
    imports = ["."],
)

py_test(
    name = "witness_test",
    size = "small",
    srcs = ["witness_test.py"],
    deps = [":witness"],
)

# A hang has to yield a backtrace. The open `find_timing -threads 32`
# hang was never root-caused because no run of it produced a stack.
py_library(
    name = "watchdog",
    srcs = ["watchdog.py"],
    imports = ["."],
)

py_test(
    name = "watchdog_test",
    size = "small",
    srcs = ["watchdog_test.py"],
    deps = [":watchdog"],
)

# The static audit of class 1 (pointer-keyed containers whose iteration
# order follows the allocator). It needs no flow runs, so it is the part
# of the campaign that produces evidence before any arm has been run.
# Manual because it downloads the pinned OpenSTA on a cache miss.
py_binary(
    name = "sta_audit",
    srcs = ["sta_audit.py"],
    imports = ["."],
    tags = ["manual"],
)

py_test(
    name = "sta_audit_test",
    size = "small",
    srcs = ["sta_audit_test.py"],
    deps = [":sta_audit"],
)
