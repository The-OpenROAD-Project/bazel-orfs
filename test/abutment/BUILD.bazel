# The pieces a design built from abutted macros uses: a parent hardened
# as a macro with a notch for its tiles (io_notch.tcl, place_notch.tcl),
# pins placed from a plan (pins_plan.tcl), macros that route on M2-M8
# with M8 straps for power (pdn_macro.tcl), a top level of macros only
# (io_top.tcl, pdn_top.tcl, tapcell_none.tcl, dpl_none.tcl), and
# abstracts with exact shapes (abstract_exact.tcl), so a macro's notch
# stays free for the macros that abut it; or a top level with a strip of
# rows of its own under the macros, for its clock tree (core_rows.tcl),
# whose wires cross the tiles above the tiles' own layers (grt_notch.tcl);
# or a macro built only to be placed and dissolved into its parent's
# cells after tapcell (dissolve.tcl).
exports_files([
    "abstract_exact.tcl",
    "core_rows.tcl",
    "dissolve.tcl",
    "dpl_none.tcl",
    "grt_notch.tcl",
    "io_notch.tcl",
    "io_top.tcl",
    "pdn_macro.tcl",
    "pdn_top.tcl",
    "pins_plan.tcl",
    "place_notch.tcl",
    "tapcell_none.tcl",
])
