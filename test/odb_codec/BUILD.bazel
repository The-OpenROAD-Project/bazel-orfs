# What //tools/odb_codec does to the compressed size of a flow's .odb
# files: measure.sh builds a few asap7 designs with and without it and
# runs measure.py over every .odb their stages write.
load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

py_binary(
    name = "measure",
    srcs = ["measure.py"],
    args = [
        "--codec=$(rootpath //tools/odb_codec)",
        "--zstd=$(rootpath @zstd//:zstd_cli)",
        "--openroad=$(rootpath @openroad)",
    ],
    data = [
        "//tools/odb_codec",
        "@openroad",
        "@zstd//:zstd_cli",
    ],
    tags = ["manual"],
)

# The carried OpenROAD patch, in this repository's CI: OpenROAD's own
# tests for it do not run here.
sh_test(
    name = "codec_hook_test",
    size = "small",
    srcs = ["codec_hook_test.sh"],
    args = [
        "$(rootpath @openroad)",
        "$(rootpath stub_codec.sh)",
        "$(rootpath //tools/odb_codec)",
        "$(rootpath @openroad//src/odb/test:design_odb_data)",
    ],
    data = [
        "stub_codec.sh",
        "//tools/odb_codec",
        "@openroad",
        "@openroad//src/odb/test:design_odb_data",
    ],
)

# gcd's floorplan and place substeps, each with the files it is stored
# against.
[
    filegroup(
        name = "gcd_" + substep,
        srcs = ["@orfs//flow/designs/asap7/gcd:gcd_" + stage],
        output_group = "substep_" + substep,
    )
    for stage, substep in [
        ("floorplan", "2_1_floorplan"),
        ("place", "3_1_place_gp_skip_io"),
    ]
]

sh_test(
    name = "substep_chain_test",
    srcs = ["substep_chain_test.sh"],
    args = [
        "$(rootpath @openroad)",
        "$(rootpath //tools/odb_codec)",
        "$(rootpaths :gcd_2_1_floorplan)",
        "$(rootpaths :gcd_3_1_place_gp_skip_io)",
    ],
    data = [
        ":gcd_2_1_floorplan",
        ":gcd_3_1_place_gp_skip_io",
        "//tools/odb_codec",
        "@openroad",
    ],
    tags = ["orfs"],
)
