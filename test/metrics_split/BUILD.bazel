load("@rules_python//python:defs.bzl", "py_test")
load("//:openroad.bzl", "orfs_flow")

# The <stage>_report targets reproduce the in-stage metrics
# (docs/performance.md). Two gcd flows, the same but for where report_metrics
# runs: "instage" runs it inside each stage, as ORFS does by default;
# "ondemand" builds with bazel-orfs's default SKIP_REPORT_METRICS=1 and
# reports from each stage's saved results in a <stage>_report target.
[orfs_flow(
    name = "gcd",
    arguments = {
        "CORE_ASPECT_RATIO": "1",
        "CORE_MARGIN": "0.5",
        "CORE_UTILIZATION": "65",
        "GPL_PLACE_IOS": "1",
        "PLACE_DENSITY": "0.35",
    } | extra,
    sources = {"SDC_FILE": ["@orfs//flow/designs/asap7/gcd:constraint.sdc"]},
    tags = ["manual"],
    top = "gcd",
    variant = variant,
    verilog_files = ["@orfs//flow/designs/src/gcd:gcd.v"],
) for variant, extra in [
    (
        "instage",
        {"SKIP_REPORT_METRICS": "0"},
    ),
    ("ondemand", {}),
]]

# stage, the in-stage .json holding its report_metrics, the in-stage .rpt.
# The place stage declares no .rpt: its .json is compared alone.
STAGES = [
    ("place", "3_5_place_dp.json", None),
    ("cts", "4_1_cts.json", "4_cts_final.rpt"),
    ("grt", "5_1_grt.json", "5_global_route.rpt"),
    ("final", "6_report.json", "6_finish.rpt"),
]

[filegroup(
    name = "instage_%s_%s" % (
        stage,
        f.replace(".", "_"),
    ),
    srcs = [":gcd_instage_" + stage],
    output_group = f,
    tags = ["manual"],
) for stage, json, rpt in STAGES for f in [
    json,
    rpt,
] if f]

py_test(
    name = "metrics_split_test",
    size = "small",
    srcs = ["metrics_split_test.py"],
    args = [
        ",".join(
            ["%s=$(rootpath :instage_%s_%s)" % (
                stage,
                stage,
                json.replace(".", "_"),
            )] +
            (["$(rootpath :instage_%s_%s)" % (
                stage,
                rpt.replace(".", "_"),
            )] if rpt else [""]) + [
                "$(rootpath :gcd_ondemand_%s_report.json)" % stage,
                "$(rootpath :gcd_ondemand_%s_report.rpt)" % stage,
            ],
        )
        for stage, json, rpt in STAGES
    ],
    data = [
        ":instage_%s_%s" % (
            stage,
            f.replace(".", "_"),
        )
        for stage, json, rpt in STAGES
        for f in [
            json,
            rpt,
        ]
        if f
    ] + [
        ":gcd_ondemand_%s_report.%s" % (stage, ext)
        for stage, _, _ in STAGES
        for ext in [
            "json",
            "rpt",
        ]
    ],
)
