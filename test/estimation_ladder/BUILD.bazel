    deps = [":optuna_study_lib"],
)

# The measurement that licenses the gate: does an estimator ensemble
# reach the same verdict a flow ensemble would?
#
# On multiplier, because that flow is 47s and can therefore be
# ensembled. Magnitudes are not expected to match -- the estimator is
# biased and its per-perturbation response is uncorrelated with the
# flow's -- only the ordering has to carry over, which is the weakest
# claim the gate needs and the only one with a chance of holding.
py_binary(
    name = "method_validation",
    srcs = ["method_validation.py"],
