]

# The deliverable: a quantified, actionable PR verdict.
#
# Both arms are ensembles, because a single run of anything -- flow or
# estimator -- is one draw from a distribution wide enough to swamp most
# changes. The KPI is rank-based (Hodges-Lehmann shift, Mann-Whitney win
# probability) since the measured behaviour of this flow violates what a
# mean-and-t-interval assumes.
#
# Every verdict carries the difference the ensemble could actually
# resolve. Without that line a KPI on a design with this noise floor
# hands someone a "win" every other PR, and dies the first time it
# contradicts what a developer can see for themselves.
#
# Demonstrated here with base vs split: an edit that provably cannot
# change what the circuit computes, and costs 9.6% of the achieved
# period. Real gate usage substitutes the merge-base and PR estimators.
py_binary(
    name = "ci_gate_demo",
    srcs = ["ci_gate.py"],
