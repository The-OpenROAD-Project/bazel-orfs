# -------------------------------------------------------------
# Seed sensitivity: is the published front reproducible?
#
# Every number on the front comes from one run, and adjacent rungs sit
# 0.0005 to 0.006 apart in mean_rel_err. Nothing so far establishes that
# the front is reproducible to that precision -- only that an identical
# re-run reproduces, which is a different claim.
#
# No stage exposes a random seed, so the study uses the literature's
# substitute (Kahng & Mantik ISQED'02, Chan/Kahng/Woo SLIP'20): perturb an
# input by an amount nobody would call a design change and read the
# spread.
#
# It measures the spread of the ESTIMATE, not of the flow, so it is not a
# noise floor in Chan/Kahng/Woo's sense -- that would be the dispersion of
# the target, which bounds achievable accuracy and needs the flow re-run.
# What this bounds is narrower: whether ranking two rungs by one run each
# is a measurement or a coin flip.
#
# It is cheap because the perturbation is keyed per stage, so the
# batch walk shares the whole prefix above the perturbed stage and pays
# only the tail below it -- see seed_sensitivity.py.
# -------------------------------------------------------------
py_binary(
    name = "seed_sensitivity",
    srcs = ["seed_sensitivity.py"],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "multiplier",
    ],
    data = [
        "ground_truth.json",
        ":fast_estimator_executable",
    ],
    deps = [":optuna_study_lib"],
)

py_binary(
    name = "seed_sensitivity_top",
    srcs = ["seed_sensitivity.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "seed_sensitivity.py",
    deps = [":optuna_study_lib"],
)

# The null control as a test: a clock-period nudge at floorplan and at
# place_pins, neither of which reads timing, must leave every sampled
# path bit-identical.
#
# This is the guard the whole study rests on. A perturbation that
# silently failed to apply would pass every accuracy check and then
# report a spread of exactly zero -- the one wrong answer that looks
# like a clean result. It also exercises fork reproducibility, which is
# not free: threads do not survive fork() and the pools are respawned in
# each child.
py_test(
    name = "seed_sensitivity_test",
    timeout = "eternal",
    srcs = [
        "seed_sensitivity.py",
        "seed_sensitivity_test.py",
    ],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
    ],
    data = [
        "ground_truth.json",
        ":fast_estimator_executable",
    ],
    main = "seed_sensitivity_test.py",
    tags = ["manual"],
    deps = [":optuna_study_lib"],
)

# -------------------------------------------------------------
# Are real RTL changes below the flow's own fuzzing floor?
#
# The developer's question is "did my change help", and the theory is that
# running the real flow cannot answer it -- not because the flow is slow,
# but because one flow run is one draw from a distribution wider than the
# effect being looked for. If that holds, an infinitely fast flow would
# still be useless, and the only way to answer the question is an
# ensemble, which is affordable for the estimator and not for the flow.
#
# Testing it needs RTL edits whose true effect is known. multiplier_fuzz.sv
# provides both kinds: three equivalence-preserving edits whose true effect
# on the achieved period is exactly zero, and an effect-size dial whose
# effect is real and monotone. Each is run at five site-aligned core-area
# perturbations, through the real flow AND through the estimator, so the
# same perturbation set blocks both arms -- common random numbers, which is
# what lets the comparison be paired rather than unpaired.
#
# CORE_AREA is nudged in whole sites (0.054um on asap7, from
# //test/estimation_ladder:site_probe). initialize_floorplan snaps the core
# to the site grid, so a sub-site nudge can snap back to nothing while
# still being reported as a perturbation.
# -------------------------------------------------------------

# The variant family spans true effects from provably zero up to huge, so
# detectability can be plotted against effect size rather than asserted at
# one point. The load* settings exist because every EXTRA_ADD_STAGES
# setting landed far above the flow's own 1.24% spread, which is exactly
# the regime the theory is about.
FUZZ_VARIANTS = {
    # name: (VERILOG_DEFINES, true effect on the achieved period)
    "base": ("", "reference"),
    "order": ("-D FUZZ_ORDER=1", "zero"),
    "alias": ("-D FUZZ_ALIAS=1", "zero"),
    "split": ("-D FUZZ_SPLIT=1", "zero"),
    "load1": ("-D EXTRA_LOAD_BITS=1", "real"),
    "load8": ("-D EXTRA_LOAD_BITS=8", "real"),
    "load32": ("-D EXTRA_LOAD_BITS=32", "real"),
    "dial1": ("-D EXTRA_ADD_STAGES=1", "real"),
    "dial2": ("-D EXTRA_ADD_STAGES=2", "real"),
    "dial4": ("-D EXTRA_ADD_STAGES=4", "real"),
    "dial8": ("-D EXTRA_ADD_STAGES=8", "real"),
}

FUZZ_EPS = [
    -2,
    -1,
    0,
    1,
    2,
]

FUZZ_ARGS = MULTIPLIER_ARGS | {"DESIGN_NAME": "multiplier_fuzz"}

# Precomputed rather than built by a helper: BUILD files may not define
# functions.
FUZZ_EPS_TAG = {
    -2: "m2",
    -1: "m1",
    0: "0",
    1: "p1",
    2: "p2",
}

# The core x-edge moved by eps whole sites: 38.000um +/- eps * 0.054um.
# Written out rather than computed, because Starlark's % has no zero-padded
# integer conversion and the arithmetic is more legible as its result.
FUZZ_CORE_AREA = {
    -2: "2 2 37.892 38",
    -1: "2 2 37.946 38",
    0: "2 2 38 38",
