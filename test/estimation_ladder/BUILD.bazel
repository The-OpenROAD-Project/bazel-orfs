load("//:openroad.bzl", "orfs_flow", "orfs_run")

package(default_visibility = ["//visibility:public"])

# Single Source of Truth for the multiplier design
MULTIPLIER_SOURCES = {
    "SDC_FILE": ["constraints.sdc"],
}

MULTIPLIER_ARGS = {
    "DESIGN_NAME": "multiplier",
    "CORE_UTILIZATION": "40",
    "CORE_ASPECT_RATIO": "1",
}

# Base flow target synthesizing the pipelined multiplier
orfs_flow(
    name = "multiplier_asap7",
    verilog_files = ["multiplier.sv"],
    top = "multiplier",
    pdk = "@orfs//flow:asap7",
    sources = MULTIPLIER_SOURCES,
    arguments = MULTIPLIER_ARGS,
    stage_sources = {
        "synth": ["multiplier.sv", "constraints.sdc"],
    },
)

# Common configuration shared across the estimation ladder (DRY & SSOT)
ESTIMATOR_SOURCES = {
    
    
    "ESTIMATOR_TCL": ["estimator.tcl"],
}

ESTIMATION_LADDER_STAGES = {
    "synth": ["synth"],
    "floorplan": ["synth", "floorplan"],
    "place": ["synth", "floorplan", "place"],
    "grt": ["synth", "floorplan", "place", "grt"],
}

# Composable estimation ladder expressed via list comprehension of orfs_run targets
[
    orfs_run(
        name = "multiplier_estimate_{}".format(stage),
        src = ":multiplier_asap7_synth",
        script = "estimator.tcl",
        cmd = "run",
        stages = ["synth", "floorplan", "place", "grt", "route"],
        arguments = MULTIPLIER_ARGS | {
            "ESTIMATION_STAGE": stage,
            "OUTPUT_YAML": "$(location :multiplier_{}_estimate.yaml)".format(stage),
        },
        sources = ESTIMATOR_SOURCES,
        outs = [
            "multiplier_{}_estimate.yaml".format(stage),
        ],
    )
    for stage, stages_up_to in ESTIMATION_LADDER_STAGES.items()
]

# Ground Truth measurement using actual grt output from orfs_flow
orfs_run(
    name = "multiplier_estimate_grt_true",
    src = ":multiplier_asap7_grt",
    script = "estimator.tcl",
    cmd = "run",
    stages = ["synth", "floorplan", "place", "grt", "route"],
    arguments = MULTIPLIER_ARGS | {
        "ESTIMATION_STAGE": "grt_true",
        "OUTPUT_YAML": "$(location :multiplier_grt_true_estimate.yaml)",
    },
    sources = ESTIMATOR_SOURCES,
    outs = [
        "multiplier_grt_true_estimate.yaml",
    ],
)

load("@rules_python//python:defs.bzl", "py_binary", "py_test")

py_binary(
    name = "generate_report",
    srcs = ["generate_report.py"],
)

ESTIMATES = [
    "multiplier_synth_estimate.yaml",
    "multiplier_floorplan_estimate.yaml",
    "multiplier_place_estimate.yaml",
    "multiplier_grt_estimate.yaml",
    "multiplier_grt_true_estimate.yaml",
]

genrule(
    name = "estimation_report",
    srcs = ESTIMATES,
    outs = ["report.md"],
    cmd = "$(location :generate_report) $(SRCS) --output-report $@",
    tools = [":generate_report"],
)

py_test(
    name = "check_trends_test",
    srcs = ["check_trends_test.py"],
    data = ESTIMATES,
    args = ["$(location %s)" % e for e in ESTIMATES],
)

py_binary(
    name = "optuna_study",
    srcs = ["optuna_study.py"],
    data = [
        ":multiplier_asap7_grt_deps_tar.tar.gz",
        ":multiplier_asap7_synth",
        ":multiplier_asap7_grt",
    ],
    deps = [
        "@bazel-orfs-pip//optuna",
        "@bazel-orfs-pip//pandas",
        "@bazel-orfs-pip//scipy",
    ],
)
