# -------------------------------------------------------------
# Flow-side per-stage variance decomposition: where is the noise born?
#
# seed_sensitivity measures the ESTIMATOR's per-stage stability and is
# explicit that the flow-side dispersion is out of its scope.  This is
# that flow-side arm: the production ORFS stage scripts floorplan..grt
# chained in ONE OpenROAD process (the KEEP_VARS trick ORFS's own
# floorplan_to_place.tcl uses), with an ensemble forked off each stage
# boundary -- GPL_RANDOM_SEED at place, a 1ps-scale clock nudge at cts
# (which exposes no seed), GRT_SEED at grt, and an all-levers arm whose
# directly measured variance the per-arm decomposition must predict.
# Every member runs the production tail to grt and is measured there by
# extract_lib.tcl, the same instrument as the ground truth.
#
# The spine is paid once; a member costs only its tail, so the whole
# 30-odd-member campaign costs a handful of flow-equivalents rather
# than 30.  Members are single-threaded (threads do not survive fork,
# docs/fork.md); the driver bounds concurrency via ORFS_FORK_JOBS.
#
# The output is a menu, not a verdict: sigma and the resolvable effect
# delta_min = z*sigma*sqrt(2/k) per KPI candidate (max / quantiles /
# top-N means / mean of the sampled worst-25% paths, plus std-cell
# area; power is recorded equal to area, TODO), and CPU-cost-vs-
# resolution rows per candidate ensemble generator.  Deciding which
# compromise to gate PRs on comes after these numbers exist, not
# before.
# -------------------------------------------------------------
orfs_run_executable(
    name = "stage_variance_top_executable",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "stage_variance.tcl",
    sources = {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
        "IO_CONSTRAINTS": ["io_constraints.tcl"],
    },
    stages = [
        "floorplan",
        "place",
        "cts",
        "grt",
    ],
)

py_binary(
    name = "stage_variance_top",
    srcs = ["stage_variance.py"],
    args = [
        "$(location :stage_variance_top_executable)",
        "multiplier_top",
    ],
    data = [
        ":stage_variance_top_executable",
    ],
    main = "stage_variance.py",
    deps = [":optuna_study_lib"],
)

py_library(
    name = "stage_variance_lib",
    srcs = ["stage_variance.py"],
    imports = ["."],
)

# The aggregation math alone -- KPI candidates, k-sizing, the variance
# decomposition and its interaction flag, the determinism and
# nudge-landed guards -- on synthetic ensembles.  The only CI-visible
# piece of the campaign; the walk itself is hours of flow runtime.
py_test(
    name = "stage_variance_test",
    srcs = ["stage_variance_test.py"],
    main = "stage_variance_test.py",
    deps = [":stage_variance_lib"],
)

# The same walk on the simple multiplier: a fifteen-minute smoke loop
# for the harness, and a second design's data point for free -- whether
# the noise is born in the same stage on a design with no macros is
# itself part of the answer.
orfs_run_executable(
    name = "stage_variance_executable",
    src = ":multiplier_asap7_synth",
    arguments = MULTIPLIER_ARGS,
    cmd = "run",
    script = "stage_variance.tcl",
    sources = {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
        "IO_CONSTRAINTS": ["io_constraints.tcl"],
    },
    stages = [
        "floorplan",
        "place",
        "cts",
        "grt",
    ],
)

py_binary(
    name = "stage_variance_small",
    srcs = ["stage_variance.py"],
    args = [
        "$(location :stage_variance_executable)",
        "multiplier",
    ],
    data = [
        ":stage_variance_executable",
    ],
    main = "stage_variance.py",
    deps = [":optuna_study_lib"],
)

# -------------------------------------------------------------
# Is RTL-MP's scoring function any good?
#
# stage_variance located the noise at macro placement: downstream of a
# fixed placement the flow is quiet, while the placer's response to its
# input swings the achieved period ~25%.  Choosing a placement is
# therefore choosing a downstream outcome -- and RTL-MP chooses with an
# internal annealing cost never checked against the flow.  This
# campaign runs a population of candidate placements -- the placer's
# own winners, optima of distorted objectives, and deliberately
# degraded permutations -- through the production tail, and reports
# how well the objective predicts the KPI menu at grt: pairwise pick
# accuracy, winner-vs-degraded separation, and selection regret.
# Mechanics and math in macro_score.py's docstring.
# -------------------------------------------------------------
orfs_run_executable(
    name = "macro_score_top_executable",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "macro_score.tcl",
    sources = {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
        "IO_CONSTRAINTS": ["io_constraints.tcl"],
    },
    stages = [
        "floorplan",
        "place",
        "cts",
        "grt",
    ],
)

py_binary(
    name = "macro_score_top",
    srcs = ["macro_score.py"],
    args = [
        "$(location :macro_score_top_executable)",
        "multiplier_top",
        "$(location stage_variance_multiplier_top.json)",
    ],
    data = [
        "stage_variance_multiplier_top.json",
        ":macro_score_top_executable",
    ],
    main = "macro_score.py",
    deps = [
        ":optuna_study_lib",
        ":stage_variance_lib",
    ],
)

py_library(
    name = "macro_score_lib",
    srcs = ["macro_score.py"],
    imports = ["."],
    deps = [":stage_variance_lib"],
)

# The audit math alone -- generator legality, the penalty-table parser,
# the fixed-normalization score, pick accuracy / AUC / regret with tie
# handling -- on synthetic populations.  The campaign itself is hours
# of flow runtime and stays manual.
py_test(
    name = "macro_score_test",
    srcs = ["macro_score_test.py"],
    main = "macro_score_test.py",
    deps = [":macro_score_lib"],
)

# -------------------------------------------------------------
# swerv_wrapper (asap7): the macro-placement campaign's real
# target (ideas/rtl-mpl.md).  multiplier_top's 16 identical macros
# make it the easiest possible macro problem -- a pure permutation
# -- and it becomes the null control; swerv_wrapper's ~28 SRAM
# macros in three fakeram sizes are the design the selector has to
# earn its keep on.
#
# The flow targets themselves come from the pinned ORFS tree
# (@orfs//flow/designs/asap7/swerv_wrapper, parsed from its
# config.mk by @orfs_designs), built with the carried-patch
# OpenROAD.  The parsed config is reused below so the consumer
# variant is the production configuration plus exactly one change:
# MACRO_PLACEMENT_TCL pointing at the selector's winner.
# -------------------------------------------------------------

SWERV = DESIGNS["asap7/swerv_wrapper"]

SWERV_SYNTH = "@orfs//flow/designs/asap7/swerv_wrapper:swerv_wrapper_synth"

# Labels in the parsed config.mk are relative to the ORFS repo.
SWERV_SOURCES = {
    var: ["@orfs" + label if label.startswith("//") else label for label in labels]
    for var, labels in SWERV["sources"].items()
}

SWERV_VERILOG = [
    "@orfs" + f if f.startswith("//") else f
    for f in SWERV["verilog_files"]
    if "$(" not in f
]

# Campaign step 2: swerv's own noise floor and delta_tie.  Never
# reuse multiplier_top's numbers -- the resolvable delta is a
# property of the design.
orfs_run_executable(
    name = "stage_variance_swerv_executable",
    src = SWERV_SYNTH,
    arguments = SWERV["arguments"],
    cmd = "run",
    script = "stage_variance.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
    },
    stages = [
        "floorplan",
        "place",
        "cts",
        "grt",
    ],
)

py_binary(
    name = "stage_variance_swerv",
    srcs = ["stage_variance.py"],
    args = [
        "$(location :stage_variance_swerv_executable)",
        "swerv_wrapper",
    ],
    data = [
        ":stage_variance_swerv_executable",
    ],
    main = "stage_variance.py",
    deps = [":optuna_study_lib"],
)

# Campaign step 3: the objective audit on a macro-heterogeneous
# design -- baseline P_pick / AUC / regret the selector must beat.
# The py driver is wired up once stage_variance_swerv has produced
# stage_variance_swerv_wrapper.json (the delta_tie input), the same
# order the multiplier_top campaign ran in.
orfs_run_executable(
    name = "macro_score_swerv_executable",
    src = SWERV_SYNTH,
    arguments = SWERV["arguments"],
    cmd = "run",
    script = "macro_score.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
    },
    stages = [
        "floorplan",
        "place",
        "cts",
        "grt",
    ],
)

# Campaign step 4: the selector.  Consumes the synthesis output,
# generates k seed-perturbed RTL-MP candidates over one shared
# production floorplan spine, scores each with the fast
# non-timing-driven global placement rung, and materializes the
# winner as macro.tcl -- the file the flow variant below injects
# through MACRO_PLACEMENT_TCL.  Per-candidate evidence (scores,
# runtimes, peak RSS, the sampled paths) lands in the out_dir.
orfs_run(
    name = "swerv_macro_select",
    src = SWERV_SYNTH,
    outs = ["macro.tcl"],
    arguments = SWERV["arguments"],
    cmd = "run",
    out_dir = "macro_select_evidence",
    script = "macro_select.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
    },
    stages = [
        "floorplan",
        "place",
    ],
    tags = ["manual"],
)

# The same walk as a bazelisk-run executable, for the parallelism
# calibration experiment: KEY=VALUE overrides pick the execution
# shape (MS_JOBS=N for fork-parallel single-threaded candidates,
# MS_SERIAL_THREADS=N for sequential candidates with N threads
# each) and MS_K/MS_OUT_DIR/MS_WORK size and place the run.  The
# winning static shape for this machine class is recorded in the
# README and baked into the swerv_macro_select defaults.
orfs_run_executable(
    name = "swerv_macro_select_executable",
    src = SWERV_SYNTH,
    arguments = SWERV["arguments"],
    cmd = "run",
    script = "macro_select.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
    },
    stages = [
        "floorplan",
        "place",
    ],
)

# Campaign step 5/6: the consumer.  The main base flow variant of
# swerv_wrapper in this package: the production configuration from
# the pinned ORFS tree, sharing the same synthesis action as the
# @orfs baseline, with the selector's winner injected through
# MACRO_PLACEMENT_TCL.  A/B against
# @orfs//flow/designs/asap7/swerv_wrapper:swerv_wrapper_grt with
# the macro_score KPI menu, gated on stage_variance_swerv's
# delta_tie.
orfs_flow(
    name = "swerv_wrapper",
    arguments = SWERV["arguments"],
    previous_stage = {"floorplan": SWERV_SYNTH},
    sources = SWERV_SOURCES | {
        "MACRO_PLACEMENT_TCL": [":macro.tcl"],
    },
    tags = ["manual"],
    top = "swerv_wrapper",
    verilog_files = SWERV_VERILOG,
)

# A/B measurement with the shared instrument: the same KPI menu at grt
# for the selector-fed variant and the untouched baseline.
orfs_run(
    name = "swerv_ab_selected",
    src = ":swerv_wrapper_grt",
    outs = ["swerv_ab_selected.json"],
    arguments = SWERV["arguments"] | {
        "OUTPUT_JSON": "$(location swerv_ab_selected.json)",
    },
    cmd = "run",
    script = "extract_from_src.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
        "EXTRACT_TCL": ["extract.tcl"],
    },
    src_logs = True,
    tags = ["manual"],
)

orfs_run(
    name = "swerv_ab_baseline",
    src = "@orfs//flow/designs/asap7/swerv_wrapper:swerv_wrapper_grt",
    outs = ["swerv_ab_baseline.json"],
    arguments = SWERV["arguments"] | {
        "OUTPUT_JSON": "$(location swerv_ab_baseline.json)",
    },
    cmd = "run",
    script = "extract_from_src.tcl",
    sources = SWERV_SOURCES | {
        "EXTRACT_LIB_TCL": ["extract_lib.tcl"],
        "EXTRACT_TCL": ["extract.tcl"],
    },
    src_logs = True,
    tags = ["manual"],
)
