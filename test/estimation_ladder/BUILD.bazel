    deps = [":optuna_study_lib"],
)

# Does more ensemble buy resolution on a macro design, or is the spread a
# bias that no averaging removes? This is the measurement that decides
# whether a top-level gate is possible at all, and it runs before the
# 7.5 CPU-hour flow reference is committed.
#
# roworder is the variant that matters: its true effect on the function is
# exactly zero, and at k=5 it was reported as an 11.8% regression. If that
# delta shrinks with k it was noise; if it holds while its interval
# shrinks, a semantically neutral edit really does cost QoR through macro
# placement -- which is what split turned out to be on the multiplier
# design.
py_binary(
