load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//:openroad.bzl", "orfs_flow", "orfs_run", "orfs_run_executable")

package(default_visibility = ["//visibility:public"])

# Shared accuracy metrics, used by both rungs of the study.
py_library(
    name = "estimation_metrics",
    srcs = ["estimation_metrics.py"],
    # Importable as a bare module name rather than by its full package
    # path, so the study scripts read the same run under bazel and when
    # run directly.
    imports = ["."],
    deps = ["@bazel-orfs-dev-pip//scipy"],
)

# Single Source of Truth for the multiplier design
MULTIPLIER_SOURCES = {
    "SDC_FILE": ["constraints.sdc"],
    "IO_CONSTRAINTS": ["io_constraints.tcl"],
}

MULTIPLIER_ARGS = {
    "DESIGN_NAME": "multiplier",
    "DIE_AREA": "0 0 40 40",
    "CORE_AREA": "2 2 38 38",
    "PDN_TCL": "$(PLATFORM_DIR)/openRoad/pdn/BLOCK_grid_strategy.tcl",
    "PLACE_DENSITY": "0.65",
}

# Base flow target synthesizing the pipelined multiplier
orfs_flow(
    name = "multiplier_asap7",
    abstract_stage = "grt",
    arguments = MULTIPLIER_ARGS,
    sources = MULTIPLIER_SOURCES,
    tags = ["manual"],
    top = "multiplier",
    verilog_files = ["multiplier.sv"],
)

# Common configuration shared across the estimator
ESTIMATOR_SOURCES = {
    "ESTIMATOR_BATCH_TCL": ["estimator_batch.tcl"],
    "ESTIMATOR_LIB_TCL": ["estimator_lib.tcl"],
    "ESTIMATOR_TCL": ["estimator.tcl"],
    "IO_CONSTRAINTS": ["io_constraints.tcl"],
}

# Ground Truth measurement using actual grt output from orfs_flow
orfs_run(
    name = "extract_ground_truth",
    src = ":multiplier_asap7_grt",
    outs = [
        "ground_truth.json",
    ],
    arguments = MULTIPLIER_ARGS | {
        "OUTPUT_JSON": "$(location ground_truth.json)",
    },
    cmd = "run",
    script = "extract.tcl",
    sources = {
        "EXTRACT_TCL": ["extract.tcl"],
    },
)

# Standalone fast estimator executable target for Optuna hyperparameter exploration
orfs_run_executable(
    name = "fast_estimator_executable",
    src = ":multiplier_asap7_synth",
    arguments = MULTIPLIER_ARGS,
    cmd = "run",
    script = "estimator.tcl",
    sources = ESTIMATOR_SOURCES,
)

py_binary(
    name = "optuna_study",
    srcs = ["optuna_study.py"],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "multiplier",
    ],
    data = [
        "ground_truth.json",
        ":fast_estimator_executable",
        ":multiplier_asap7_grt",
        ":multiplier_asap7_synth",
    ],
    deps = [
        ":estimation_metrics",
        "@bazel-orfs-dev-pip//optuna",
        "@bazel-orfs-dev-pip//pandas",
    ],
)

py_binary(
    name = "wave_savings",
    srcs = ["wave_savings.py"],
)

py_binary(
    name = "update-readme",
    srcs = ["update_readme.py"],
    args = [
        "$(location ground_truth.json)",
        "$(location ground_truth_top.json)",
    ],
    data = [
        "ground_truth.json",
        "ground_truth_top.json",
    ],
    main = "update_readme.py",
    deps = [
        "@bazel-orfs-dev-pip//matplotlib",
        "@bazel-orfs-dev-pip//pandas",
        "@bazel-orfs-dev-pip//tabulate",
    ],
)

py_test(
    name = "optuna_study_test",
    timeout = "eternal",
    srcs = ["optuna_study_test.py"],
    args = [
        "$(location :optuna_study)",
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
    ],
    data = [
        "ground_truth.json",
        "ground_truth_top.json",
        ":fast_estimator_executable",
        ":fast_estimator_top_executable",
        ":optuna_study",
    ],
    tags = ["manual"],
    deps = [
        "@bazel-orfs-dev-pip//pandas",
    ],
)

# -------------------------------------------------------------
# Complex Macro-Based Design Target
# -------------------------------------------------------------

MULTIPLIER_TOP_SOURCES = {
    "SDC_FILE": ["constraints.sdc"],
    "IO_CONSTRAINTS": ["io_constraints.tcl"],
}

MULTIPLIER_TOP_ARGS = {
    "DESIGN_NAME": "multiplier_top",
    "DIE_AREA": "0 0 400 400",
    "CORE_AREA": "4 4 396 396",
    "PDN_TCL": "$(PLATFORM_DIR)/openRoad/pdn/BLOCKS_grid_strategy.tcl",
    "PLACE_DENSITY": "0.65",
}

orfs_flow(
    name = "multiplier_top_asap7",
    arguments = MULTIPLIER_TOP_ARGS,
    macros = [":multiplier_asap7_generate_abstract"],
    sources = MULTIPLIER_TOP_SOURCES,
    tags = ["manual"],
    top = "multiplier_top",
    verilog_files = [
        "multiplier_top.sv",
        "multiplier.sv",
    ],
)

orfs_run(
    name = "extract_ground_truth_top",
    src = ":multiplier_top_asap7_grt",
    outs = [
        "ground_truth_top.json",
    ],
    arguments = MULTIPLIER_TOP_ARGS | {
        "OUTPUT_JSON": "$(location ground_truth_top.json)",
    },
    cmd = "run",
    script = "extract.tcl",
    sources = {
        "EXTRACT_TCL": ["extract.tcl"],
    },
)

orfs_run_executable(
    name = "fast_estimator_top_executable",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "estimator.tcl",
    sources = ESTIMATOR_SOURCES,
)

py_binary(
    name = "optuna_study_top",
    srcs = ["optuna_study.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
        ":multiplier_top_asap7_grt",
        ":multiplier_top_asap7_synth",
    ],
    main = "optuna_study.py",
    deps = [
        ":estimation_metrics",
        "@bazel-orfs-dev-pip//optuna",
        "@bazel-orfs-dev-pip//pandas",
    ],
)

# -------------------------------------------------------------
# Rung B: adaptive runtime measurement
#
# Kept separate from the rung A binaries on purpose: rung A runs
# estimators concurrently and must never be in the same process as the
# rung that times them one at a time.
# -------------------------------------------------------------

py_library(
    name = "optuna_study_lib",
    srcs = ["optuna_study.py"],
    imports = ["."],
    deps = [
        ":estimation_metrics",
        "@bazel-orfs-dev-pip//optuna",
    ],
)

py_binary(
    name = "measure_runtime",
    srcs = ["measure_runtime.py"],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "multiplier",
        "--archive",
        "archive_multiplier.json",
    ],
    data = [
        "ground_truth.json",
        ":fast_estimator_executable",
    ],
    deps = [
        ":optuna_study_lib",
        "@bazel-orfs-dev-pip//scikit_learn",
    ],
)

py_binary(
    name = "measure_runtime_top",
    srcs = ["measure_runtime.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top",
        "--archive",
        "archive_multiplier_top.json",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "measure_runtime.py",
    deps = [
        ":optuna_study_lib",
        "@bazel-orfs-dev-pip//scikit_learn",
    ],
)

# Fit the calibration constant on the simple design, apply it unchanged
# to the macro design. Fitting and scoring on the same ground truth
# would measure nothing but the free parameter, so the two designs are
# wired in deliberately.
py_binary(
    name = "calibration_transfer",
    srcs = ["calibration.py"],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
    ],
    data = [
        "ground_truth.json",
        "ground_truth_top.json",
        ":fast_estimator_executable",
        ":fast_estimator_top_executable",
    ],
    main = "calibration.py",
    deps = [":optuna_study_lib"],
)

# Fit alternative calibration models to the per-path pairs the transfer
# test already produced. Pure post-processing -- seconds against runs
# that cost minutes -- so it takes no estimator dependency.
py_binary(
    name = "calibration_models",
    srcs = ["calibration_models.py"],
    deps = [
        "@bazel-orfs-dev-pip//numpy",
        "@bazel-orfs-dev-pip//scikit_learn",
        "@bazel-orfs-dev-pip//scipy",
    ],
)

# B1: what happens to the macros when rtl_macro_placer is skipped? Four
# of the six front points on the macro design skip it, so whether global
# placement positions the macros sensibly or leaves them stacked decides
# whether those points mean anything.
orfs_run_executable(
    name = "macro_probe",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "macro_probe.tcl",
    sources = {
        "MACRO_PROBE_TCL": ["macro_probe.tcl"],
        "IO_CONSTRAINTS": ["io_constraints.tcl"],
    },
)

orfs_run_executable(
    name = "nameprobe",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "nameprobe.tcl",
    sources = {"NAMEPROBE_TCL": ["nameprobe.tcl"]},
)

# C2: can a per-path feature fix the ordering, which no correction
# reading only the estimate can? Post-processing over the pairs the
# transfer test already collected.
py_binary(
    name = "feature_models",
    srcs = ["feature_models.py"],
    deps = [
        "@bazel-orfs-dev-pip//numpy",
        "@bazel-orfs-dev-pip//scikit_learn",
        "@bazel-orfs-dev-pip//scipy",
    ],
)

# -------------------------------------------------------------
# The macro-path study.
#
# The same design and the same estimator runs, scored only on the paths
# that touch a macro pin. They are a separate population -- faster than
# the top-level logic, never among the worst paths, and ordered far
# worse by the estimator -- so a sweep guided by the combined average
# optimises for the non-macro majority and never explores what the macro
# paths need. What it takes to estimate macro timing is its own
# question, and it gets its own study.
# -------------------------------------------------------------

py_binary(
    name = "optuna_study_top_macro",
    srcs = ["optuna_study.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top_macro",
        "--subset",
        "macro",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "optuna_study.py",
    deps = [
        ":estimation_metrics",
        "@bazel-orfs-dev-pip//optuna",
        "@bazel-orfs-dev-pip//pandas",
    ],
)

py_binary(
    name = "measure_runtime_top_macro",
    srcs = ["measure_runtime.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top_macro",
        "--archive",
        "archive_multiplier_top_macro.json",
        "--accuracy-key",
        "mean_rel_err_macro",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "measure_runtime.py",
    deps = [
        ":optuna_study_lib",
        "@bazel-orfs-dev-pip//scikit_learn",
    ],
)

orfs_run_executable(
    name = "layer_probe",
    src = ":multiplier_top_asap7_synth",
    arguments = MULTIPLIER_TOP_ARGS,
    cmd = "run",
    script = "layer_probe.tcl",
    sources = {"LAYER_PROBE_TCL": ["layer_probe.tcl"]},
)

# B4: which routing layer should stand in for "an average wire"? One
# knob, one rung held fixed, every layer run on both designs -- a
# controlled experiment rather than an association pulled out of a sweep.
py_binary(
    name = "rc_sweep",
    srcs = ["rc_sweep.py"],
    args = [
        "$(location :fast_estimator_executable)",
        "$(location ground_truth.json)",
        "multiplier",
    ],
    data = [
        "ground_truth.json",
        ":fast_estimator_executable",
    ],
    deps = [":optuna_study_lib"],
)

py_binary(
    name = "rc_sweep_top",
    srcs = ["rc_sweep.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "rc_sweep.py",
    deps = [":optuna_study_lib"],
)

# -------------------------------------------------------------
# B3: does the bias cancel when comparing two designs?
#
# Absolute error is what the study has measured so far, and it is not
# what an engineer iterating on RTL asks. They ask whether variant B is
# faster than variant A, and by how much. Both estimates are optimistic;
# if they are optimistic by a similar amount then the difference between
# them survives even though neither number does -- and a difference that
# survives is worth much more than the absolute accuracy suggests.
#
# The variants are the same RTL synthesised against different clock
# targets: genuinely different netlists, close enough together to be the
# A/B case rather than the two-unrelated-designs case already measured.
# -------------------------------------------------------------

AB_PERIODS = [
    "700",
    "800",
    "900",
    "1000",
    "1100",
]

[
    orfs_flow(
        name = "ab_asap7",
        abstract_stage = "grt",
        arguments = MULTIPLIER_ARGS,
        sources = {
            "SDC_FILE": ["constraints_%s.sdc" % period],
            "IO_CONSTRAINTS": ["io_constraints.tcl"],
        },
        tags = ["manual"],
        top = "multiplier",
        # A variant per clock target: the same design name would collide
        # on every intermediate file, since ORFS keys its output tree on
        # the design and the variant rather than the target name.
        variant = "p%s" % period,
        verilog_files = ["multiplier.sv"],
    )
    for period in AB_PERIODS
]

[
    orfs_run(
        name = "ab_%s_ground_truth" % period,
        src = ":ab_asap7_p%s_grt" % period,
        outs = ["ab_%s_truth.json" % period],
        arguments = MULTIPLIER_ARGS | {
            "OUTPUT_JSON": "$(location ab_%s_truth.json)" % period,
        },
        cmd = "run",
        script = "extract.tcl",
        sources = {"EXTRACT_TCL": ["extract.tcl"]},
    )
    for period in AB_PERIODS
]

[
    orfs_run_executable(
        name = "ab_%s_estimator" % period,
        src = ":ab_asap7_p%s_synth" % period,
        arguments = MULTIPLIER_ARGS,
        cmd = "run",
        script = "estimator.tcl",
        sources = ESTIMATOR_SOURCES,
    )
    for period in AB_PERIODS
]

py_binary(
    name = "ab_compare",
    srcs = ["ab_compare.py"],
    args = [
        "--variant=%s=$(location :ab_%s_estimator)=$(location ab_%s_truth.json)" % (p, p, p)
        for p in AB_PERIODS
    ],
    data = [":ab_%s_estimator" % p for p in AB_PERIODS] +
           ["ab_%s_truth.json" % p for p in AB_PERIODS],
    deps = [
        ":estimation_metrics",
        ":optuna_study_lib",
        "@bazel-orfs-dev-pip//scipy",
    ],
)

orfs_run_executable(
    name = "unit_probe",
    src = ":multiplier_asap7_synth",
    arguments = MULTIPLIER_ARGS,
    cmd = "run",
    script = "unit_probe.tcl",
    sources = {"UNIT_PROBE_TCL": ["unit_probe.tcl"]},
)
