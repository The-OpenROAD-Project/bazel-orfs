# the asap7 site width from //test/estimation_ladder:site_probe.
# initialize_floorplan snaps the core to the site grid, so a sub-site
# nudge can snap back to nothing while still being reported as a
# perturbation.
FUZZ_TOP_CORE_AREA = {
    -2: "4 4 395.892 396",
    -1: "4 4 395.946 396",
    0: "4 4 396 396",
    1: "4 4 396.054 396",
    2: "4 4 396.108 396",
}

FUZZ_TOP_ARGS = MULTIPLIER_TOP_ARGS | {"DESIGN_NAME": "multiplier_top_fuzz"}

[
    orfs_flow(
        name = "fuzz_top_asap7",
