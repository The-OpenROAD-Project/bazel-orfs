# The decisive pre-flight for the top gate: what difference can an
# estimator ensemble actually resolve on a design with macros?
#
# Estimator arm only -- no --flow arguments -- because the 900s flow
# reference is the expensive part and there is no point paying for it
# until the paired resolution is known. Phase 1 found the raw spread on
# this design to be ~25% of the achieved period, so an unpaired
# comparison is hopeless; the question is how much of that cancels when
# base and change see the same perturbations.
py_binary(
    name = "gate_probe_top",
    srcs = ["fuzz_floor.py"],
    args = [
        "--macro-rungs",
