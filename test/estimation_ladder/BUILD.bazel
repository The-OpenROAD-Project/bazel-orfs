# -------------------------------------------------------------
# Phase 1 of the multiplier_top CI-gate campaign: is rtl_macro_placer
# deterministic, thread-independent, and stable?
#
# Runs first because any of the three answers changes the rest of the
# campaign, and it costs minutes rather than the 7.5 CPU-hours the flow
# reference does. Global placement is off, so the recorded macro origins
# are the macro placer's output and nothing else's.
#
# The RTL-MP papers describe a multi-start "go-with-the-winners" scheme
# across 10 threads, which is a specific reason to doubt determinism at
# this one stage -- and threads do not survive fork(), so a thread-
# dependent placer would make run_estimator_batch's cores//len(manifest)
# split an uncontrolled perturbation.
# -------------------------------------------------------------
py_binary(
    name = "macro_stability_top",
    srcs = ["macro_stability.py"],
    args = [
        "$(location :fast_estimator_top_executable)",
        "$(location ground_truth_top.json)",
        "multiplier_top",
    ],
    data = [
        "ground_truth_top.json",
        ":fast_estimator_top_executable",
    ],
    main = "macro_stability.py",
    deps = [":optuna_study_lib"],
)

# -------------------------------------------------------------
# The multiplier_top CI-gate campaign: flow reference verdicts.
#
# Six top-level RTL variants at five site-aligned core-area
# perturbations, through the real flow. This is the reference the
# estimator's verdicts are scored against, and at ~900s a run it is the
# dominant cost of the campaign -- so the variant list is deliberately
# short and chosen from what the multiplier campaign actually learned.
#
# Statement-order and identity-wire fuzzes are absent on purpose: yosys
# canonicalised both away there, giving a timing fingerprint identical to
# the base at every perturbation, and each would cost five 900s runs to
# learn the same nothing. The reassociation fuzzes are the ones that
# reached the netlist.
#
# The macro's CONTENTS are constant -- every variant consumes the same
# :multiplier_asap7_generate_abstract, hardened once. Its PLACEMENT is
# not: rtl_macro_placer runs for every variant and every perturbation,
# because macro placement is the biggest lever on top-level QoR and
# frequently the thing a change is trying to move, and nothing can tell
# us programmatically which changes affect it.
# -------------------------------------------------------------

FUZZ_TOP_VARIANTS = {
    # name: (VERILOG_DEFINES, true effect on the achieved period)
    "base": ("", "reference"),
    "roworder": ("-D FUZZ_TOP_ROWORDER=1", "zero"),
