WHOLE_DESIGN = {
    "SYNTH_VERILOG_SURGERY": (
        {},
        {"SYNTH_VERILOG_SURGERY": ["//test/verilog_surgery:surgery.py"]},
    ),
    "VERILOG_TOP_PARAMS": (
        {"VERILOG_TOP_PARAMS": "WIDTH 8"},
        {},
    ),
}

[orfs_flow(
    name = "WholeDesign",
    arguments = ARGUMENTS | arguments,
    last_stage = "synth",
    sources = {"SDC_FILE": [":constraints.sdc"]} | sources,
    tags = ["manual"],
    top = "SliceTop",
    variant = "%s_auto" % var,
    verilog_files = ["before.v"],
) for var, (arguments, sources) in WHOLE_DESIGN.items()]

# A lone synth stage: nothing else depends on a target that is refused
# at analysis, so CI's manual-target analysis can leave it out by itself.
[orfs_synth(
    name = "WholeDesign_%s_true_synth" % var,
    arguments = ARGUMENTS | arguments,
    module_top = "SliceTop",
    sources = {"SDC_FILE": [":constraints.sdc"]} | sources,
    tags = ["manual"],
    variant = "%s_true" % var,
    verilog_files = ["before.v"],
    verilog_slices = True,
) for var, (arguments, sources) in WHOLE_DESIGN.items()]

[slices_off_test(
    name = "whole_design_%s_auto_test" % var,
    target_under_test = ":WholeDesign_%s_auto_synth" % var,
) for var in WHOLE_DESIGN]

[analysis_failure_test(
    name = "whole_design_%s_refused_test" % var,
    message = "%s acts on the whole design" % var,
    target_under_test = ":WholeDesign_%s_true_synth" % var,
) for var in WHOLE_DESIGN]
