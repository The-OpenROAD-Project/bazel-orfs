load("@rules_python//python:defs.bzl", "py_test")

# verilog_slices: each kept module canonicalized from its own slice of
# the Verilog instead of from the global canonicalize.
#
# SliceTop keeps Outer, Inner (inside Outer) and Other (which holds a
# memory AUTO_MEMORIES makes a macro of, from ram_64x16.memories). after.v differs from before.v in
# Inner's body only.
# The global variant opts out (verilog_slices = False), before slices by
# default (SYNTH_KEEP_MODULES pinned) and after asks for it explicitly.
#
#   slices_equal_test   the slice path gives the partitions the global
#                       path gives them: byte-identical netlists, and the
#                       same merged netlist.
#   slices_edit_test    the edit to Inner leaves Outer's and Other's
#                       slices, canonical RTLIL and netlists as they were.
#   slices_key_test     no per-module canonicalize reads the global
#                       canonicalize or the design's sources.
#   module_sta_inner_test, module_sta_outer_test
#                       the after variant's Inner, and its Outer with the
#                       Inner inside, swapped into their contexts cut from
#                       the before variant, time as the after variant
#                       does flat, endpoint for endpoint.
#   module_sta_negative_test
#                       the before Inner in the same context does not.
#   SliceTop_sta_ab     what the edit did to timing (orfs_timing_ab).
#
# MemTop keeps MemA and MemB, which hold a memory each, and Plain, in two
# partitions (SYNTH_NUM_PARTITIONS = 2): MemA and MemB share one.
#
#   slices_grouped_test     each partition reads its modules' slices'
#                           memories and not the whole design's.
#   slices_partitions_test  the memories are found, and the netlists are
#                           those of one partition per module.
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:openroad.bzl", "orfs_flat_sta", "orfs_flow", "orfs_module_context", "orfs_module_iteration", "orfs_module_sta_base", "orfs_timing_ab")
load(":slices_key_test.bzl", "slices_grouped_test", "slices_key_test")

package(default_visibility = ["//visibility:private"])

KEPT = [
    "Outer",
    "Inner",
    "Other",
]

ARGUMENTS = {
    "AUTO_MEMORIES": "1",
    "SYNTH_HIERARCHICAL": "1",
    "SYNTH_KEEP_MODULES": " ".join(KEPT),
    # One module per definition, named as the sources name it, which a
    # slice's canonicalize names it too.
    "SYNTH_SLANG_ARGS": "--disable-instance-caching=false",
}

[orfs_flow(
    name = "SliceTop",
    arguments = ARGUMENTS,
    last_stage = "synth",
    sources = {
        "ADDITIONAL_MEMORIES": [":ram_64x16.memories"],
        "SDC_FILE": [":constraints.sdc"],
    },
    variant = variant,
    verilog_files = [verilog],
    verilog_slices = slices,
) for variant, verilog, slices in [
    ("global", "before.v", False),
    ("before", "before.v", None),
    ("after", "after.v", True),
]]

[filegroup(
    name = "partitions_" + variant,
    srcs = [":SliceTop_%s_synth" % variant],
    output_group = "partitions",
) for variant in [
    "global",
    "before",
    "after",
]]

[filegroup(
    name = "netlist_" + variant,
    srcs = [":SliceTop_%s_synth" % variant],
    output_group = "1_2_yosys.v",
) for variant in [
    "global",
    "before",
]]

sh_test(
    name = "slices_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :netlist_global)",
        "$(location :netlist_before)",
        " ".join(KEPT),
        "$(locations :partitions_global)",
        "--",
        "$(locations :partitions_before)",
    ],
    data = [
        ":netlist_before",
        ":netlist_global",
        ":partitions_before",
        ":partitions_global",
    ],
)

sh_test(
    name = "slices_edit_test",
    size = "small",
    srcs = ["slices_edit_test.sh"],
    args = [
        "$(locations :partitions_before)",
        "--",
        "$(locations :partitions_after)",
    ],
    data = [
        ":partitions_after",
        ":partitions_before",
    ],
)

# FoldTop keeps Bank and Entry, with three Entry instances in Bank and two
# beside it, read as slang reads it by default: one module per instance.
# SYNTH_CANONICALIZE_TCL is XiangShan's fold_entries.tcl, which folds the
# copies onto one Entry, on the whole design (global) and on each slice
# (slices).
#
#   fold_equal_test   the slices give every partition, and the design,
#                     the netlist the whole design's fold gives it.
FOLD_KEPT = [
    "Bank",
    "Entry",
]

[orfs_flow(
    name = "FoldTop",
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": " ".join(FOLD_KEPT),
    },
    last_stage = "synth",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
        "SYNTH_CANONICALIZE_TCL": ["//test/coremark_joule/designs/asap7/xiangshan:fold_entries.tcl"],
    },
    user_arguments = {"XS_FOLD_MODULES": "Entry"},
    user_stages = {"XS_FOLD_MODULES": ["synth"]},
    variant = variant,
    verilog_files = ["fold.v"],
    verilog_slices = slices,
) for variant, slices in [
    ("global", False),
    ("slices", True),
]]

[filegroup(
    name = "fold_%s_%s" % (group, variant),
    srcs = [":FoldTop_%s_synth" % variant],
    output_group = group,
) for group in [
    "partitions",
    "1_2_yosys.v",
] for variant in [
    "global",
    "slices",
]]

sh_test(
    name = "fold_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :fold_1_2_yosys.v_global)",
        "$(location :fold_1_2_yosys.v_slices)",
        " ".join(FOLD_KEPT),
        "$(locations :fold_partitions_global)",
        "--",
        "$(locations :fold_partitions_slices)",
    ],
    data = [
        ":fold_1_2_yosys.v_global",
        ":fold_1_2_yosys.v_slices",
        ":fold_partitions_global",
        ":fold_partitions_slices",
    ],
)

# DpiTop keeps Counter and Watcher, which call DPI functions, and Mixer,
# which calls none, from firtool's guarded DPI imports between modules.
#
#   dpi_equal_test   the slices elaborate, which a call with no import
#                    would not, and give every partition, and the design,
#                    the netlist the whole design gives it.
DPI_KEPT = [
    "Counter",
    "Watcher",
    "Mixer",
]

[orfs_flow(
    name = "DpiTop",
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": " ".join(DPI_KEPT),
    },
    last_stage = "synth",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
    },
    variant = variant,
    verilog_files = ["dpi.v"],
    verilog_slices = slices,
) for variant, slices in [
    ("global", False),
    ("slices", True),
]]

[filegroup(
    name = "dpi_%s_%s" % (group, variant),
    srcs = [":DpiTop_%s_synth" % variant],
    output_group = group,
) for group in [
    "partitions",
    "1_2_yosys.v",
] for variant in [
    "global",
    "slices",
]]

sh_test(
    name = "dpi_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :dpi_1_2_yosys.v_global)",
        "$(location :dpi_1_2_yosys.v_slices)",
        " ".join(DPI_KEPT),
        "$(locations :dpi_partitions_global)",
        "--",
        "$(locations :dpi_partitions_slices)",
    ],
    data = [
        ":dpi_1_2_yosys.v_global",
        ":dpi_1_2_yosys.v_slices",
        ":dpi_partitions_global",
        ":dpi_partitions_slices",
    ],
)

slices_key_test(
    name = "slices_key_test",
    modules = KEPT,
    sources = ["before.v"],
    target_under_test = ":SliceTop_before_synth",
)

# Module-in-context timing (private/module_sta.bzl): the before variant as
# a hierarchical database, the contexts of Inner (a leaf) and Outer (which
# holds Inner) cut from it, and each swapped for its after variant and
# timed. Every endpoint of the module and of the registers it reaches must
# have the slack the after variant has timed flat; the before Inner in
# Inner's context must not (the negative control).
orfs_module_sta_base(
    name = "SliceTop_hier",
    synth = ":SliceTop_before_synth",
)

[orfs_module_context(
    name = "SliceTop_%s_ctx" % name,
    base = ":SliceTop_hier",
    clocks = {"clock": "2000"},
    module = path,
) for name, path in [
    ("inner", "outer/inner"),
    ("outer", "outer"),
]]

[orfs_flat_sta(
    name = "SliceTop_%s_flat" % variant,
    base = ":SliceTop_hier",
    clocks = {"clock": "2000"},
    synth = ":SliceTop_%s_synth" % variant,
) for variant in [
    "before",
    "after",
]]

# a variant's partition netlist, its module renamed, as the AI loop hands
# a module it synthesised again to the iteration
[genrule(
    name = "%s_%s_new" % (module, variant),
    srcs = [":partitions_" + variant],
    outs = ["%s_%s_new.v" % (module, variant)],
    cmd = "for f in $(SRCS); do case $$f in */partition_%s.v) $(execpath //tools/module_sta:rename_module) $$f %s_new $@ ;; esac; done" % (module, module),
    tools = ["//tools/module_sta:rename_module"],
) for module, variant in [
    ("Inner", "before"),
    ("Inner", "after"),
    ("Outer", "after"),
]]

orfs_module_iteration(
    name = "SliceTop_inner_after",
    context = ":SliceTop_inner_ctx",
    netlists = [":Inner_after_new"],
    new_module = "Inner_new",
)

orfs_module_iteration(
    name = "SliceTop_inner_before",
    context = ":SliceTop_inner_ctx",
    netlists = [":Inner_before_new"],
    new_module = "Inner_new",
)

genrule(
    name = "partition_Inner_after",
    srcs = [":partitions_after"],
    outs = ["partition_Inner_after.v"],
    cmd = "for f in $(SRCS); do case $$f in */partition_Inner.v) cp $$f $@ ;; esac; done",
)

orfs_module_iteration(
    name = "SliceTop_outer_after",
    context = ":SliceTop_outer_ctx",
    netlists = [
        ":Outer_after_new",
        ":partition_Inner_after",
    ],
    new_module = "Outer_new",
)

[py_test(
    name = name,
    size = "small",
    srcs = ["//tools/module_sta:ends.py"],
    args = [
        "compare",
        "$(location :%s)" % iteration,
        "$(location :SliceTop_after_flat)",
    ] + extra,
    data = [
        ":" + iteration,
        ":SliceTop_after_flat",
    ],
    main = "//tools/module_sta:ends.py",
) for name, iteration, extra in [
    ("module_sta_inner_test", "SliceTop_inner_after", []),
    ("module_sta_outer_test", "SliceTop_outer_after", []),
    (
        "module_sta_negative_test",
        "SliceTop_inner_before",
        ["--expect-differences"],
    ),
]]

orfs_timing_ab(
    name = "SliceTop_sta_ab",
    a = ":SliceTop_before_flat",
    b = ":SliceTop_inner_after",
)

MEM_KEPT = [
    "MemA",
    "Plain",
    "MemB",
]

[orfs_flow(
    name = "MemTop",
    arguments = ARGUMENTS | {"SYNTH_KEEP_MODULES": " ".join(MEM_KEPT)} | extra,
    last_stage = "synth",
    sources = {
        "ADDITIONAL_MEMORIES": [":ram_64x16.memories"],
        "SDC_FILE": [":constraints.sdc"],
    },
    variant = variant,
    verilog_files = ["memories.v"],
    verilog_slices = True,
) for variant, extra in [
    ("modules", {}),
    (
        "grouped",
        {"SYNTH_NUM_PARTITIONS": "2"},
    ),
]]

[filegroup(
    name = "mem_%s_%s" % (name, variant),
    srcs = [":MemTop_%s_synth" % variant],
    output_group = group,
) for name, group in [
    ("partitions", "partitions"),
    ("netlist", "1_2_yosys.v"),
] for variant in [
    "modules",
    "grouped",
]]

slices_grouped_test(
    name = "slices_grouped_test",
    partitions = {
        "0": [
            "MemA",
            "MemB",
        ],
        "1": ["Plain"],
    },
    target_under_test = ":MemTop_grouped_synth",
)

sh_test(
    name = "slices_partitions_test",
    size = "small",
    srcs = ["slices_partitions_test.sh"],
    args = [
        "$(location :mem_netlist_modules)",
        "$(location :mem_netlist_grouped)",
        "$(locations :mem_partitions_modules)",
        "--",
        "$(locations :mem_partitions_grouped)",
    ],
    data = [
        ":mem_netlist_grouped",
        ":mem_netlist_modules",
        ":mem_partitions_grouped",
        ":mem_partitions_modules",
    ],
)
