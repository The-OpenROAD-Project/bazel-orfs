    data = [
        ":port_order_netlist_global",
        ":port_order_netlist_slices",
        ":port_order_partitions_global",
        ":port_order_partitions_slices",
    ],
)

# RomTop keeps Lookup, whose two case statements yosys's proc_rom makes
# ROMs of, as it does the top's. proc_rom numbers a ROM within its module
# (patches/yosys-0003-*), so the top's ROM has the same name in the whole
# design, where Lookup's ROMs come first, as in the top's slice.
#
#   rom_memories_test   the slices find the ROMs the whole design does:
#                       the slice memories check passes, and the slices'
#                       memories.json is the global path's.
#   rom_rtlil_test      Lookup and the top are in their slices'
#                       canonicalized RTLIL as in the whole design's,
#                       byte for byte.
#   rom_equal_test      the slices give Lookup's and the top's partition
#                       and the design the netlists the global path gives
#                       them, byte for byte. techmap orders cells by name
#                       (patches/yosys-0007-*), not by IdString index,
#                       which Lookup's names, held in the whole design and
#                       not in the top's slice, shift.
[orfs_flow(
    name = "RomTop",
    arguments = ARGUMENTS | {"SYNTH_KEEP_MODULES": "Lookup"},
    last_stage = "synth",
    sources = {"SDC_FILE": [":constraints.sdc"]},
    variant = variant,
    verilog_files = ["rom.v"],
    verilog_slices = slices,
) for variant, slices in [
    ("global", False),
    ("slices", True),
]]

[filegroup(
    name = "rom_memories_json_" + variant,
    srcs = [":RomTop_%s_synth" % variant],
    output_group = "memories.json",
) for variant in [
    "global",
    "slices",
]]

diff_test(
    name = "rom_memories_test",
    file1 = ":rom_memories_json_global",
    file2 = ":rom_memories_json_slices",
)

filegroup(
    name = "rom_canonicalize_global",
    srcs = [":RomTop_global_synth"],
    output_group = "1_1_yosys_canonicalize.rtlil",
)

[filegroup(
    name = "rom_partitions_" + variant,
    srcs = [":RomTop_%s_synth" % variant],
    output_group = "partitions",
) for variant in [
    "global",
    "slices",
]]

[filegroup(
    name = "rom_netlist_" + variant,
    srcs = [":RomTop_%s_synth" % variant],
    output_group = "1_2_yosys.v",
) for variant in [
    "global",
    "slices",
]]

sh_test(
    name = "rom_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :rom_netlist_global)",
        "$(location :rom_netlist_slices)",
        "Lookup",
        "$(locations :rom_partitions_global)",
