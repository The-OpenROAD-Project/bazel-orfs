# verilog_slices: each kept module canonicalized from its own slice of
# the Verilog instead of from the global canonicalize.
#
# SliceTop keeps Outer, Inner (inside Outer) and Other (which holds a
# memory AUTO_MEMORIES makes a macro of, from ram_64x16.memories). after.v differs from before.v in
# Inner's body only.
# The global variant opts out (verilog_slices = False), before slices by
# default (SYNTH_KEEP_MODULES pinned) and after asks for it explicitly.
#
#   slices_equal_test   the slice path gives the partitions, the top's
#                       included, the netlists the global path gives
#                       them, byte for byte, and the same merged netlist.
#   slices_edit_test    the edit to Inner leaves Outer's and Other's
#                       slices, canonical RTLIL and netlists as they were.
#   slices_key_test     no per-module canonicalize, and not the top
#                       partition, reads the global canonicalize or the
#                       design's sources.
#   module_sta_inner_test, module_sta_outer_test
#                       the after variant's Inner, and its Outer with the
#                       Inner inside, swapped into their contexts cut from
#                       the before variant, time as the after variant
#                       does flat, endpoint for endpoint.
#   module_sta_negative_test
#                       the before Inner in the same context does not.
#   SliceTop_sta_ab     what the edit did to timing (orfs_timing_ab).
#   floorplan_slices_test, floorplan_global_test
#                       with slices the floorplan neither reads nor
#                       forwards the whole design's canonicalize, which
#                       nothing after synthesis reads; without, it does.
#
# MemTop keeps MemA and MemB, which hold a memory each, and Plain, in two
# partitions (SYNTH_NUM_PARTITIONS = 2): MemA and MemB share one. The top
# holds a memory of its own.
#
#   slices_grouped_test     each partition reads its modules' slices'
#                           memories and not the whole design's.
#   slices_partitions_test  the memories are found, and the netlists are
#                           those of one partition per module.
#   mem_equal_test          the slices give every partition, the top's
#                           included, and the design the netlist the
#                           global path gives them.
#   memories_union_test     the slices' memories together are the
#                           whole design's: what the merge, 1_synth.odb
#                           and every later stage read.
#
# SYNTH_VERILOG_SURGERY and VERILOG_TOP_PARAMS act on the whole design.
#
#   whole_design_<var>_auto_test     by default, a flow that sets one
#                                    canonicalizes out of the whole design.
#   whole_design_<var>_refused_test  verilog_slices = True with one is
#                                    refused at analysis.
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:openroad.bzl", "orfs_flat_sta", "orfs_flow", "orfs_module_context", "orfs_module_iteration", "orfs_module_sta_base", "orfs_synth", "orfs_timing_ab")
load("//test:analysis_failure_test.bzl", "analysis_failure_test")
load(":slices_key_test.bzl", "slices_floorplan_test", "slices_grouped_test", "slices_key_test", "slices_off_test")

package(default_visibility = ["//visibility:private"])

KEPT = [
    "Outer",
    "Inner",
    "Other",
]

ARGUMENTS = {
    "AUTO_MEMORIES": "1",
    "SYNTH_HIERARCHICAL": "1",
    "SYNTH_KEEP_MODULES": " ".join(KEPT),
    # One module per definition, named as the sources name it, which a
    # slice's canonicalize names it too.
    "SYNTH_SLANG_ARGS": "--disable-instance-caching=false",
}

[orfs_flow(
    name = "SliceTop",
    arguments = ARGUMENTS,
    last_stage = "synth",
    sources = {
        "ADDITIONAL_MEMORIES": [":ram_64x16.memories"],
        "SDC_FILE": [":constraints.sdc"],
    },
    variant = variant,
    verilog_files = [verilog],
    verilog_slices = slices,
) for variant, verilog, slices in [
    ("global", "before.v", False),
    ("before", "before.v", None),
    ("after", "after.v", True),
]]

[filegroup(
    name = "partitions_" + variant,
    srcs = [":SliceTop_%s_synth" % variant],
    output_group = "partitions",
) for variant in [
    "global",
    "before",
    "after",
]]

[filegroup(
    name = "netlist_" + variant,
    srcs = [":SliceTop_%s_synth" % variant],
    output_group = "1_2_yosys.v",
) for variant in [
    "global",
    "before",
]]

sh_test(
    name = "slices_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :netlist_global)",
        "$(location :netlist_before)",
        " ".join(KEPT),
        "$(locations :partitions_global)",
        "--",
        "$(locations :partitions_before)",
    ],
    data = [
        ":netlist_before",
        ":netlist_global",
        ":partitions_before",
        ":partitions_global",
    ],
)

sh_test(
    name = "slices_edit_test",
    size = "small",
    srcs = ["slices_edit_test.sh"],
    args = [
        "$(locations :partitions_before)",
        "--",
        "$(locations :partitions_after)",
    ],
    data = [
        ":partitions_after",
        ":partitions_before",
    ],
)

# FoldTop keeps Bank and Entry, with three Entry instances in Bank and two
# beside it, read as slang reads it by default: one module per instance.
# SYNTH_CANONICALIZE_TCL is XiangShan's fold_entries.tcl, which folds the
# copies onto one Entry, on the whole design (global) and on each slice
# (slices).
#
#   fold_equal_test   the slices give every partition, the top's
#                     included, and the design the netlist the whole
#                     design's fold gives it.
FOLD_KEPT = [
    "Bank",
    "Entry",
]

[orfs_flow(
    name = "FoldTop",
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": " ".join(FOLD_KEPT),
    },
    last_stage = "synth",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
        "SYNTH_CANONICALIZE_TCL": ["//test/coremark_joule/designs/asap7/xiangshan:fold_entries.tcl"],
    },
    user_arguments = {"XS_FOLD_MODULES": "Entry"},
    user_stages = {"XS_FOLD_MODULES": ["synth"]},
    variant = variant,
    verilog_files = ["fold.v"],
    verilog_slices = slices,
) for variant, slices in [
    ("global", False),
    ("slices", True),
]]

[filegroup(
    name = "fold_%s_%s" % (group, variant),
    srcs = [":FoldTop_%s_synth" % variant],
    output_group = group,
) for group in [
    "partitions",
    "1_2_yosys.v",
] for variant in [
    "global",
    "slices",
]]

sh_test(
    name = "fold_equal_test",
    size = "small",
    srcs = ["slices_equal_test.sh"],
    args = [
        "$(location :fold_1_2_yosys.v_global)",
        "$(location :fold_1_2_yosys.v_slices)",
        " ".join(FOLD_KEPT),
        "$(locations :fold_partitions_global)",
        "--",
        "$(locations :fold_partitions_slices)",
    ],
    data = [
        ":fold_1_2_yosys.v_global",
        ":fold_1_2_yosys.v_slices",
        ":fold_partitions_global",
        ":fold_partitions_slices",
    ],
)

# DpiTop keeps Counter and Watcher, which call DPI functions, and Mixer,
# which calls none, from firtool's guarded DPI imports between modules.
