# buildifier: disable=duplicated-name
[orfs_flow(
    name = "SliceTop",
    arguments = {
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY": "0.65",
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": " ".join(KEPT),
        "SYNTH_SLANG_ARGS": "--disable-instance-caching=false",
    },
    last_stage = "floorplan",
    sources = {"SDC_FILE": [":constraints.sdc"]},
    variant = "floorplan_" + variant,
