        ":rom_canonicalize_global",
        ":rom_partitions_slices",
    ],
)

slices_grouped_test(
    name = "slices_grouped_test",
    partitions = {
        "0": [
            "MemA",
            "MemB",
        ],
        "1": ["Plain"],
    },
    target_under_test = ":MemTop_grouped_synth",
