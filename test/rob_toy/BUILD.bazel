load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load(":rob_toy.bzl", "rob_toy")

# A toy of XiangShan's Rob entry state, scaled by entries with the Rob's
# ports, built through global route against a five-minute roof: grow it
# until a build passes five minutes, fix what took the time, grow again,
# until the Rob's 352 entries are under the roof. Every flow is manual.

py_binary(
    name = "rob_toy",
    srcs = ["rob_toy.py"],
)

py_library(
    name = "rob_toy_lib",
    srcs = ["rob_toy.py"],
    imports = ["."],
)

# the netlist builder, for the real Rob's array
# (test/coremark_joule/designs/asap7/xiangshan/rob_array)
py_library(
    name = "rob_gen_lib",
    srcs = ["rob_gen.py"],
    imports = ["."],
    visibility = ["//test/coremark_joule/designs/asap7/xiangshan/rob_array:__pkg__"],
    deps = [":rob_toy_lib"],
)

py_binary(
    name = "rob_gen",
    srcs = ["rob_gen.py"],
    deps = [
        ":rob_toy_lib",
        "//tools/yosys_arrays:structgen_lib",
    ],
)

[
    rob_toy(entries)
    for entries in [
        16,
        32,
        64,
        128,
        256,
        352,
    ]
]

# build time first, QoR after: the entry logic is ~550 ps deep against
# 473 ps, and at 64 entries the RTL's setup repair ground 74 s of CTS
# over 3,874 violating endpoints; the flows above skip setup repair, the
# ones below compare the generated Rob with the RTL through yosys and
# ABC, the baseline, with it on
[
    rob_toy(
        entries,
        repair = True,
        rtl = rtl,
    )
    for entries in [
        16,
        32,
        64,
        128,
        256,
        352,
    ]
    for rtl in [
        False,
        True,
    ]
]

# the generated structure around one RobEntry of RTL that ABC maps once
[
    rob_toy(
        entries,
        entry_rtl = True,
        repair = True,
    )
    for entries in [
        16,
        32,
        64,
        128,
        256,
        352,
    ]
]

# the generated netlist alone: the flow buffers, sizes and places it
[
    rob_toy(
        entries,
        plain = True,
        repair = True,
    )
    for entries in [
        16,
        32,
        64,
        128,
        256,
        352,
    ]
]
