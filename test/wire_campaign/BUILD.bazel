    visibility = ["//test:__subpackages__"],
)

py_binary(
    name = "campaign",
    srcs = ["campaign.py"],
    main = "campaign.py",
)

py_test(
    name = "campaign_test",
    srcs = [
        "campaign.py",
        "campaign_test.py",
    ],
    main = "campaign_test.py",
)
