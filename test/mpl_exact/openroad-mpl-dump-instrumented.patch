+// Study instrumentation: one JSON line per annealing run in
+// $MPL_DUMP_DIR/mpl_dump.<pid>.jsonl.
+template <class T>
+void SimulatedAnnealingCore<T>::dump(const double seconds) const
+{
+  const char* dir = std::getenv("MPL_DUMP_DIR");
+  if (dir == nullptr) {
+    return;
+  }
+  std::ostringstream os;
+  auto quote = [](const std::string& text) {
+    std::string out = "\"";
+    for (const char c : text) {
+      if (c == '"' || c == '\\') {
+        out += '\\';
+        out += c;
+      } else if (c == '\n') {
+        out += "\\n";
+      } else {
+        out += c;
+      }
+    }
+    return out + "\"";
+  };
+  os << "{\"tag\":" << quote(dump_tag_)
+     << ",\"kind\":" << quote(std::is_same_v<T, SoftMacro> ? "soft" : "hard")
+     << ",\"dbu\":" << block_->getDbUnitsPerMicron() << ",\"outline\":["
+     << outline_.xMin() << "," << outline_.yMin() << "," << outline_.xMax()
+     << "," << outline_.yMax() << "]"
+     << ",\"steps\":" << max_num_step_
+     << ",\"perturb_per_step\":" << num_perturb_per_step_
+     << ",\"seq_pair_macros\":" << number_of_sequence_pair_macros_
+     << ",\"invalid_states_allowed\":" << invalid_states_allowed_
+     << ",\"initial_sequence_pair\":" << has_initial_sequence_pair_
+     << ",\"initial_valid\":" << initial_valid_
+     << ",\"first_valid_step\":" << first_valid_step_
+     << ",\"last_improvement_step\":" << last_improvement_step_
+     << ",\"improvements\":[" << [&] {
+          std::string text;
+          for (const auto& [at, cost] : improvements_) {
+            text += (text.empty() ? "[" : ",[") + std::to_string(at) + ","
+                    + std::to_string(cost) + "]";
+          }
+          return text;
+        }() << "]"
+     << ",\"valid\":" << isValid() << ",\"width\":" << width_
+     << ",\"height\":" << height_ << ",\"norm_cost\":" << calNormCost()
+     << ",\"seconds\":" << seconds << ",\"macros\":[";
+  bool first = true;
+  for (const T& macro : macros_) {
+    os << (first ? "" : ",") << "{\"name\":" << quote(macro.getName())
+       << ",\"w\":" << macro.getWidth() << ",\"h\":" << macro.getHeight()
+       << ",\"x\":" << macro.getX() << ",\"y\":" << macro.getY()
+       << ",\"fixed\":" << macro.isFixed();
+    if constexpr (std::is_same_v<T, SoftMacro>) {
+      const char* type = "other";
+      if (macro.isBlockage()) {
+        type = "blockage";
+      } else if (macro.getCluster() == nullptr) {
+        type = "terminal";
+      } else if (macro.isMacroCluster()) {
+        type = "macro";
+      } else if (macro.isMixedCluster()) {
+        type = "mixed";
+      } else if (macro.isStdCellCluster()) {
+        type = "std";
+      } else if (macro.isClusterOfUnplacedIOPins()) {
+        type = "io";
+      }
+      os << ",\"type\":" << quote(type) << ",\"area\":" << macro.getArea()
+         << ",\"wi\":[";
+      bool first_interval = true;
+      for (const Interval& interval : macro.getWidthIntervals()) {
+        os << (first_interval ? "" : ",") << "[" << interval.min << ","
+           << interval.max << "]";
+        first_interval = false;
+      }
+      os << "],\"hi\":[";
+      first_interval = true;
+      for (const Interval& interval : macro.getHeightIntervals()) {
+        os << (first_interval ? "" : ",") << "[" << interval.min << ","
+           << interval.max << "]";
+        first_interval = false;
+      }
+      os << "]";
+    } else {
+      os << ",\"rw\":" << macro.getRealWidth()
+         << ",\"rh\":" << macro.getRealHeight();
+    }
+    os << "}";
+    first = false;
+  }
+  os << "],\"packing\":" << quote([&] {
+    std::ostringstream text;
+    writePackingProblem(
+        text,
+        "_",
+        toPackingProblem(outline_, macros_, number_of_sequence_pair_macros_));
+    return text.str();
+  }());
+  os << "}\n";
+
+  static std::mutex mutex;
+  std::lock_guard<std::mutex> lock(mutex);
+  std::ofstream out(std::string(dir) + "/mpl_dump."
+                        + std::to_string(getpid()) + ".jsonl",
+                    std::ios::app);
+  out << os.str();
+}
+
 template class SimulatedAnnealingCore<SoftMacro>;
 template class SimulatedAnnealingCore<HardMacro>;
 
