@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Study driver: reads packing problems (writePackingProblem's format) from
+// stdin, prints one CSV row each.
+//   packing_driver [deterministic_time [workers [fixes]]]
+// With "fixes", each problem that does not fit also gets the smallest
+// height at its width, width at its height and same-aspect width.
+
+#include <chrono>
+#include <cstdlib>
+#include <iostream>
+#include <string>
+
+#include "packing.h"
+
+int main(int argc, char** argv)
+{
+  mpl::PackingLimits limits;
+  if (argc > 1) {
+    limits.deterministic_time = std::atof(argv[1]);
+  }
+  if (argc > 2) {
+    limits.workers = std::atoi(argv[2]);
+  }
+  const bool fixes = argc > 3 && std::string(argv[3]) == "fixes";
+  const char* status_names[] = {"fits", "does_not_fit", "undecided"};
+  const char* cause_names[]
+      = {"none", "block_too_wide", "block_too_tall", "area", "arrangement"};
+  std::cout << "tag,width,height,blocks,status,cause,seconds"
+            << (fixes ? ",min_height,min_width,same_aspect_width" : "")
+            << "\n";
+  std::string tag;
+  mpl::PackingProblem problem;
+  while (mpl::readPackingProblem(std::cin, tag, problem)) {
+    const auto start = std::chrono::steady_clock::now();
+    const mpl::PackingResult result = mpl::checkPacking(problem, limits);
+    const std::chrono::duration<double> elapsed
+        = std::chrono::steady_clock::now() - start;
+    std::cout << tag << "," << problem.width << "," << problem.height << ","
+              << problem.blocks.size() << ","
+              << status_names[static_cast<int>(result.status)] << ","
+              << cause_names[static_cast<int>(result.cause)] << ","
+              << elapsed.count();
+    if (fixes) {
+      auto range = [](const mpl::DimensionFix& fix) {
+        if (!fix.found) {
+          return std::string("none");
+        }
+        return fix.lower == fix.upper ? std::to_string(fix.upper)
+                                      : std::to_string(fix.lower) + "-"
+                                            + std::to_string(fix.upper);
+      };
+      if (result.status == mpl::PackingStatus::kDoesNotFit) {
+        std::cout << "," << range(mpl::smallestHeight(problem, 1, limits))
+                  << "," << range(mpl::smallestWidth(problem, 1, limits))
+                  << "," << range(mpl::smallestSameAspect(problem, 1, limits));
+      } else {
+        std::cout << ",,,";
+      }
+    }
+    std::cout << "\n";
+  }
+  return 0;
+}
