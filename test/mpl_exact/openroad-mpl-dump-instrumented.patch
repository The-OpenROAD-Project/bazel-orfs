new file mode 100644
index 0000000000..addca0e6af
--- /dev/null
+++ b/src/mpl/src/packing.h
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#pragma once
+
+#include <cstdint>
+#include <iosfwd>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "shapes.h"
+
+namespace mpl {
+
+// Exact feasibility of a fixed-outline packing: can these rectangles be
+// placed inside a W x H outline without overlap? Coordinates and sizes are
+// integers (DBU), relative to the outline's lower-left corner, halos
+// included. No odb dependency, so the questions can be asked from unit tests
+// and from the annealer's callers alike.
+
+// One piece of a soft block's shape curve: any width in `width`, with
+// height = floor(area / width), as mpl's SoftMacro resizes.
+struct SoftShape
+{
+  Interval width;
+  int64_t area{0};
+};
+
+struct PackingBlock
+{
+  std::string name;
+  // Allowed (width, height) pairs; one entry for a rigid block.
+  std::vector<Tiling> shapes;
+  // A soft block's shape curve; used instead of `shapes` when not empty.
+  std::vector<SoftShape> soft_shapes;
+  // A block that may not move; it uses shapes.front().
+  std::optional<int> fixed_x;
+  std::optional<int> fixed_y;
+
+  bool isFixed() const { return fixed_x.has_value(); }
+  bool isSoft() const { return !soft_shapes.empty(); }
+};
+
+struct PackingProblem
+{
+  int width{0};
+  int height{0};
+  std::vector<PackingBlock> blocks;
+};
+
+enum class PackingStatus
+{
+  kFits,
+  kDoesNotFit,
+  kUndecided  // the solver's deterministic limit ran out
+};
+
+// Why a problem does not fit, in the order they are checked.
+enum class PackingCause
+{
+  kNone,
+  kBlockTooWide,   // one block is wider than the outline in every shape
+  kBlockTooTall,   // one block is taller than the outline in every shape
+  kArea,           // the blocks' minimum areas exceed the outline's area
+  kArrangement     // the area suffices, no arrangement does
+};
+
+struct PlacedBlock
+{
+  int x{0};
+  int y{0};
+  int width{0};
+  int height{0};
+};
+
+struct PackingResult
+{
+  PackingStatus status{PackingStatus::kUndecided};
+  PackingCause cause{PackingCause::kNone};
+  // Index of the block named by kBlockTooWide/kBlockTooTall.
+  int block{-1};
+  // One entry per block when status is kFits.
+  std::vector<PlacedBlock> placement;
+  // The solver's status when it decided nothing, for diagnostics.
+  std::string solver_status;
+};
+
+struct PackingLimits
+{
+  // CP-SAT deterministic time, independent of machine load.
+  double deterministic_time{10.0};
+  int seed{0};
+  // More than one worker runs CP-SAT's portfolio interleaved, which keeps
+  // the answer independent of thread scheduling.
+  int workers{1};
+};
+
+PackingResult checkPacking(const PackingProblem& problem,
+                           const PackingLimits& limits = {});
+
+// The smallest outline dimension at which the problem fits, searched on
+// multiples of `step` (a row height, a site width). `lower` is proven not to
+// fit below it, `upper` proven to fit; they are equal unless a check was
+// undecided. A bigger outline never makes a packing impossible, so the
+// search is a bisection over exact checks.
+struct DimensionFix
+{
+  bool found{false};  // no outline up to the search limit fits
+  int lower{0};
+  int upper{0};
+};
+
+// Keep the width, grow or shrink the height.
+DimensionFix smallestHeight(const PackingProblem& problem,
+                            int step,
+                            const PackingLimits& limits = {});
+// Keep the height, grow or shrink the width.
+DimensionFix smallestWidth(const PackingProblem& problem,
+                           int step,
+                           const PackingLimits& limits = {});
+// Keep the aspect ratio; the result is the width, the height follows as
+// ceil(width * height / problem.width) rounded up to `step`.
+DimensionFix smallestSameAspect(const PackingProblem& problem,
+                                int step,
+                                const PackingLimits& limits = {});
+
+// A plain-text form of a problem, one line per item, for reproducers:
+//   P <tag> <width> <height> <blocks>
+//   B <name> F <x> <y> <width> <height>        a fixed block
+//   B <name> R <k> <width> <height> ...        k rigid shapes
+//   B <name> S <k> <min> <max> <area> ...      k soft pieces
+// Names must not contain white space.
+void writePackingProblem(std::ostream& out,
+                         const std::string& tag,
+                         const PackingProblem& problem);
+// Returns false at the end of the input; throws on malformed input.
+bool readPackingProblem(std::istream& in,
+                        std::string& tag,
+                        PackingProblem& problem);
+
+}  // namespace mpl
diff --git a/src/mpl/src/packingAdapter.cpp b/src/mpl/src/packingAdapter.cpp
new file mode 100644
index 0000000000..fc5131171d
--- /dev/null
+++ b/src/mpl/src/packingAdapter.cpp
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "packingAdapter.h"
+
+#include <cstdint>
+#include <vector>
+
+#include "object.h"
+#include "odb/geom.h"
+#include "packing.h"
+#include "shapes.h"
+
+namespace mpl {
+
+namespace {
+
+int packedCount(const int sequence_pair_macros, const size_t size)
+{
+  return sequence_pair_macros > 0 ? sequence_pair_macros
+                                  : static_cast<int>(size);
+}
+
+PackingBlock fixedBlock(const std::string& name,
+                        const int x,
+                        const int y,
+                        const int width,
+                        const int height)
+{
+  PackingBlock block;
+  block.name = name;
+  block.shapes.emplace_back(width, height);
+  block.fixed_x = x;
+  block.fixed_y = y;
+  return block;
+}
+
+}  // namespace
+
+PackingProblem toPackingProblem(const odb::Rect& outline,
+                                const std::vector<SoftMacro>& macros,
+                                const int sequence_pair_macros)
+{
+  PackingProblem problem{outline.dx(), outline.dy(), {}};
+  const int count = packedCount(sequence_pair_macros, macros.size());
+  for (int i = 0; i < count; i++) {
+    const SoftMacro& macro = macros[i];
+    if (static_cast<int64_t>(macro.getWidth()) * macro.getHeight() == 0) {
+      continue;  // takes no room
+    }
+    if (macro.isFixed()) {
+      problem.blocks.push_back(fixedBlock(macro.getName(),
+                                          macro.getX(),
+                                          macro.getY(),
+                                          macro.getWidth(),
+                                          macro.getHeight()));
+      continue;
+    }
+    PackingBlock block;
+    block.name = macro.getName();
+    const IntervalList& widths = macro.getWidthIntervals();
+    const IntervalList& heights = macro.getHeightIntervals();
+    bool rigid = true;
+    for (size_t k = 0; k < widths.size(); k++) {
+      rigid &= widths[k].min == widths[k].max
+               && heights[k].min == heights[k].max;
+    }
+    if (widths.empty()) {
+      // No shape curve: the annealer never resizes it.
+      block.shapes.emplace_back(macro.getWidth(), macro.getHeight());
+    } else if (rigid) {
+      for (size_t k = 0; k < widths.size(); k++) {
+        block.shapes.emplace_back(widths[k].min, heights[k].min);
+      }
+    } else {
+      // SoftMacro::resizeRandomly: piece k keeps the area
+      // min width * max height, and height = floor(area / width).
+      for (size_t k = 0; k < widths.size(); k++) {
+        block.soft_shapes.push_back(
+            {widths[k], widths[k].min * static_cast<int64_t>(heights[k].max)});
+      }
+    }
+    problem.blocks.push_back(block);
+  }
+  return problem;
+}
+
+PackingProblem toPackingProblem(const odb::Rect& outline,
+                                const std::vector<HardMacro>& macros,
+                                const int sequence_pair_macros)
+{
+  PackingProblem problem{outline.dx(), outline.dy(), {}};
+  const int count = packedCount(sequence_pair_macros, macros.size());
+  for (int i = 0; i < count; i++) {
+    const HardMacro& macro = macros[i];
+    if (macro.getArea() == 0) {
+      continue;
+    }
+    if (macro.isFixed()) {
+      problem.blocks.push_back(fixedBlock(macro.getName(),
+                                          macro.getX(),
+                                          macro.getY(),
+                                          macro.getWidth(),
+                                          macro.getHeight()));
+      continue;
+    }
+    PackingBlock block;
+    block.name = macro.getName();
+    block.shapes.emplace_back(macro.getWidth(), macro.getHeight());
+    problem.blocks.push_back(block);
+  }
+  return problem;
+}
+
+}  // namespace mpl
