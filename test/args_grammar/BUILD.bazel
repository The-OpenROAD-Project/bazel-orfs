load("@bazel-orfs//:openroad.bzl", "orfs_flow")
load("@rules_python//python:defs.bzl", "py_test")

# ORFS's command arguments grammar (carried ORFS patch 0247, ORFS #4771)
# through bazel-orfs: one variable per command, each edit scoped to a stage
# or a call. private/stages.bzl gives each stage the edits it reads, so the
# value of ARGS below that a stage's action sees is:
#
#   floorplan  REPAIR_TIMING_ARGS = floorplan:0
#   place      REPAIR_TIMING_ARGS = place:0
#   cts        REPAIR_TIMING_ARGS = cts:0
#   grt        REPAIR_TIMING_ARGS = grt:-setup_margin 0.1
#              GLOBAL_ROUTE_ARGS  = -congestion_iterations 20
#
# stage_keys.py shows what an edit to the grt lines does to each stage's
# actions.
ARGS = {
    "CORE_UTILIZATION": "40",
    "GLOBAL_ROUTE_ARGS": "-congestion_iterations 20",
    "PLACE_DENSITY": "0.6",
    "REPAIR_TIMING_ARGS": "floorplan:0 place:0 cts:0 grt:-setup_margin 0.1",
    "SYNTH_HDL_FRONTEND": "slang",
}

orfs_flow(
    name = "accumulator",
    arguments = ARGS,
    last_stage = "grt",
    sources = {"SDC_FILE": [":constraints.sdc"]},
    tags = ["manual"],
    top = "accumulator",
    verilog_files = ["accumulator.sv"],
)

[filegroup(
    name = "accumulator_%s_logs" % stage,
    srcs = [":accumulator_%s" % stage],
    output_group = "logs",
    tags = ["manual"],
) for stage in [
    "floorplan",
    "grt",
]]

py_test(
    name = "args_grammar_test",
    size = "small",
    srcs = ["args_grammar_test.py"],
    args = [
        "--floorplan",
        "$(rootpaths :accumulator_floorplan_logs)",
        "--grt",
        "$(rootpaths :accumulator_grt_logs)",
    ],
    data = [
        ":accumulator_floorplan_logs",
        ":accumulator_grt_logs",
    ],
    tags = ["manual"],
)
