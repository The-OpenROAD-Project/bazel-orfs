load("@bazel-orfs//:openroad.bzl", "odb_debug", "orfs_flow")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_python//python:defs.bzl", "py_binary")
load(":scaffold.bzl", "array_scaffold")

# STRUCTURED_MEMORIES in mode netlist: a generated register file dropped
# FIRM into its parent's rows at floorplan instead of hardened as a macro
# (patch 0078). The parent keeps one placement, clock tree and route
# across it. small_top_place is the check: the file's cells are in the
# placed design, FIRM, at the location placement.txt gives.
orfs_flow(
    name = "small_top",
    arguments = {
        "AUTO_MEMORIES": "1",
        "CORE_AREA": "10 10 190 190",
        "DIE_AREA": "0 0 200 200",
        "PLACE_DENSITY": "0.5",
        "SKIP_REPORT_METRICS": "1",
    },
    last_stage = "grt",
    pdk = "//flow:asap7",
    sources = {
        "SDC_FILE": [":constraints.sdc"],
        "STRUCTURED_MEMORIES": [":SmallFile.regfile"],
        "STRUCTURED_PLACEMENT": [":placement.txt"],
    },
    verilog_files = [":small_file.sv"],
)

odb_debug(
    name = "small_top_place_odb_debug",
    src = ":small_top_place",
)

odb_debug(
    name = "small_top_grt_odb_debug",
    src = ":small_top_grt",
)

# The battery's first negative: a placed netlist gets through repair_design
# (its cells dont_touch, patch 0084), CTS (its flops rewired, its buffers
# seated in the service columns), the legaliser and global route, with one
# dead column skipped at floorplan (0082) and no macro placer run on a
# fully fixed macro set (0083). Seconds, where the parent took a night.
build_test(
    name = "small_top_grt_build_test",
    tags = ["manual"],  # XiangShan infrastructure: off CI, in //:slow_tests
    targets = [":small_top_grt"],
)

# XiangShan's three placed netlists at real size, each in a parent of flops
# (scaffold_gen.py, scaffold.bzl): the rung between the 30 um files of the
# miniature planned parent and the parent itself. A 305 um array grows
# nets the resizer wants to buffer, which the small files never do
# (inventory entry 16); CTS rewires its flops and seats its buffers in the
# service columns at the real count. The outlines are the generator's
# .def DIEAREA for each spec; a stale pair fails at floorplan.
py_binary(
    name = "scaffold_gen",
    srcs = ["scaffold_gen.py"],
    main = "scaffold_gen.py",
)

XS_SPECS = "//test/coremark_joule/designs/asap7/xiangshan:"

array_scaffold(
    name = "RenameBufferFile",
    height_um = 192.24,
    spec = XS_SPECS + "RenameBufferFile.regfile",
    width_um = 306.504,
)

array_scaffold(
    name = "RobEntryFile",
    height_um = 192.51,
    spec = XS_SPECS + "RobEntryFile.regfile",
    width_um = 318.384,
)

array_scaffold(
    name = "IntRegFile",
    height_um = 243.27,
    spec = XS_SPECS + "IntRegFile.regfile",
    width_um = 406.404,
)
