load("@rules_python//python:defs.bzl", "py_binary")
load(":scaffold.bzl", "array_scaffold")

# The smallest register file is //test/regfile's regfile_top.
#
# XiangShan's three register files at real size, each in a parent of flops
# (scaffold_gen.py, scaffold.bzl): the rung between the 30 um files of the
# miniature planned parent and the parent itself. A 305 um array grows
# nets the resizer wants to buffer, which the small files never do
# (inventory entry 16); CTS rewires its flops and seats its buffers in the
# service columns at the real count. The outlines are generate_ram's,
# for each spec in the netlist shape; a stale pair fails at floorplan.
py_binary(
    name = "scaffold_gen",
    srcs = ["scaffold_gen.py"],
    main = "scaffold_gen.py",
    visibility = ["//test/regfile/options:__pkg__"],
)

XS_SPECS = "//test/coremark_joule/designs/asap7/xiangshan:"

array_scaffold(
    name = "RenameBufferFile",
    height_um = 190.35,
    periphery_um2 = 7027,
    spec = XS_SPECS + "RenameBufferFile.regfile",
    width_um = 129.06,
)

array_scaffold(
    name = "RobEntryFile",
    height_um = 95.31,
    periphery_um2 = 7027,
    spec = XS_SPECS + "RobEntryFile.regfile",
    width_um = 295.002,
)

array_scaffold(
    name = "IntRegFile",
    height_um = 242.19,
    periphery_um2 = 3236,
    spec = XS_SPECS + "IntRegFile.regfile",
    width_um = 192.294,
)

# generate_ram's golden case (tools/structured_gen:golden_test).
exports_files(
    ["SmallFile.regfile"],
    visibility = ["//tools/structured_gen:__pkg__"],
)
