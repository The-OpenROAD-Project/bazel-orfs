"""Pin traps: a block's own choice, right for it and pathological for its parent.

Each trap is one parent and its hardened blocks, generated by trap_gen.py,
built in two or more arms that differ only in what the trap is about. The
"own" arm is today's flow: each block built alone, its free pins where its
own placement puts them. The "hand" arm is the answer written by hand. Both
are measured by probe.tcl on the placed block and the placed parent;
trap_test.py checks each arm against the numbers worked out in its
docstring, so a trap is a development test only once both hold.
"""

load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_run")
load("@rules_python//python:defs.bzl", "py_test")
load("//test/grt_scaling:arms.bzl", "TURNAROUND_ARGS")

# asap7, the pin layers and routing range of the XiangShan study, a block's
# free pins placed by the pin placer's default (Hungarian) assignment
TRAP_BASE_ARGS = TURNAROUND_ARGS | {
    "AUTO_MEMORIES": "0",
    "IO_PLACER_H": "M2 M4",
    "IO_PLACER_V": "M3 M5",
    "MAX_ROUTING_LAYER": "M7",
    "MIN_ROUTING_LAYER": "M2",
    "PLACE_DENSITY": "0.6",
    "SYNTH_HDL_FRONTEND": "slang",
}

def _r(x):
    """Three decimals; Starlark has no round()."""
    return int(x * 1000 + 0.5) / 1000.0

def _areas(w, h, margin_x = 2.0, margin_y = 2.0):
    return {
        "CORE_AREA": "{} {} {} {}".format(_r(margin_x), _r(margin_y), _r(w - margin_x), _r(h - margin_y)),
        "DIE_AREA": "0 0 {} {}".format(_r(w), _r(h)),
    }

def _pins(contract, arm_pins):
    return " ".join([p for p in [contract, arm_pins] if p])

def pin_trap(name, bits, blocks, parent, arms):
    """One trap's flows and probes.

    Args:
      name: the trap, a trap_gen.py --trap name; modules are <name>_<block>
        and <name>_top.
      bits: the interface width passed to the generator.
      blocks: {block: {"die": [w, h], "pins": PIN_GROUPS}}, the pins being
        the block's contract, common to every arm.
      parent: {"die": [w, h], "core_margin": [x, y], "pins": PIN_GROUPS,
        "locs": BLOCK_LOCS or None for the macro placer, "channel": um}.
      arms: {arm: {"pins": {block: PIN_GROUPS added to the contract},
        "blocks": {block: overrides}, "parent": overrides}}: an arm changes
        only what its trap is about.

    Targets: <name>_<block>_<arm>_* and <name>_top_<arm>_* flows, and
    <name>_<arm>_<block>_probe / <name>_<arm>_top_probe JSON.
    """
    sv = name + ".sv"
    probes = {}
    native.genrule(
        name = name + "_rtl",
        outs = [sv],
        cmd = "$(execpath :trap_gen) --trap {} --bits {} --out $@".format(name, bits),
        tools = [":trap_gen"],
    )
    for arm in sorted(arms):
        spec = arms[arm]
        macros = []
        for block in sorted(blocks):
            b = blocks[block] | spec.get("blocks", {}).get(block, {})
            module = "{}_{}".format(name, block)
            args = TRAP_BASE_ARGS | _areas(b["die"][0], b["die"][1])
            sources = {
                "IO_CONSTRAINTS": [":pins.tcl"],
                # a block's grid: rails and straps a parent's grid connects to
                "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCK_grid_strategy.tcl"],
                "SDC_FILE": [":constraints.sdc"],
            }
            user = {"PIN_GROUPS": _pins(b.get("pins", ""), spec.get("pins", {}).get(block, ""))}
            orfs_flow(
                name = module,
                top = module,
                abstract_stage = "place",
                arguments = args,
                pdk = "//flow:asap7",
                sources = sources,
                user_arguments = user,
                variant = arm,
                verilog_files = [":" + sv],
            )
            macros.append(":{}_{}_generate_abstract".format(module, arm))
            probes["{}:{}".format(arm, block)] = ":{}_{}_{}_probe".format(name, arm, block)
            orfs_run(
                name = "{}_{}_{}_probe".format(name, arm, block),
                src = ":{}_{}_place".format(module, arm),
                outs = ["{}_{}_{}_probe.json".format(name, arm, block)],
                arguments = args,
                script = ":probe.tcl",
                sources = sources,
                user_arguments = user | {
                    "OUTPUT_JSON": "$(location {}_{}_{}_probe.json)".format(name, arm, block),
                },
                variant = arm,
            )
        top = name + "_top"
        p = parent | spec.get("parent", {})
        mx, my = p.get("core_margin", [2.0, 2.0])
        channel = p.get("channel", 4.0)
        args = TRAP_BASE_ARGS | _areas(p["die"][0], p["die"][1], mx, my) | {
            # a port's buffer goes where the parent has rows, which in a
            # trap is wherever its geometry put the parent's logic: every
            # port wire would run there and back, in every arm alike
            "DONT_BUFFER_PORTS": "1",
            # a minimum channel is twice the halo it replaced, as in mpl
            "RTLMP_MIN_CHANNEL_SIZE": "{} {}".format(_r(channel), _r(channel)),
        }
        sources = {
            "IO_CONSTRAINTS": [":pins.tcl"],
            # the parent's grid over hardened blocks
            "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCKS_grid_strategy.tcl"],
            "SDC_FILE": [":constraints.sdc"],
        }
        user = {"PIN_GROUPS": p.get("pins", "")}
        if p.get("locs"):
            # the trap's geometry; without it the macro placer places them
            sources["MACRO_PLACEMENT_TCL"] = [":place_blocks.tcl"]
            user["BLOCK_LOCS"] = p["locs"]
        orfs_flow(
            name = top,
            top = top,
            arguments = args,
            last_stage = "place",
            macros = macros,
            pdk = "//flow:asap7",
            sources = sources,
            user_arguments = user,
            variant = arm,
            verilog_files = [":" + sv],
        )
        orfs_run(
            name = "{}_{}_top_probe".format(name, arm),
            src = ":{}_{}_place".format(top, arm),
            outs = ["{}_{}_top_probe.json".format(name, arm)],
            arguments = args,
            script = ":probe.tcl",
            sources = sources,
            user_arguments = user | {
                "OUTPUT_JSON": "$(location {}_{}_top_probe.json)".format(name, arm),
            },
            variant = arm,
        )
        probes["{}:top".format(arm)] = ":{}_{}_top_probe".format(name, arm)
    py_test(
        name = name + "_test",
        srcs = [":trap_test.py"],
        args = ["--trap", name] + [
            "{}=$(rootpath {})".format(key, probes[key])
            for key in sorted(probes)
        ],
        data = [probes[key] for key in sorted(probes)],
        main = "trap_test.py",
    )
