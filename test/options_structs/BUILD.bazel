load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_options")
load("@rules_python//python:defs.bzl", "py_test")

# OpenROAD #11755's options structs (carried OpenROAD patch 0248) through
# ORFS (carried ORFS patch 0249) and bazel-orfs: one dict per command,
# passed to the command's -options. orfs_options() gives each stage the
# dicts of the commands it calls, and of a command that runs in two stages
# the scopes that stage reads, so the value a stage's action sees is:
#
#   place  GLOBAL_PLACEMENT_OPTIONS = routability.global_route.congestion_iterations 5
#          REPAIR_DESIGN_OPTIONS    = slew_margin 5
#   grt    GLOBAL_ROUTE_OPTIONS     = congestion_iterations 20
#          REPAIR_DESIGN_OPTIONS    = slew_margin 5 @grt {slew_margin 10}
#
# stage_keys.py shows what an edit to the grt lines does to each stage's
# actions.
OPTIONS = {
    "global_placement": {"routability": {"global_route": {"congestion_iterations": 5}}},
    "global_route": {"congestion_iterations": 20},
    "repair_design": {
        "slew_margin": 5,
        "@grt": {"slew_margin": 10},
    },
}

orfs_flow(
    name = "accumulator",
    arguments = {
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY": "0.6",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    last_stage = "grt",
    sources = {"SDC_FILE": [":constraints.sdc"]},
    stage_arguments = orfs_options(OPTIONS),
    tags = ["manual"],
    top = "accumulator",
    verilog_files = ["accumulator.sv"],
)

[filegroup(
    name = "accumulator_%s_logs" % stage,
    srcs = [":accumulator_%s" % stage],
    output_group = "logs",
    tags = ["manual"],
) for stage in [
    "place",
    "grt",
]]

py_test(
    name = "options_structs_test",
    size = "small",
    srcs = ["options_structs_test.py"],
    args = [
        "--place",
        "$(rootpaths :accumulator_place_logs)",
        "--grt",
        "$(rootpaths :accumulator_grt_logs)",
    ],
    data = [
        ":accumulator_grt_logs",
        ":accumulator_place_logs",
    ],
    tags = ["manual"],
)
