load(":arms.bzl", "cluster_pull_arms", "fine_arms")

# The cluster-pull study (issue #1263, patch 0127): ORFS designs to
# global route, each from ORFS's own synthesis. "off" keeps the macro
# placer's clusters in the database and does not pull them; its
# placement must be ORFS's own (@orfs//flow/designs/<key>:<name>_grt).
# A study, not a gate: every target is manual.
package(default_visibility = ["//visibility:private"])

# weight: the bounded pull on a cell, in pins; it fades to 0 at the
# 150th Nesterov iteration.
ARMS = {
    "off": None,
    "w1": "-cluster_pull_weight 1",
    "w4": "-cluster_pull_weight 4",
    "w16": "-cluster_pull_weight 16",
}

# Rung 5, the macro placer's cluster granularity. With automatic sizes it
# clusters at one level when a design has fewer than 15 macro masters
# (ClusteringEngine::setBaseThresholds), whatever RTLMP_MAX_LEVEL says:
# 3-11 clusters on these designs. Explicit sizes skip that override and
# aim at roughly 25-50 std-cell clusters. The sizes also move the macros,
# so "fine" has its own "off".
# Phase A: groups from the logical hierarchy (patch 0129), module
# instances at depth 1 and 2, against the same "off". Black Parrot keeps
# its hierarchy in instance names; swerv_wrapper's database is flat.
HIERARCHY = {
    "h%d_w4" % depth: "-cluster_pull_weight 4 -cluster_pull_depth %d" % depth
    for depth in [
        1,
        2,
    ]
}

HIERARCHICAL = [
    "nangate45/bp_be_top",
    "nangate45/bp_fe_top",
]

FINE_SIZES = {
    "asap7/swerv_wrapper": ("2000", "4000"),
    "nangate45/bp_be_top": ("1000", "2000"),
    "nangate45/bp_fe_top": ("600", "1200"),
}

[
    cluster_pull_arms(
        key,
        ARMS | (fine_arms(
            ARMS,
            FINE_SIZES[key],
        ) if key in FINE_SIZES else {}) | (HIERARCHY if key in HIERARCHICAL else {}),
    )
    for key in [
        "asap7/gcd",
        "asap7/aes-block",
        "asap7/riscv32i-mock-sram",
        "asap7/swerv_wrapper",
        "gf180/uart-blocks",
        "nangate45/bp_fe_top",
        "nangate45/bp_be_top",
        "nangate45/ariane133",
    ]
]
