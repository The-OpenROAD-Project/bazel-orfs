# coralnpu's EX/MEM register (surgery.py --address-register, carried as
# patches/0106) does what the snapshot's load/store unit does, a cycle
# later: both LSUs under the same random requests, every bus
# transaction, writeback, flush and fault compared in order, and a
# negative control that must differ. The generator also stops the build
# if the surgery touches any module other than LsuV1.
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

package(default_visibility = ["//visibility:private"])

VARIANTS = [
    "ref",
    "exmem",
    "bad",
]

genrule(
    name = "lsu_variants",
    srcs = [
        "lsu_variants.py",
        "@orfs//flow/designs/asap7/coralnpu:surgery.py",
        "@orfs//flow/designs/src/coralnpu:CoreMiniAxi.sv",
    ],
    outs = ["lsu_%s.v" % v for v in VARIANTS],
    cmd = """
python3 -I $(location lsu_variants.py) \
    --surgery $(location @orfs//flow/designs/asap7/coralnpu:surgery.py) \
    --snapshot $(location @orfs//flow/designs/src/coralnpu:CoreMiniAxi.sv) \
    --out-dir $(RULEDIR)
""",
)

[
    [
        verilog_library(
            name = "lsu_%s_rtl" % v,
            srcs = ["lsu_%s.v" % v],
        ),
        verilator_cc_library(
            name = "lsu_%s" % v,
            module = ":lsu_%s_rtl" % v,
            module_top = "LsuV1_%s" % v,
            trace_mode = "none",
            vopts = [
                "-Wno-fatal",
                "--x-initial",
                "0",
                "--x-assign",
                "0",
                "-DSYNTHESIS",
            ],
        ),
    ]
    for v in VARIANTS
]

cc_test(
    name = "exmem_sim_test",
    size = "medium",
    srcs = ["tb_main.cc"],
    tags = ["study"],
    deps = [":lsu_%s" % v for v in VARIANTS],
)
