load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":arms.bzl", "channel_arm", "pinwall_arm")

# Calibration of the floorplan planner's constants on a synthetic parent
# with one pin-wall block. See arms.bzl and tools/macro_select/.

exports_files([
    "constraints.sdc",
    "pins_top.tcl",
    "place_block.tcl",
    "place_block_lateral.tcl",
    "pins_split.tcl",
    "place_two_blocks.tcl",
    "route0.tcl",
])

py_binary(
    name = "pinwall_gen",
    srcs = ["pinwall_gen.py"],
    main = "pinwall_gen.py",
)

[
    pinwall_arm(pins, channel)
    for pins in [
        1000,
        3000,
        6000,
        10000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]

pinwall_arm(
    3000,
    40,
    margin = 3.0,
)

pinwall_arm(
    6000,
    40,
    margin = 3.0,
)

# The lateral case: the logic beside the pin side, every wire turning along
# the channel. Where XiangShan's walls came from.
[
    pinwall_arm(
        pins,
        channel,
        lateral = True,
    )
    for pins in [
        1000,
        3000,
        6000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]

# The channel between two blocks: XiangShan's route-0 gate stopped on
# GRT-0228 inside the 11 um placement gap between Frontend and MemBlock
# (inventory entry 13). The same interface at two gaps, measured by a
# zero-iteration global route on the CTS checkpoint.
[
    channel_arm(3000, gap)
    for gap in [
        10,
        60,
    ]
]

py_test(
    name = "channel_test",
    srcs = ["channel_test.py"],
    data = [
        ":route0_ch_p3000_g10.json",
        ":route0_ch_p3000_g60.json",
    ],
    main = "channel_test.py",
)
