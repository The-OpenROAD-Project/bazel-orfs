load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/floorplan:floorplan.bzl", "floorplan_extract", "floorplan_plan")
load(":arms.bzl", "channel_arm", "pinwall_arm")

# Calibration of the floorplan planner's constants on a synthetic parent
# with one pin-wall block. See arms.bzl and tools/macro_select/.

exports_files([
    "constraints.sdc",
    "pins_top.tcl",
    "place_block.tcl",
    "place_block_lateral.tcl",
    "pins_split.tcl",
    "place_two_blocks.tcl",
    "route0.tcl",
])

py_binary(
    name = "pinwall_gen",
    srcs = ["pinwall_gen.py"],
    main = "pinwall_gen.py",
)

[
    pinwall_arm(pins, channel)
    for pins in [
        1000,
        3000,
        6000,
        10000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]

pinwall_arm(
    3000,
    40,
    margin = 3.0,
)

pinwall_arm(
    6000,
    40,
    margin = 3.0,
)

# The lateral case: the logic beside the pin side, every wire turning along
# the channel. Where XiangShan's walls came from.
[
    pinwall_arm(
        pins,
        channel,
        lateral = True,
    )
    for pins in [
        1000,
        3000,
        6000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]

# The channel between two blocks: XiangShan's route-0 gate stopped on
# GRT-0228 inside the 11 um placement gap between Frontend and MemBlock
# (inventory entry 13). The same interface at two gaps, measured by a
# zero-iteration global route on the CTS checkpoint.
[
    channel_arm(3000, gap)
    for gap in [
        10,
        60,
    ]
]

py_test(
    name = "channel_test",
    srcs = ["channel_test.py"],
    data = [
        ":route0_ch_p3000_g10.json",
        ":route0_ch_p3000_g60.json",
    ],
    main = "channel_test.py",
    tags = ["study"],
)

# The global floorplan planner (tools/floorplan) on two calibrated arms: the
# block's pin side is pins x 0.096 um x 1.5 / 2 long, so its rung (a) must
# put it at the two-layer limit, which the arms route clean with the logic
# facing it.
[
    floorplan_extract(
        name = "floorplan_p%d" % pins,
        src = ":pinwall_block_pw_p%d_c40_m15_synth" % pins,
        arguments = {"DIE_AREA": "0 0 %s 40" % (pins * 0.072)},
        timing = False,
    )
    for pins in [
        3000,
        10000,
    ]
]

[
    floorplan_plan(
        name = "floorplan_p%d_plan" % pins,
        blocks = [":floorplan_p%d" % pins],
        constraints = ":floorplan_p%d.json" % pins,
        cut = ":floorplan_cut.json",
        pdk = "//test/floorplan_toy:asap7",
    )
    for pins in [
        3000,
        10000,
    ]
]

# ... and on the channel arms: two blocks side by side, the whole
# interface between their top sides, the parent's logic above. Both gaps
# wall at route-0 (channel_test); rung (e)'s track count passes both, the
# strip above the blocks having the tracks: what walls there is the wires
# turning along the pin side, which the capacity model does not charge.
floorplan_extract(
    name = "floorplan_ch",
    src = ":pinwall_block_ch_p3000_g10_synth",
    arguments = {"DIE_AREA": "0 0 432 40"},
    timing = False,
)

[
    floorplan_plan(
        name = "floorplan_ch_g%d_plan" % gap,
        blocks = [":floorplan_ch"],
        constraints = ":floorplan_ch_g%d.json" % gap,
        cut = ":floorplan_ch_cut.json",
        parent = ":floorplan_ch_parent.json",
        pdk = "//test/floorplan_toy:asap7",
    )
    for gap in [
        10,
        60,
    ]
]
