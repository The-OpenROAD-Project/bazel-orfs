load("@rules_python//python:defs.bzl", "py_binary")
load(":arms.bzl", "pinwall_arm")

# Calibration of the floorplan planner's constants on a synthetic parent
# with one pin-wall block. See arms.bzl and tools/macro_select/.

exports_files([
    "constraints.sdc",
    "pins_top.tcl",
    "place_block.tcl",
    "place_block_lateral.tcl",
])

py_binary(
    name = "pinwall_gen",
    srcs = ["pinwall_gen.py"],
    main = "pinwall_gen.py",
)

[
    pinwall_arm(pins, channel)
    for pins in [
        1000,
        3000,
        6000,
        10000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]

pinwall_arm(
    3000,
    40,
    margin = 3.0,
)

pinwall_arm(
    6000,
    40,
    margin = 3.0,
)

# The lateral case: the logic beside the pin side, every wire turning along
# the channel. Where XiangShan's walls came from.
[
    pinwall_arm(
        pins,
        channel,
        lateral = True,
    )
    for pins in [
        1000,
        3000,
        6000,
    ]
    for channel in [
        10,
        40,
        100,
    ]
]
