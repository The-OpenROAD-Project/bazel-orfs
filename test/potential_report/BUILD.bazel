load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_run")

# The potential report pilot's placed probe: does decoding a ROB's
# pointers once in the parent, instead of comparing every entry's index
# with every pointer, buy period once the array is placed and its wires
# are real? Three arms of one function (rob_like.v), each to placement:
#   kept:      RobLikeEntry kept as a module, as XiangShan keeps
#              RobEntryCell (SYNTH_KEEP_MODULES): no constant reaches it
#   flat:      the same RTL flattened: constants propagate, ABC shares
#   rewritten: ONEHOT=1, the pointers decoded once in the parent
# Each arm writes its period (clock minus worst slack at placement).

ARMS = {
    "kept": {
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": "RobLikeEntry",
    },
    "flat": {},
    "rewritten": {
        "VERILOG_TOP_PARAMS": "ONEHOT 1",
    },
}

[
    orfs_flow(
        name = "rob_like",
        arguments = {
            "CORE_UTILIZATION": "40",
            "PLACE_DENSITY": "0.60",
            "SKIP_REPORT_METRICS": "1",
        } | args,
        last_stage = "place",
        sources = {
            "SDC_FILE": [":constraints.sdc"],
        },
        tags = ["manual"],
        top = "RobLike",
        variant = arm,
        verilog_files = ["rob_like.v"],
    )
    for arm, args in ARMS.items()
]

[
    orfs_run(
        name = "rob_like_%s_period" % arm,
        src = ":rob_like_%s_place" % arm,
        outs = ["rob_like_%s_period.json" % arm],
        script = ":period.tcl",
        tags = ["manual"],
        user_arguments = {
            "OUTPUT": "rob_like_%s_period.json" % arm,
        },
    )
    for arm in ARMS
]
