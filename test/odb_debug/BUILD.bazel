load("@rules_python//python:defs.bzl", "py_test")
load("//:openroad.bzl", "odb_debug")

# The daemon on a real placed design: launch, wait for daemon.json, ask
# through the client, stop. //tools/odb_debug tests the wire protocol
# against a fake; this is the one place the Tcl side runs.
odb_debug(
    name = "multiplier_place_odb_debug",
    src = "//test/estimation_ladder:multiplier_asap7_place",
)

# The warm-gui skill's example, and the design its GUI was tried on: ORFS's
# gcd, its final stage. Manual: a run target, nothing tests it.
odb_debug(
    name = "gcd_final_odb_debug",
    src = "@orfs//flow/designs/asap7/gcd:gcd_final",
    tags = ["manual"],
)

py_test(
    name = "smoke_test",
    size = "large",
    srcs = ["smoke_test.py"],
    args = ["$(rootpath :multiplier_place_odb_debug)"],
    data = [":multiplier_place_odb_debug"],
    deps = ["//tools/odb_debug:odbdebug_lib"],
)

# The daemon on a 10 um block with no flow behind it: pin_access reports
# DRT's own markers for a pin with no access point, image draws it, and
# the idle exit neither kills a long request nor misses an idle daemon.
# Seconds, not a flow.
py_test(
    name = "block_test",
    size = "small",
    srcs = ["block_test.py"],
    args = [
        "$(rootpath //test:openroad_exec)",
        "$(rootpath @orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef)",
        "$(rootpath block.tcl)",
        "$(rootpath //tools/odb_debug:daemon.tcl)",
    ],
    data = [
        "block.lef",
        "block.tcl",
        "design.def",
        "//test:openroad_exec",
        "//tools/odb_debug:daemon.tcl",
        "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
    ],
    deps = ["//tools/odb_debug:odbdebug_lib"],
)
