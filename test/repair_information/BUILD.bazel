# wirebound: the vehicle this study needed and the stock designs cannot
# provide. Built for pre-route-pessimism (#958/#963) as "the congested,
# top-metal, wire-delay-dominated corner that no asap7 design in ORFS
# occupies" -- MAX_ROUTING_LAYER=M9 so it can reach the two least
# resistive layers no stock design is allowed to use, a scattered fan-in
# so the inter-group nets stay die-crossing however the placer folds the
# design, and a balanced XOR tree four levels deep so cell delay stays
# small while the wires stay long.
#
# That second property is the one the gcd ladder proved was needed: a
# 20x core bought gcd 28% more wire because nothing stopped the placer
# clustering 34 flops, so its wire share never left 3%. Here the length
# is a property of the netlist rather than of a placement.
#
# WIREBOUND_CLK_PERIOD_PS is read by the design's own constraint.sdc and
# not by ORFS, so it takes the user_arguments hatch.
WIREBOUND = LOCAL_DESIGNS["asap7/wirebound"]

WIREBOUND_USER_VARS = ["WIREBOUND_CLK_PERIOD_PS"]

ri_ladder(
    name = "wirebound",
    arguments = {
        key: value
        for key, value in WIREBOUND["arguments"].items()
        if key not in WIREBOUND_USER_VARS
    },
    cts = "//flow/designs/asap7/wirebound:wirebound_cts",
    design = WIREBOUND,
    final = "//flow/designs/asap7/wirebound:wirebound_final",
    qualify_sources = False,
    sources = WIREBOUND["sources"],
    user_arguments = {
        key: value
        for key, value in WIREBOUND["arguments"].items()
        if key in WIREBOUND_USER_VARS
    },
)

py_binary(
    name = "update_wirebound",
    srcs = ["//test/pre_route_pessimism:update_results.py"],
    args = ["--dest-dir=test/repair_information/results"] + [
        "$(rootpath :wirebound_{}.json)".format(rung)
        for rung in RUNGS
    ],
    data = [":wirebound_{}.json".format(rung) for rung in RUNGS],
    main = "update_results.py",
    tags = ["manual"],
)

# Driving wirebound onto the top of the stack.
#
# Corrected for reg2reg, wirebound is the most wire-dominated design
# measured here -- 26.5% of its period is signal wire delay, against
# coralnpu's 19.4% and gcd's 2.0%. What it is not is *long*: 11.6um
# nets against an ~8um break-even for repaying a via stack, so the
# router has no reason to climb and M8/M9 carry nothing at all, on the
# one design in the tree permitted to use them.
#
# The three shape knobs move together or not at all, per
# pre-route-pessimism's own arms: PLACE_DENSITY follows CORE_UTILIZATION
# down (or placement packs the cells into a corner of the bigger die and
# hands back short wires), and ROUTING_LAYER_ADJUSTMENT buys back the
# contention that spreading costs, since demand grows as the square root
# of die area while supply grows linearly.
#
# The clock is tightened from the shipped 1000ps to 320ps, just above the
# 306.7ps the design actually achieves. At 1000ps the reg2reg WNS is
# about +700ps, so nothing is critical -- and a router asked to be
# resistance-aware about critical nets has nothing to be aware of.
WIREBOUND_TIGHT_CLK = "320"

# The QoR arms need a clock the design *misses*. At 320 ps wirebound
# closes with 20-28 ps to spare, and repair_timing then has nothing to
# repair: ENABLE_PLACE_REPAIR_TIMING=0 reproduced the stock result to
# six significant figures on all three seeds, which measures the
# constraint rather than the knob. repair-timing-grt's Trap 4 says this
# in as many words -- a design that closes measures nothing about a
# repair knob, because every setting reaches the same floor.
#
# 260 ps is below the ~292 ps the shipped shape achieves, so repair is
# still working when it stops and the arms can differ.
WIREBOUND_QOR_CLK = "260"

ri_shapes(
    name = "wbf",
    arguments = {
        key: value
        for key, value in WIREBOUND["arguments"].items()
        if key not in WIREBOUND_USER_VARS
