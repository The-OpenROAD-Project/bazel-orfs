        for probe in [
            "placement",
            "zero_rc",
            "gr",
            "spef",
        ]
    ],
    main = "update_results.py",
    tags = ["manual"],
)

# What resistance does the critical path behave as if it sees?
#
# One probe per scale on the u12_tight CTS ODB, placement parasitics
# only, so each point is an STA run and the whole scan is seconds. The
# scale whose min_period meets the routed 318.0 ps is the answer.
RC_SCALES = [
    "0.40",
    "0.50",
    "0.55",
    "0.60",
    "0.70",
    "1.00",
]

[
    ri_probe(
        name = "rcscan_{}".format(scale.replace(".", "")),
        src = ":wbr_u12_tight_g32_cts",
        arguments = {
            key: value
            for key, value in WIREBOUND["arguments"].items()
            if key not in WIREBOUND_USER_VARS
        } | WIREBOUND_ROUTED_SHAPES["u12_tight"] | {
            "VERILOG_DEFINES": "-D WIREBOUND_GROUPS=32",
        },
        design = WIREBOUND,
        extra_sources = {
            "LAYER_PARASITICS_FILE": ["//test/repair_information:rc_scan.tcl"],
        },
        parasitics = "placement",
        probe_env = {"RI_RC_SCALE": scale},
        qualify_sources = False,
        sources = WIREBOUND["sources"],
        user_arguments = {"WIREBOUND_CLK_PERIOD_PS": WIREBOUND_TIGHT_CLK},
    )
    for scale in RC_SCALES
]

# A3: is the early repair worth anything at all?
#
# The gating question of the whole study, and it has never been asked.
# ENABLE_PLACE_REPAIR_TIMING=0 turns off the resize-stage repair that
# runs against the placement estimate; if final QoR does not move, then
# re-aiming that repair -- which is what a fork/join global route would
# buy -- cannot be worth anything either, whatever the instruments say.
#
# Both shapes, because the sign of the pre-route error flips between
# them: on u55 placement and global route agree within 1%, on u12_tight
# placement is 23% pessimistic. An early repair working from a target
# that slack is the case where turning it off might *help*.
#
# Three seeds, because this is the study's first QoR comparison and
# every number before it was a single deterministic run.
# The two repairs the stock flow actually runs.
#
# ENABLE_PLACE_REPAIR_TIMING is *off* by default -- variables.yaml says
# "pre-CTS setup/hold repair is skipped unless this is set to 1" -- so
# the resize-stage repair this study's opening premise counted as one of
# three does not run at all. An arm that turned it off reproduced the
# stock result to six significant figures on every seed, because it was
# already off. Verified rather than assumed: over six flows, every
# "Repair setup and hold violations..." line in the logs came from the
# grt stage and none from place.
#
# So ORFS repairs timing twice: once at CTS against the placement
# estimate, once at global route against the routed guides. These are
# the arms that turn each of them off.
WIREBOUND_QOR_ARMS = {
    "base": {},
    "no_cts_rt": {"SKIP_CTS_REPAIR_TIMING": "1"},
    "no_grt_rt": {"SKIP_INCREMENTAL_REPAIR": "1"},
    # Rip up the early repair's work before global route, two ways.
    #
    # The CTS repair costs 30.3 um2 of logic area for a period change
    # that does not resolve, so its buffers are a candidate for removal
    # by a repair that can see the real parasitics. "wholesale" removes
    # every signal buffer before the route; "selective" removes none and
    # instead lets the global-route repair use the unbuffer move, so the
    # pair separates whether it matters *that* buffers come out or
    # *which* ones do.
    #
    # Neither is expected to beat no_cts_rt, which already recovers the
    # area by never inserting them -- the clock tree is built before the
    # CTS repair runs, so a ripped-up netlist is the un-repaired one plus
    # a perturbed detailed placement. The arms exist because that
    # reasoning is falsifiable and cheap to falsify.
    "unbuf_wholesale": {},
    "unbuf_selective": {},
    # Neither. Removing one repair alone barely moves the period, which
    # is what two substitutes look like: whichever runs second fixes
    # what the first would have. Only turning both off separates "repair
    # does little" from "each covers for the other".
    "no_rt": {
        "SKIP_CTS_REPAIR_TIMING": "1",
        "SKIP_INCREMENTAL_REPAIR": "1",
    },
}

WIREBOUND_SEEDS = [
    "0",
    "1",
    "2",
]

# One shape, not both. The QoR arms are a seed ensemble on the shipped
# shape at a clock the design misses; u12_tight would double the flow
# count to answer a question about repair that the shape does not
# change. It is absent rather than pending: nothing in the conclusion
