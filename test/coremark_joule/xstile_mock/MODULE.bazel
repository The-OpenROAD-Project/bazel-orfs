"""The certificate: how CoupledL2's Verilog is made from XiangShan's Chisel.

Nobody needs to run this. The SystemVerilog beside it is the design; this
module documents, as code, how the generated Verilog it is proven
equivalent to is produced, and runs that proof:

  bazelisk run //:generate   # writes generated/CoupledL2.sv and its manifest
  bazelisk run //:lec        # the equivalence proof (not available yet)

Self-contained: every source is pinned below by commit and sha256, and each
archive's BUILD overlay is inline. XiangShan's own sources are unpatched.
"""

module(name = "xstile_mock")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")

# A hermetic C toolchain for espresso, the one C tool elaboration needs.
bazel_dep(name = "llvm", version = "0.8.18")

register_toolchains("@llvm//toolchain:all")

# XiangShan's own build.mill pins Chisel 7.13.0 on Scala 2.13.17.
bazel_dep(name = "rules_chisel", version = "0.4.2")

chisel = use_extension("@rules_chisel//chisel:extensions.bzl", "chisel")
chisel.toolchain(
    chisel_version = "7.13.0",
    scala_version = "2.13.17",
)
use_repo(chisel, "chisel_firtool", "chisel_maven")

bazel_dep(name = "rules_jvm_external", version = "6.7")
bazel_dep(name = "rules_scala", version = "7.1.5")

scala_config = use_extension("@rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(scala_version = "2.13.17")
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension("@rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()
use_repo(scala_deps, "rules_scala_toolchains")

# The Maven artifacts XiangShan's build.mill names beyond Chisel itself, at
# upstream's versions.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "xs_maven",
    artifacts = [
        "com.lihaoyi:sourcecode_2.13:0.4.4",
        "io.github.alexarchambault:data-class_2.13:0.2.11",
        "com.github.scopt:scopt_2.13:4.1.0",
        "com.lihaoyi:os-lib_2.13:0.11.3",
        "io.circe:circe-core_2.13:0.14.10",
        "org.typelevel:cats-core_2.13:2.12.0",
        "com.chuusai:shapeless_2.13:2.3.12",
        "org.scalatest:scalatest-core_2.13:3.2.19",
        "org.scalatest:scalatest-compatible:3.2.19",
        "org.scalatest:scalatest-flatspec_2.13:3.2.19",
        "org.scalatest:scalatest-shouldmatchers_2.13:3.2.19",
        "org.scalatest:scalatest-matchers-core_2.13:3.2.19",
        "org.scalatest:scalatest-mustmatchers_2.13:3.2.19",
        "org.scalactic:scalactic_2.13:3.2.19",
        "io.circe:circe-generic_2.13:0.14.10",
        "io.circe:circe-parser_2.13:0.14.10",
        "io.circe:circe-yaml-common_2.13:0.16.1",
        "com.lihaoyi:mainargs_2.13:0.7.7",
        "org.json4s:json4s-jackson_2.13:4.0.7",
        "org.json4s:json4s-jackson-core_2.13:4.0.7",
        "org.json4s:json4s-native_2.13:4.0.7",
        "org.json4s:json4s-native-core_2.13:4.0.7",
        "org.json4s:json4s-core_2.13:4.0.7",
        "org.json4s:json4s-ast_2.13:4.0.7",
        "org.scala-lang:scala-reflect:2.13.17",
        "io.circe:circe-yaml_2.13:0.16.1",
        "io.circe:circe-generic-extras_2.13:0.14.4",
    ],
)
use_repo(maven, "xs_maven")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# XiangShan Kunminghu at aa6b520, and the repositories its tree records as
# submodules at the commits it records. CoupledL2 is XSCache's code.
