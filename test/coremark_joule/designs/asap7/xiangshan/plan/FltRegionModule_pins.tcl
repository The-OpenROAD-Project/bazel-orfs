  utl::error FLW 4 "FltRegionModule_pins.tcl: [llength $rest] pins the plan does not place, [lrange $rest 0 9]; regenerate the plan from a pin_partners dump that names them"
}
puts "FltRegionModule_pins.tcl: [llength $placed] pins placed by the plan on bottom and top and left"
