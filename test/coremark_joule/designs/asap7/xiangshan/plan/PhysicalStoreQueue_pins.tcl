}
set rest {}
foreach n $names { if { [lsearch -exact $placed $n] < 0 } { lappend rest $n } }
if { [llength $rest] > 0 } {
  utl::error FLW 4 "PhysicalStoreQueue_pins.tcl: [llength $rest] pins the plan does not place, [lrange $rest 0 9]; regenerate the plan from a pin_partners dump that names them"
}
puts "PhysicalStoreQueue_pins.tcl: [llength $placed] pins placed by the plan on bottom"
