if { [info exists ::plan_pins_only] } { return }
set names {}
foreach bterm [[ord::get_db_block] getBTerms] {
  if { [$bterm getSigType] ne "SIGNAL" && [$bterm getSigType] ne "CLOCK" } { continue }
  lappend names [$bterm getName]
}
set placed {}
foreach {pin layer x y w h} $::plan_pins(Rob) {
  if { [lsearch -exact $names $pin] < 0 } { continue }
  place_pin -pin_name $pin -layer $layer -location [list $x $y] -pin_size [list $w $h] -force_to_die_boundary
  lappend placed $pin
}
set rest {}
foreach n $names { if { [lsearch -exact $placed $n] < 0 } { lappend rest $n } }
if { [llength $rest] > 0 } {
  utl::error FLW 4 "Rob_pins.tcl: [llength $rest] pins the plan does not place, [lrange $rest 0 9]; regenerate the plan from a pin_partners dump that names them"
}
puts "Rob_pins.tcl: [llength $placed] pins placed by the plan on bottom and top and right"
