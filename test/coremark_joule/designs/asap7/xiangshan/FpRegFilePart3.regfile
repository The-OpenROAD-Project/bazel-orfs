# FpRegFilePart3: a quarter of XiangShan's floating-point register file,
# 256 words of 16 bits with 14 read and 7 write ports. As flops it stopped
# the fp region block's detailed placement twice; as a generated macro it
# is 232 x 140 um in four banks. Ports are the RTL module's own; the tool
# checks them against the Verilog before it builds anything.
module FpRegFilePart3
words 256
bits 16
clock clock
read io_readPorts_0_addr io_readPorts_0_data
read io_readPorts_1_addr io_readPorts_1_data
read io_readPorts_2_addr io_readPorts_2_data
read io_readPorts_3_addr io_readPorts_3_data
read io_readPorts_4_addr io_readPorts_4_data
read io_readPorts_5_addr io_readPorts_5_data
read io_readPorts_6_addr io_readPorts_6_data
read io_readPorts_7_addr io_readPorts_7_data
read io_readPorts_8_addr io_readPorts_8_data
read io_readPorts_9_addr io_readPorts_9_data
read io_readPorts_10_addr io_readPorts_10_data
read io_readPorts_11_addr io_readPorts_11_data
read io_readPorts_12_addr io_readPorts_12_data
read io_readPorts_13_addr io_readPorts_13_data
write io_writePorts_0_addr io_writePorts_0_data io_writePorts_0_wen
write io_writePorts_1_addr io_writePorts_1_data io_writePorts_1_wen
write io_writePorts_2_addr io_writePorts_2_data io_writePorts_2_wen
write io_writePorts_3_addr io_writePorts_3_data io_writePorts_3_wen
write io_writePorts_4_addr io_writePorts_4_data io_writePorts_4_wen
write io_writePorts_5_addr io_writePorts_5_data io_writePorts_5_wen
write io_writePorts_6_addr io_writePorts_6_data io_writePorts_6_wen
cell flop DFFHQNx1_ASAP7_75t_R
cell and2 AND2x2_ASAP7_75t_R
cell or2 OR2x2_ASAP7_75t_R
cell ao22 AO22x2_ASAP7_75t_R
cell inv INVx1_ASAP7_75t_R
cell tap TAPCELL_ASAP7_75t_R
pin_layer M4
tap_columns 8
service_sites 40
banks 4
