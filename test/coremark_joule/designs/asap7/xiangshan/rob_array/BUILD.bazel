load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_run")
load("@rules_python//python:defs.bzl", "py_binary")
load("//test/coremark_joule/designs/asap7/xiangshan:xiangshan.bzl", "XS_BLOCKS", "XS_ICG_USER_ARGUMENTS", "XS_ICG_USER_SOURCES", "XS_USER_STAGES", "XS_VT")

# XiangShan's Rob with its 352 RobEntryCells swapped, by surgery, for one
# generated RobEntryArray (rob_surgery.py, rob_array_gen.py): every
# channel decoded once and shared by all entries, the netlist in asap7
# cells so synthesis maps none of it. The flow is the Rob macro's
# (XS_BLOCKS) with the settings test/rob_toy found at the Rob's size:
# timing-driven global placement, the flow buffering and sizing the
# array. Manual: the whole core's Verilog is read.

py_binary(
    name = "rob_array_gen",
    srcs = ["rob_array_gen.py"],
    deps = ["//test/rob_toy:rob_gen_lib"],
)

py_binary(
    name = "rob_surgery",
    srcs = ["rob_surgery.py"],
)

genrule(
    name = "rob_array",
    outs = ["RobEntryArray.v"],
    cmd = "$(execpath :rob_array_gen) $@",
    tags = ["manual"],
    tools = [":rob_array_gen"],
)

genrule(
    name = "rob_surgered",
    srcs = [
        "//test/coremark_joule/designs/asap7/xiangshan/surgery:xiangshan_surgered",
        "RobEntryCell.expected.sv",
    ],
    outs = ["rob_surgered.sv"],
    cmd = "$(execpath :rob_surgery) $(location //test/coremark_joule/designs/asap7/xiangshan/surgery:xiangshan_surgered) $(location RobEntryCell.expected.sv) $@",
    tags = ["manual"],
    tools = [":rob_surgery"],
)

ROB = XS_BLOCKS["Rob"]

# The Rob's two register files, each a macro of its own as the planned
# flow builds them (xiangshan.bzl, _regfile_macro): generate_ram's
# netlist, through global route, its abstract for the Rob. Built in
# parallel with the Rob's synthesis. Inlined, they were two thirds of
# the Rob's 759k instances, and timing-driven global placement on all of
# it took 1,022 s.
REGFILES = [
    "RobEntryFile",
    "RenameBufferFile",
]

[
    orfs_flow(
        name = module,
        abstract_stage = "grt",
        arguments = {
            "ASAP7_USE_VT": XS_VT,
            "AUTO_MEMORIES": "1",
            "CORE_UTILIZATION": "40",
            "GLOBAL_ROUTE_ARGS": "-congestion_iterations 0 -allow_congestion -verbose",
            "PLACE_DENSITY": "0.6",
            "SKIP_PIN_ACCESS": "1",
            "SKIP_REPORT_METRICS": "1",
            "SYNTH_HDL_FRONTEND": "slang",
        },
        pdk = "//flow:asap7",
        sources = {
            "AUTO_MEMORIES_REGFILES": ["//test/coremark_joule/designs/asap7/xiangshan:%s.regfile" % module],
            "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCK_grid_strategy.tcl"],
            "SDC_FILE": ["//test/coremark_joule/designs/asap7/xiangshan:constraints.sdc"],
        },
        stage_arguments = {"grt": {"HOLD_SLACK_MARGIN": "-1000"}},
        tags = ["manual"],
        verilog_files = [":rob_surgered.sv"],
    )
    for module in REGFILES
]

orfs_flow(
    name = "Rob",
    arguments = {
        k: v
        for k, v in ROB["arguments"].items()
        if k != "SYNTH_KEEP_MODULES"
    } | {
        # the cells are gone; what else the Rob macro keeps stays kept
        "SYNTH_KEEP_MODULES": "RenameBuffer VTypeBuffer",
        "GPL_TIMING_DRIVEN": "1",
        # as the planned blocks route: route-0, congestion allowed, no
        # pin access (detailed route waits for the final check)
        "GLOBAL_ROUTE_ARGS": "-congestion_iterations 0 -allow_congestion -verbose",
        "SKIP_PIN_ACCESS": "1",
        # QoR as it comes: setup repair at CTS and global route ground
        # past 45 minutes chasing 473 ps, which XSTile's ~2,000 ps does
        # not need from the Rob
        "SKIP_CTS_REPAIR_TIMING": "1",
        "SKIP_INCREMENTAL_REPAIR": "1",
    },
    last_stage = "grt",
    macros = [":%s_generate_abstract" % m for m in REGFILES],
    pdk = "//flow:asap7",
    sources = {
        k: v
        for k, v in ROB["sources"].items()
        if k != "AUTO_MEMORIES_REGFILES"
    },
    stage_arguments = {"grt": {"HOLD_SLACK_MARGIN": "-1000"}},
    tags = ["manual"],
    user_arguments = ROB["user_arguments"] | XS_ICG_USER_ARGUMENTS,
    user_sources = ROB["user_sources"] | XS_ICG_USER_SOURCES,
    user_stages = {
        v: s
        for v, s in XS_USER_STAGES.items()
        if v in ROB["user_arguments"] | XS_ICG_USER_ARGUMENTS or v in ROB["user_sources"] | XS_ICG_USER_SOURCES
    },
    verilog_files = [
        ":rob_surgered.sv",
        ":RobEntryArray.v",
    ],
)

# The same Rob through the generic front end instead of the surgery and
# the hand-written generator: its 352 entries found and extracted as one
# cell, RobEntry, instanced per entry (../arrays: entries.py, extract.py,
# proven equal by check.py), the register files the same macros. Only the
# netlist differs from the flow above.
orfs_flow(
    name = "RobEntries",
    arguments = {
        k: v
        for k, v in ROB["arguments"].items()
        if k != "SYNTH_KEEP_MODULES"
    } | {
        "GLOBAL_ROUTE_ARGS": "-congestion_iterations 0 -allow_congestion -verbose",
        "GPL_TIMING_DRIVEN": "1",
        "SKIP_CTS_REPAIR_TIMING": "1",
        "SKIP_INCREMENTAL_REPAIR": "1",
        "SKIP_PIN_ACCESS": "1",
        "SYNTH_HDL_FRONTEND": "",
        "SYNTH_HIERARCHICAL": "1",
        # the entry cell, mapped once; the rest was flattened by the front
        # end's elaboration
        "SYNTH_KEEP_MODULES": "RobEntry",
    },
    last_stage = "grt",
    macros = [":%s_generate_abstract" % m for m in REGFILES],
    pdk = "//flow:asap7",
    sources = {
        k: v
        for k, v in ROB["sources"].items()
        if k != "AUTO_MEMORIES_REGFILES"
    },
    stage_arguments = {"grt": {"HOLD_SLACK_MARGIN": "-1000"}},
    tags = ["manual"],
    top = "Rob",
    user_arguments = ROB["user_arguments"] | XS_ICG_USER_ARGUMENTS,
    user_sources = ROB["user_sources"] | XS_ICG_USER_SOURCES,
    user_stages = {
        v: s
        for v, s in XS_USER_STAGES.items()
        if v in ROB["user_arguments"] | XS_ICG_USER_ARGUMENTS or v in ROB["user_sources"] | XS_ICG_USER_SOURCES
    },
    verilog_files = ["//test/coremark_joule/designs/asap7/xiangshan/arrays:Rob_extracted.v"],
    yosys_frontend_reason = "the input is a netlist yosys wrote (extract.py); slang elaborates every instance of the kept entry cell as a module of its own",
)

[
    orfs_run(
        name = "Rob_%s_qor" % stage,
        src = ":Rob_%s" % stage,
        outs = ["Rob_%s_qor.json" % stage],
        script = ":qor_probe.tcl",
        tags = ["manual"],
        user_arguments = {
            "OUTPUT_JSON": "$(location Rob_%s_qor.json)" % stage,
        },
    )
    for stage in [
        "cts",
        "grt",
    ]
]

orfs_run(
    name = "RobEntries_grt_qor",
    src = ":RobEntries_grt",
    outs = ["RobEntries_grt_qor.json"],
    script = ":qor_probe.tcl",
    tags = ["manual"],
    user_arguments = {
        "OUTPUT_JSON": "$(location RobEntries_grt_qor.json)",
    },
)

exports_files(["qor_probe.tcl"])
