load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_run")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//test/coremark_joule/designs/asap7/xiangshan:xiangshan.bzl", "XS_BLOCKS", "XS_ICG_USER_ARGUMENTS", "XS_ICG_USER_SOURCES", "XS_USER_STAGES")

# The blocks whose entries the front end extracts (entries.py says how
# much of each follows one rule).
TOPS = [
    "LoadQueueRAR",
    "LoadQueueReplay",
    "PhysicalStoreQueue",
    "TLBFA",
    "TLBFA_1",
    "Uncache",
    "VirtualLoadQueue",
    "VirtualStoreQueue",
]

# The modules extracted, the blocks above and the Rob, whose flow is
# rob_array's next to the surgered Rob's; and the modules that stay
# blackboxes in each, macros of their own.
EXTRACTED = TOPS + ["Rob"]

# The RTL every module is extracted from: the surgered core XSTile's
# flows read, so an extracted module has the ports its parent instances
# (the constants surgery drops ports; the vec elaboration's
# RenameBufferFile had 20 read ports, the surgered core's 16).
SURGERED = "//test/coremark_joule/designs/asap7/xiangshan/surgery:xiangshan_surgered"

# RenameBuffer and VTypeBuffer stay modules of their own, as the plan keeps
# them: its macro placement names the register file inside RenameBuffer
# by that path (rob/rab/renameBuffer), which flattening would rename.
BLACKBOXES = {
    "Rob": [
        "RenameBuffer",
        "RobEntryFile",
        "VTypeBuffer",
    ],
}

# Finding XiangShan's arrays for generate_array, one macro at a time:
# array_reroll and the classifier on the packed-vector elaboration
# (//test/coremark_joule/xiangshan:xiangshan_sv_vec). A dry run: a
# report, nothing changed. Manual: it needs XiangShan elaborated.

py_binary(
    name = "dryrun",
    srcs = ["dryrun.py"],
)

[
    genrule(
        name = top + "_dryrun",
        srcs = [
            "//test/coremark_joule/xiangshan:xiangshan_sv_vec",
            "//tools/yosys_arrays:classify.py",
        ],
        outs = [top + "_dryrun.txt"],
        cmd = "$(execpath :dryrun) $(execpath @yosys) $(execpath @sv-elab//src/yosys_plugin:slang.so) " +
              "$(execpath //tools/yosys_arrays:arrays.so) $(execpath //tools/yosys_arrays:classify.py) " +
              "$(location //test/coremark_joule/xiangshan:xiangshan_sv_vec) %s $@" % top,
        tags = ["manual"],
        tools = [
            ":dryrun",
            "//tools/yosys_arrays:arrays.so",
            "@sv-elab//src/yosys_plugin:slang.so",
            "@yosys",
        ],
    )
    for top in TOPS
]

# One module after proc and nothing else, as yosys JSON: what entries.py
# reads. No opt: it folds each entry's index constant differently
# (x == 0 becomes !x), and the entries would no longer look alike.
py_library(
    name = "dryrun_lib",
    srcs = ["dryrun.py"],
    imports = ["."],
)

py_binary(
    name = "proc_json",
    srcs = ["proc_json.py"],
    deps = [":dryrun_lib"],
)

[
    genrule(
        name = top + "_proc_json",
        srcs = [SURGERED],
        outs = [top + "_proc.json"],
        cmd = "$(execpath :proc_json) $(execpath @yosys) $(execpath @sv-elab//src/yosys_plugin:slang.so) " +
              "$(location %s) %s $@ %s" % (
                  SURGERED,
                  top,
                  ",".join(BLACKBOXES.get(top, [])),
              ),
        tags = ["manual"],
        tools = [
            ":proc_json",
            "@sv-elab//src/yosys_plugin:slang.so",
            "@yosys",
        ],
    )
    for top in EXTRACTED
]

# The front end, end to end: a module's entries found (entries.py) and
# extracted as one cell instanced per entry (extract.py), written back
# to Verilog by yosys for the block's flow.
py_library(
    name = "entries_lib",
    srcs = ["entries.py"],
    imports = ["."],
)

py_binary(
    name = "extract",
    srcs = ["extract.py"],
    deps = [":entries_lib"],
)

py_binary(
    name = "check",
    srcs = ["check.py"],
    deps = [":entries_lib"],
)

[
    genrule(
        name = top + "_extracted",
        srcs = [":%s_proc.json" % top],
        outs = [
            top + "_extracted.v",
            top + "_extracted.json",
            top + "_extracted.json.renames",
        ],
        cmd = "$(execpath :extract) $(location :%s_proc.json) %s $(location %s_extracted.json) && " % (top, top, top) +
              "$(execpath @yosys) -q -p 'read_json $(location %s_extracted.json); hierarchy -top %s; " % (top, top) +
              # an async load of a constant is an async reset: the flow maps
              # the one and not the other
              "opt_dff; write_verilog -noattr $(location %s_extracted.v)'" % top,
        tags = ["manual"],
        tools = [
            ":extract",
            "@yosys",
        ],
        visibility = ["//test/coremark_joule/designs/asap7/xiangshan/rob_array:__pkg__"],
    )
    for top in EXTRACTED
]

# A study, off by default: the extraction with every read side left in
# the block (extract.py --no-read), the cell its entries' registers and
# write logic alone: Uncache's 435-bit read side mapped inside the kept
# cell, where nothing is optimised across its boundary.
READ_STUDY = ["Uncache"]

[
    genrule(
        name = top + "_noread_extracted",
        srcs = [":%s_proc.json" % top],
        outs = [
            top + "_noread_extracted.v",
            top + "_noread_extracted.json",
        ],
        cmd = "$(execpath :extract) $(location :%s_proc.json) %s $(location %s_noread_extracted.json) --no-read && " % (top, top, top) +
              "$(execpath @yosys) -q -p 'read_json $(location %s_noread_extracted.json); hierarchy -top %s; " % (top, top) +
              "opt_dff; write_verilog -noattr $(location %s_noread_extracted.v)'" % top,
        tags = ["manual"],
        tools = [
            ":extract",
            "@yosys",
        ],
    )
    for top in READ_STUDY
]

# The same with the broadcasts into the cells treed (--fanout-tree, as
# TREE below), <top>_noread_tree: 977.9 ps against the treed extraction's
# 992.1 (A 916.0), global route as long.
[
    genrule(
        name = top + "_noread_tree_extracted",
        srcs = [":%s_proc.json" % top],
        outs = [
            top + "_noread_tree_extracted.v",
            top + "_noread_tree_extracted.json",
        ],
        cmd = "$(execpath :extract) $(location :%s_proc.json) %s $(location %s_noread_tree_extracted.json) --no-read --fanout-tree=8 && " % (top, top, top) +
              "$(execpath @yosys) -q -p 'read_json $(location %s_noread_tree_extracted.json); hierarchy -top %s; " % (top, top) +
              "opt_dff; write_verilog -noattr $(location %s_noread_tree_extracted.v)'" % top,
        tags = ["manual"],
        tools = [
            ":extract",
            "@yosys",
        ],
    )
    for top in READ_STUDY
]

# Every broadcast into the entry cells (an input all of them share)
# driven through two levels of inverters, one at the root and one per
# eight entries (extract.py --fanout-tree), instead of one net into
# every cell that placement's repair_design buffers with BUFx2 trees at
# fanout 32. Each inverter is an instance of <top>FanoutInv, a module of
# one $not the flow keeps, so synthesis maps it to the platform's own
# inverter; the proofs flatten it (<top>_tree_check_test). On in the
# blocks' flows where it wins (TREE), a study elsewhere (TREE_STUDY).
# The clock is left alone (extract.py clock_ports): treed, CTS cloned the
# second level's inverter once per register. Period at grt on the
# routes' parasitics (ps, untreed -> treed; A): PhysicalStoreQueue
# 1,666.4 -> 1,579.6 (1,453.0), VirtualLoadQueue 972.6 -> 847.0 (857.6),
# Uncache 1,171.3 -> 992.1 (916.0), LoadQueueRAR 863.5 -> 818.1 (781.3).
TREE = [
    "LoadQueueRAR",
    "PhysicalStoreQueue",
    "Uncache",
    "VirtualLoadQueue",
]

TREE_STUDY = []

# The blocks whose broadcasts include a computation the RTL repeats once
# per entry in the block (extract.py --tree-copies), treed as the one
# broadcast synthesis merges it into. PhysicalStoreQueue's 36 such bits
# (64 copies of an adder on the forwarding query's end) reached the cells
# untreed, through repair_design's BUFx2 at fanout 32, ahead of the
# query's own tree: period at grt 1,579.6 -> 1,483.9 ps, time a tie.
# Not LoadQueueRAR: its 48 (write data, one buffer per entry) cost it
# 818.1 -> 882.5 ps.
TREE_COPIES = ["PhysicalStoreQueue"]

[
    genrule(
        name = top + "_tree_extracted",
        srcs = [":%s_proc.json" % top],
        outs = [
            top + "_tree_extracted.v",
            top + "_tree_extracted.json",
            top + "_tree_extracted.json.renames",
        ],
        cmd = "$(execpath :extract) $(location :%s_proc.json) %s $(location %s_tree_extracted.json) --fanout-tree=8%s && " % (
                  top,
                  top,
                  top,
                  " --tree-copies" if top in TREE_COPIES else "",
              ) +
              "$(execpath @yosys) -q -p 'read_json $(location %s_tree_extracted.json); hierarchy -top %s; " % (top, top) +
              "opt_dff; write_verilog -noattr $(location %s_tree_extracted.v)'" % top,
        tags = ["manual"],
        tools = [
            ":extract",
            "@yosys",
        ],
    )
    for top in TREE + TREE_STUDY
]

# The core XSTile's MemBlock and parent read: the surgered core with the
# extractions in place of the modules they came from (substitute.py), each
# proven by its <top>_check_test. TLBFA, the instruction TLB, is
# Frontend's and stays out, so Frontend reads the surgered core and stays
# cached.
INTEGRATED = [
    "LoadQueueRAR",
    "LoadQueueReplay",
    "PhysicalStoreQueue",
    "Rob",
    "TLBFA_1",
    "VirtualStoreQueue",
]

py_binary(
    name = "substitute",
    srcs = ["substitute.py"],
)

genrule(
    name = "xiangshan_extracted",
    srcs = [SURGERED] + [":%s_extracted.v" % top for top in INTEGRATED],
    outs = ["xiangshan_extracted.sv"],
    cmd = "$(execpath :substitute) $(location %s) $@ %s" % (
        SURGERED,
        " ".join(["$(location :%s_extracted.v)" % top for top in INTEGRATED]),
    ),
    tags = ["manual"],
    tools = [":substitute"],
    visibility = [
        "//test/coremark_joule/designs/asap7/xiangshan:__pkg__",
        "//test/coremark_joule/designs/asap7/xiangshan/rob_array:__pkg__",
    ],
)

# The block on the extracted Verilog through slang, its entry cell kept
# and slang's per-instance copies of it folded onto one module
# (fold_entries.tcl), so synthesis maps it once, as XSTile's flows do: setup repair off (XSTile's ~2,000 ps), no pin access, and
# the carve's placement (timing- and routability-driven global placement
# off), so floorplan through global route compares with the carve's
# numbers. The Rob's block settings without its register files.
BLOCK = XS_BLOCKS["Rob"]

# The blocks that stay on yosys's frontend, the extraction read as the
# netlist it is, each entry cell kept and mapped once: on slang and the
# fold their period at global route was worse, single runs (ps, yosys
# against slang): PhysicalStoreQueue 1,905.1 against 2,304.9,
# VirtualStoreQueue 1,485.0 against 1,849.1, TLBFA_1 349.5 against 364.7.
# VirtualStoreQueue again with its decoders' enables decoded (2026-10-30):
# 961.3 against 1,320.7, its RTL arm 1,014.1 against 1,200.1; on slang
# 8,859 more cells and the read at the dequeue pointer slower.
# The other three were better on slang: LoadQueueRAR 997.7 to 961.1,
# LoadQueueReplay 1,469.7 to 1,289.9, TLBFA 285.9 to 272.0.
YOSYS_FRONTEND = [
    "PhysicalStoreQueue",
    "TLBFA_1",
    "VirtualStoreQueue",
]

# A study, off by default: both arms with repair_design's slew target 40 %
# under the library's limit (SLEW_MARGIN), <top>_slew and <top>_rtl_slew.
# In PhysicalStoreQueue's extraction synthesis leaves the forwarding
# query's broadcast into the 64 kept cells unbuffered (800 fanout
# violations at place against 1 in the RTL arm), and repair_design's
# BUFx2 trees at fanout 32 met the slew limit at 287 ps. Period at grt
# (ps): extraction 1,905.1 -> 1,613.2, RTL arm 1,582.9 -> 1,424.3; the
# extraction still trades (ideas/structured-macros.md). On the treed
# extraction, its inverters kept as in the default arm (same netlist):
# 1,579.6 -> 1,439.2, time +10.8 %.
SLEW_STUDY = {
    "PhysicalStoreQueue": {"SLEW_MARGIN": "40"},
}

# A study, off by default: both arms with ABC's upsizing widened to the
# paths within 20 % of each module's critical delay and no downsizing
# (abc_speed_window.script: ORFS's abc_speed.script with `upsize -c -W
# 20`, ABC's default window 1 %, and no `dnsize -c`), <top>_abcwin and
# <top>_rtl_abcwin. ABC maps each kept module alone and upsizes only the
# paths near that module's own critical delay, so a path that ends at an
# entry cell's input or starts at its pin is left at BUFx2 chains. Period
# at grt (ps, as is -> windowed): LoadQueueRAR A 781.3 -> 699.6, B
# 818.1 -> 743.8; Uncache A 916.0 -> 872.8, B 992.1 -> 920.1. Both arms
# gain alike: it is no lever for the extraction.
ABC_WINDOW_STUDY = [
    "LoadQueueRAR",
    "Uncache",
]

STUDY_SOURCES = {
    v: {"ABC_SCRIPT": [":abc_speed_window.script"]}
    for v in [
        "abcwin",
        "rtl_abcwin",
    ]
}

# Each block twice, the arms of its A/B: <top> on the extraction and
# <top>_rtl on the module as it is (the same proc JSON written back as
# Verilog, no entry cell, nothing folded), every other setting the same by
# construction: what the extraction alone buys in build time and period.
[
    genrule(
        name = top + "_rtl_verilog",
        srcs = [":%s_proc.json" % top],
        outs = [top + "_rtl.v"],
        cmd = "$(execpath @yosys) -q -p 'read_json $<; hierarchy -top %s; " % top +
              "opt_dff; write_verilog -noattr $@'",
        tags = ["manual"],
        tools = ["@yosys"],
    )
    for top in TOPS
]

[
    orfs_flow(
        name = top,
        arguments = {k: v for k, v in BLOCK["arguments"].items() if k != "SYNTH_KEEP_MODULES"} | {
            "GLOBAL_ROUTE_ARGS": "-congestion_iterations 0 -allow_congestion -verbose",
            "GPL_ROUTABILITY_DRIVEN": "0",
            "GPL_TIMING_DRIVEN": "0",
            "SKIP_CTS_REPAIR_TIMING": "1",
            # as the carve: floorplan's repair_timing (unbuffer, size-up) was
            # 335 of the 349 s of floorplan
            "SKIP_FLOORPLAN_REPAIR_TIMING": "1",
            "SKIP_INCREMENTAL_REPAIR": "1",
            "SKIP_PIN_ACCESS": "1",
            "SKIP_REPORT_METRICS": "1",
            "SYNTH_HIERARCHICAL": "1",
            # the tree's inverters (<top>FanoutInv) kept, so synthesis does
            # not fold the two levels away
            "SYNTH_KEEP_MODULES": "" if rtl else " ".join([top + "Entry"] + ([top + "FanoutInv"] if variant in ("tree", "noread_tree") or (variant in (None, "slew", "abcwin") and top in TREE) else [])),
        } | ({"SYNTH_HDL_FRONTEND": ""} if top in YOSYS_FRONTEND else {}) | extra,
        last_stage = "grt",
        pdk = "//flow:asap7",
        sources = {k: v for k, v in BLOCK["sources"].items() if k != "AUTO_MEMORIES_REGFILES"} | ({} if rtl or top in YOSYS_FRONTEND else {
            "SYNTH_CANONICALIZE_TCL": ["//test/coremark_joule/designs/asap7/xiangshan:fold_entries.tcl"],
        }) | STUDY_SOURCES.get(variant, {}),
        stage_arguments = {"grt": {"HOLD_SLACK_MARGIN": "-1000"}},
        tags = ["manual"],
        user_arguments = BLOCK["user_arguments"] | XS_ICG_USER_ARGUMENTS | ({} if rtl or top in YOSYS_FRONTEND else {"XS_FOLD_MODULES": " ".join([top + "Entry"] + ([top + "FanoutInv"] if variant in ("tree", "noread_tree") or (variant in (None, "slew", "abcwin") and top in TREE) else []))}),
        user_sources = BLOCK["user_sources"] | XS_ICG_USER_SOURCES,
        user_stages = {
            v: s
            for v, s in XS_USER_STAGES.items()
            if v in BLOCK["user_arguments"] | XS_ICG_USER_ARGUMENTS | ({} if rtl or top in YOSYS_FRONTEND else {"XS_FOLD_MODULES": ""}) or v in BLOCK["user_sources"] | XS_ICG_USER_SOURCES
        },
        variant = variant,
        verilog_files = [":%s_%s.v" % (
            top,
            "rtl" if rtl else {
                "noread": "noread_extracted",
                "tree": "tree_extracted",
                "noread_tree": "noread_tree_extracted",
            }.get(
                variant,
                "tree_extracted" if top in TREE else "extracted",
            ),
        )],
        yosys_frontend_reason = "period worse on slang and the fold (YOSYS_FRONTEND)" if top in YOSYS_FRONTEND else None,
    )
    for top in TOPS
    for rtl, variant, extra in [
        (False, None, {}),
        (True, "rtl", {}),
    ] + ([
        (False, "noread", {}),
        (False, "noread_tree", {}),
    ] if top in READ_STUDY else []) + ([(False, "tree", {})] if top in TREE_STUDY else []) + ([
        (
            False,
            "slew",
            SLEW_STUDY[top],
        ),
        (
            True,
            "rtl_slew",
            SLEW_STUDY[top],
        ),
    ] if top in SLEW_STUDY else []) + ([
        (False, "abcwin", {}),
        (True, "rtl_abcwin", {}),
    ] if top in ABC_WINDOW_STUDY else [])
]

# A study, off by default: the extraction with its entry cells flattened
# before synthesis (SYNTH_HIERARCHICAL 0), its comparisons still
# decoded once in the block, so ABC maps an entry's compare and the
# block's select over it together. For a block whose broadcast into the
# cells is inherent (PhysicalStoreQueue's forwarding query); placement
# saw one netlist already (OPENROAD_HIERARCHICAL 0). LoadQueueRAR flat:
# 800.8 ps at 5.4 min against its RTL arm's 781.3 at 6.59, synthesis
# 209 s against 191-267: the decoding alone buys nothing, the kept cell's
# synthesis is the extraction's time.
FLAT_STUDY = [
    "LoadQueueRAR",
    "PhysicalStoreQueue",
]

[
    orfs_flow(
        name = top,
        arguments = {k: v for k, v in BLOCK["arguments"].items() if k != "SYNTH_KEEP_MODULES"} | {
            "GLOBAL_ROUTE_ARGS": "-congestion_iterations 0 -allow_congestion -verbose",
            "GPL_ROUTABILITY_DRIVEN": "0",
            "GPL_TIMING_DRIVEN": "0",
            "SKIP_CTS_REPAIR_TIMING": "1",
            "SKIP_FLOORPLAN_REPAIR_TIMING": "1",
            "SKIP_INCREMENTAL_REPAIR": "1",
            "SKIP_PIN_ACCESS": "1",
            "SKIP_REPORT_METRICS": "1",
            "SYNTH_HIERARCHICAL": "0",
            "SYNTH_KEEP_MODULES": "",
        } | ({"SYNTH_HDL_FRONTEND": ""} if top in YOSYS_FRONTEND else {}),
        last_stage = "grt",
        pdk = "//flow:asap7",
        sources = {k: v for k, v in BLOCK["sources"].items() if k != "AUTO_MEMORIES_REGFILES"},
        stage_arguments = {"grt": {"HOLD_SLACK_MARGIN": "-1000"}},
        tags = ["manual"],
        user_arguments = BLOCK["user_arguments"] | XS_ICG_USER_ARGUMENTS,
        user_sources = BLOCK["user_sources"] | XS_ICG_USER_SOURCES,
        user_stages = {
            v: s
            for v, s in XS_USER_STAGES.items()
            if v in BLOCK["user_arguments"] | XS_ICG_USER_ARGUMENTS or v in BLOCK["user_sources"] | XS_ICG_USER_SOURCES
        },
        variant = "flat",
        verilog_files = [":%s_extracted.v" % top],
        yosys_frontend_reason = "period worse on slang and the fold (YOSYS_FRONTEND)" if top in YOSYS_FRONTEND else None,
    )
    for top in FLAT_STUDY
]

[
    orfs_run(
        name = flow + "_grt_qor",
        src = ":%s_grt" % flow,
        outs = [flow + "_grt_qor.json"],
        script = "//test/coremark_joule/designs/asap7/xiangshan/rob_array:qor_probe.tcl",
        tags = ["manual"],
        user_arguments = {
            "OUTPUT_JSON": "$(location %s_grt_qor.json)" % flow,
        },
    )
    for top in TOPS
    for flow in [
        top,
        top + "_rtl",
    ] + ([top + "_flat"] if top in FLAT_STUDY else []) + ([
        top + "_noread",
        top + "_noread_tree",
    ] if top in READ_STUDY else []) + ([top + "_tree"] if top in TREE_STUDY else []) + ([
        top + "_slew",
        top + "_rtl_slew",
    ] if top in SLEW_STUDY else []) + ([
        top + "_abcwin",
        top + "_rtl_abcwin",
    ] if top in ABC_WINDOW_STUDY else [])
]

# The extraction's proof as a test: the extracted module, its comparisons
# decoded once, against the module it came from (check.py: registers and
# blackboxes cut, a miter, ABC's iprove), and the negative control, one
# register's D-mux swapped, which must come out different. Manual: it
# needs XiangShan elaborated; the Rob's takes over half an hour.
[
    py_test(
        name = "%s_%s_test" % (top, kind),
        timeout = "eternal" if top == "Rob" else "long",
        srcs = ["check.py"],
        args = [
            "$(rootpath @yosys)",
            "$(rootpath :%s_proc.json)" % top,
            "$(rootpath :%s_extracted.json)" % top,
            top,
        ] + (["mutate"] if kind == "control" else []),
        data = [
            ":%s_extracted.json" % top,
            ":%s_extracted.json.renames" % top,
            ":%s_proc.json" % top,
            # yosys-abc, which check.py runs, comes in yosys's runfiles
            "@yosys",
        ],
        main = "check.py",
        tags = ["manual"],
        deps = [":entries_lib"],
    )
    for top in EXTRACTED
    for kind in [
        "check",
        "control",
    ]
]

# The treed extraction's proof, through the tree (each inverter a module
# of one $not, flattened), and its negative control: one leaf of one
# broadcast's tree reads the broadcast instead of its root, so its eight
# entries see the complement, which must come out different.
[
    py_test(
        name = "%s_tree_%s_test" % (top, kind),
        timeout = "long",
        srcs = ["check.py"],
        args = [
            "$(rootpath @yosys)",
            "$(rootpath :%s_proc.json)" % top,
            "$(rootpath :%s_tree_extracted.json)" % top,
            top,
        ] + (["mutate-tree"] if kind == "control" else []),
        data = [
            ":%s_tree_extracted.json" % top,
            ":%s_tree_extracted.json.renames" % top,
            ":%s_proc.json" % top,
            "@yosys",
        ],
        main = "check.py",
        tags = ["manual"],
        deps = [":entries_lib"],
    )
    for top in TREE + TREE_STUDY
    for kind in [
        "check",
        "control",
    ]
]

# The front end end to end on an 8-entry CAM small enough to read: its
# entries found, the index decoded once, the match left in the cell, a
# blackbox kept, the extraction proven equal and the control different,
# and the entry cell's slang copies folded onto one module. Seconds.
py_test(
    name = "features_test",
