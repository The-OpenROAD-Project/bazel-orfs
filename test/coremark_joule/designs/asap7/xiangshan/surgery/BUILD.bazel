load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":surgery.bzl", "kept_cells", "xs_surgery_chain")

# Surgery on the books: the constants XiangShan ties into the modules this
# flow keeps, folded before synthesis by xs_surgery.py from manifest.json,
# each entry's precondition checked exactly (xs_surgery.py says how).

py_binary(
    name = "xs_surgery",
    srcs = ["xs_surgery.py"],
    visibility = ["//test/coremark_joule:__subpackages__"],
)

py_test(
    name = "xs_surgery_test",
    size = "small",
    srcs = [
        "xs_surgery.py",
        "xs_surgery_test.py",
    ],
    main = "xs_surgery_test.py",
    tags = ["study"],
)

# XiangShan's flat Verilog after the surgery: what every XiangShan flow
# synthesises (XS_VERILOG), xiangshan_surgered.sv. XSTile's own ports are
# what the SoC stitch and the gate-level simulation plug into, so they
# are protected.
xs_surgery_chain(
    name = "xiangshan_surgered",
    src = "//test/coremark_joule/xiangshan:xiangshan_flat",
    manifest = "manifest.json",
    protect = ["XSTile"],
    rounds = 5,
)

# The surgered file is still SystemVerilog slang elaborates under XSTile,
# the way the flow's canonicalisation reads it. Manual: a minute, the
# whole core.
genrule(
    name = "xiangshan_surgered_elaborates",
    srcs = [":xiangshan_surgered"],
    outs = ["xiangshan_surgered_elaborates.log"],
    cmd = "$(execpath @yosys//:yosys) -q -m $(execpath @sv-elab//src/yosys_plugin:slang.so) " +
          "-p 'read_slang --keep-hierarchy --top XSTile $(location :xiangshan_surgered); hierarchy -top XSTile; tee -o $@ stat -top XSTile' > /dev/null",
    tags = ["manual"],
    tools = [
        "@sv-elab//src/yosys_plugin:slang.so",
        "@yosys",
    ],
)

py_binary(
    name = "constant_outputs",
    srcs = ["constant_outputs.py"],
)

py_binary(
    name = "kept_cells",
    srcs = ["kept_cells.py"],
)

# What the surgery removes before synthesis maps anything: cells and flop
# bits of every kept module without it and with it.
kept_cells(
    name = "kept_cells_before",
    src = "//test/coremark_joule/xiangshan:xiangshan_flat",
)

kept_cells(
    name = "kept_cells_after",
    src = ":xiangshan_surgered",
)
