# IntRegFile: XiangShan's integer register file, 224 words of 64 bits in
# four banks of 56, with 12 read and 9 write ports. The RTL is a
# RegfileBank: every read port carries one 6-bit address and one 64-bit
# data bus per bank, and the bank mux sits outside in the data path;
# writes carry the full 8-bit address. `read_banked` gives the per-bank
# buses in bank order, and the array's banks are those banks.
module IntRegFile
words 224
bits 64
banks 4
clock clock
reset reset
read_banked io_readPorts_0_addr_0 io_readPorts_0_data_0 io_readPorts_0_addr_1 io_readPorts_0_data_1 io_readPorts_0_addr_2 io_readPorts_0_data_2 io_readPorts_0_addr_3 io_readPorts_0_data_3
