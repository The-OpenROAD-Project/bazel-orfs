# The two-level replay (flow/power.bzl's shard_replays two_level), on a
# unit of its own, Punched (punched.sv), whose netlist is written by hand
# (punched_netlist.v) in the shape a hierarchical global route leaves a
# kept module: ports its RTL lacks, punched to feed its own loads from
# the parent's buffers, one from its own output, one from a sibling's;
# an unused RTL input no port of it; its clock on a clock-tree leaf.
# No ORFS flow: seconds of Verilator. punched_test.py says what it proves.
shard_capture_rtl(
    name = "punched_capture_rtl",
    paths = ["u_core"],
    rtl = ":punched.sv",
    scope = "Punched",
    top = "Punched",
)

verilog_library(
    name = "punched_capture_v",
    srcs = [
        ":punched_capture_rtl.sv",
        ":punched_capture_rtl_trace.v",
    ],
    tags = ["manual"],
)

verilator_cc_library(
    name = "punched_capture_lib",
    copts = [
        "-O2",
        "-Wno-all",
    ],
    module = ":punched_capture_v",
    module_top = "Punched",
    tags = ["manual"],
    trace_mode = "vcd",
    vopts = VOPTS,
)

cc_binary(
    name = "punched_tb",
    srcs = ["punched_tb.cc"],
    copts = ["-O2"],
    tags = ["manual"],
    deps = [":punched_capture_lib"],
)

genrule(
    name = "punched_capture",
    srcs = [":punched_tb"],
    outs = ["punched_capture.vcd"],
    cmd = "$(execpath :punched_tb) $@ 200 1000",
    tags = ["manual"],
)

# PunCore's clock-tree leaf, a clock net the merge compares
PUNCHED_CLOCKS = CLOCK_PORTS + ["clknet_1_0__leaf_clock"]

# the reference: Punched replayed whole, its netlist's punched ports
# inside it, driven by its own buffers
shard_replay(
    name = "punched_whole",
    capture = ":punched_capture.vcd",
    capture_scope = "TOP.Punched",
    cells = ":cells_init",
    clk_period = "1000",
    clock_ports = PUNCHED_CLOCKS,
    netlist = ":punched_netlist.v",
    rtl = ":punched.sv",
    top = "Punched",
    vopts = VOPTS,
    window_start = "16000",
)

# u_core cut out, in two levels: punched_cut_parent, the rest of Punched
# with u_core a stub, its SAIF and the stub's ports
# (punched_cut_parent_stubs.vcd); punched_cut_u_core, u_core replayed
# from those; punched_cut.saif, the two merged
shard_replays(
    name = "punched_cut",
    capture = ":punched_capture.vcd",
    capture_scope = "TOP.Punched",
    cells = ":cells_init",
    clk_period = "1000",
    clock_ports = PUNCHED_CLOCKS,
    cuts = {"": ["u_core"]},
    netlist = ":punched_netlist.v",
    rtl = ":punched.sv",
    top = "Punched",
    two_level = True,
    units = {},
    vopts = VOPTS,
    window_start = "16000",
)

# The unit's netlist with PunCore's data[0] made to differ from the RTL:
# r[0] & r[3], only while v (r[3]) is 0, which PunCore ignores; and
# r[0] ^ r[3], only while v is 1, which it takes. Level 1 reports either
# difference at the stub's input and passes; level 2 passes the first and
# fails the second at PunCore's output acc.
[
    genrule(
        name = "punched_%s_netlist" % variant,
        srcs = [":punched_netlist.v"],
        outs = ["punched_%s.v" % variant],
        cmd = "sed 's/^ assign dsel = r\\[0\\];$$/ %s dsel_gate (.A(r[0]), .B(r[3]), .Y(dsel));/' $< > $@ && grep -q dsel_gate $@" % cell,
        tags = ["manual"],
    )
    for variant, cell in [
        ("dontcare", "AND2x2_ASAP7_75t_R"),
        ("matters", "XOR2xp5_ASAP7_75t_R"),
    ]
]

[
    shard_replays(
        name = "punched_" + variant,
        capture = ":punched_capture.vcd",
        capture_scope = "TOP.Punched",
        cells = ":cells_init",
        clk_period = "1000",
        clock_ports = PUNCHED_CLOCKS,
        cuts = {"": ["u_core"]},
        netlist = ":punched_%s.v" % variant,
        rtl = ":punched.sv",
        top = "Punched",
        two_level = True,
        units = {},
        vopts = VOPTS,
        window_start = "16000",
    )
    for variant in [
        "dontcare",
        "matters",
    ]
]

# The "matters" netlist with u_core's level 2 counting the outputs that
# differ instead of failing on the first (count_outputs): it passes, and
# punched_counted_u_core_outputs.json says acc differs and from when.
shard_replays(
    name = "punched_counted",
    capture = ":punched_capture.vcd",
    capture_scope = "TOP.Punched",
    cells = ":cells_init",
    clk_period = "1000",
    clock_ports = PUNCHED_CLOCKS,
    count_outputs = ["u_core"],
    cuts = {"": ["u_core"]},
    netlist = ":punched_matters.v",
    rtl = ":punched.sv",
    top = "Punched",
    two_level = True,
    units = {},
    vopts = VOPTS,
    window_start = "16000",
)

# PunCore's rdy made to differ from the RTL before the first reset (gated
# by a flop the reset sets, which starts at 0), during it (or'ed with
# reset), and after it (one cycle late): replayed with u_core's outputs
# compared from the cycle after the captured reset falls
# (compare_from_reset). The first two pass, the third fails, and counts
# with count_outputs. Without the flag the first fails at cycle 0.
RDY_VARIANTS = {
    "before": " OR2x2_ASAP7_75t_R _s0_ (.A(reset), .B(seen), .Y(seen_d));\\n DFFHQNx1_ASAP7_75t_R seen_reg (.CLK(clknet_1_0__leaf_clock), .D(seen_d), .QN(seen_n));\\n INVx1_ASAP7_75t_R _s1_ (.A(seen_n), .Y(seen));\\n AND2x2_ASAP7_75t_R _s2_ (.A(rdyq), .B(seen), .Y(rdy));",
    "during": " OR2x2_ASAP7_75t_R _v0_ (.A(rdyq), .B(reset), .Y(rdy));",
    "after": " DFFHQNx1_ASAP7_75t_R late_reg (.CLK(clknet_1_0__leaf_clock), .D(rdyq), .QN(late_n));\\n INVx1_ASAP7_75t_R _l0_ (.A(late_n), .Y(rdy));",
}

[
    genrule(
        name = "punched_rdy_%s_netlist" % variant,
        srcs = [":punched_netlist.v"],
        outs = ["punched_rdy_%s.v" % variant],
        cmd = "sed 's/^ assign rdy = rdyq;$$/%s/' $< > $@ && ! grep -q '^ assign rdy = rdyq;' $@" % gates,
        tags = ["manual"],
    )
    for variant, gates in RDY_VARIANTS.items()
]

[
    shard_replays(
        name = "punched_rdy_" + variant,
        capture = ":punched_capture.vcd",
        capture_scope = "TOP.Punched",
        cells = ":cells_init",
        clk_period = "1000",
        clock_ports = PUNCHED_CLOCKS,
        compare_from_reset = ["u_core"],
        count_outputs = ["u_core"] if variant == "after" else [],
        cuts = {"": ["u_core"]},
        netlist = ":punched_rdy_%s.v" % variant,
        rtl = ":punched.sv",
        top = "Punched",
        two_level = True,
        units = {},
        vopts = VOPTS,
        window_start = "16000",
    )
    for variant in RDY_VARIANTS
]

# u_core's level 2 again, from the same level 1: "before" without the
# flag, "after" without counting
[
    shard_replay(
        name = "punched_rdy_%s_%s_u_core" % (variant, arm),
        capture = ":punched_rdy_%s_parent_stubs.vcd" % variant,
        capture_scope = "TOP.punched_rdy_%s_parent.dut.u_core" % variant,
        cells = ":cells_init",
        clk_period = "1000",
        clock_ports = PUNCHED_CLOCKS,
        compare_from_reset = arm == "strict",
        netlist = ":punched_rdy_%s.v" % variant,
        path = "u_core",
        rtl = ":punched.sv",
        stub_map = ":punched_rdy_%s_parent_stubs.json" % variant,
        top = "Punched",
        vopts = VOPTS,
        window_start = "16000",
    )
    for variant, arm in [
        ("before", "plain"),
        ("after", "strict"),
    ]
]

