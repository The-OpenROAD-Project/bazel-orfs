"""YunSuan: XiangShan's vector and floating-point units.

Kept as one target. Splitting it per functional unit is possible and
speeds up incremental Scala builds, but the study elaborates once per
change to the generator, so the split would buy nothing here.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")

package(default_visibility = ["//visibility:public"])

chisel_library(
    name = "yunsuan",
    srcs = glob(["src/main/scala/**/*.scala"]),
    scalacopts = [
        "-Ymacro-annotations",
        "-Xcheckinit:false",
    ],
    deps = ["@xs_maven//:com_lihaoyi_sourcecode_2_13"],
)
