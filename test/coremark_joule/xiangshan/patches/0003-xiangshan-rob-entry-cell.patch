-      robEntries(i).uopNum := enqWBNum
-    }.elsewhen(robEntries(i).valid) {
-      // update by writing back
-      robEntries(i).uopNum := robEntries(i).uopNum - wbCnt
-      assert(!(robEntries(i).uopNum - wbCnt > robEntries(i).uopNum), s"robEntries $i uopNum is overflow!")
-    }
-
-    val fflagsCanWbSeq = fflags_wb.map(writeback => writeback.valid && writeback.bits.robIdx.value === i.U && writeback.bits.fflagsWen.getOrElse(false.B))
-    val fflagsRes = fflagsCanWbSeq.zip(fflags_wb).map { case (canWb, wb) => Mux(canWb, wb.bits.fflags.get, 0.U) }.fold(false.B)(_ | _)
-    when(isFirstEnq) {
-      robEntries(i).fflags := 0.U
-    }.elsewhen(fflagsRes.orR) {
-      robEntries(i).fflags := robEntries(i).fflags | fflagsRes
-    }
-
-    val vxsatCanWbSeq = vxsat_wb.map(writeback => writeback.valid && writeback.bits.robIdx.value === i.U)
-    val vxsatRes = vxsatCanWbSeq.zip(vxsat_wb).map { case (canWb, wb) => Mux(canWb, wb.bits.vxsat.get, 0.U) }.fold(false.B)(_ | _)
-    when(isFirstEnq) {
-      robEntries(i).vxsat := 0.U
-    }.elsewhen(vxsatRes.orR) {
-      robEntries(i).vxsat := robEntries(i).vxsat | vxsatRes
-    }
-
-    // trace
-    val taken = branchWBs.map(writeback => writeback.valid && writeback.bits.robIdx.value === i.U && writeback.bits.redirect.get.bits.taken).reduce(_ || _)
-    when(robEntries(i).valid && Itype.isNonTaken(robEntries(i).traceBlockInPipe.itype) && taken){
-      // BranchType code(notaken itype = 4) must be correctly replaced!
-      robEntries(i).traceBlockInPipe.itype := Itype.Taken
-    }
-  }
+  // (writebacked state per entry: RobEntryCell)
 
   // begin update robBanksRdata
   val robBanksRdata = VecInit(robBanksRdataThisLine ++ robBanksRdataNextLine)
@@ -1172,21 +1090,54 @@
   robBanksRdataNextLineUpdate := VecInit(needUpdate.drop(bankNum))
   // end update robBanksRdata
 
-  // interrupt_safe
-  for (i <- 0 until RenameWidth) {
-    when(canEnqueue(i)) {
-      // For now, we allow non-load-store instructions to trigger interrupts
-      // For MMIO instructions, they should not trigger interrupts since they may
-      // be sent to lower level before it writes back.
-      // However, we cannot determine whether a load/store instruction is MMIO.
-      // Thus, we don't allow load/store instructions to trigger an interrupt.
-      // TODO: support non-MMIO load-store instructions to trigger interrupts
-      val allow_interrupts = !CommitType.isLoadStore(io.enq.req(i).bits.commitType) &&
-                             !FuType.isFence(io.enq.req(i).bits.fuType) &&
-                             !FuType.isCsr(io.enq.req(i).bits.fuType) &&
-                             !FuType.isVset(io.enq.req(i).bits.fuType) &&
-                             !FuType.isAMO(io.enq.req(i).bits.fuType)
-      robEntries(allocatePtrVec(i).value).interrupt_safe := allow_interrupts
+  // The per-entry cells: every entry sees the same enqueue, writeback,
+  // commit and redirect buses and picks out its own by index. This is
+  // where interrupt_safe, mmio, vls, valid, realDestSize, uopNum,
+  // fflags, vxsat, needFlush and the trace itype are written now.
+  val allowInterruptVec = VecInit(io.enq.req.map(req =>
+    // For now, we allow non-load-store instructions to trigger interrupts
+    // For MMIO instructions, they should not trigger interrupts since they may
+    // be sent to lower level before it writes back.
+    // However, we cannot determine whether a load/store instruction is MMIO.
+    // Thus, we don't allow load/store instructions to trigger an interrupt.
+    // TODO: support non-MMIO load-store instructions to trigger interrupts
+    !CommitType.isLoadStore(req.bits.commitType) &&
+      !FuType.isFence(req.bits.fuType) &&
+      !FuType.isCsr(req.bits.fuType) &&
+      !FuType.isVset(req.bits.fuType) &&
+      !FuType.isAMO(req.bits.fuType)))
+  robEntryCells.zipWithIndex.foreach { case (cell, i) =>
+    cell.io.idx := i.U
+    cell.io.enq.zip(io.enq.req).foreach { case (c, req) => c.valid := req.valid; c.bits := req.bits }
+    cell.io.enqCanAccept := io.enq.canAccept
+    cell.io.allocatePtr := VecInit(allocatePtrVec.map(_.value))
+    cell.io.allowInterrupt := allowInterruptVec
+    cell.io.redirectValid := io.redirect.valid
+    cell.io.redirectValidReg := redirectValidReg
+    cell.io.redirectBegin := redirectBegin
+    cell.io.redirectEnd := redirectEnd
+    cell.io.redirectAll := redirectAll
+    cell.io.isCommit := io.commits.isCommit
+    cell.io.commitValid := io.commits.commitValid
+    cell.io.deqPtr := VecInit(deqPtrVec.map(_.value))
+    cell.io.exuWb.zip(exuWBs).foreach { case (c, wb) => c.valid := wb.valid; c.bits := wb.bits.robIdx.value }
+    cell.io.writebackNums := VecInit(io.writebackNums.map(_.bits))
+    cell.io.excWb.zip(exceptionWBs).foreach { case (c, wb) => c.valid := wb.valid; c.bits := wb.bits.robIdx.value }
+    cell.io.writebackNeedFlush := io.writebackNeedFlush
+    cell.io.fflagsWb.zip(fflagsWBs).foreach { case (c, wb) =>
+      c.valid := wb.valid
+      c.bits.robIdx := wb.bits.robIdx.value
+      c.bits.wen := wb.bits.fflagsWen.getOrElse(false.B)
+      c.bits.fflags := wb.bits.fflags.get
+    }
+    cell.io.vxsatWb.zip(vxsatWBs).foreach { case (c, wb) =>
+      c.valid := wb.valid
+      c.bits.robIdx := wb.bits.robIdx.value
+      c.bits.vxsat := wb.bits.vxsat.get
+    }
+    cell.io.branchTaken.zip(branchWBs).foreach { case (c, wb) =>
+      c.valid := wb.valid && wb.bits.redirect.get.bits.taken
+      c.bits := wb.bits.robIdx.value
     }
   }
 
@@ -1931,3 +1882,153 @@
     io.commits.info.map(info => dontTouch(info.debug_pc.get))
   }
 }
+
+
+/** One reorder-buffer entry: its RobEntryBundle register and every write to
+  * it -- enqueue (connectEnq, mmio, vls, interrupt_safe), the valid
+  * state machine, the writeback counting (uopNum, realDestSize), the
+  * fflags and vxsat accumulation, the exception flush flag and the trace
+  * itype -- exactly as the loops over RobSize in RobImp wrote them, in
+  * the same order. The entry's index is an input, not a parameter, so all
+  * RobSize instances are one module: synthesis maps it once and the
+  * placer gets RobSize copies, instead of one flat body of RobSize
+  * unrolled loops.
+  *
+  * Debug-only fields (perfDebugInfo, debug_*, basicDebug) are written by
+  * RobImp directly and are not supported through the cell: this cell is
+  * for builds with debugEn off.
+  */
+class RobEntryCellFflagsWb(idxWidth: Int) extends Bundle {
+  val robIdx = UInt(idxWidth.W)
+  val wen = Bool()
+  val fflags = UInt(5.W)
+}
+
+class RobEntryCellVxsatWb(idxWidth: Int) extends Bundle {
+  val robIdx = UInt(idxWidth.W)
+  val vxsat = Bool()
+}
+
+class RobEntryCell(numExuWb: Int, numExcWb: Int, numFflagsWb: Int, numVxsatWb: Int, numBranchWb: Int, wbNumWidth: Int)(implicit p: Parameters, params: BackendParams) extends XSModule {
+  private val idxWidth = log2Up(RobSize)
+  val io = IO(new Bundle {
+    val idx = Input(UInt(idxWidth.W))
+    val enq = Vec(RenameWidth, Flipped(ValidIO(new EnqRobUop)))
+    val enqCanAccept = Input(Bool())
+    val allocatePtr = Vec(RenameWidth, Input(UInt(idxWidth.W)))
+    val allowInterrupt = Vec(RenameWidth, Input(Bool()))
+    val redirectValid = Input(Bool())
+    val redirectValidReg = Input(Bool())
+    val redirectBegin = Input(UInt(idxWidth.W))
+    val redirectEnd = Input(UInt(idxWidth.W))
+    val redirectAll = Input(Bool())
+    val isCommit = Input(Bool())
+    val commitValid = Vec(CommitWidth, Input(Bool()))
+    val deqPtr = Vec(CommitWidth, Input(UInt(idxWidth.W)))
+    val exuWb = Vec(numExuWb, Flipped(ValidIO(UInt(idxWidth.W))))
+    val writebackNums = Vec(numExuWb, Input(UInt(wbNumWidth.W)))
+    val excWb = Vec(numExcWb, Flipped(ValidIO(UInt(idxWidth.W))))
+    val writebackNeedFlush = Vec(numExcWb, Input(Bool()))
+    val fflagsWb = Vec(numFflagsWb, Flipped(ValidIO(new RobEntryCellFflagsWb(idxWidth))))
+    val vxsatWb = Vec(numVxsatWb, Flipped(ValidIO(new RobEntryCellVxsatWb(idxWidth))))
+    val branchTaken = Vec(numBranchWb, Flipped(ValidIO(UInt(idxWidth.W))))
+    val entry = Output(new RobEntryBundle)
+  })
+
+  val entry = RegInit((new RobEntryBundle).Lit(_.valid -> false.B))
+  io.entry := entry
+
+  // enqueue
+  val canEnqueue = VecInit(io.enq.map(req => req.valid && req.bits.firstUop && io.enqCanAccept))
+  val enqOH = VecInit(canEnqueue.zip(io.allocatePtr.map(_ === io.idx)).map(x => x._1 && x._2))
+  val enqHit = enqOH.asUInt.orR
+  assert(PopCount(enqOH) < 2.U, "robEntries enqOH is not one hot")
+  when(enqHit && !io.redirectValid) {
+    connectEnq(entry, Mux1H(enqOH, io.enq.map(_.bits)))
+  }
+  when(enqHit) {
+    entry.mmio := false.B
+    entry.vls := Mux1H(enqOH, io.enq.map(_.bits.vlsInstr))
+  }
+
+  // valid
+  val commitCond = io.isCommit && io.commitValid.zip(io.deqPtr.map(_ === io.idx)).map(x => x._1 && x._2).reduce(_ || _)
+  val needFlushRedirect = io.redirectValidReg && (Mux(
+    io.redirectEnd > io.redirectBegin,
+    (io.idx > io.redirectBegin) && (io.idx < io.redirectEnd),
+    (io.idx > io.redirectBegin) || (io.idx < io.redirectEnd)
+  ) || io.redirectAll)
+  when(commitCond) {
+    entry.valid := false.B
+  }.elsewhen(enqHit && !io.redirectValid) {
+    entry.valid := true.B
+  }.elsewhen(needFlushRedirect) {
+    entry.valid := false.B
+  }
+
+  // writebacked state
+  val uopEnqValidSeq = io.enq.map(req => io.enqCanAccept && req.valid)
+  val instEnqValidSeq = io.enq.map(req => io.enqCanAccept && req.valid && req.bits.firstUop)
+  val robIdxMatchSeq = io.enq.map(_.bits.robIdx.value === io.idx)
+  val uopCanEnqSeq = uopEnqValidSeq.zip(robIdxMatchSeq).map { case (valid, isMatch) => valid && isMatch }
+  val instCanEnqSeq = instEnqValidSeq.zip(robIdxMatchSeq).map { case (valid, isMatch) => valid && isMatch }
+  val instCanEnqFlag = Cat(instCanEnqSeq).orR
+  val isFirstEnq = !entry.valid && instCanEnqFlag
+  val realDestEnqNum = PopCount(io.enq.map(_.bits.needEnqRab).zip(uopCanEnqSeq).map { case (writeFlag, valid) => writeFlag && valid })
+  when(isFirstEnq) {
+    entry.realDestSize := realDestEnqNum
+  }.elsewhen(entry.valid && Cat(uopCanEnqSeq).orR) {
+    entry.realDestSize := entry.realDestSize + realDestEnqNum
+  }
+  val enqWBNum = PriorityMux(instCanEnqSeq, io.enq.map(_.bits.numWB))
+
+  val canWbSeq = io.exuWb.map(wb => wb.valid && wb.bits === io.idx)
+  val wbCnt = Mux1H(canWbSeq, io.writebackNums)
+
+  val canWbExceptionSeq = io.excWb.map(wb => wb.valid && wb.bits === io.idx)
+  val needFlush = entry.needFlush
+  val needFlushWriteBack = Mux1H(canWbExceptionSeq, io.writebackNeedFlush)
+  when(entry.valid) {
+    entry.needFlush := needFlush || needFlushWriteBack
+  }
+
+  when(entry.valid && (needFlush || needFlushWriteBack)) {
+    // exception flush
+    entry.uopNum := entry.uopNum - wbCnt
+  }.elsewhen(!entry.valid && instCanEnqFlag) {
+    // enq set num of uops
+    entry.uopNum := enqWBNum
+  }.elsewhen(entry.valid) {
+    // update by writing back
+    entry.uopNum := entry.uopNum - wbCnt
+    assert(!(entry.uopNum - wbCnt > entry.uopNum), "robEntries uopNum is overflow!")
+  }
+
+  val fflagsCanWbSeq = io.fflagsWb.map(wb => wb.valid && wb.bits.robIdx === io.idx && wb.bits.wen)
+  val fflagsRes = fflagsCanWbSeq.zip(io.fflagsWb).map { case (canWb, wb) => Mux(canWb, wb.bits.fflags, 0.U) }.fold(0.U(5.W))(_ | _)
+  when(isFirstEnq) {
+    entry.fflags := 0.U
+  }.elsewhen(fflagsRes.orR) {
+    entry.fflags := entry.fflags | fflagsRes
+  }
+
+  val vxsatCanWbSeq = io.vxsatWb.map(wb => wb.valid && wb.bits.robIdx === io.idx)
+  val vxsatRes = vxsatCanWbSeq.zip(io.vxsatWb).map { case (canWb, wb) => Mux(canWb, wb.bits.vxsat, false.B) }.fold(false.B)(_ | _)
+  when(isFirstEnq) {
+    entry.vxsat := 0.U
+  }.elsewhen(vxsatRes) {
+    entry.vxsat := entry.vxsat | vxsatRes
+  }
+
+  // trace
+  val taken = io.branchTaken.map(wb => wb.valid && wb.bits === io.idx).reduce(_ || _)
+  when(entry.valid && Itype.isNonTaken(entry.traceBlockInPipe.itype) && taken) {
+    // BranchType code(notaken itype = 4) must be correctly replaced!
+    entry.traceBlockInPipe.itype := Itype.Taken
+  }
+
+  // interrupt_safe
+  when(enqHit) {
+    entry.interrupt_safe := Mux1H(enqOH, io.allowInterrupt)
+  }
+}
\ No newline at end of file
