+  // that used to sit in loops over RobSize here are in the cell.
+  val robEntryCells = Seq.fill(RobSize)(Module(new RobEntryCell(
+    exuWBs.length, exceptionWBs.length, fflagsWBs.length, vxsatWBs.length, branchWBs.length,
+    io.writebackNums.head.bits.getWidth)))
+  val robEntries = VecInit(robEntryCells.map(_.io.entry))
   // pointers
   // For enqueue ptr, we don't duplicate it since only enqueue needs it.
   val enqPtrVec = Wire(Vec(RenameWidth, new RobPtr))
@@ -202,14 +210,7 @@
