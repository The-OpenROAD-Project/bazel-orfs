-    val enqOH = VecInit(canEnqueue.zip(allocatePtrVec.map(_.value === i.U)).map(x => x._1 && x._2))
-    assert(PopCount(enqOH) < 2.U, s"robEntries$i enqOH is not one hot")
-    when(enqOH.asUInt.orR && !io.redirect.valid){
