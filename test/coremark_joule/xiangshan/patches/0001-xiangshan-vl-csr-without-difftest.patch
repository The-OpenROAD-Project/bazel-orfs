From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Oyvind Harboe <oyvind.harboe@zylin.com>
Date: Tue, 15 Sep 2026 00:00:00 +0000
Subject: [PATCH] backend: the CSR's vl does not need the difftest RAT buffer

csrio.vpu.vl is driven from vecRegion.out.diff.get.diffVl: a read port
on the vl physical register file addressed by the committed vl mapping,
and both the port and the mapping exist only under basicDebugEn. The
mapping comes out of DiffRatStateBuffer, whose eight 704x776 banks --
4.4 Mbit, read combinationally -- exist to align difftest with commit.
So a build with AlwaysBasicDiff = false does not elaborate, and a build
with it carries 4.4 Mbit of verification storage into the core. This is
the `Todo here need change design` comment above the assignment.

The vl path is made unconditional and given a source that does not
need the buffer: the vl rename table already exposes its architectural
mapping (arch_table(0), as debug_vl). diff_vl_rat is Some at every
level; RenameTableWrapper drives it from the buffer when there is one
and from vlRat's architectural copy otherwise. VecRegionModule keeps
the vl read port and its diff in/out bundles unconditionally; every
other difftest structure stays behind AlwaysBasicDiff || EnableDifftest
and disappears with them.

Behaviour with difftest on is unchanged. With it off, vl reads through
the committed mapping directly rather than through the per-commit
snapshot; CoreMark does not touch vl, and the CRC gate and the cycle
count are the check that nothing else moved.

Carried by the bazel-orfs CoreMark/Joule study. Upstream as
OpenXiangShan/XiangShan#6589 (draft, 2026-09-18), branch kunminghu-v3;
retires at a bump onto a XiangShan that carries it.
---
diff --git a/src/main/scala/xiangshan/backend/CtrlBlock.scala b/src/main/scala/xiangshan/backend/CtrlBlock.scala
index 29e3f03..b9d8760 100644
--- a/src/main/scala/xiangshan/backend/CtrlBlock.scala
+++ b/src/main/scala/xiangshan/backend/CtrlBlock.scala
@@ -1058,7 +1058,8 @@ class CtrlBlockIO()(implicit p: Parameters, params: BackendParams) extends XSBun
       val lsdqFull  = Bool()
     }
   })
-  val diff_vl_rat  = if (params.basicDebugEn) Some(Vec(1, Output(UInt(PhyRegIdxWidth.W)))) else None
+  // Committed vl mapping, read by the CSR as well as by difftest.
+  val diff_vl_rat  = Some(Vec(1, Output(UInt(PhyRegIdxWidth.W))))
 
   val sqCanAccept = Input(Bool())
   val lqCanAccept = Input(Bool())
diff --git a/src/main/scala/xiangshan/backend/rename/Rename.scala b/src/main/scala/xiangshan/backend/rename/Rename.scala
index 49e9715..b456165 100644
--- a/src/main/scala/xiangshan/backend/rename/Rename.scala
+++ b/src/main/scala/xiangshan/backend/rename/Rename.scala
@@ -91,7 +91,8 @@ class Rename(implicit p: Parameters) extends XSModule with HasCircularQueuePtrHe
     val diffRatCommitRobIdx = Option.when(backendParams.basicDebugEn)(Input(Valid(new RobPtr)))
     val diffRatCommitRobIdxVec =
       Option.when(backendParams.basicDebugEn)(Input(Vec(CommitWidth, Valid(new RobPtr))))
-    val diff_vl_rat      = Option.when(backendParams.basicDebugEn)(Output(Vec(VlLogicRegs, UInt(PhyRegIdxWidth.W))))
+    // Committed vl mapping, read by the CSR as well as by difftest.
+    val diff_vl_rat      = Some(Output(Vec(VlLogicRegs, UInt(PhyRegIdxWidth.W))))
     val ratSnpt = Input(new SnapshotPort)
     // perf only
     val debugDispatchAllFire = OptionWrapper(backendParams.debugEn, Input(Bool()))
diff --git a/src/main/scala/xiangshan/backend/rename/RenameTable.scala b/src/main/scala/xiangshan/backend/rename/RenameTable.scala
index f103830..af08009 100644
--- a/src/main/scala/xiangshan/backend/rename/RenameTable.scala
+++ b/src/main/scala/xiangshan/backend/rename/RenameTable.scala
@@ -86,10 +86,12 @@ class RenameTable(reg_t: RegType, numDiffWritePorts: Int)(implicit p: Parameters
     val snpt = Input(new SnapshotPort)
     val diffRatBase = if (backendParams.basicDebugEn) Some(Vec(rdataNums, Output(UInt(PhyRegIdxWidth.W)))) else None
     val debug_rdata = if (backendParams.debugEn) Some(Vec(rdataNums, Output(UInt(PhyRegIdxWidth.W)))) else None
-    val debug_vl = if (backendParams.debugEn) reg_t match {
+    // The committed vl mapping. Not debug-only whatever the name says: the
+    // CSR reads vl through it when the difftest RAT buffer is not built.
+    val debug_vl = reg_t match {
       case Reg_Vl => Some(Output(UInt(PhyRegIdxWidth.W)))
       case _ => None
-    } else None
+    }
   })
 
   // speculative rename table
@@ -216,8 +218,8 @@ class RenameTableWrapper(implicit p: Parameters) extends XSModule {
     val debug_vec_rat = Option.when(backendParams.debugEn)(Vec(VecStdLogicRegs, Output(UInt(PhyRegIdxWidth.W))))
     val debug_vl_rat  = Option.when(backendParams.debugEn)(Vec(VlLogicRegs, Output(UInt(PhyRegIdxWidth.W))))
 
-    // for difftest
-    val diff_vl_rat  = Option.when(backendParams.basicDebugEn)(Vec(VlLogicRegs,Output(UInt(PhyRegIdxWidth.W))))
+    // The committed vl mapping, for difftest and for the CSR's vl read.
+    val diff_vl_rat  = Some(Vec(VlLogicRegs,Output(UInt(PhyRegIdxWidth.W))))
   })
 
   val intRat = Module(new RenameTable(Reg_I, 0))
@@ -341,7 +343,10 @@ class RenameTableWrapper(implicit p: Parameters) extends XSModule {
 
   // debug read ports for difftest
   io.debug_vl_rat.foreach(_ := vlRat.io.debug_rdata.get)
-  io.diff_vl_rat.foreach(_ := diffRatBuffer.get.io.diffRat.vlRat)
+  // Without the difftest buffer the committed mapping is the vl rename
+  // table's architectural copy, which is what the CSR needs.
+  io.diff_vl_rat.foreach(_ := diffRatBuffer.map(_.io.diffRat.vlRat).getOrElse(
+    VecInit(Seq.fill(VlLogicRegs)(vlRat.io.debug_vl.get))))
   vlRat.io.readPorts <> io.vlReadPorts
   vlRat.io.redirect := io.redirect
   vlRat.io.snpt := io.snpt
diff --git a/src/main/scala/xiangshan/backend/vector/VecRegionModule.scala b/src/main/scala/xiangshan/backend/vector/VecRegionModule.scala
index aa3a26e..b1f424a 100644
--- a/src/main/scala/xiangshan/backend/vector/VecRegionModule.scala
+++ b/src/main/scala/xiangshan/backend/vector/VecRegionModule.scala
@@ -96,8 +96,10 @@ class VecRegionImp(
