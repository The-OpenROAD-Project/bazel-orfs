+    // One SqForwardPipe per load pipeline; the entries fan out to all.
+    val pipes = Seq.fill(LoadPipelineWidth)(Module(new SqForwardPipe(param)))
+    pipes.zipWithIndex.foreach { case (pipe, i) =>
+      pipe.io.query <> io.query(i)
+      pipe.io.mdpQueryResp <> io.mdpQueryResp(i)
