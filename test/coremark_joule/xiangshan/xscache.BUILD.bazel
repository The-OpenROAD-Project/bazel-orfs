"""XSCache: coupledL2, openLLC and the shared cache utilities.

The L2 is outside the measurement boundary -- the study hardens XSCore,
which is the core with its L1I and L1D -- but XSCore cannot be
elaborated or simulated without an L2 to talk to, so this compiles.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")

package(default_visibility = ["//visibility:public"])

chisel_library(
    name = "xscache",
    srcs = glob(["src/main/scala/**/*.scala"]),
    scalacopts = [
        "-Ymacro-annotations",
        "-Xcheckinit:false",
    ],
    exports = ["@xs_rocket_chip//:rocket_chip"],
    deps = [
        "@xs_maven//:com_github_scopt_scopt_2_13",
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
        "@xs_openncb//:openncb",
        "@xs_rocket_chip//:macros",
        "@xs_rocket_chip//:rocket_chip",
        "@xs_utility//:utility",
    ],
)
