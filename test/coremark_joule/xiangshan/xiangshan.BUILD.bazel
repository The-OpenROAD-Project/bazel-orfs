"""XiangShan itself.

One target, deliberately. XiangShan's Scala has circular references
between its parameter classes and the wrapper classes they name, so a
finer split of src/main/scala deadlocks on a dependency cycle rather
than building faster.

src/main/resources is on the elaborator's path upstream, so it is
carried as resources rather than dropped.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")
load("@rules_scala//scala:scala.bzl", "scala_macro_library")

package(default_visibility = ["//visibility:public"])

scala_macro_library(
    name = "macros",
    srcs = glob(["macros/src/main/scala/**/*.scala"]),
    deps = ["@xs_maven//:org_scala_lang_scala_reflect"],
)

chisel_library(
    name = "xiangshan",
    srcs = glob(["src/main/scala/**/*.scala"]),
    resource_strip_prefix = "src/main/resources",
    resources = glob(["src/main/resources/**"]),
    scalacopts = [
        "-Ymacro-annotations",
        "-Xcheckinit:false",
    ],
    deps = [
        ":macros",
        "@xs_cache//:xscache",
        "@xs_chiselaia//:chiselaia",
        "@xs_chiseliopmp//:chiseliopmp",
        "@xs_difftest//:difftest",
        "@xs_maven//:com_chuusai_shapeless_2_13",
        "@xs_maven//:com_github_scopt_scopt_2_13",
        "@xs_maven//:com_lihaoyi_os_lib_2_13",
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
        "@xs_maven//:io_circe_circe_core_2_13",
        "@xs_maven//:io_circe_circe_generic_2_13",
        "@xs_maven//:io_circe_circe_generic_extras_2_13",
        "@xs_maven//:io_circe_circe_parser_2_13",
        "@xs_maven//:io_circe_circe_yaml_2_13",
        "@xs_maven//:io_circe_circe_yaml_common_2_13",
        "@xs_maven//:org_scalactic_scalactic_2_13",
        "@xs_maven//:org_scalatest_scalatest_compatible",
        "@xs_maven//:org_scalatest_scalatest_core_2_13",
        "@xs_maven//:org_scalatest_scalatest_flatspec_2_13",
        "@xs_maven//:org_scalatest_scalatest_matchers_core_2_13",
        "@xs_maven//:org_scalatest_scalatest_mustmatchers_2_13",
        "@xs_maven//:org_scalatest_scalatest_shouldmatchers_2_13",
        "@xs_maven//:org_typelevel_cats_core_2_13",
        "@xs_openncb//:openncb",
        "@xs_rocket_chip//:macros",
        "@xs_rocket_chip//:rocket_chip",
        "@xs_utility//:utility",
        "@xs_yunsuan//:yunsuan",
    ],
)
