# XiangShan V3 (Kunminghu), rung 10 of the CoreMark-per-Joule study.
#
# The Chisel build lives here; the BUILD overlays for XiangShan and the
# ten repositories its build pulls in as submodules are the
# *.BUILD.bazel files in this package, referenced from MODULE.bazel.
# Nothing is vendored.

load("@rules_chisel//chisel:defs.bzl", "chisel_binary")
load("@rules_chisel//verilog:defs.bzl", "verilog_directory", "verilog_single_file_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

package(default_visibility = ["//test/coremark_joule:__subpackages__"])

# The overlays, and the patch MODULE.bazel applies to the XiangShan archive.
exports_files(glob([
    "*.BUILD.bazel",
    "patches/*.patch",
]))

# The generator. Two entry points against one elaboration path: the
# minimal configuration proves the pipeline in minutes, the study
# configuration is the one that gets measured.
[
    chisel_binary(
        name = "generator" + suffix,
        srcs = [
            "src/CoreMarkJouleSoC.scala",
            "src/XSCoreGenerator.scala",
        ],
        # Upstream's mill build asks for -Xmx40G and -Xss256m. The stack
        # size is not negotiable: diplomacy elaboration recurses deeply.
        # The heap is capped below what this machine has, so an overrun
        # fails rather than swaps.
        jvm_flags = [
            "-Xmx24g",
            "-Xss256m",
        ],
        main_class = "coremark_joule.xiangshan.XSCoreGenerator" + main_suffix,
        resource_strip_prefix = "test/coremark_joule/xiangshan/resources",
        resources = ["resources/gitStatus"],
        # rules_chisel compiles with -Xcheckinit, which XiangShan's own
        # build does not use: it inserts a runtime check on every field
        # read and XiangShan reads fields that are legitimately still
        # being initialized during elaboration. Turned off everywhere the
        # study compiles XiangShan, so the semantics match upstream's.
        scalacopts = ["-Xcheckinit:false"],
        deps = [
            # XSTileKey's parameters name types from XSCache, so the
            # generator compiles against it directly rather than relying
            # on reaching them through xiangshan.
            "@xiangshan",
            "@xs_cache//:xscache",
            "@xs_rocket_chip//:macros",
            "@xs_rocket_chip//:rocket_chip",
            "@xs_utility//:utility",
        ],
    )
    for suffix, main_suffix in [
        ("", ""),
        ("_minimal", "Minimal"),
    ]
]

# The same elaboration with memory and the control device attached. This is
# what simulates; the target above is what the flow hardens XSTile out of.
[
    chisel_binary(
        name = "soc_generator" + suffix,
        srcs = [
            "src/CoreMarkJouleSoC.scala",
            "src/XSCoreGenerator.scala",
        ],
        jvm_flags = [
            "-Xmx24g",
            "-Xss256m",
        ],
        main_class = "coremark_joule.xiangshan.CoreMarkJouleSoCGenerator" + main_suffix,
        resource_strip_prefix = "test/coremark_joule/xiangshan/resources",
        resources = ["resources/gitStatus"],
        scalacopts = ["-Xcheckinit:false"],
        deps = [
            # XSTileKey's parameters name types from XSCache, so the
            # generator compiles against it directly rather than relying
            # on reaching them through xiangshan.
            "@xiangshan",
            "@xs_cache//:xscache",
            "@xs_rocket_chip//:macros",
            "@xs_rocket_chip//:rocket_chip",
            "@xs_utility//:utility",
        ],
    )
    for suffix, main_suffix in [
        ("", ""),
        ("_minimal", "Minimal"),
    ]
]

# Elaboration. This is a genrule rather than rules_chisel's fir_library
# for one reason: Chisel's EspressoMinimizer shells out to an executable
# named `espresso` found on PATH, and XiangShan names that minimizer
# explicitly, so elaboration needs a PATH that fir_library does not offer
# a way to set. Everything else matches what fir_library does -- run the
# generator with -o, with CHISEL_FIRTOOL_PATH pointing at firtool.
[
    genrule(
        name = prefix + "_fir" + suffix,
        outs = [prefix + "_fir" + suffix + ".fir"],
        cmd = " ".join([
            "FIRTOOL_DIR=$$(dirname $$(realpath $(execpath @chisel_firtool//:bin/firtool)));",
            "ESPRESSO_DIR=$$(dirname $$(realpath $(execpath @espresso//:bin/espresso)));",
            "PATH=$$ESPRESSO_DIR:$$FIRTOOL_DIR:$$PATH",
            "CHISEL_FIRTOOL_PATH=$$FIRTOOL_DIR",
            "$(execpath :" + generator + suffix + ")",
            # No --repl-seq-mem. firtool already emits every inferred
            # memory as its own ram_<depth>x<width> module with the
            # R0_addr/en/clk/data ports ORFS's AUTO_MEMORIES converts, and
            # the flag replaces some of those with bodiless _ext
            # blackboxes instead -- which both hides them from the
            # detector and makes the design unsimulatable. Measured on
            # XSCore: 38 convertible memories without it, 20 with.
            #
            # No verification layer. Chisel puts every assertion in a
            # layer that firtool lowers to a `<Module>_Verification_Assert`
            # module bound into its parent with hierarchical references
            # (312 of them in XSCore); slang, which keeps the hierarchy the
            # flow partitions on, refuses a hierarchical reference across a
            # preserved module boundary, and yosys's own frontend only ever
            # dropped them silently. Disabling the layers here, where the
            # FIRRTL still has them, leaves them out of every view -- the
            # simulator's included -- rather than filtering the Verilog
            # afterwards. This is the generator's firtool argument list:
            # emitHWDialect takes the remaining args as firtool options.
            "--default-layer-specialization=disable",
            "-o $@",
        ]),
        tools = [
            ":" + generator + suffix,
            "@chisel_firtool//:bin/firtool",
            "@espresso//:bin/espresso",
        ],
    )
    for prefix, generator in [
        ("xiangshan", "generator"),
        ("cmj_soc", "soc_generator"),
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# Split Verilog: one file per module, which is what makes XSTile
# addressable as a synthesis top without carving it out of a single file.
[
    verilog_directory(
        name = prefix + "_sv" + suffix,
        srcs = [":" + prefix + "_fir" + suffix],
        opts = [
            "--disable-all-randomization",
            "--lowering-options=disallowPackedArrays,disallowLocalVariables,noAlwaysComb",
        ],
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# How big is the thing we are actually hardening? firtool emits one file
# per module, so the answer is available before synthesis: walk the
# instantiations from XSTile and add up what is reachable. Most of what
# gets elaborated is uncore that no flow will ever see.
[
    genrule(
        name = "xstile_closure_" + prefix + suffix,
        srcs = [":" + prefix + "_sv" + suffix],
        outs = ["xstile_closure_" + prefix + suffix + ".json"],
        cmd = "$(execpath //test/coremark_joule/scripts:module_closure) $(location :" +
              prefix + "_sv" + suffix + ") --top XSTile --out $@",
        tools = ["//test/coremark_joule/scripts:module_closure"],
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# The port list of a generated module, as a readable artifact. The SoC
# wrapper has to match XSTop's AXI ports exactly, and those are decided by
# elaboration rather than by anything checked in.
[
    genrule(
        name = module + "_ports",
        srcs = [":xiangshan_sv"],
        outs = [module + "_ports.txt"],
        cmd = "sed -n '/^module " + module + "/,/^  );/p' " +
              "$(location :xiangshan_sv)/" + module + ".sv > $@",
    )
    for module in [
        "XSTop",
        "XSTile",
    ]
]

# One file, for the simulator. rules_verilator wants a verilog_library and
# a verilog_library wants files rather than a directory artifact, so the
# split output is concatenated back. The `include lines go with it: every
# included file is already in the concatenation, so leaving them in makes
# Verilator look for files that are not there.
[
    verilog_single_file_library(
        name = prefix + "_concat" + suffix,
        srcs = [":" + prefix + "_sv" + suffix],
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

[
    genrule(
        name = prefix + "_flat" + suffix,
        srcs = [":" + prefix + "_concat" + suffix],
        outs = [prefix + "_flat" + suffix + ".sv"],
        cmd = "grep -hvF '`include' $(location :" + prefix + "_concat" + suffix + ") > $@ || true",
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

[
    verilog_library(
        name = prefix + suffix,
        srcs = [prefix + "_flat" + suffix + ".sv"],
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# The gate-level XiangShan: XSTile's global-route netlist with the RTL of
# everything it still needs -- the SoC wrapper and bus around it, and the
# behavioural models of what synthesis blackboxed: the five hardened
# blocks and the SRAM macros, whose models are their own RTL modules
# under the same names. scripts/gate_stitch.py walks both closures and
# fails loudly on a name it cannot place, so a block or memory cannot
# silently drop out of the simulation.
_GATE_NETLIST = "//test/coremark_joule/designs/asap7/xiangshan:cmj_xiangshan_grt_netlist.v"

genrule(
    name = "cm_soc_xiangshan_gate_stitch",
    srcs = [
        ":cmj_soc_sv",
        _GATE_NETLIST,
    ],
    outs = [
        "cm_soc_xiangshan_gate.sv",
        "cm_soc_xiangshan_gate_report.json",
    ],
    cmd = "$(execpath //test/coremark_joule/scripts:gate_stitch) " +
          "--netlist $(location " + _GATE_NETLIST + ") " +
          "--rtl-dir $(location :cmj_soc_sv) --top cm_soc --cell-suffix _ASAP7_ " +
          "--out $(location cm_soc_xiangshan_gate.sv) " +
          "--report $(location cm_soc_xiangshan_gate_report.json)",
    tags = ["manual"],
    tools = ["//test/coremark_joule/scripts:gate_stitch"],
)

verilog_library(
    name = "cm_soc_xiangshan_gate",
    srcs = [
        ":cm_soc_xiangshan_gate.sv",
        _GATE_NETLIST,
    ],
    tags = ["manual"],
    deps = ["//test/coremark_joule/rtl:asap7_stdcells"],
)
