# XiangShan V3 (Kunminghu), rung 10 of the CoreMark-per-Joule study.
#
# The Chisel build lives here; the BUILD overlays for XiangShan and the
# ten repositories its build pulls in as submodules are the
# *.BUILD.bazel files in this package, referenced from MODULE.bazel.
# Nothing is vendored.

load("@rules_chisel//chisel:defs.bzl", "chisel_binary")
load("@rules_chisel//verilog:defs.bzl", "verilog_directory")

package(default_visibility = ["//test/coremark_joule:__subpackages__"])

exports_files(glob(["*.BUILD.bazel"]))

# The generator. Two entry points against one elaboration path: the
# minimal configuration proves the pipeline in minutes, the study
# configuration is the one that gets measured.
[
    chisel_binary(
        name = "generator" + suffix,
        srcs = [
            "src/CoreMarkJouleSoC.scala",
            "src/XSCoreGenerator.scala",
        ],
        # Upstream's mill build asks for -Xmx40G and -Xss256m. The stack
        # size is not negotiable: diplomacy elaboration recurses deeply.
        # The heap is capped below what this machine has, so an overrun
        # fails rather than swaps.
        jvm_flags = [
            "-Xmx24g",
            "-Xss256m",
        ],
        main_class = "coremark_joule.xiangshan.XSCoreGenerator" + main_suffix,
        resource_strip_prefix = "test/coremark_joule/xiangshan/resources",
        resources = ["resources/gitStatus"],
        # rules_chisel compiles with -Xcheckinit, which XiangShan's own
        # build does not use: it inserts a runtime check on every field
        # read and XiangShan reads fields that are legitimately still
        # being initialized during elaboration. Turned off everywhere the
        # study compiles XiangShan, so the semantics match upstream's.
        scalacopts = ["-Xcheckinit:false"],
        deps = [
            "@xiangshan",
            "@xs_rocket_chip//:macros",
            "@xs_rocket_chip//:rocket_chip",
            "@xs_utility//:utility",
        ],
    )
    for suffix, main_suffix in [
        ("", ""),
        ("_minimal", "Minimal"),
    ]
]

# The same elaboration with memory and the control device attached. This is
# what simulates; the target above is what the flow hardens XSCore out of.
[
    chisel_binary(
        name = "soc_generator" + suffix,
        srcs = [
            "src/CoreMarkJouleSoC.scala",
            "src/XSCoreGenerator.scala",
        ],
        jvm_flags = [
            "-Xmx24g",
            "-Xss256m",
        ],
        main_class = "coremark_joule.xiangshan.CoreMarkJouleSoCGenerator" + main_suffix,
        resource_strip_prefix = "test/coremark_joule/xiangshan/resources",
        resources = ["resources/gitStatus"],
        scalacopts = ["-Xcheckinit:false"],
        deps = [
            "@xiangshan",
            "@xs_rocket_chip//:macros",
            "@xs_rocket_chip//:rocket_chip",
            "@xs_utility//:utility",
        ],
    )
    for suffix, main_suffix in [
        ("", ""),
        ("_minimal", "Minimal"),
    ]
]

# Elaboration. This is a genrule rather than rules_chisel's fir_library
# for one reason: Chisel's EspressoMinimizer shells out to an executable
# named `espresso` found on PATH, and XiangShan names that minimizer
# explicitly, so elaboration needs a PATH that fir_library does not offer
# a way to set. Everything else matches what fir_library does -- run the
# generator with -o, with CHISEL_FIRTOOL_PATH pointing at firtool.
[
    genrule(
        name = prefix + "_fir" + suffix,
        outs = [prefix + "_fir" + suffix + ".fir"],
        cmd = " ".join([
            "FIRTOOL_DIR=$$(dirname $$(realpath $(execpath @chisel_firtool//:bin/firtool)));",
            "ESPRESSO_DIR=$$(dirname $$(realpath $(execpath @espresso//:bin/espresso)));",
            "PATH=$$ESPRESSO_DIR:$$FIRTOOL_DIR:$$PATH",
            "CHISEL_FIRTOOL_PATH=$$FIRTOOL_DIR",
            "$(execpath :" + generator + suffix + ")",
            # Extract every inferred memory into its own module. Without
            # this firtool inlines them as reg arrays inside whatever
            # module used them, ORFS's AUTO_MEMORIES detector finds no
            # module to convert, and a core whose caches are most of its
            # area synthesises as flip-flops.
            "--repl-seq-mem",
            "--repl-seq-mem-file=$(RULEDIR)/" + prefix + suffix + ".mems.conf",
            "-o $@",
        ]),
        tools = [
            ":" + generator + suffix,
            "@chisel_firtool//:bin/firtool",
            "@espresso//:bin/espresso",
        ],
    )
    for prefix, generator in [
        ("xiangshan", "generator"),
        ("cmj_soc", "soc_generator"),
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# Split Verilog: one file per module, which is what makes XSCore
# addressable as a synthesis top without carving it out of a single file.
[
    verilog_directory(
        name = prefix + "_sv" + suffix,
        srcs = [":" + prefix + "_fir" + suffix],
        opts = [
            "--disable-all-randomization",
            "--lowering-options=disallowPackedArrays,disallowLocalVariables,noAlwaysComb",
        ],
    )
    for prefix in [
        "xiangshan",
        "cmj_soc",
    ]
    for suffix in [
        "",
        "_minimal",
    ]
]

# How big is the thing we are actually hardening? firtool emits one file
# per module, so the answer is available before synthesis: walk the
# instantiations from XSCore and add up what is reachable. Most of what
# gets elaborated is uncore that no flow will ever see.
[
    genrule(
        name = "xscore_closure" + suffix,
        srcs = [":xiangshan_sv" + suffix],
        outs = ["xscore_closure" + suffix + ".json"],
        cmd = "$(execpath //test/coremark_joule/scripts:module_closure) $(location :xiangshan_sv" +
              suffix + ") --top XSCore --out $@",
        tools = ["//test/coremark_joule/scripts:module_closure"],
    )
    for suffix in [
        "",
        "_minimal",
    ]
]

# The port list of a generated module, as a readable artifact. The SoC
# wrapper has to match XSTop's AXI ports exactly, and those are decided by
# elaboration rather than by anything checked in.
[
    genrule(
        name = module + "_ports",
        srcs = [":xiangshan_sv"],
        outs = [module + "_ports.txt"],
        cmd = "sed -n '/^module " + module + "/,/^  );/p' " +
              "$(location :xiangshan_sv)/" + module + ".sv > $@",
    )
    for module in [
        "XSTop",
        "XSCore",
    ]
]
