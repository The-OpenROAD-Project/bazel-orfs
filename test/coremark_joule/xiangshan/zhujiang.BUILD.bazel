"""ZhuJiang, XSCache's NoC, with the xs-utils it carries in its own tree.

XiangShan's build.mill compiles the two as one module, zhujiangCompat;
this does the same. ZhuJiang's own rocket-chip copy is not used: the
study's rocket-chip is the one XiangShan pins.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")

package(default_visibility = ["//visibility:public"])

chisel_library(
    name = "zhujiang",
    srcs = glob([
        "src/main/scala/**/*.scala",
        "xs-utils/src/main/scala/**/*.scala",
    ]),
    scalacopts = [
        "-Ymacro-annotations",
        "-Xcheckinit:false",
    ],
    exports = ["@xs_rocket_chip//:rocket_chip"],
    deps = [
        "@xs_difftest//:difftest",
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
        "@xs_rocket_chip//:macros",
        "@xs_rocket_chip//:rocket_chip",
        "@xs_utility//:utility",
    ],
)
