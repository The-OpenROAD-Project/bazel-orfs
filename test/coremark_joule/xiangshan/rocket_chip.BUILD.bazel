"""rocket-chip, XiangShan's fork.

hardfloat and cde are submodules of rocket-chip that a source tarball
does not carry, so they arrive as their own archives and are deps here
rather than globs.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")
load("@rules_scala//scala:scala.bzl", "scala_macro_library")

package(default_visibility = ["//visibility:public"])

scala_macro_library(
    name = "macros",
    srcs = glob(["macros/src/main/scala/**/*.scala"]),
    deps = ["@xs_maven//:org_scala_lang_scala_reflect"],
)

chisel_library(
    name = "rocket_chip",
    # diplomacy/Main.scala is a command-line entry point for emitting
    # diplomacy graphs. Nothing elaborates through it, and it is the only
    # file that pulls in os-lib, mainargs and scala-collection-compat.
    srcs = glob(
        ["src/main/scala/**/*.scala"],
        exclude = ["src/main/scala/diplomacy/Main.scala"],
    ),
    scalacopts = [
        "-Ymacro-annotations",
        "-Xcheckinit:false",
    ],
    exports = [
        ":macros",
        "@xs_cde//:cde",
        "@xs_hardfloat//:hardfloat",
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
    ],
    deps = [
        ":macros",
        "@xs_cde//:cde",
        "@xs_hardfloat//:hardfloat",
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
        "@xs_maven//:org_json4s_json4s_ast_2_13",
        "@xs_maven//:org_json4s_json4s_core_2_13",
        "@xs_maven//:org_json4s_json4s_jackson_2_13",
        "@xs_maven//:org_json4s_json4s_jackson_core_2_13",
    ],
)
