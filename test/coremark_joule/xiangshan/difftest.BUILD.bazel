"""difftest: XiangShan's co-simulation harness.

The study does not use it -- correctness is CoreMark's own CRCs, read
from stdout -- but xiangshan's Scala imports it, so it has to compile.
"""

load("@rules_chisel//chisel:defs.bzl", "chisel_library")

package(default_visibility = ["//visibility:public"])

chisel_library(
    name = "difftest",
    srcs = glob(["src/main/scala/**/*.scala"]),
    scalacopts = ["-Ymacro-annotations"],
    deps = [
        "@xs_maven//:com_lihaoyi_sourcecode_2_13",
        "@xs_maven//:org_json4s_json4s_ast_2_13",
        "@xs_maven//:org_json4s_json4s_core_2_13",
        "@xs_maven//:org_json4s_json4s_jackson_2_13",
        "@xs_maven//:org_json4s_json4s_jackson_core_2_13",
        "@xs_maven//:org_json4s_json4s_native_2_13",
        "@xs_maven//:org_json4s_json4s_native_core_2_13",
    ],
)
