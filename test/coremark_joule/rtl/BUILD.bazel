# The simulation wrappers: RAM, the sim-control device, and one bus
# adapter per core. Only the core instance inside is ever hardened.
#
# Every wrapper declares its top module as `cm_soc`, so one harness
# source (//test/coremark_joule/sim:main.cc) serves all three cores and
# the file name is what selects which one is built.
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

package(default_visibility = ["//test/coremark_joule:__subpackages__"])

exports_files([
    "cmj_ibex.sv",
    "cmj_picorv32.v",
    "cmj_serv.v",
    "ibex.BUILD.bazel",
    "picorv32.BUILD.bazel",
    "serv.BUILD.bazel",
])

verilog_library(
    name = "picorv32",
    srcs = ["@picorv32//:rtl"],
)

# The frozen core configuration, shared by the simulator and the flow so
# the measured design and the hardened design cannot diverge.
verilog_library(
    name = "cmj_picorv32",
    srcs = ["cmj_picorv32.v"],
    deps = [":picorv32"],
)

verilog_library(
    name = "cm_soc_picorv32",
    srcs = ["cm_soc_picorv32.v"],
    deps = [":cmj_picorv32"],
)

verilog_library(
    name = "serv",
    srcs = ["@serv//:rtl"],
)

verilog_library(
    name = "cmj_serv",
    srcs = ["cmj_serv.v"],
    deps = [":serv"],
)

verilog_library(
    name = "cm_soc_serv",
    srcs = ["cm_soc_serv.v"],
    deps = [":cmj_serv"],
)

verilog_library(
    name = "ibex_pkgs",
    srcs = ["@ibex//:pkgs"],
    hdrs = ["@ibex//:hdrs"],
    includes = [
        "vendor/lowrisc_ip/dv/sv/dv_utils",
        "vendor/lowrisc_ip/ip/prim/rtl",
    ],
)

verilog_library(
    name = "ibex",
    srcs = ["@ibex//:rtl"],
    hdrs = ["@ibex//:hdrs"],
    # prim_assert.sv and dv_fcov_macros.svh are `include`d by name from
    # ibex sources, so the directories holding them go on the include
    # path.
    includes = [
        "vendor/lowrisc_ip/dv/sv/dv_utils",
        "vendor/lowrisc_ip/ip/prim/rtl",
    ],
    deps = [":ibex_pkgs"],
)

verilog_library(
    name = "cmj_ibex",
    srcs = ["cmj_ibex.sv"],
    deps = [":ibex"],
)

verilog_library(
    name = "cm_soc_ibex",
    srcs = ["cm_soc_ibex.sv"],
    deps = [":cmj_ibex"],
)
