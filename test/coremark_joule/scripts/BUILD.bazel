# Parsers and checks for the study.
#
# Each one is a py_binary so a genrule can execute it, and each has a
# unit test: a study's arithmetic is worth no more than the parser
# underneath it, and these parse output formats that upstream projects
# are free to change.
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//test/coremark_joule:__subpackages__"])

exports_files([
    "check_coremark.py",
    "elf_sections.py",
    "iteration_delta_test.py",
    "run_check.sh",
])

py_binary(
    name = "elf2hex",
    srcs = ["elf2hex.py"],
    main = "elf2hex.py",
)

py_binary(
    name = "check_coremark",
    srcs = ["check_coremark.py"],
    main = "check_coremark.py",
)

py_binary(
    name = "cm_per_mhz",
    srcs = ["cm_per_mhz.py"],
    main = "cm_per_mhz.py",
)

# Unit tests for the parsers. Not manual: seconds of work, and each one
# reads a format an upstream project is free to change -- a silent parse
# failure would not look like a failure, it would look like a
# measurement.
py_test(
    name = "parsers_test",
    size = "small",
    srcs = [
        "check_coremark.py",
        "cm_per_mhz.py",
        "elf2hex.py",
        "parsers_test.py",
    ],
    main = "parsers_test.py",
)
