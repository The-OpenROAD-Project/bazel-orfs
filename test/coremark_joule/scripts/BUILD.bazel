)

py_binary(
    name = "section_links",
    srcs = ["section_links.py"],
    main = "section_links.py",
)

# write_verilog can emit two instances under one name. Zero renames is
# the assertion; a design that needs one says so and says why.
py_binary(
    name = "uniquify_netlist",
    srcs = ["uniquify_netlist.py"],
    main = "uniquify_netlist.py",
)

py_test(
    name = "uniquify_netlist_test",
    size = "small",
    srcs = [
        "uniquify_netlist.py",
        "uniquify_netlist_test.py",
    ],
    main = "uniquify_netlist_test.py",
)

# A SAIF cannot carry a net name containing the hierarchy separator.
# Dropping those entries turns read_saif's total failure into a bounded,
# classified loss -- and the budget on non-clock nets is what keeps it
# bounded.
py_binary(
    name = "filter_saif",
    srcs = ["filter_saif.py"],
    main = "filter_saif.py",
)

py_test(
    name = "filter_saif_test",
    size = "small",
    srcs = [
        "filter_saif.py",
        "filter_saif_test.py",
    ],
    main = "filter_saif_test.py",
)

# The period a core actually closes at, derived rather than guessed.
# The loop drives bazel and rewrites the design's constraints.sdc, so it
# is a `bazel run` job and never part of a build; only its decision
# logic is tested here, over fixtures, which is the part that can be
# wrong in a way a human would not notice.
py_binary(
    name = "auto_period",
    srcs = ["auto_period.py"],
    visibility = ["//test/coremark_joule:__subpackages__"],
)

py_test(
    name = "auto_period_test",
    size = "small",
    srcs = [
        "auto_period.py",
        "auto_period_test.py",
    ],
    main = "auto_period_test.py",
)

# The paper's fitted figures, from the pinned results. 4.6's slope, R^2
