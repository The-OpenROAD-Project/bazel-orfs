    main = "bus_probe_test.py",
)

# The constraint model of §3.8, checked rather than commented. Not
# manual: it is milliseconds, and what it guards -- an SDC that says
# nothing and so inherits an 80 ps IO budget -- is silent in every
# report downstream of it.
py_test(
    name = "check_sdc_test",
    size = "small",
    srcs = [
        "check_sdc.py",
        "check_sdc_test.py",
    ],
    main = "check_sdc_test.py",
)

py_binary(
    name = "check_sdc",
    srcs = ["check_sdc.py"],
    main = "check_sdc.py",
)

# The README quotes results.json, and nothing it quotes may disagree.
# Not manual: milliseconds, and what it guards -- three drafts' numbers
# coexisting in the prose -- is silent everywhere else.
py_test(
    name = "readme_numbers_test",
    size = "small",
    srcs = [
        "readme_numbers.py",
        "readme_numbers_test.py",
    ],
    data = [
        "//test/coremark_joule:README.md",
        "//test/coremark_joule:results.json",
        "//test/coremark_joule/results:commodity_coremark.csv",
    ],
    main = "readme_numbers_test.py",
)

py_binary(
    name = "readme_numbers",
    srcs = ["readme_numbers.py"],
    data = ["//test/coremark_joule/results:commodity_coremark.csv"],
    main = "readme_numbers.py",
)

