# The study's pinned results.
#
# Measurements are minutes per core; presentation is not. Pinning the
# numbers into a committed file means iterating on a plot never re-runs a
# flow, and a number that changes shows up as a line in a pull request.
load("@rules_python//python:defs.bzl", "py_binary")
load("//test/coremark_joule/flow:seeds.bzl", "SEEDS")

package(default_visibility = ["//test/coremark_joule:__subpackages__"])

exports_files([
    "README.md",
    "results.json",
])

py_binary(
    name = "pin",
    srcs = ["//test/coremark_joule/scripts:pin_results.py"],
    args = [
        "$(location //test/coremark_joule/sim:point_picorv32_rv32im)",
        "$(location //test/coremark_joule/sim:point_serv_rv32i)",
        "$(location //test/coremark_joule/sim:point_ibex_rv32imc)",
        "$(location //test/coremark_joule/sim:point_veer_rv32imc)",
    ] + [
        # §5.13: the other four placement draws of every core, as samples
        # beside its point.
        "--sample $(location //test/coremark_joule/sim:point_{}_seed{})".format(p, seed)
        for p in [
            "picorv32_rv32im",
            "serv_rv32i",
            "ibex_rv32imc",
            "veer_rv32imc",
        ]
        for seed in SEEDS
        # The physical side of each point, from the same grt ODB (§4.9).
        "--physical",
        "picorv32:$(location //test/coremark_joule/designs/asap7/picorv32:cmj_picorv32_physical)",
        "--physical",
        "serv:$(location //test/coremark_joule/designs/asap7/serv:cmj_serv_physical)",
        "--physical",
        "ibex:$(location //test/coremark_joule/designs/asap7/ibex:cmj_ibex_physical)",
        "--physical",
        "veer:$(location //test/coremark_joule/designs/asap7/veer:swerv_wrapper_physical)",
    ],
    data = [
        "//test/coremark_joule/designs/asap7/ibex:cmj_ibex_physical",
        "//test/coremark_joule/designs/asap7/picorv32:cmj_picorv32_physical",
        "//test/coremark_joule/designs/asap7/serv:cmj_serv_physical",
        "//test/coremark_joule/designs/asap7/veer:swerv_wrapper_physical",
        "//test/coremark_joule/sim:point_ibex_rv32imc",
        "//test/coremark_joule/sim:point_picorv32_rv32im",
        "//test/coremark_joule/sim:point_serv_rv32i",
        "//test/coremark_joule/sim:point_veer_rv32imc",
    ] + [
        "//test/coremark_joule/sim:point_{}_seed{}".format(p, seed)
        for p in [
            "picorv32_rv32im",
            "serv_rv32i",
            "ibex_rv32imc",
            "veer_rv32imc",
        ]
        for seed in SEEDS
    ],
    main = "//test/coremark_joule/scripts:pin_results.py",
    tags = ["manual"],
)

# The plot, from the pinned results alone -- no flow in the loop.
genrule(
    name = "plot",
    srcs = [
        "results.json",
        "silicon.json",
    ],
    outs = ["coremark_joule.png"],
    cmd = "$(execpath //test/coremark_joule/scripts:plot_results) " +
          "$(location results.json) --out $@ " +
          "--silicon $(location silicon.json)",
    tags = ["manual"],
    tools = ["//test/coremark_joule/scripts:plot_results"],
)
