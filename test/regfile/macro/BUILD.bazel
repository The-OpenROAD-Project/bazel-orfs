load("@bazel-orfs//:openroad.bzl", "orfs_flow", "orfs_headroom", "orfs_run")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_python//python:defs.bzl", "py_test")

# A register file kept as a macro is a flow of its own, whose abstract the
# parent reads: the flow builds the register file's clock tree before the
# abstract is written, so the macro's clock pin is a buffer's and its
# model carries the tree (check_macro_lib.py). mode macro, which wrote the
# model from generate_ram's netlist unclocked, presented this register
# file's whole clock net as one 8.5 pF pin; it now stops (ORFS patch 0125).
#
# A wide register file, the shape that exposed it on XiangShan
# (FtqMetaQueueResolve, 954 bits): 64 words of 256 bits, one read and one
# write, a hold mux per bit.
SPEC = """\
module RegFile
words 64
bits 256
clock clock
read r0_addr r0_data
write w0_addr w0_data w0_en
cell flop DFFHQNx1_ASAP7_75t_R
cell and2 AND2x2_ASAP7_75t_R
cell or2 OR2x2_ASAP7_75t_R
cell ao22 AO22x2_ASAP7_75t_R
cell inv INVx1_ASAP7_75t_R
cell tap TAPCELL_ASAP7_75t_R
pin_layer M4
tap_columns 8
service_sites 40
bit_folds 4
"""

write_file(
    name = "wide_spec",
    out = "RegFile.regfile",
    content = [SPEC],
    tags = ["manual"],
)

genrule(
    name = "wide_rtl",
    srcs = [":RegFile.regfile"],
    outs = ["wide_top.sv"],
    cmd = "$(execpath //test/structured_netlist:scaffold_gen) --spec $< --sv $@ --top wide_top",
    tags = ["manual"],
    tools = ["//test/structured_netlist:scaffold_gen"],
)

# The register file as a macro of its own: its module is a flow's top,
# generate_ram's netlist inlined in the module's place (not macro-placed:
# a top whose only flops sit in a macro has no registers at synthesis,
# and the platform SDC's groups and boundary limits need them), and the
# flow builds its clock tree before the abstract (at grt) is written.
orfs_flow(
    name = "RegFile",
    abstract_stage = "grt",
    arguments = {
        "AUTO_MEMORIES": "1",
        "CORE_UTILIZATION": "40",
        # generate_ram's layout is kept (ORFS patch 0162): global placement
        # moves the few hundred cells synthesis added among 66k fixed ones,
        # where timing- and routability-driven placement diverge (GPL-0305)
        "GPL_ROUTABILITY_DRIVEN": "0",
        "GPL_TIMING_DRIVEN": "0",
        "PLACE_DENSITY": "0.6",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    sources = {
        "AUTO_MEMORIES_REGFILES": [":RegFile.regfile"],
        # the one-flop-loop floor, reported at the end of grt: its storage
        # flops hold through a mux back to themselves
        "POST_GLOBAL_ROUTE_TCL": ["//tools/headroom:report_floor_cycles.tcl"],
        # a block's grid, so the parent's macro grid connects to it
        "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCK_grid_strategy.tcl"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    tags = ["manual"],
    verilog_files = [":wide_top.sv"],
)

# The parent, with the register file as that macro.
orfs_flow(
    name = "wide_top_hard",
    arguments = {
        # room for the macro grid's core rings
        "CORE_MARGIN": "4",
        "CORE_UTILIZATION": "30",
        "PLACE_DENSITY": "0.5",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    last_stage = "cts",
    macros = [":RegFile_generate_abstract"],
    sources = {
        "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCKS_grid_strategy.tcl"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    tags = ["manual"],
    top = "wide_top",
    verilog_files = [":wide_top.sv"],
)

# the abstract's files (the abstract target itself is executable)
filegroup(
    name = "RegFile_abstract",
    srcs = [":RegFile_generate_abstract"],
    tags = ["manual"],
)

py_test(
    name = "check_macro_lib_test",
    size = "small",
    srcs = ["check_macro_lib.py"],
    args = ["$(rootpaths :RegFile_abstract)"],
    data = [":RegFile_abstract"],
    main = "check_macro_lib.py",
    tags = ["manual"],
)

# Repair headroom across a parent and a hardened block (orfs_headroom,
# .claude/skills/repair-headroom): wide_top through global route with the
# RegFile at its own grt, stitched in OpenSTA. The test checks what the
# measurements promise, not their values: every what-if is undone (the
# period measured again equals the start), no floor or ceiling is above
# the period, skew keeps hold, the RegFile's flops count as the block's.
orfs_flow(
    name = "wide_top_grt_hr",
    arguments = {
        "CORE_MARGIN": "4",
        "CORE_UTILIZATION": "30",
        "PLACE_DENSITY": "0.5",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    last_stage = "grt",
    macros = [":RegFile_generate_abstract"],
    sources = {
        "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCKS_grid_strategy.tcl"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    tags = ["manual"],
    top = "wide_top",
    verilog_files = [":wide_top.sv"],
)

# scoped to the 200 worst endpoints: every endpoint (16,896) took 206 s,
# and what is checked does not depend on the scope; a 1 ps target, which
# every reg2reg endpoint is over, so the mass is counted at each
orfs_headroom(
    name = "wide_top_headroom",
    blocks = {"RegFile": ":RegFile_grt"},
    ends = 200,
    parent = "wide_top",
    parent_stage = ":wide_top_grt_hr_grt",
    target = 1,
)

py_test(
    name = "headroom_test",
    size = "small",
    srcs = ["headroom_test.py"],
    args = [
        "$(rootpath :wide_top_headroom)",
        "$(rootpath :wide_top_headroom_nowire)",
    ],
    data = [
        ":wide_top_headroom",
        ":wide_top_headroom_nowire",
    ],
)

# The one-flop-loop floor reported at the end of the RegFile's global route
# (tools/headroom/report_floor_cycles.tcl as POST_GLOBAL_ROUTE_TCL): the
# log names the register, and the metric is a period no larger than the
# stage's own minimum period, since a loop is one of its paths.
filegroup(
    name = "RegFile_grt_logs",
    srcs = [":RegFile_grt"],
    output_group = "logs",
    tags = ["manual"],
)

filegroup(
    name = "RegFile_grt_jsons",
    srcs = [":RegFile_grt"],
    output_group = "jsons",
    tags = ["manual"],
)

py_test(
    name = "floor_cycles_test",
    size = "small",
    srcs = ["floor_cycles_test.py"],
    args = [
        "$(rootpaths :RegFile_grt_logs)",
        "$(rootpaths :RegFile_grt_jsons)",
    ],
    data = [
        ":RegFile_grt_jsons",
        ":RegFile_grt_logs",
    ],
)

# A macro pin plan, two passes in one graph (//tools/pin_plan): wide_top's
# placement with the register file as built tells the register file where
# its pins belong, on the sides that face their logic; the register file is
# built again with them, and the parent placed again with the macro where
# the plan was made. pin_plan_test checks that fewer pins face away from
# their logic. Manual: two register-file flows and two parents.
orfs_run(
    name = "wide_top_pin_plan",
    src = ":wide_top_hard_place",
    outs = [
        "RegFile_pins.tcl",
        "wide_top_macros.tcl",
        "wide_top_pins_before.txt",
    ],
    script = "//tools/pin_plan:pin_plan.tcl",
    tags = ["manual"],
    user_arguments = {
        "PINS_OUT": "RegFile $(location RegFile_pins.tcl) 0 0",
        "PIN_PLAN_PLACEMENT": "$(location wide_top_macros.tcl)",
        "PIN_PLAN_REPORT": "$(location wide_top_pins_before.txt)",
        "PIN_PLAN_STAGE": "3_place",
    },
)

# buildifier: disable=duplicated-name
orfs_flow(
    name = "RegFile",
    abstract_stage = "grt",
    arguments = {
        "AUTO_MEMORIES": "1",
        "CORE_UTILIZATION": "40",
        "PLACE_DENSITY": "0.6",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    # a pin plan changes nothing synthesis reads; only a flow without
    # macros can share it: a later stage takes its macros from its src,
    # synthesis, and would place the base flow's
    previous_stage = {"floorplan": ":RegFile_synth"},
    sources = {
        "AUTO_MEMORIES_REGFILES": [":RegFile.regfile"],
        "IO_CONSTRAINTS": [":RegFile_pins.tcl"],
        "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCK_grid_strategy.tcl"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    tags = ["manual"],
    variant = "pinplan",
    verilog_files = [":wide_top.sv"],
)

# buildifier: disable=duplicated-name
orfs_flow(
    name = "wide_top_hard",
    arguments = {
        "CORE_MARGIN": "4",
        "CORE_UTILIZATION": "30",
        "PLACE_DENSITY": "0.5",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    last_stage = "place",
    macros = [":RegFile_pinplan_generate_abstract"],
    sources = {
        "MACRO_PLACEMENT_TCL": [":wide_top_macros.tcl"],
        "PDN_TCL": ["//flow:platforms/asap7/openRoad/pdn/BLOCKS_grid_strategy.tcl"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    tags = ["manual"],
    top = "wide_top",
    variant = "pinplan",
    verilog_files = [":wide_top.sv"],
)

# The same plan from wide_top through global route (wide_top_grt_hr, the
# same settings as wide_top_hard), side by side with the plan from its
# placement: does a plan need the route, or does the placement say it?
orfs_run(
    name = "wide_top_pin_plan_grt",
    src = ":wide_top_grt_hr_grt",
    outs = [
        "grt/RegFile_pins.tcl",
        "grt/wide_top_macros.tcl",
        "grt/wide_top_pins_before.txt",
    ],
    script = "//tools/pin_plan:pin_plan.tcl",
    tags = ["manual"],
    user_arguments = {
        "PINS_OUT": "RegFile $(location grt/RegFile_pins.tcl) 0 0",
        "PIN_PLAN_PLACEMENT": "$(location grt/wide_top_macros.tcl)",
        "PIN_PLAN_REPORT": "$(location grt/wide_top_pins_before.txt)",
        "PIN_PLAN_STAGE": "5_1_grt",
    },
)

genrule(
    name = "wide_top_pin_plan_diff",
    srcs = [
        "wide_top_pins_before.txt",
        "grt/wide_top_pins_before.txt",
        "wide_top_macros.tcl",
        "grt/wide_top_macros.tcl",
        "RegFile_pins.tcl",
        "grt/RegFile_pins.tcl",
    ],
    outs = ["wide_top_pin_plan_diff.txt"],
    cmd = "$(execpath //tools/pin_plan:pin_plan_diff) $@ place grt $(SRCS)",
    tags = ["manual"],
    tools = ["//tools/pin_plan:pin_plan_diff"],
)

orfs_run(
    name = "wide_top_pins_after",
    src = ":wide_top_hard_pinplan_place",
    outs = ["wide_top_pins_after.txt"],
    script = "//tools/pin_plan:pin_plan.tcl",
    tags = ["manual"],
    user_arguments = {
        "PINS_OUT": "",
        "PIN_PLAN_REPORT": "$(location wide_top_pins_after.txt)",
        "PIN_PLAN_STAGE": "3_place",
    },
)

py_test(
    name = "pin_plan_test",
    size = "small",
    srcs = ["pin_plan_test.py"],
    args = [
        "$(rootpath :wide_top_pins_before.txt)",
        "$(rootpath :wide_top_pins_after.txt)",
    ],
    data = [
        ":wide_top_pins_after.txt",
        ":wide_top_pins_before.txt",
    ],
    main = "pin_plan_test.py",
    tags = ["manual"],
)
