load("@orfs_designs//:designs.bzl", "DESIGNS")

# The register-file ladder: ORFS asap7 designs with a register file,
# smallest first, each against its -regfile variant (carried ORFS
# patches) at global route. A row passes when the register file's
# minimum period is at most 3 % above the flip-flops'; area, power, hold
# and wall time are recorded. Rows are manual: each builds two flows.
#
# Before a variant is flowed, its spec's generated netlist is simulated
# beside the RTL it replaces (regfile_sim_test).
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("//tools/lib_to_verilog:lib_to_verilog.bzl", "stdcell_verilog")
load(":ladder.bzl", "ladder_row", "ladder_tools")
load(":sim.bzl", "regfile_sim_test", "surgery_cmp_test")

package(default_visibility = ["//visibility:private"])

ladder_tools()

py_binary(
    name = "gen_tb",
    srcs = ["gen_tb.py"],
    main = "gen_tb.py",
)

py_binary(
    name = "gen_cmp_tb",
    srcs = ["gen_cmp_tb.py"],
    main = "gen_cmp_tb.py",
)

stdcell_verilog(
    name = "asap7_stdcell",
    lefs = ["@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef"],
    libs = [
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz",
    ],
)

# Rung 1: riscv32i, a module spec, against src/riscv32i/regfile.v.
regfile_sim_test(
    name = "riscv32i_sim_test",
    module = "regfile",
    rtl = ["@orfs//flow/designs/src/riscv32i:regfile.v"],
    rtl_module = "regfile",
    spec = "@orfs//flow/designs/asap7/riscv32i-regfile:regfile.regfile",
)

ladder_row(
    name = "riscv32i",
    design = "riscv32i",
    top = "riscv_top",
)

# Rung 2: picorv32, a seam spec, against the memory it replaces.
regfile_sim_test(
    name = "picorv32_sim_test",
    module = "picorv32_rf",
    spec = "@orfs//flow/designs/asap7/picorv32-regfile:cpuregs.regfile",
)

ladder_row(
    name = "picorv32",
    design = "picorv32",
    top = "picorv32",
)

# picorv32's period difference against its placement-seed noise band:
# both arms at GPL_RANDOM_SEED 2 and 3 (ORFS patch 0100).
[
    ladder_row(
        name = "picorv32_seed%d" % seed,
        design = "picorv32-seed%d" % seed,
        regfile_design = "picorv32-regfile-seed%d" % seed,
        top = "picorv32",
    )
    for seed in [
        2,
        3,
    ]
]

# Rung 3: ibex, a module spec with an asynchronous reset, against
# ibex_register_file_ff.sv.
regfile_sim_test(
    name = "ibex_sim_test",
    module = "ibex_register_file_ff",
    rtl = ["@orfs//flow/designs/src/ibex_sv:ibex_register_file_ff.sv"],
    rtl_module = "ibex_register_file_ff",
    spec = "@orfs//flow/designs/asap7/ibex-regfile:ibex_register_file_ff.regfile",
)

# The negative control: ibex's spec with the reset dropped (`reset`, a
# port the array ignores, for `async_reset`). The harness must see it.
genrule(
    name = "ibex_no_reset_regfile",
    srcs = ["@orfs//flow/designs/asap7/ibex-regfile:ibex_register_file_ff.regfile"],
    outs = ["ibex_no_reset.regfile"],
    cmd = "sed 's/^async_reset rst_ni low$$/reset rst_ni/' $< > $@ && grep -q '^reset rst_ni$$' $@",
)

regfile_sim_test(
    name = "ibex_no_reset_sim_test",
    expect_mismatch = True,
    module = "ibex_register_file_ff",
    rtl = ["@orfs//flow/designs/src/ibex_sv:ibex_register_file_ff.sv"],
    rtl_module = "ibex_register_file_ff",
    spec = ":ibex_no_reset.regfile",
)

ladder_row(
    name = "ibex",
    design = "ibex",
    top = "ibex_core",
)

# Rung 4: tinyRocket, a seam spec, against the memory it replaces.
regfile_sim_test(
    name = "tinyRocket_sim_test",
    module = "rocket_rf",
    spec = "@orfs//flow/designs/asap7/tinyRocket-regfile:rocket_rf.regfile",
)

ladder_row(
    name = "tinyRocket",
    design = "tinyRocket",
    top = "RocketTile",
)

# Rung 5: swerv_wrapper. A SYNTH_VERILOG_SURGERY script moves the array of
# dec_gpr_ctl into dec_gpr_ctl_rf; the spec replaces that. Both arms
# through yosys (swerv_wrapper itself synthesises with SYNTH_USE_SYN).
py_binary(
    name = "swerv_surgery",
    srcs = ["@orfs//flow/designs/asap7/swerv_wrapper-regfile:surgery.py"],
    main = "@orfs//flow/designs/asap7/swerv_wrapper-regfile:surgery.py",
)

SWERV_SRCS = [
    "@orfs//flow/designs/src/swerv:swerv_wrapper.sv2v.v",
    "@orfs//flow/designs/asap7/swerv_wrapper:macros.v",
    # CLKGATE_MAP_FILE: macros.v's clockhdr instantiates OPENROAD_CLKGATE
    "@orfs//flow:platforms/asap7/yoSys/cells_clkgate_R.v",
]

# The spec against the behavioural memory it describes.
regfile_sim_test(
    name = "swerv_sim_test",
    module = "dec_gpr_ctl_rf",
    spec = "@orfs//flow/designs/asap7/swerv_wrapper-regfile:dec_gpr_ctl_rf.regfile",
)

# dec_gpr_ctl as ORFS has it against the surgered one with the generated
# register file, scan_mode held low (the surgery ties it off).
surgery_cmp_test(
    name = "swerv_surgery_test",
    srcs = SWERV_SRCS,
    clocks = [
        "clk",
        "active_clk",
    ],
    # The platform's OPENROAD_CLKGATE is a clock gate only with this
    # defined, and a wire without: upstream's rvdffe words are gated.
    defines = ["OPENROAD_CLKGATE"],
    module = "dec_gpr_ctl_GPR_BANKS1_GPR_BANKS_LOG21",
    regfile_module = "dec_gpr_ctl_rf",
    reset = "rst_l:low",
    spec = "@orfs//flow/designs/asap7/swerv_wrapper-regfile:dec_gpr_ctl_rf.regfile",
    surgery = ":swerv_surgery",
    ties = {"scan_mode": "0"},
)

ladder_row(
    name = "swerv_wrapper",
    design = "swerv_wrapper-yosys",
    regfile_design = "swerv_wrapper-regfile",
    top = "swerv_wrapper",
)

# Rung 6: cva6 (cv32a65x). A SYNTH_VERILOG_SURGERY script keeps
# ariane_regfile's parameters and ports and moves its array into
# ariane_regfile_rf; the spec, with write_priority last, replaces that.
py_binary(
    name = "cva6_surgery",
    srcs = ["@orfs//flow/designs/asap7/cva6-regfile:surgery.py"],
    main = "@orfs//flow/designs/asap7/cva6-regfile:surgery.py",
)

CVA6_REGFILE = "@orfs//flow/designs/src/cva6/core:ariane_regfile_ff.sv"

genrule(
    name = "cva6_surgered",
    srcs = [CVA6_REGFILE],
    outs = ["cva6_surgered_out/ariane_regfile_ff.sv"],
    cmd = "$(execpath :cva6_surgery) --out-dir $(RULEDIR)/cva6_surgered_out -- $<",
    tools = [":cva6_surgery"],
)

# The generated register file against the behavioural one the surgery
# wrote, colliding writes included.
regfile_sim_test(
    name = "cva6_sim_test",
    module = "ariane_regfile_rf",
    rtl = [":cva6_surgered_out/ariane_regfile_ff.sv"],
    rtl_module = "ariane_regfile_rf",
    spec = "@orfs//flow/designs/asap7/cva6-regfile:ariane_regfile_rf.regfile",
)

# ariane_regfile as ORFS has it against the surgered one with the
# generated register file.
genrule(
    name = "cva6_cmp_srcs",
    srcs = [
        CVA6_REGFILE,
        ":cva6_surgered_out/ariane_regfile_ff.sv",
        ":cva6_sim_test_gen.v",
    ],
    outs = [
        "cva6_cmp/orig.sv",
        "cva6_cmp/new.sv",
        "cva6_cmp/gen.v",
    ],
    cmd = """
sed 's/^module ariane_regfile #(/module ariane_regfile_orig #(/' $(location {orig}) > $(location cva6_cmp/orig.sv)
grep -q '^module ariane_regfile_orig #(' $(location cva6_cmp/orig.sv)
awk '/^module ariane_regfile_rf /{{skip=1}} !skip{{print}} skip&&/^endmodule/{{skip=0}}' $(location :cva6_surgered_out/ariane_regfile_ff.sv) > $(location cva6_cmp/new.sv)
grep -q '^module ariane_regfile #(' $(location cva6_cmp/new.sv)
! grep -q '^module ariane_regfile_rf ' $(location cva6_cmp/new.sv)
sed 's/^module ariane_regfile_rf_gen(/module ariane_regfile_rf(/' $(location :cva6_sim_test_gen.v) > $(location cva6_cmp/gen.v)
""".format(orig = CVA6_REGFILE),
)

verilog_library(
    name = "cva6_cmp_rtl",
    srcs = [
        "cva6_cmp/gen.v",
        "cva6_cmp/new.sv",
        "cva6_cmp/orig.sv",
        "cva6_cmp_tb.sv",
        ":asap7_stdcell.v",
        ":asap7_stdcell_empty.v",
        "@orfs//flow/designs/src/cva6/core/include:build_config_pkg.sv",
        "@orfs//flow/designs/src/cva6/core/include:config_pkg.sv",
        "@orfs//flow/designs/src/cva6/core/include:cv32a65x_config_pkg.sv",
        "@orfs//flow/designs/src/cva6/core/include:riscv_pkg.sv",
    ],
)

verilator_cc_library(
    name = "cva6_cmp_vtb",
    module = ":cva6_cmp_rtl",
    module_top = "tb_top",
    trace_mode = "none",
    vopts = [
        "-Wno-fatal",
        "--x-initial",
        "0",
    ],
)

cc_test(
    name = "cva6_surgery_test",
    size = "small",
    srcs = [
        "cva6_cmp_config.cc",
        "tb_main.cc",
    ],
    deps = [":cva6_cmp_vtb"],
)

ladder_row(
    name = "cva6",
    design = "cva6",
    top = "cva6",
)

# asap7/coralnpu's synthesis (ORFS patch 0102): no verification layers,
# the kept modules by name, both TCM SRAMs generated macros with their
# byte masks.
[
    filegroup(
        name = "coralnpu_synth_" + f.replace(".", "_"),
        srcs = ["@orfs//flow/designs/asap7/coralnpu:CoreMiniAxi_synth"],
        output_group = f,
    )
    for f in [
        "1_2_yosys.v",
        "memories.json",
    ]
]

py_test(
    name = "coralnpu_synth_test",
    srcs = ["coralnpu_synth_test.py"],
    args = [
        "$(location :coralnpu_synth_1_2_yosys_v)",
        "$(location :coralnpu_synth_memories_json)",
    ],
    data = [
        ":coralnpu_synth_1_2_yosys_v",
        ":coralnpu_synth_memories_json",
    ],
)

# Rung 7: coralnpu. ORFS patch 0103's surgery.py --regfile moves
# Regfile's 31 words into Regfile_rf: 8 reads, 6 writes ORed on a
# collision, reset high.
py_binary(
    name = "coralnpu_surgery",
    srcs = ["@orfs//flow/designs/asap7/coralnpu:surgery.py"],
    main = "@orfs//flow/designs/asap7/coralnpu:surgery.py",
)

CORALNPU_SPEC = "@orfs//flow/designs/asap7/coralnpu-regfile:Regfile_rf.regfile"

# Regfile as ORFS has it against the surgered one with the generated
# register file: six write ports with random addresses collide, masks,
# readSet, reads of words being written, resets with an edge.
surgery_cmp_test(
    name = "coralnpu_surgery_test",
    srcs = ["@orfs//flow/designs/src/coralnpu:CoreMiniAxi.sv"],
    clocks = ["clock"],
    module = "Regfile",
    regfile_module = "Regfile_rf",
    reset = "reset:high",
    spec = CORALNPU_SPEC,
    surgery = ":coralnpu_surgery",
    surgery_args = ["--regfile"],
)

# The generated register file against the behavioural one the surgery
# wrote.
regfile_sim_test(
    name = "coralnpu_sim_test",
    module = "Regfile_rf",
    rtl = [":coralnpu_surgery_test_surgery/CoreMiniAxi.sv"],
    rtl_module = "Regfile_rf",
    spec = CORALNPU_SPEC,
)

# The negative control: the spec with the later write winning instead of
# Regfile's OR. It must mismatch, or the stimulus never collides.
genrule(
    name = "coralnpu_write_last_regfile",
    srcs = [CORALNPU_SPEC],
    outs = ["coralnpu_write_last.regfile"],
    cmd = "cat $< > $@ && echo 'write_priority last' >> $@",
)

regfile_sim_test(
    name = "coralnpu_write_last_sim_test",
    expect_mismatch = True,
    module = "Regfile_rf",
    rtl = [":coralnpu_surgery_test_surgery/CoreMiniAxi.sv"],
    rtl_module = "Regfile_rf",
    spec = ":coralnpu_write_last.regfile",
)

ladder_row(
    name = "coralnpu",
    design = "coralnpu",
    top = "CoreMiniAxi",
)

# The clock gate per word against a mux per word (ORFS patch 0104), on
# the two rungs where the register file cost power.
ladder_row(
    name = "coralnpu_mux",
    design = "coralnpu",
    regfile_design = "coralnpu-regfile-mux",
    top = "CoreMiniAxi",
)

ladder_row(
    name = "swerv_wrapper_mux",
    design = "swerv_wrapper-yosys",
    regfile_design = "swerv_wrapper-regfile-mux",
    top = "swerv_wrapper",
)

# Each design directory gets its own config, even when it shares a
# DESIGN_NICKNAME (the seed and mux variants include their base's
# config.mk): see designs_by_directory_test.py.
py_test(
    name = "designs_by_directory_test",
    srcs = ["designs_by_directory_test.py"],
    args = ["'%s'" % json.encode({
        d: {
            "arguments": DESIGNS["asap7/" + d]["arguments"],
            "sources": DESIGNS["asap7/" + d]["sources"],
        }
        for d in [
            "picorv32-regfile",
            "picorv32-regfile-seed2",
            "picorv32-regfile-seed3",
            "coralnpu-regfile",
            "coralnpu-regfile-mux",
            "swerv_wrapper-regfile",
            "swerv_wrapper-regfile-mux",
        ]
    })],
)
