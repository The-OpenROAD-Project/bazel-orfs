# Register files of real designs through generate_ram (OpenROAD patches
# 0011 to 0023), by ORFS's own translation of their specs (regfile_ram.py,
# ORFS patch 0089), each simulated against the RTL it replaces (sim.bzl),
# every read compared under random reads, writes and resets. Seconds
# each.
#
# - riscv32i's register file, in each write style and with its periphery
#   as Verilog.
# - ibex's register file: `async_reset` (every word reset to zero), its
#   SystemVerilog header, and `unused` inputs; with a negative control,
#   the reset dropped.
# - rf_wp: `write_priority last`, two writes to one word in one cycle,
#   the later port winning; with a negative control whose RTL lets the
#   earlier port win.
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/lib_to_verilog:lib_to_verilog.bzl", "stdcell_verilog")
load(":sim.bzl", "regfile_sim_test")

package(default_visibility = ["//visibility:private"])

py_binary(
    name = "gen_tb",
    srcs = ["gen_tb.py"],
    main = "gen_tb.py",
)

py_binary(
    name = "ram_gen",
    srcs = ["ram_gen.py"],
    main = "ram_gen.py",
    visibility = [
        "//test/regfile_lec:__pkg__",
    ],
)

stdcell_verilog(
    name = "asap7_stdcell",
    lefs = ["@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef"],
    libs = [
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz",
    ],
)

regfile_sim_test(
    name = "ibex_sim_test",
    module = "ibex_register_file_ff",
    rtl = ["@orfs//flow/designs/src/ibex_sv:ibex_register_file_ff.sv"],
    rtl_module = "ibex_register_file_ff",
    spec = ":ibex_register_file_ff.regfile",
)

# The negative control: ibex's spec with the reset dropped (`reset`, a
# port the array ignores, for `async_reset`). The harness must see it.
genrule(
    name = "ibex_no_reset_regfile",
    srcs = [":ibex_register_file_ff.regfile"],
    outs = ["ibex_no_reset.regfile"],
    cmd = "sed 's/^async_reset rst_ni low$$/reset rst_ni/' $< > $@ && grep -q '^reset rst_ni$$' $@",
)

regfile_sim_test(
    name = "ibex_no_reset_sim_test",
    expect_mismatch = True,
    module = "ibex_register_file_ff",
    rtl = ["@orfs//flow/designs/src/ibex_sv:ibex_register_file_ff.sv"],
    rtl_module = "ibex_register_file_ff",
    spec = ":ibex_no_reset.regfile",
)

regfile_sim_test(
    name = "write_last_sim_test",
    module = "rf_wp",
    rtl = [":write_last.v"],
    rtl_module = "rf_wp",
    spec = ":rf_wp.regfile",
)

regfile_sim_test(
    name = "write_first_sim_test",
    expect_mismatch = True,
    module = "rf_wp",
    rtl = [":write_first.v"],
    rtl_module = "rf_wp",
    spec = ":rf_wp.regfile",
)

# riscv32i's register file (test/regfile/riscv32i's specs): a hold mux
# per bit, a clock gate per word, and the periphery as Verilog.
[
    regfile_sim_test(
        name = "riscv32i_%s_sim_test" % shape,
        module = "regfile",
        rtl = ["@orfs//flow/designs/src/riscv32i:regfile.v"],
        rtl_module = "regfile",
        spec = spec,
    )
    for shape, spec in [
        ("mux", ":riscv32i_mux.regfile"),
        ("clock_gate", "//test/regfile/riscv32i:inlined.regfile"),
        ("periphery_verilog", "//test/regfile/riscv32i:inlined_verilog.regfile"),
    ]
]

# test/regfile/designs' rtl_zero arms: riscv32i's regfile as a 31-word
# array with x0 in RTL (riscv32i_rtl_zero.v), against the zero-word
# netlist, itself checked against riscv32i's regfile.v above.
#
# The 31-word array on its own reads a stored word at address 31, where
# its behavioural model reads 0: an address outside the array is not
# defined, so this test passes only while they differ.
regfile_sim_test(
    name = "riscv32i_regfile31_sim_test",
    expect_mismatch = True,
    module = "regfile31",
    spec = "//test/regfile/designs:regfile31.regfile",
)

# riscv32i_rtl_zero.v's wrapper alone, the behavioural regfile31 cut off
# and the generated one, regfile31_gen, in its place; and the same with
# x0's reads not forced to 0 (the negative control)
[
    genrule(
        name = "riscv32i_rtl_zero_%s_v" % name,
        srcs = ["//test/regfile/designs:riscv32i_rtl_zero.v"],
        outs = ["riscv32i_rtl_zero_%s.v" % name],
        cmd = "sed -e '/^\\/\\/ the array generate_ram builds/,$$d' -e 's/^   regfile31 rf /   regfile31_gen rf /' %s $< > $@ && grep -q 'regfile31_gen rf' $@ && ! grep -q 'module regfile31' $@" % sed,
    )
    for name, sed in [
        ("wrapper", ""),
        ("unmasked", "-e 's/(ra\\([12]\\) != 0) ? q\\([12]\\) : 0/q\\2/'"),
    ]
]

# the generated 31-word netlist in the wrapper, against the zero-word netlist
[
    regfile_sim_test(
        name = "riscv32i_rtl_zero_%s_sim_test" % name,
        expect_mismatch = name == "unmasked",
        module = "regfile",
        rtl = [
            ":riscv32i_rtl_zero_%s.v" % name,
            ":riscv32i_regfile31_sim_test_gen.v",
        ],
        rtl_module = "regfile",
        spec = "//test/regfile/riscv32i:inlined.regfile",
    )
    for name in [
        "wrapper",
        "unmasked",
    ]
]

genrule(
    name = "riscv32i_mux_regfile",
    srcs = ["//test/regfile/riscv32i:inlined.regfile"],
    outs = ["riscv32i_mux.regfile"],
    cmd = "sed 's/^write_style clock_gate$$/write_style mux/' $< > $@ && grep -q '^write_style mux$$' $@",
)

# Synthetic specs, one per spec feature the designs above leave out: banks
# (contiguous and interleaved, side by side and stacked, banked reads, the
# zero word), bit folds, netlist mode, tap columns, and a registered read
# with the RTL's flop names. Each against a behavioural memory built from
# the spec itself (gen_tb.py), no RTL needed.
#
# These test OpenROAD's generate_ram, not bazel-orfs. They are here only
# because OpenROAD has no good place for them today, and they are manual:
# CI has no business building them. generate_ram is to emit Verilog
# behavioural models of what it builds; once OpenROAD takes delivery of
# these tests, or its own models make them redundant, delete them here.
[
    regfile_sim_test(
        name = "golden_%s_sim_test" % spec,
        module = module,
        spec = "golden/%s.regfile" % spec,
        tags = ["manual"],
    )
    for spec, module in [
        ("banked", "GoldenBanked"),
        ("folds", "GoldenFolds"),
        ("netlist", "GoldenNetlist"),
        ("plain", "GoldenPlain"),
        ("registered", "GoldenRegistered"),
    ]
]

test_suite(
    name = "golden_sim_tests",
    tags = ["manual"],
    tests = [":golden_%s_sim_test" % s for s in [
        "banked",
        "folds",
        "netlist",
        "plain",
        "registered",
    ]],
)
