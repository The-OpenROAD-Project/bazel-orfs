load("@bazel-orfs//:openroad.bzl", "orfs_flow")
load("@rules_python//python:defs.bzl", "py_test")

# A register file from generate_ram as its own block, with the settings
# XiangShan's register files use (xiangshan.bzl) but the default
# negotiation legalizer: the cells left to placement go to the band of
# rows around the FIRM array (ORFS patch 0215), not into its holes.
orfs_flow(
    name = "Rf25x72",
    arguments = {
        "AUTO_MEMORIES": "1",
        "CORE_UTILIZATION": "40",
        "GPL_ROUTABILITY_DRIVEN": "0",
        "GPL_TIMING_DRIVEN": "0",
        "PLACE_DENSITY": "0.6",
        "SKIP_LAST_GASP": "1",
        "SKIP_REPORT_METRICS": "1",
        "SYNTH_HDL_FRONTEND": "slang",
    },
    last_stage = "place",
    sources = {
        "AUTO_MEMORIES_REGFILES": [":Rf25x72.regfile"],
        "SDC_FILE": ["//test/regfile:constraint.sdc"],
    },
    verilog_files = ["rf25x72.v"],
)

filegroup(
    name = "Rf25x72_place_logs",
    srcs = [":Rf25x72_place"],
    output_group = "logs",
)

# Detailed placement legalizes the register file without leaving a cell
# to the diamond search.
py_test(
    name = "band_test",
    size = "small",
    srcs = ["band_test.py"],
    args = ["$(rootpaths :Rf25x72_place_logs)"],
    data = [":Rf25x72_place_logs"],
)
