# riscv32i's regfile with x0 in RTL (riscv32i_rtl_zero.v): the array is
# regfile31, 31 words, no zero word. Otherwise as
# test/regfile/riscv32i/inlined.regfile.
module regfile31
words 31
bits 32
clock clk
read ra1 rd1
read ra2 rd2
write wa3 wd3 we3
write_style clock_gate
cell icg ICGx1_ASAP7_75t_R
cell flop DFFHQNx1_ASAP7_75t_R
cell and2 AND2x2_ASAP7_75t_R
cell or2 OR2x2_ASAP7_75t_R
cell ao22 AO22x2_ASAP7_75t_R
cell inv INVx1_ASAP7_75t_R
