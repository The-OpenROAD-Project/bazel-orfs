load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":designs.bzl", "SHAPES", "design_arms")

# ORFS's designs as flip-flops and with their register files generated
# by generate_ram (OpenROAD #11723), each shape through detailed route.
# Each arm runs at the periods listed for it: first the design's own
# clock, then one calibrated clock for all of a design's arms, 3 % under
# the best period any of them reached at the first, so repair has a
# target and the arms compare at the same one. The
# minimum period reported is clk_period - WNS of the second run. A study,
# not a gate: every target is manual.
package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "regfile31.regfile",
        "riscv32i_rtl_zero.v",
    ],
    visibility = ["//test/regfile/cores:__pkg__"],
)

py_binary(
    name = "sdc_period",
    srcs = ["sdc_period.py"],
    main = "sdc_period.py",
)

py_binary(
    name = "report",
    srcs = ["report.py"],
    main = "report.py",
)

py_test(
    name = "report_test",
    size = "small",
    srcs = [
        "report.py",
        "report_test.py",
    ],
    imports = ["."],
    main = "report_test.py",
)

py_test(
    name = "sdc_period_test",
    size = "small",
    srcs = [
        "sdc_period.py",
        "sdc_period_test.py",
    ],
    imports = ["."],
    main = "sdc_period_test.py",
)

# riscv32i also runs shapes that exercise options on a real design whose
# register file does not need them: banks, bit folds, service columns.
COVERAGE = SHAPES | {
    # unfolded, as test/regfile/riscv32i placed it beside the FakeRAMs
    "netlist": "mode netlist\n",
    "banks": "banks 4\nbank_columns 2\nbank_order interleaved\n",
    "folds": "bit_folds 2\n",
    "service": "tap_columns 8\nservice_sites 20\n",
    # the alternative to `zero_word 0` (OpenROAD #11723 review): a 31-word
    # array, x0 handled in riscv32i_rtl_zero.v, inlined and as a macro
    "rtl_zero": "",
    "rtl_zero_netlist": "mode netlist\n",
}

# the rtl_zero shapes' spec, module and RTL
RTL_ZERO = [
    "rtl_zero",
    "rtl_zero_netlist",
]

# riscv32i's Verilog with riscv32i_rtl_zero.v in regfile.v's place
RISCV32I_RTL_ZERO = [
    "@orfs//flow/designs/src/riscv32i:adder.v",
    "@orfs//flow/designs/src/riscv32i:alu.v",
    "@orfs//flow/designs/src/riscv32i:aludec.v",
    "@orfs//flow/designs/src/riscv32i:controller.v",
    "@orfs//flow/designs/src/riscv32i:datapath.v",
    "@orfs//flow/designs/src/riscv32i:dmem.v",
    "@orfs//flow/designs/src/riscv32i:flopenr.v",
    "@orfs//flow/designs/src/riscv32i:flopens.v",
    "@orfs//flow/designs/src/riscv32i:flopr.v",
    "@orfs//flow/designs/src/riscv32i:magcompare2b.v",
    "@orfs//flow/designs/src/riscv32i:magcompare2c.v",
    "@orfs//flow/designs/src/riscv32i:magcompare32.v",
    "@orfs//flow/designs/src/riscv32i:maindec.v",
    "@orfs//flow/designs/src/riscv32i:mux2.v",
    "@orfs//flow/designs/src/riscv32i:mux3.v",
    "@orfs//flow/designs/src/riscv32i:mux4.v",
    "@orfs//flow/designs/src/riscv32i:mux5.v",
    "@orfs//flow/designs/src/riscv32i:mux8.v",
    "@orfs//flow/designs/src/riscv32i:riscv.v",
    "@orfs//flow/designs/src/riscv32i:rom.v",
    "@orfs//flow/designs/src/riscv32i:shifter.v",
    "@orfs//flow/designs/src/riscv32i:signext.v",
    "@orfs//flow/designs/src/riscv32i:top.v",
    ":riscv32i_rtl_zero.v",
]

ALL = ["flops"] + list(SHAPES)

LARGE = [
    "flops",
    "inline",
    "netlist",
]

ARMS_1 = design_arms(
    name = "riscv32i",
    base_specs = {shape: ":regfile31.regfile" for shape in RTL_ZERO},
    # the macro beside riscv32i's four FakeRAMs, as test/regfile/riscv32i
    # measured it: at 62 % they do not tile with its halo
    extra = {shape: {
        "CORE_UTILIZATION": "55",
        "RTLMP_MIN_CHANNEL_SIZE": "2 2",
    } for shape in [
        "netlist",
        "rtl_zero_netlist",
    ]},
    flops = "asap7/riscv32i",
    module = "regfile",
    modules = {shape: "regfile31" for shape in RTL_ZERO},
    # 830: about 10 % under the calibrated clock, where a clock gate's
    # insertion delay and enable setup cost most (the write-style retrial)
    periods = {arm: [
        950,
        920,
    ] + ([830] if arm in [
        "flops",
        "inline",
        "mux",
    ] else []) for arm in ["flops"] + list(COVERAGE)},
    regfile = None,
    shapes = COVERAGE,
    spec = "//test/regfile/riscv32i:inlined.regfile",
    top = "riscv_top",
    verilog = {shape: RISCV32I_RTL_ZERO for shape in RTL_ZERO},
)

ARMS_2 = design_arms(
    name = "picorv32",
    flops = "asap7/picorv32",
    module = "picorv32_regs",
    periods = {arm: [
        300,
        440,
    ] for arm in ALL},
    regfile = "asap7/picorv32-regfile",
    top = "picorv32",
)

ARMS_3 = design_arms(
    name = "ibex",
    flops = "asap7/ibex",
    module = "ibex_register_file_ff",
    periods = {arm: [
        1468,
        1240,
    ] for arm in ALL},
    regfile = "asap7/ibex-regfile",
    top = "ibex_core",
)

# tinyRocket's array the other way round from riscv32i's rtl_zero arms:
# 32 words with the zero word, against its own 31
ZERO32 = {
    "zero32": "",
    "zero32_netlist": SHAPES["netlist"],
}

ARMS_4 = design_arms(
    name = "tinyRocket",
    base_specs = {shape: ":Rocket_rf32.regfile" for shape in ZERO32},
    flops = "asap7/tinyRocket",
    module = "Rocket_rf",
    periods = {arm: [
        600,
        620,
    ] for arm in ALL + list(ZERO32)},
    regfile = "asap7/tinyRocket-regfile",
    shapes = SHAPES | ZERO32,
    top = "RocketTile",
)

ARMS_5 = design_arms(
    name = "swerv",
    flops = "asap7/swerv_wrapper-yosys",
    module = "dec_gpr_ctl_rf",
    periods = {arm: [1300] for arm in LARGE},
    regfile = "asap7/swerv_wrapper-regfile",
    top = "swerv_wrapper",
)

ARMS_6 = design_arms(
    name = "cva6",
    flops = "asap7/cva6",
    module = "ariane_regfile_rf",
    periods = {arm: [910] for arm in LARGE},
    regfile = "asap7/cva6-regfile",
    top = "cva6",
)

ARMS_7 = design_arms(
    name = "coralnpu",
    flops = "asap7/coralnpu",
    module = "Regfile_rf",
    periods = {arm: [1900] for arm in LARGE},
    regfile = "asap7/coralnpu-regfile",
    top = "CoreMiniAxi",
)

ARMS_8 = design_arms(
    name = "coralnpu_exmem",
    flops = "asap7/coralnpu-exmem",
    module = "Regfile_rf",
    periods = {arm: [1700] for arm in LARGE},
    regfile = "asap7/coralnpu-regfile-exmem",
    top = "CoreMiniAxi",
)

# both register files: the variant as ORFS has it, two specs
ARMS_9 = design_arms(
    name = "coralnpu_exmem_both",
    flops = "asap7/coralnpu-exmem",
    module = "Regfile_rf",
    periods = {"as_is": [1700]},
    regfile = "asap7/coralnpu-regfiles-exmem",
    shapes = {"as_is": None},
    top = "CoreMiniAxi",
)

ARMS = ARMS_1 + ARMS_2 + ARMS_3 + ARMS_4 + ARMS_5 + ARMS_6 + ARMS_7 + ARMS_8 + ARMS_9

SMALL = ARMS_1 + ARMS_2 + ARMS_3 + ARMS_4

# The measured arms as tables: QoR against flip-flops and stage times;
# report_small_tables for riscv32i, picorv32, ibex and tinyRocket only.
#   bazelisk build //test/regfile/designs:report_tables
[
    genrule(
        name = name,
        srcs = [":%s_measure" % arm for arm in arms] + [":%s_logs" % arm for arm in arms],
        outs = [
            name + ".csv",
            name + ".md",
        ],
        cmd = "$(execpath :report) --csv $(location %s.csv) --md $(location %s.md) --arms %s $(SRCS)" % (
            name,
            name,
            ",".join(arms),
        ),
        tags = ["manual"],
        tools = [":report"],
    )
    for name, arms in [
        ("report_tables", ARMS),
        ("report_small_tables", SMALL),
    ]
]
