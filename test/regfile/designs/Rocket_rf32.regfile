# tinyRocket's Rocket_rf (ORFS patch 0099) as 32 words with the zero
# word, the reverse of riscv32i's rtl_zero arms (OpenROAD #11723
# review). Rocket addresses the array by the inverted register number,
# so x0 is word 31. Rocket never reads it (its bypass gives 0 for x0)
# and never writes it (rf_waddr != 0): a word the 31-word array leaves
# undefined, here defined as 0. Otherwise as Rocket_rf.regfile.
module Rocket_rf
words 32
bits 32
clock clock
read r0_addr r0_data
read r1_addr r1_data
write w0_addr w0_data w0_en
zero_word 31
write_style clock_gate
cell icg ICGx1_ASAP7_75t_R
cell flop DFFHQNx1_ASAP7_75t_R
cell and2 AND2x2_ASAP7_75t_R
cell or2 OR2x2_ASAP7_75t_R
cell ao22 AO22x2_ASAP7_75t_R
cell inv INVx1_ASAP7_75t_R
