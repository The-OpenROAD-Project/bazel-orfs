load("@orfs_designs//:designs.bzl", "DESIGNS")
load("//:openroad.bzl", "odb_debug", "orfs_flow")

# riscv32i's register file in each shape generate_regfile offers, on
# ORFS's own riscv32i config (62 %, its io.tcl), to global route: flops
# (ORFS's riscv32i), inlined (synthesis reads the generated netlist),
# netlist (macro-placed, then dissolved) and macro (macro-placed, kept).
# A study, not a gate: every target is manual.
package(default_visibility = ["//visibility:private"])

RISCV32I = DESIGNS["asap7/riscv32i"]

# DESIGNS' labels are ORFS's own, relative to its repository.
SOURCES = {
    key: [
        "@orfs" + label if label.startswith("//") else label
        for label in labels
    ]
    for key, labels in RISCV32I["sources"].items()
}

VERILOG_FILES = [
    "@orfs" + f if f.startswith("//") else f
    for f in RISCV32I["verilog_files"]
]

# riscv32i's RTLMP_MIN_CHANNEL_SIZE (8 8) is sized for its FakeRAMs;
# "narrow" sets 2 2 on every shape, flops included, to measure what the
# channels cost. Left unset, ORFS defaults to 20 20.
NARROW = RISCV32I["arguments"] | {"RTLMP_MIN_CHANNEL_SIZE": "2 2"}

[
    orfs_flow(
        name = "riscv_top",
        arguments = arguments | ({
            "AUTO_MEMORIES": "1",
        } if regfile else {}) | macro_place,
        last_stage = "grt",
        sources = SOURCES | ({
            "AUTO_MEMORIES_REGFILES": [":%s.regfile" % regfile],
        } if regfile else {}),
        tags = ["manual"],
        variant = regfile + suffix if regfile else "flops" + suffix,
        verilog_files = VERILOG_FILES,
    )
    for suffix, arguments in [
        (
            "",
            RISCV32I["arguments"],
        ),
        ("_narrow", NARROW),
    ]
    for regfile, macro_place in [
        ("inlined", {}),
        ("inlined_verilog", {}),
        (
            "netlist",
            {"AUTO_MEMORIES_MACRO_PLACE": "regfile"},
        ),
        (
            "netlist_service0",
            {"AUTO_MEMORIES_MACRO_PLACE": "regfile"},
        ),
        (
            "netlist_verilog",
            {"AUTO_MEMORIES_MACRO_PLACE": "regfile"},
        ),
        (
            "macro",
            {"AUTO_MEMORIES_MACRO_PLACE": "regfile"},
        ),
    ] + ([("", {})] if suffix else [])
]

# The netlist shape at 55 %, where AutoMemories.md measured the padded
# abstract (959 ps on a 4 644 um2 core): at 62 % the four 42 um tall
# FakeRAMs and the register file with its row halo do not tile.
[
    orfs_flow(
        name = "riscv_top",
        arguments = NARROW | {
            "AUTO_MEMORIES": "1",
            "AUTO_MEMORIES_MACRO_PLACE": "regfile",
            "CORE_UTILIZATION": "55",
        },
        last_stage = "grt",
        sources = SOURCES | {
            "AUTO_MEMORIES_REGFILES": [":%s.regfile" % regfile],
        },
        tags = ["manual"],
        variant = "%s_narrow_55" % regfile,
        verilog_files = VERILOG_FILES,
    )
    for regfile in [
        "netlist",
        "netlist_verilog",
    ]
]

# odb-debug sessions on each stage, for ledger.tcl
# and questions.
[
    odb_debug(
        name = "%s_%s_odb_debug" % (shape, stage),
        src = src % stage,
        tags = ["manual"],
    )
    for shape, src in [
        ("flops", "@orfs//flow/designs/asap7/riscv32i:riscv_top_%s"),
        ("inlined", ":riscv_top_inlined_%s"),
        ("inlined_verilog", ":riscv_top_inlined_verilog_%s"),
        ("netlist", ":riscv_top_netlist_%s"),
        ("netlist_service0", ":riscv_top_netlist_service0_%s"),
        ("macro", ":riscv_top_macro_%s"),
        ("netlist_narrow_55", ":riscv_top_netlist_narrow_55_%s"),
        ("netlist_verilog_narrow_55", ":riscv_top_netlist_verilog_narrow_55_%s"),
    ] + [
        (
            shape + "_narrow",
            ":riscv_top_%s_narrow_%%s" % shape,
        )
        for shape in [
            "flops",
            "inlined",
            "inlined_verilog",
            "netlist",
            "netlist_service0",
            "macro",
        ]
    ]
    for stage in [
        "synth",
        "floorplan",
        "grt",
    ]
]
