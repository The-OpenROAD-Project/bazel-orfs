# riscv32i's regfile, macro-placed and then dissolved (mode netlist):
# its core fixed where the macro was placed, its address decode left to
# the parent. Otherwise as inlined.regfile.
module regfile
mode netlist
words 32
bits 32
clock clk
read ra1 rd1
read ra2 rd2
write wa3 wd3 we3
zero_word 0
write_style clock_gate
cell icg ICGx1_ASAP7_75t_R
cell flop DFFHQNx1_ASAP7_75t_R
cell and2 AND2x2_ASAP7_75t_R
cell or2 OR2x2_ASAP7_75t_R
cell ao22 AO22x2_ASAP7_75t_R
cell inv INVx1_ASAP7_75t_R
