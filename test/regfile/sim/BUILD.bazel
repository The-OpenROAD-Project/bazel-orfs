# What generate_regfile builds computes what the RTL it replaces does:
# riscv32i's register file as generate_regfile writes it, simulated beside
# src/riscv32i/regfile.v under random reads and writes, every read
# compared. One netlist per write style: a hold mux per bit, and a clock
# gate per word; and the clock gate with its periphery as assigns
# (`periphery verilog`), inlined and, in mode netlist, as a wrapper
# around the core's own netlist (regfile_core.v).
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("//tools/lib_to_verilog:lib_to_verilog.bzl", "stdcell_verilog")

package(default_visibility = ["//visibility:private"])

stdcell_verilog(
    name = "asap7_stdcell",
    lefs = ["@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef"],
    libs = [
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz",
    ],
)

[
    [
        genrule(
            name = "regfile_%s_v" % style,
            srcs = [
                ":regfile.regfile",
                "@orfs//flow/designs/src/riscv32i:regfile.v",
                "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
                "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
            ],
            outs = ["regfile_%s.v" % style] + (
                ["regfile_core.v"] if "periphery verilog" in lines and "mode netlist" in lines else []
            ),
            cmd = """
grep -v '^write_style' $(location :regfile.regfile) > $(@D)/regfile_{style}.regfile
{extra}
cat > $(@D)/regfile_{style}.tcl <<TCL
read_lef $(location @orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef)
read_lef $(location @orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef)
generate_regfile -spec $(@D)/regfile_{style}.regfile -check_ports $(location @orfs//flow/designs/src/riscv32i:regfile.v) -verilog $(@D)/regfile_{style}.gen.v
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/regfile_{style}.tcl > $(@D)/regfile_{style}.log 2>&1 || {{ cat $(@D)/regfile_{style}.log; exit 1; }}
sed -e 's/^module regfile(/module regfile_gen(/' -e '/^(\\* blackbox \\*)$$/,$$d' $(@D)/regfile_{style}.gen.v > $(@D)/regfile_{style}.v
""".format(
                extra = "\n".join([
                    "echo '%s' >> $(@D)/regfile_%s.regfile" % (line, style)
                    for line in lines
                ]),
                style = style,
            ),
            tools = ["@openroad"],
        ),
        verilog_library(
            name = "tb_%s_rtl" % style,
            srcs = [
                "tb_top.v",
                ":regfile_%s.v" % style,
            ] + (
                [":regfile_core.v"] if "periphery verilog" in lines and "mode netlist" in lines else []
            ) + [
                ":asap7_stdcell.v",
                ":asap7_stdcell_empty.v",
                "@orfs//flow/designs/src/riscv32i:regfile.v",
            ],
        ),
        verilator_cc_library(
            name = "tb_%s" % style,
            module = ":tb_%s_rtl" % style,
            module_top = "tb_top",
            trace_mode = "none",
            vopts = [
                "-Wno-fatal",
                "--x-initial",
                "0",
            ],
        ),
        cc_test(
            name = "regfile_%s_sim_test" % style,
            size = "small",
            srcs = ["tb_main.cc"],
            deps = [":tb_%s" % style],
        ),
    ]
    for style, lines in [
        ("mux", []),
        (
            "clock_gate",
            ["write_style clock_gate"],
        ),
        (
            "clock_gate_verilog",
            [
                "write_style clock_gate",
                "periphery verilog",
            ],
        ),
        (
            "netlist_verilog",
            [
                "mode netlist",
                "write_style clock_gate",
                "periphery verilog",
            ],
        ),
    ]
]

# generate_ram with two write ports (OpenROAD patch 0011): its netlist
# beside its own behavioral model on Nangate45, whose tristate buffers
# make the read bitlines, under random writes on both ports, a quarter
# of them to the same word, the last port winning.
stdcell_verilog(
    name = "nangate45_stdcell",
    lefs = ["@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef"],
    libs = ["@orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib"],
)

NANGATE45 = {
    "lefs": [
        "@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.tech.lef",
        "@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef",
    ],
    "libs": ["@orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib"],
    "stdcell": [
        ":nangate45_stdcell.v",
        ":nangate45_stdcell_empty.v",
    ],
}

ASAP7 = {
    "lefs": [
        "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
        "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
    ],
    "libs": [
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz",
    ],
    "stdcell": [
        ":asap7_stdcell.v",
        ":asap7_stdcell_empty.v",
    ],
}

# Each shape of generate_ram's 8 x 8, two write ports and one read:
# Nangate45's tristate bitlines (patch 0011), its AND-OR trees asked for
# (patch 0012), and asap7's, which has no tristate cell, with its QN-only
# flop (the storage cell named: the smallest flop is negative-edge), and
# with a word reading 0 (patch 0013), on either polarity of flop; and
# with an asynchronous reset to a value of both 0s and 1s (patch 0014),
# on Nangate45's set/reset flop and asap7's, which stores !D; and in
# banks (patch 0015), contiguous and interleaved, side by side and
# stacked, tristate and AND-OR, and 12 words in banks of 3; and with a
# banked read port beside a plain one (patch 0016).
[
    [
        genrule(
            name = "%s_v" % name,
            srcs = platform["lefs"] + platform["libs"],
            outs = [
                "%s_gen.v" % name,
                "%s_model.v" % name,
            ],
            cmd = """
cat > $(@D)/{name}.tcl <<TCL
{read_libs}
{read_lefs}
generate_ram_netlist -mask_size 8 -word_size 8 -num_words {words} -r_ports 1 -w_ports 2 {args} -write_behavioral_verilog $(@D)/{name}_model.v
write_db $(@D)/{name}.odb
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/{name}.tcl > $(@D)/{name}.log 2>&1 || {{ cat $(@D)/{name}.log; exit 1; }}
# write_verilog needs the network linked to the block, as reading it back
# does
cat > $(@D)/{name}_v.tcl <<TCL
{read_libs}
read_db $(@D)/{name}.odb
write_verilog $(@D)/{name}.v
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/{name}_v.tcl >> $(@D)/{name}.log 2>&1 || {{ cat $(@D)/{name}.log; exit 1; }}
sed -e 's/^module RAM{words}x8 /module RAM8x8_gen /' $(@D)/{name}.v > $(location {name}_gen.v)
sed -i 's/^module RAM{words}x8 /module RAM8x8 /' $(location {name}_model.v)
""".format(
                name = name,
                args = args,
                read_lefs = "\n".join(["read_lef $(location %s)" % f for f in platform["lefs"]]),
                read_libs = "\n".join(["read_liberty $(location %s)" % f for f in platform["libs"]]),
                words = words,
            ),
            tools = ["@openroad"],
        ),
        verilog_library(
            name = "tb_%s_rtl" % name,
            srcs = [
                ("%s.v" % tb) if words == 8 else ("%s_%d.v" % (tb, words)),
                ":%s_gen.v" % name,
                ":%s_model.v" % name,
            ] + platform["stdcell"],
        ),
        verilator_cc_library(
            name = "tb_%s" % name,
            module = ":tb_%s_rtl" % name,
            module_top = tb,
            trace_mode = "none",
            vopts = [
                "-Wno-fatal",
                "--x-initial",
                "0",
            ],
        ),
        cc_test(
            name = "%s_sim_test" % name,
            size = "small",
            srcs = ["%s.cc" % tb],
            defines = ["WORDS=%d" % words],
            deps = [":tb_%s" % name],
        ),
    ]
    for name, platform, args, tb, words in [
        ("ram_2w", NANGATE45, "-storage_cell DFF_X1", "tb_ram_2w", 8),
        ("ram_2w_and_or", NANGATE45, "-storage_cell DFF_X1 -read_style and_or", "tb_ram_2w", 8),
        ("ram_2w_and_or_zero", NANGATE45, "-storage_cell DFF_X1 -read_style and_or -zero_word 3", "tb_ram_2w", 8),
        ("ram_2w_asap7", ASAP7, "-storage_cell DFFHQNx1_ASAP7_75t_R", "tb_ram_2w", 8),
        ("ram_2w_asap7_zero", ASAP7, "-storage_cell DFFHQNx1_ASAP7_75t_R -zero_word 0", "tb_ram_2w", 8),
        ("ram_2w_rst", NANGATE45, "-storage_cell DFFRS_X1 -reset_value 0xa5", "tb_ram_2w_rst", 8),
        ("ram_2w_rst_and_or", NANGATE45, "-storage_cell DFFRS_X1 -read_style and_or -reset_value 0xa5", "tb_ram_2w_rst", 8),
        ("ram_2w_rst_asap7", ASAP7, "-storage_cell DFFASRHQNx1_ASAP7_75t_R -reset_value 0xa5", "tb_ram_2w_rst", 8),
        ("ram_2w_banks", NANGATE45, "-storage_cell DFF_X1 -banks 4 -bank_columns 2 -bank_order interleaved", "tb_ram_2w", 8),
        ("ram_2w_banks_and_or", NANGATE45, "-storage_cell DFF_X1 -read_style and_or -banks 2 -bank_columns 2", "tb_ram_2w", 8),
        ("ram_2w_banks_asap7", ASAP7, "-storage_cell DFFHQNx1_ASAP7_75t_R -banks 4 -bank_columns 2 -bank_order interleaved -zero_word 0", "tb_ram_2w", 8),
        ("ram_2w_banks12_asap7", ASAP7, "-storage_cell DFFHQNx1_ASAP7_75t_R -banks 4 -bank_columns 2", "tb_ram_2w", 12),
        ("ram_2w_banks12", NANGATE45, "-storage_cell DFF_X1 -banks 4 -bank_columns 4 -bank_order interleaved", "tb_ram_2w", 12),
        ("ram_rb", NANGATE45, "-storage_cell DFF_X1 -banks 4 -bank_columns 2 -bank_order interleaved -rb_ports 1", "tb_ram_rb", 8),
        ("ram_rb_asap7", ASAP7, "-storage_cell DFFHQNx1_ASAP7_75t_R -banks 4 -bank_columns 2 -rb_ports 1 -zero_word 0", "tb_ram_rb", 8),
    ]
]
