# What generate_regfile builds computes what the RTL it replaces does:
# riscv32i's register file as generate_regfile writes it, simulated beside
# src/riscv32i/regfile.v under random reads and writes, every read
# compared. One netlist per write style: a hold mux per bit, and a clock
# gate per word; and the clock gate with its periphery as assigns
# (`periphery verilog`), inlined and, in mode netlist, as a wrapper
# around the core's own netlist (regfile_core.v).
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")
load("//tools/lib_to_verilog:lib_to_verilog.bzl", "stdcell_verilog")

package(default_visibility = ["//visibility:private"])

stdcell_verilog(
    name = "asap7_stdcell",
    lefs = ["@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef"],
    libs = [
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_AO_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_INVBUF_RVT_TT_nldm_220122.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_OA_RVT_TT_nldm_211120.lib.gz",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SEQ_RVT_TT_nldm_220123.lib",
        "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_SIMPLE_RVT_TT_nldm_211120.lib.gz",
    ],
)

[
    [
        genrule(
            name = "regfile_%s_v" % style,
            srcs = [
                ":regfile.regfile",
                "@orfs//flow/designs/src/riscv32i:regfile.v",
                "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
                "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
            ],
            outs = ["regfile_%s.v" % style] + (
                ["regfile_core.v"] if "periphery verilog" in lines and "mode netlist" in lines else []
            ),
            cmd = """
grep -v '^write_style' $(location :regfile.regfile) > $(@D)/regfile_{style}.regfile
{extra}
cat > $(@D)/regfile_{style}.tcl <<TCL
read_lef $(location @orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef)
read_lef $(location @orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef)
generate_regfile -spec $(@D)/regfile_{style}.regfile -check_ports $(location @orfs//flow/designs/src/riscv32i:regfile.v) -verilog $(@D)/regfile_{style}.gen.v
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/regfile_{style}.tcl > $(@D)/regfile_{style}.log 2>&1 || {{ cat $(@D)/regfile_{style}.log; exit 1; }}
sed -e 's/^module regfile(/module regfile_gen(/' -e '/^(\\* blackbox \\*)$$/,$$d' $(@D)/regfile_{style}.gen.v > $(@D)/regfile_{style}.v
""".format(
                extra = "\n".join([
                    "echo '%s' >> $(@D)/regfile_%s.regfile" % (line, style)
                    for line in lines
                ]),
                style = style,
            ),
            tools = ["@openroad"],
        ),
        verilog_library(
            name = "tb_%s_rtl" % style,
            srcs = [
                "tb_top.v",
                ":regfile_%s.v" % style,
            ] + (
                [":regfile_core.v"] if "periphery verilog" in lines and "mode netlist" in lines else []
            ) + [
                ":asap7_stdcell.v",
                ":asap7_stdcell_empty.v",
                "@orfs//flow/designs/src/riscv32i:regfile.v",
            ],
        ),
        verilator_cc_library(
            name = "tb_%s" % style,
            module = ":tb_%s_rtl" % style,
            module_top = "tb_top",
            trace_mode = "none",
            vopts = [
                "-Wno-fatal",
                "--x-initial",
                "0",
            ],
        ),
        cc_test(
            name = "regfile_%s_sim_test" % style,
            size = "small",
            srcs = ["tb_main.cc"],
            deps = [":tb_%s" % style],
        ),
    ]
    for style, lines in [
        ("mux", []),
        (
            "clock_gate",
            ["write_style clock_gate"],
        ),
        (
            "clock_gate_verilog",
            [
                "write_style clock_gate",
                "periphery verilog",
            ],
        ),
        (
            "netlist_verilog",
            [
                "mode netlist",
                "write_style clock_gate",
                "periphery verilog",
            ],
        ),
    ]
]

# generate_ram with two write ports (OpenROAD patch 0011): its netlist
# beside its own behavioral model on Nangate45, whose tristate buffers
# make the read bitlines, under random writes on both ports, a quarter
# of them to the same word, the last port winning.
stdcell_verilog(
    name = "nangate45_stdcell",
    lefs = ["@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef"],
    libs = ["@orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib"],
)

genrule(
    name = "ram_2w_v",
    srcs = [
        "@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.tech.lef",
        "@orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef",
        "@orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib",
    ],
    outs = [
        "ram_2w_gen.v",
        "ram_2w_model.v",
    ],
    cmd = """
cat > $(@D)/ram_2w.tcl <<TCL
read_liberty $(location @orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib)
read_lef $(location @orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.tech.lef)
read_lef $(location @orfs//flow:platforms/nangate45/lef/NangateOpenCellLibrary.macro.mod.lef)
generate_ram_netlist -mask_size 8 -word_size 8 -num_words 8 -r_ports 1 -w_ports 2 -storage_cell DFF_X1 -write_behavioral_verilog $(@D)/ram_2w_model.v
write_db $(@D)/ram_2w.odb
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/ram_2w.tcl > $(@D)/ram_2w.log 2>&1 || { cat $(@D)/ram_2w.log; exit 1; }
# write_verilog needs the network linked to the block, as reading it back
# does
cat > $(@D)/ram_2w_v.tcl <<TCL
read_liberty $(location @orfs//flow:platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib)
read_db $(@D)/ram_2w.odb
write_verilog $(@D)/ram_2w.v
TCL
$(location @openroad//:openroad) -exit -no_init -no_splash $(@D)/ram_2w_v.tcl >> $(@D)/ram_2w.log 2>&1 || { cat $(@D)/ram_2w.log; exit 1; }
sed 's/^module RAM8x8 /module RAM8x8_gen /' $(@D)/ram_2w.v > $(location ram_2w_gen.v)
""",
    tools = ["@openroad"],
)

verilog_library(
    name = "tb_ram_2w_rtl",
    srcs = [
        "tb_ram_2w.v",
        ":nangate45_stdcell.v",
        ":nangate45_stdcell_empty.v",
        ":ram_2w_gen.v",
        ":ram_2w_model.v",
    ],
)

verilator_cc_library(
    name = "tb_ram_2w",
    module = ":tb_ram_2w_rtl",
    module_top = "tb_ram_2w",
    trace_mode = "none",
    vopts = [
        "-Wno-fatal",
        "--x-initial",
        "0",
    ],
)

cc_test(
    name = "ram_2w_sim_test",
    size = "small",
    srcs = ["tb_ram_2w.cc"],
    deps = [":tb_ram_2w"],
)
