+// A read address split for predecode: groups of at most three bits, at
+// most three groups, so a word select is one NOR of one predecode line
+// per group.
+std::vector<int> PredecodeGroups(int bits)
+{
+  switch (bits) {
+    case 0:
+      return {};
+    case 1:
+    case 2:
+    case 3:
+      return {bits};
+    case 4:
+      return {2, 2};
+    case 5:
+      return {3, 2};
+    case 6:
+      return {3, 3};
+    case 7:
+      return {3, 2, 2};
+    case 8:
+      return {3, 3, 2};
+    case 9:
+      return {3, 3, 3};
+    default:
+      throw std::runtime_error(
+          "a read address of " + std::to_string(bits)
+          + " bits is wider than the predecode takes (9): bank the port");
+  }
+}
+
+int Log2Exact(int n)
+{
+  int k = 0;
+  while ((1 << k) < n) {
+    ++k;
+  }
+  return k;
+}
