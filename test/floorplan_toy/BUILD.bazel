load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//:openroad.bzl", "orfs_flow", "orfs_macro", "orfs_run")
load("//tools/floorplan:floorplan.bzl", "floorplan_consume", "floorplan_extract", "floorplan_netlist", "floorplan_parent", "floorplan_pdk", "floorplan_plan")

# The global floorplan planner's toy (tools/floorplan, toy.sv): three
# blocks and the parent's glue, synthesised in seconds.

package(default_visibility = ["//visibility:private"])

exports_files(["toy.sv"])

orfs_macro(
    name = "fakeram7_256x34",
    lef = "//flow:platforms/asap7/lef/fakeram7_256x34.lef",
    lib = "//flow:platforms/asap7/lib/NLDM/fakeram7_256x34.lib",
    module_top = "fakeram7_256x34",
)

BLOCK_ARGS = {
    "CORE_UTILIZATION": "40",
    "PDN_TCL": "$(PLATFORM_DIR)/openRoad/pdn/BLOCK_grid_strategy.tcl",
    "PLACE_DENSITY": "0.6",
}

# FpMem is mostly memory, and its flow packs it as tightly as a
# memory-dominated block's flow does
BLOCKS = {
    "FpCore": ([], BLOCK_ARGS),
    "FpMem": (
        [":fakeram7_256x34"],
        BLOCK_ARGS | {
            "CORE_UTILIZATION": "70",
            "RTLMP_MIN_CHANNEL_SIZE": "4 4",
        },
    ),
    "FpVec": ([], BLOCK_ARGS),
}

# Each block's flow from the floorplan stage on reads the clean plan
# (floorplan_consume below): its outline replaces its utilisation, its
# pins go where the plan put them, on two layers per side as the plan
# allows. Synthesis never reads the plan.
[
    orfs_flow(
        name = block,
        abstract_stage = "grt",
        arguments = {k: v for k, v in arguments.items() if k != "CORE_UTILIZATION"} | {
            "IO_PLACER_H": "M2 M4",
            "IO_PLACER_V": "M3 M5",
        },
        extra_arguments = {"floorplan": [":clean_%s.args.json" % block]},
        macros = macros,
        sources = {
            "IO_CONSTRAINTS": [":clean_%s_pins.tcl" % block],
            "SDC_FILE": [":constraints.sdc"],
        },
        tags = ["manual"],
        verilog_files = [":toy.sv"],
    )
    for block, (macros, arguments) in BLOCKS.items()
]

# The parent's synthesis, the blocks kept as modules: the crossings
# between them are read from it.
orfs_flow(
    name = "fp_top",
    arguments = {
        "CORE_UTILIZATION": "30",
        "OPENROAD_HIERARCHICAL": "1",
        "SYNTH_HIERARCHICAL": "1",
        "SYNTH_KEEP_MODULES": "FpCore FpMem FpVec",
    },
    last_stage = "synth",
    macros = [":fakeram7_256x34"],
    sources = {"SDC_FILE": [":constraints.sdc"]},
    tags = ["manual"],
    verilog_files = [":toy.sv"],
)

# every synthesis the planner reads, in seconds; //test:local
build_test(
    name = "synth_build_test",
    tags = ["manual"],
    targets = [
        ":FpCore_synth",
        ":FpMem_synth",
        ":FpVec_synth",
        ":fp_top_synth",
    ],
    visibility = ["//test:__pkg__"],
)

# The planner's inputs: each block's facts and the platform's wire model.
[
    floorplan_extract(
        name = block,
        src = ":%s_synth" % block,
        arguments = arguments,
    )
    for block, (_, arguments) in BLOCKS.items()
]

# rung 1's netlists: Rent's fit and each bus's cones
[
    floorplan_netlist(
        name = block + "_netlist",
        src = ":%s_synth" % block,
    )
    for block in BLOCKS
]

floorplan_pdk(
    name = "asap7",
    src = ":FpCore_synth",
    visibility = ["//test:__subpackages__"],
)

# //test:local
py_test(
    name = "extract_test",
    srcs = ["extract_test.py"],
    args = ["$(rootpaths :%s)" % t for t in [
        "FpCore",
        "FpMem",
        "FpVec",
        "asap7",
        "fp_top_parent",
        "fp_top_macros_parent",
        "fp_top_macros_parent_FpCore",
        "fp_top_macros_parent_FpMem",
        "fp_top_macros_parent_FpVec",
    ]] + ["$(rootpath //test/macro_select:floorplan_calibration.json)"],
    data = [
        ":FpCore",
        ":FpMem",
        ":FpVec",
        ":asap7",
        ":fp_top_macros_parent",
        ":fp_top_macros_parent_FpCore",
        ":fp_top_macros_parent_FpMem",
        ":fp_top_macros_parent_FpVec",
        ":fp_top_parent",
        "//test/macro_select:floorplan_calibration.json",
    ],
    main = "extract_test.py",
    tags = ["manual"],
    visibility = ["//test:__pkg__"],
)

# The seeded faults (tools/floorplan/testdata/toy/constraints_*.json),
# each planned on the extracts above; plan_test reads the verdicts.
VARIANTS = {
    "area": "area FpMem - -",
    "path": "path_budget FpVec - deep_in",
    "aspect": "aspect FpMem - -",
    "channel": "channel_capacity FpMem - wide",
    "clean": "feasible - - -",
    "pins": "pins_per_um FpVec - wide",
    "wall": "internal_arrangement FpMem W -",
    "wire": "wire_demand FpCore - -",
}

[
    floorplan_plan(
        name = "plan_" + variant,
        blocks = [
            ":FpCore",
            ":FpMem",
            ":FpVec",
        ],
        calibration = "//tools/floorplan:testdata/toy/calibration.json",
        constraints = "//tools/floorplan:testdata/toy/constraints_%s.json" % variant,
        cut = "//tools/floorplan:testdata/toy/cut.json",
        netlists = [":%s_netlist" % b for b in BLOCKS],
        parent = ":fp_top_parent",
        pdk = ":asap7",
        tangles = [":%s_netlist_tangle" % b for b in BLOCKS],
    )
    for variant in VARIANTS
]

# //test:local
py_test(
    name = "plan_test",
    srcs = ["plan_test.py"],
    args = ["%s=$(rootpath :plan_%s/verdict.json)=%s" % (
        v,
        v,
        e.replace(" ", ","),
    ) for v, e in VARIANTS.items()],
    data = [":plan_%s/verdict.json" % v for v in VARIANTS],
    main = "plan_test.py",
    tags = ["manual"],
    visibility = ["//test:__pkg__"],
)

# the crossings between the blocks, from the parent's synthesis
floorplan_parent(
    name = "fp_top_parent",
    src = ":fp_top_synth",
    blocks = [
        "FpCore",
        "FpMem",
        "FpVec",
    ],
)

# The clean plan as the flows read it, and the parent built on it to
# global route: the blocks at their planned outlines and pins, placed
# where the plan put them. //test:local
floorplan_consume(
    name = "clean",
    macros = [
        "FpCore",
        "FpMem",
        "FpVec",
    ],
    plan = ":plan_clean",
)

orfs_flow(
    name = "fp_top",
    arguments = {
        "IO_PLACER_H": "M2 M4",
        "IO_PLACER_V": "M3 M5",
        "PDN_TCL": "$(PLATFORM_DIR)/openRoad/pdn/BLOCKS_grid_strategy.tcl",
        "PLACE_DENSITY": "0.5",
        "RTLMP_MIN_CHANNEL_SIZE": "2 2",
    },
    extra_arguments = {"floorplan": [":clean_parent.args.json"]},
    last_stage = "grt",
    # the memory too: toy.sv's FpMem names it, and only a macro's own
    # module is a blackbox to the parent's synthesis
    macros = [
        ":FpCore_generate_abstract",
        ":FpMem_generate_abstract",
        ":FpVec_generate_abstract",
        ":fakeram7_256x34",
    ],
    sources = {
        "MACRO_PLACEMENT_TCL": [":clean_place_macros.tcl"],
        "SDC_FILE": [":constraints.sdc"],
    },
    tags = ["manual"],
    variant = "planned",
    verilog_files = [":toy.sv"],
)

# the same crossings from the parent synthesised over the blocks'
# abstracts, each block a macro instance, and each block's facts from its
# macro: its outline and ports
floorplan_parent(
    name = "fp_top_macros_parent",
    src = ":fp_top_planned_synth",
    blocks = [
        "FpCore",
        "FpMem",
        "FpVec",
    ],
    macro_blocks = [
        "FpCore",
        "FpMem",
        "FpVec",
    ],
)

build_test(
    name = "planned_grt_build_test",
    tags = ["manual"],
    targets = [":fp_top_planned_grt"],
    visibility = ["//test:__pkg__"],
)

# The routed wire's ps per micron on the planned parent, against the wire
# model's (tools/floorplan/probe_wire.tcl).
orfs_run(
    name = "planned_wire",
    src = ":fp_top_planned_grt",
    outs = ["planned_wire.txt"],
    script = "//tools/floorplan:probe_wire.tcl",
    tags = ["manual"],
    user_arguments = {"PROBE_OUT": "$(location planned_wire.txt)"},
)

# //test:local
py_test(
    name = "wire_test",
    srcs = ["wire_test.py"],
    args = [
        "$(rootpath :planned_wire.txt)",
        "$(rootpath :asap7)",
    ],
    data = [
        ":asap7",
        ":planned_wire.txt",
    ],
    main = "wire_test.py",
    tags = ["manual"],
    visibility = ["//test:__pkg__"],
)
