        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0210-opensta-deleted-net-leaves-exceptions.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0210-opensta-deleted-net-leaves-exceptions.patch.' && exit 1)",
    ],
    patch_strip = 1,
    patches = [
        # detailed_placement checks, before its search, that the cells can be
