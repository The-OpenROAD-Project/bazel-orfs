"""bazel-orfs dependencies"""

module(
    name = "bazel-orfs",
    version = "0.0.1",
    # A hard stop, checked during module resolution before anything is
    # fetched or built, so an obsolete Bazel fails in seconds with a clear
    # message instead of hours later with a confusing one. It fires for
    # downstream consumers too, not just this repo, and their .bazelversion
    # does not have to agree with ours for it to bite.
    #
    # Kept equal to .bazelversion by //:bazel_version_test.
    bazel_compatibility = [">=9.1.1"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

# gperftools' CPU profiler for //tools/wall_profile, a wall-clock profile
# of a command's main thread.
bazel_dep(name = "gperftools", version = "2.19.1", dev_dependency = True)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "mock-klayout", version = "0.0.1", dev_dependency = True)
local_path_override(
    module_name = "mock-klayout",
    path = "mock/klayout",
)

bazel_dep(name = "abc", version = "0.68-yosyshq.bcr.1")

# Visible to .bazelrc's --@ncurses//:use_terminfo_data_target (abc and yosys ->
# readline -> ncurses), at the version the graph resolves anyway.
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.11", dev_dependency = True)

bazel_dep(name = "yosys", version = "0.68.bcr.1")

# Root-only, as every override. Each patch retires at the bump onto a BCR
# yosys that has its fix.
#
# 0001: write_xaiger2 wrote the white-box logic (holes) out of box order,
# so ABC's default &verify crashed on every abc_new run with two or more
# boxes, hidden as a warning. Fixed on yosys main after v0.69.
# 0002: abc_new took "-script" anywhere in its arguments, such as in a
# liberty path under OpenROAD-flow-scripts, for a given -script and
# dropped its default script. YosysHQ/yosys#6320, not fixed upstream.
single_version_override(
    module_name = "yosys",
    patch_strip = 1,
    patches = [
        "//patches:yosys-0001-aiger2-holes-output-order.patch",
        "//patches:yosys-0002-abc-new-script-option.patch",
    ],
)

# Tcl, for //fork: the fork/join extension is compiled against the same
# @tcl_lang the openroad module embeds (MVS keeps the two in lockstep), so
# the loadable .so always matches the interpreter that `load`s it. Non-dev:
# downstream roots build //fork:liborfsfork.so through orfs_run targets.
bazel_dep(name = "tcl_lang", version = "9.0.2.bcr.2")

# The slang frontend, sv-elab (formerly yosys-slang): the yosys plugin
# (slang.so), loaded via orfs.default(yosys_plugins=...) below since BCR
# yosys does not bundle it, and OpenROAD's syn, which compiles its sources.
# Non-dev: the orfs.default tag references @sv-elab, so the repo must stay
# visible even when bazel-orfs is consumed as a dependency (a dev dep is
# dropped for non-root modules). It also lets downstream roots reference
# the plugin label.
#
# OpenROAD pins sv-elab as its third-party/sv-elab submodule through a
# local_path_override, which Bazel honours only in the root module, and
# BCR has no release that recent. This override follows that submodule's
# sha instead: //:bump regenerates it with the openroad block, so the
# plugin and OpenROAD's syn always share one frontend. Retires when BCR
# carries the version OpenROAD asks for.
bazel_dep(name = "sv-elab", version = "2026-10-13")
archive_override(
    module_name = "sv-elab",
    integrity = "sha256-J6NDnArq4W0MSgpUlSGwV4TefkjZPvDc8/xEbkOK9LE=",
    patch_strip = 1,
    patches = [
        # A redefined net (`output q; wire q, q;`, which slang accepts with
        # -Wredefinition) gets a wire of its own that takes the port wire's
        # name; with --keep-hierarchy the module loses the port, and
        # nangate45/ariane133 failed canonicalization ("does not have a port
        # named 'flush_ex_o'"). The redefinition now shares the wire name
        # lookup finds. Not upstreamed; retires at a bump onto an sv-elab
        # that carries it.
        "//patches:sv-elab-0001-redefinition-shares-wire.patch",
    ],
    strip_prefix = "sv-elab-3e152133b9c22b7883a6a03d483ed35e8c74aba5",
    urls = ["https://github.com/povik/sv-elab/archive/3e152133b9c22b7883a6a03d483ed35e8c74aba5.tar.gz"],
)

# OpenROAD's web viewer bundles npm packages with rules_js, which below
# 3.5.0 links a package's dependencies wrongly when the package store is
# in an external repository's sub-package (aspect-build/rules_js#2864):
# @openroad//src/web:third_party_licenses fails on a missing
# package.json whenever OpenROAD is not the root module. A floor, not a
# use: retires when OpenROAD itself asks for rules_js >= 3.5.0.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "openroad")
archive_override(
    module_name = "openroad",
    integrity = "sha256-TRKcrSDXNUtr7Gr09u5g6UqIZEC7t6xVEO1oOMmsPxE=",
    # GitHub /archive/<sha>.tar.gz tarballs don't carry submodules,
    # so vendor src/sta (OpenSTA) and third-party/abc from their own
    # GitHub auto-archives at the SHAs OpenROAD's .gitmodules pins
    # to.  sha256sum -c verifies each tarball since patch_cmds bytes
    # aren't covered by archive_override's integrity.  Regenerated
    # by bump.py on every commit bump; do not edit by hand.
    patch_cmds = [
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-src-sta-bc7af6f02679074eaf43657488ca117c05f98eed.tar.gz https://github.com/The-OpenROAD-Project/OpenSTA/archive/bc7af6f02679074eaf43657488ca117c05f98eed.tar.gz && echo '03c801a4a91e5c96cde328fe1a321a02e984814d77fd5f00fc5b7e8b919a91e3  .openroad-submodule-src-sta-bc7af6f02679074eaf43657488ca117c05f98eed.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-src-sta-bc7af6f02679074eaf43657488ca117c05f98eed.tar.gz --strip-components=1 -C src/sta && rm .openroad-submodule-src-sta-bc7af6f02679074eaf43657488ca117c05f98eed.tar.gz",
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz https://github.com/The-OpenROAD-Project/abc/archive/d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz && echo '0cbf538e60d0303d0e00360d8973aaad7dae198954bed6e34cc31c9a13b3f802  .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz --strip-components=1 -C third-party/abc && rm .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz",
        # write_timing_model gave an output a constant drives no arc and
        # no function, so a parent found nothing arriving there and
        # check_setup called what it feeds unconstrained: 151 endpoints on
        # XSTile. Such an output now carries the constant. Not upstreamed;
        # retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0113-opensta-timing-model-constant-outputs.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0113-opensta-timing-model-constant-outputs.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0113-opensta-timing-model-constant-outputs.patch.' && exit 1)",
        # check_setup missed a register whose clock pin sees only the edge
        # it does not launch on (the clock network ignores transitions),
        # though no path through it was timed. Not upstreamed; retires at
        # a bump onto an OpenSTA that has it.
        # Extracted from //patches:0109-opensta-check-setup-launch-edge.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0109-opensta-check-setup-launch-edge.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0109-opensta-check-setup-launch-edge.patch.' && exit 1)",
        # check_setup counted an output port named by set_max_delay -to as
        # constrained and nothing else a set_max_delay names; extended to
        # set_max_delay generally, with "N unconstrained input ports".
        # Not upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0110-opensta-check-setup-max-delay.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0110-opensta-check-setup-max-delay.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0110-opensta-check-setup-max-delay.patch.' && exit 1)",
        # Search asked, at every edge a set_max_delay state crossed,
        # whether the pin completes the -to, through the -to's id-ordered
        # sets: a third of write_timing_model on a register file under
        # ORFS's asap7 SDC (OpenROAD#11933). The -to objects are now hashed
        # and asked first. Not upstreamed; retires at a bump onto an
        # OpenSTA that has it.
        # Extracted from //patches:0145-opensta-path-delay-to-hashed.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0145-opensta-path-delay-to-hashed.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0145-opensta-path-delay-to-hashed.patch.' && exit 1)",
        # A thread cached only the tags it made, so every tag another
        # thread made took tag_lock_ at each lookup (OpenROAD#11999). A tag
        # found in the shared set now goes into the thread's cache too.
        # Not upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0146-opensta-tag-cache-found-tags.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0146-opensta-tag-cache-found-tags.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0146-opensta-tag-cache-found-tags.patch.' && exit 1)",
        # findTagGroup took tag_group_lock_ for every lookup
        # (OpenROAD#11999); each arrival-search thread now caches the tag
        # groups it finds. Not upstreamed; retires at a bump onto an
        # OpenSTA that has it.
        # Extracted from //patches:0147-opensta-tag-group-cache.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0147-opensta-tag-group-cache.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0147-opensta-tag-group-cache.patch.' && exit 1)",
        # Every vertex a -from filter reaches was inserted into an ordered
        # set under one lock (OpenROAD#11999); each arrival-search thread
        # now collects them and adds them after the visit. Not upstreamed;
        # retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0148-opensta-filtered-arrivals-per-thread.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0148-opensta-filtered-arrivals-per-thread.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0148-opensta-filtered-arrivals-per-thread.patch.' && exit 1)",
        # write_timing_model visited an input's path ends on the main
        # thread alone (OpenROAD#11999); they are now visited on every
        # thread and the margins merged by max. Not upstreamed; retires at
        # a bump onto an OpenSTA that has it.
        # Extracted from //patches:0149-opensta-timing-model-parallel-path-ends.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0149-opensta-timing-model-parallel-path-ends.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0149-opensta-timing-model-parallel-path-ends.patch.' && exit 1)",
        # Each filtered search ended with scans of every tag group, tag
        # and clock info for the filter's (OpenROAD#11999); the ones a
