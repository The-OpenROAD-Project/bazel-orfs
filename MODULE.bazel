"""bazel-orfs dependencies"""

module(
    name = "bazel-orfs",
    version = "0.0.1",
    # A hard stop, checked during module resolution before anything is
    # fetched or built, so an obsolete Bazel fails in seconds with a clear
    # message instead of hours later with a confusing one. It fires for
    # downstream consumers too, not just this repo, and their .bazelversion
    # does not have to agree with ours for it to bite.
    #
    # Kept equal to .bazelversion by //:bazel_version_test.
    bazel_compatibility = [">=9.1.1"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "mock-klayout", version = "0.0.1", dev_dependency = True)
local_path_override(
    module_name = "mock-klayout",
    path = "mock/klayout",
)

bazel_dep(name = "abc", version = "0.68-yosyshq.bcr.1")
bazel_dep(name = "yosys", version = "0.68.bcr.1")

# Tcl, for //fork: the fork/join extension is compiled against the same
# @tcl_lang the openroad module embeds (MVS keeps the two in lockstep), so
# the loadable .so always matches the interpreter that `load`s it. Non-dev:
# downstream roots build //fork:liborfsfork.so through orfs_run targets.
bazel_dep(name = "tcl_lang", version = "9.0.2.bcr.2")

# The slang yosys frontend plugin (slang.so). yosys-slang was renamed to
# sv-elab and published on BCR; it's not bundled in BCR yosys, so we load
# it as an out-of-tree plugin via orfs.default(yosys_plugins=...) below.
# Non-dev: the orfs.default tag references @sv-elab, so the repo must stay
# visible even when bazel-orfs is consumed as a dependency (a dev dep is
# dropped for non-root modules). It also lets downstream roots reference
# the plugin label.
bazel_dep(name = "sv-elab", version = "2026-07-07")
bazel_dep(name = "openroad")
archive_override(
    module_name = "openroad",
    integrity = "sha256-zChLKCYFIrqgJyGR+VMZleaRmIOJK3LRRBCniH5Cldc=",
    # GitHub /archive/<sha>.tar.gz tarballs don't carry submodules,
    # so vendor src/sta (OpenSTA) and third-party/abc from their own
    # GitHub auto-archives at the SHAs OpenROAD's .gitmodules pins
    # to.  sha256sum -c verifies each tarball since patch_cmds bytes
    # aren't covered by archive_override's integrity.  Regenerated
    # by bump.py on every commit bump; do not edit by hand.
    patch_cmds = [
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-src-sta-65bd9df5f7846015313734d08a5a6367df79453c.tar.gz https://github.com/The-OpenROAD-Project/OpenSTA/archive/65bd9df5f7846015313734d08a5a6367df79453c.tar.gz && echo 'c2c47d7540d49c458bca977e9145eb129f97e33212deb2c27803a92ddaf6fae0  .openroad-submodule-src-sta-65bd9df5f7846015313734d08a5a6367df79453c.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-src-sta-65bd9df5f7846015313734d08a5a6367df79453c.tar.gz --strip-components=1 -C src/sta && rm .openroad-submodule-src-sta-65bd9df5f7846015313734d08a5a6367df79453c.tar.gz",
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz https://github.com/The-OpenROAD-Project/abc/archive/d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz && echo '0cbf538e60d0303d0e00360d8973aaad7dae198954bed6e34cc31c9a13b3f802  .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz --strip-components=1 -C third-party/abc && rm .openroad-submodule-third-party-abc-d527cfab4ad731b767ea0a2be2021d920d3afece.tar.gz",
        "curl -sSfL --retry 5 --retry-connrefused --retry-delay 5 -o .openroad-submodule-third-party-slang-elab-82effc8d9541be69e1ed3ec44759a4449f5d9247.tar.gz https://github.com/povik/yosys-slang/archive/82effc8d9541be69e1ed3ec44759a4449f5d9247.tar.gz && echo 'ea31b4a205ebb1fe5ec3789bcd66f21f4975e73c0901622af667f843b833ff10  .openroad-submodule-third-party-slang-elab-82effc8d9541be69e1ed3ec44759a4449f5d9247.tar.gz' | sha256sum -c - && tar xzf .openroad-submodule-third-party-slang-elab-82effc8d9541be69e1ed3ec44759a4449f5d9247.tar.gz --strip-components=1 -C third-party/slang-elab && rm .openroad-submodule-third-party-slang-elab-82effc8d9541be69e1ed3ec44759a4449f5d9247.tar.gz",
        "find . -name BUILD -exec sed -i 's|\"@slang\"|\"@sv-lang//:libsvlang\"|g' {} +",
        "sed -i 's|defines = \\[|copts = [\"-include\", \"fmt/format.h\"],\\n    defines = [|' src/syn/src/elab/BUILD third-party/slang-elab/src/BUILD",
    ],
    patch_strip = 1,
    patches = [
        # openroad reads the command file with sta::include_file, one
        # command at a time, so a failure is reported as a single line
        # with the tcl stack trace discarded, and an unbalanced brace as
        # "incomplete command at end of file" with no line at all.
        # -tcl_source reads it with tcl's source instead, which is what
        # the gui path already does. Nothing in OpenSTA changes and
        # include_file stays the default. ORFS passes the flag via
        # patches/0069-orfs-openroad-args-tcl-source.patch.
        # Not upstreamed -- retire at a bump onto an OpenROAD carrying it.
        "//patches:0001-openroad-tcl-source-flag.patch",
        # write_pin_placement wrote the pin name bare, so its output only
        # read back through the .sdc unknown handler above; on stock tcl
        # place_pin -pin_name R0_addr[0] fails on the [0]. Brace the name
        # so the file the tool writes is the tcl it means.
        # Not upstreamed -- retire at a bump onto an OpenROAD carrying it.
        "//patches:0004-openroad-write-pin-placement-brace-names.patch",
        # 27 tcl call sites in OpenROAD name a command by a unique prefix
        # of its real name (utl::metric_int, sta::check_positive_int, ...)
        # and only resolved through the .sdc unknown handler's abbreviation
        # lookup; on stock tcl the place stage fails at the first one.
        # Spell each one out.
        # Not upstreamed -- retire at a bump onto an OpenROAD carrying it.
        "//patches:0005-openroad-tcl-full-command-names.patch",
    ],
    strip_prefix = "OpenROAD-c7e5e75131a65e402a2d46a1cb82659d725655da",
    urls = ["https://github.com/The-OpenROAD-Project/OpenROAD/archive/c7e5e75131a65e402a2d46a1cb82659d725655da.tar.gz"],
)

# OpenROAD pins sv-lang 10.0.bcr.2, which is not yet published in BCR.
# Force the resolution to the latest published version until BCR catches up.
single_version_override(
    module_name = "sv-lang",
    version = "10.0.1-20260316-f04e8156",
)

# sed (transitive: abc -> ncurses -> sed): its vendored gnulib headers shadow
# libc headers (stdio.h, error.h), which hermetic-llvm's explicit libc -isystem
# entries outrank, so 4.9.bcr.3 fails to compile (BCR #7642). 4.9.bcr.5 carries
# the upstream fix (BCR #7915). (The old toolchains_llvm-era memchr patch_cmds
# is gone: it dodged a host glibc 2.41+ _Generic collision that the zero-sysroot
# hermetic-llvm toolchain no longer triggers.)
single_version_override(
    module_name = "sed",
    version = "4.9.bcr.5",
)

# --- hermetic-llvm compatibility (mirrored from OpenROAD's root MODULE.bazel) ---
# The BCR "llvm" toolchain is zero-sysroot: glibc headers arrive as explicit
# -isystem dirs that outrank the vendored gnulib/minizip headers these
# build-time deps ship. OpenROAD applies these fixes as the root module, so
# they don't propagate when we build @openroad as a dependency — every root
# that builds OpenROAD from source must repeat them. Keep in sync on each bump.

# bison (transitive: rules_bison -> bison): gnulib wrapper headers must precede
# libc via -I, not -isystem (BCR #7642). Still unfixed upstream: 3.8.2.bcr.8
# is published but is an unrelated change (its BUILD.bazel overlay is
# byte-identical to bcr.7's), so the patch stays and the pin stays here.
single_version_override(
    module_name = "bison",
    patch_strip = 1,
    patches = [
        "//patches:0001-gnulib-wrapper-headers-use-I-not-isystem.patch",
    ],
    version = "3.8.2.bcr.7",
)

# boost.icl: exclusive_less_than violates strict weak ordering (boostorg/icl#51);
# under libc++ this leaves phantom intervals after interval_set subtraction
# (#55), misplacing pad fillers. Upstream fix (#54) lands after boost 1.90.
single_version_override(
    module_name = "boost.icl",
    patch_strip = 1,
    patches = [
        "//patches:0001-refactor-interval-lookup-operations-icl-54.patch",
    ],
)

# rules_flex (transitive: openroad -> rules_flex): 0.3.1 uses the global
# `CcInfo` symbol, which Bazel 9 removed in favour of an explicit
# `load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")`. 0.4 adds that load
# and changes nothing else, so it is a no-op on Bazel 8.
#
# Not 0.4.1: it deletes flex/internal/toolchain_info.bzl, which is what puts
# `M4` (and the rest of m4_env) into `flex_toolchain.flex_env`. 0.4.1 sets M4
# inside its own flex_action instead, so a rule that drives flex from the
# toolchain directly gets an empty environment and flex dies looking for m4.
# @openroad's bazel/flex.bzl genlex is exactly such a rule -- it reads
# flex_env and rewrites the .runfiles/ paths in it -- so 0.4.1 breaks every
# OpenSTA lexer with a bare `flex failed: (Exit 1)`.
single_version_override(
    module_name = "rules_flex",
    version = "0.4",
)

# scip (transitive: openroad -> or-tools -> scip): 9.2.3's BUILD overlay
# calls cc_library with no load(); Bazel 9 removed the autoloaded native
# rules. 9.2.3.bcr.1 is the same SCIP with the load() added.
single_version_override(
    module_name = "scip",
    version = "9.2.3.bcr.1",
)

# rules_bison (transitive: openroad -> rules_bison): the BUILD its
# bison_repository generates calls cc_binary/cc_library with no load(),
# which Bazel 9 rejects. 0.4.bcr.1 emits the loads; its toolchain_info.bzl is
# unchanged from 0.3.1, so @openroad's bazel/bison.bzl genyacc -- which reads
# `bison_env["M4"]` and `["BISON_PKGDATADIR"]` straight off the toolchain --
# keeps working.
single_version_override(
    module_name = "rules_bison",
    version = "0.4.bcr.1",
)

# gawk (transitive: abc -> ncurses -> gawk; yosys -> gawk): same gnulib
# libc-header shadowing as sed (BCR #7642); 5.3.2.bcr.7 has the fix (BCR #7989).
single_version_override(
    module_name = "gawk",
    version = "5.3.2.bcr.7",
)

# m4 (transitive: rules_bison/rules_flex -> m4): same gnulib libc-header
# shadowing under hermetic-llvm (BCR #7642).
single_version_override(
    module_name = "m4",
    version = "1.4.21.bcr.4",
)

# sv-lang pulls in rules_pycross, whose toolchain extension fails on Python
# 3.8 (transitively registered via or-tools -> pybind11_abseil, dropped
# from rules_python 2.0.0's MINOR_MAPPING). pycross.configure_environments
# is root-honored only, so the workaround must live here (mirrored from
# upstream OpenROAD's MODULE.bazel, which can't apply it from non-root).
single_version_override(
    module_name = "rules_pycross",
    patch_strip = 0,
    patches = ["//patches:rules_pycross_no_warning.patch"],
)

# pybind11_abseil (transitive: openroad -> or-tools): its pip extension
# names its hub "pypi", which rules_python now reserves:
#
#   WARNING: The PyPI hub name 'pypi' is reserved (module 'pybind11_abseil').
#   Please rename your hub, otherwise a future release will rename it to
#   'pybind11_abseil_pypi'.
#
# once per supported Python version, so five copies on every build.
# Upstream marks both of its python extensions dev_dependency; BCR's
# module-dot-bazel-dev-dependency.patch strips that marker off both. The
# toolchain one has to stay non-dev -- the cc targets we build need a
# Python toolchain -- but the pip one only feeds pybind11_abseil's own
# py_tests, which no consumer builds. So restore the marker on pip alone:
# a dev usage of a non-root module is ignored, the hub is never created,
# and the warning goes with it. Retires when BCR narrows its patch or
# upstream renames the hub.
single_version_override(
    module_name = "pybind11_abseil",
    patch_strip = 0,
    patches = ["//patches:pybind11_abseil_quiet.patch"],
    version = "202402.0",
)

# protoc-gen-validate: strip unused python/pip extensions whose unhashed
# requirements.txt causes rules_python to emit hundreds of DEBUG warnings.
single_version_override(
    module_name = "protoc-gen-validate",
    patch_strip = 0,
    patches = ["//patches:protoc_gen_validate_quiet.patch"],
    version = "1.0.4.bcr.2",
)

# grpc: strip unused python/pip extensions whose unhashed
# requirements.txt causes rules_python to emit hundreds of DEBUG warnings.
single_version_override(
    module_name = "grpc",
    patch_strip = 0,
    patches = ["//patches:grpc_quiet.patch"],
    version = "1.69.0",
)

# rules_jvm_external emits a DEBUG message when multiple modules contribute
# to the maven repo.
single_version_override(
    module_name = "rules_jvm_external",
    patch_strip = 0,
    patches = ["//patches:rules_jvm_external_quiet.patch"],
)

# dev_dependency: configure_environments above is root-honored only, so
# this pair does nothing for a downstream root, which must repeat it (as
# ORFS does). sv-lang keeps pulling rules_pycross in transitively.
bazel_dep(name = "rules_pycross", version = "0.8.3", dev_dependency = True)

pycross = use_extension("@rules_pycross//pycross/extensions:pycross.bzl", "pycross", dev_dependency = True)
pycross.configure_environments(python_versions = ["3.13"])

# dev_dependency: this version-less bazel_dep only exists so the root-only
# git_override below has something to apply to. Downstream, openroad's own
# bazel_dep(qt-bazel) plus the consumer's root override carry it, as
# README.md and docs/openroad.md already require.
bazel_dep(name = "qt-bazel", dev_dependency = True)
git_override(
    module_name = "qt-bazel",
    commit = "5587ebcaf61bab7abe8e69c4db6d068b35562245",
    # openroad-qt is on a deprecation track; we don't expect Qt to change much.
    # Build xcb-util-cursor from source so the Qt xcb platform plugin
    # doesn't depend on the host having libxcb-cursor0 installed.
    # The source files are vendored in the patch to avoid flaky upstream fetches.
    patch_strip = 1,
    patches = [
        "//patches:qt-bazel-xcb-cursor-from-source.patch",
    ],
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)

# libxcb: its c_client py_binary relies on rules_python's implicit
# __init__.py creation, which is deprecated and prints a DEBUG warning on
# every build. The overlay BUILD.bazel is BCR's, so the fix is a patch on
# it: the only package c_client imports, xcbgen, ships its own
# __init__.py, so legacy_create_init = 0 costs nothing. Retires when BCR
# carries the attribute.
single_version_override(
    module_name = "libxcb",
    patch_strip = 0,
    patches = ["//patches:libxcb_explicit_init_py.patch"],
    version = "1.17.0.bcr.2",
)

# Hermetic C++ toolchain for building OpenROAD (and yosys, gnumake) from
# source: the BCR "llvm" module (hermetic-llvm) — the same statically linked,
# zero-sysroot LLVM that OpenROAD itself registers. No host compiler and no
# dynamic libxml2 link, so the old toolchains_llvm + patched LLVM tarball +
# tools/xml-hack libxml2 stub are gone. dev_dependency: only bazel-orfs's own
# from-source tests build OpenROAD; downstream roots register their own (and
# OpenROAD's own registration is likewise dev-only, so it doesn't propagate).
#
# 0.8.18, not the newest: 0.8.19 moves the prebuilt compiler from LLVM
# 22.1.8 to 23.1.0, and a compiler major bump is a different change from
# picking up seven revisions of module fixes. 0.8.18 is the last release
# still on 22.1.8, so this is the toolchain we already build with plus
# whatever upstream fixed around it. The 23.1.0 move belongs in its own
# commit, with an OpenROAD build behind it.
bazel_dep(name = "llvm", version = "0.8.18", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# --- Verilator, dev-only -----------------------------------------------
#
# Nothing shipped uses these: they exist so this repository can simulate
# the RTL it hardens, which is what //test/verilator_smoke exercises. A
# consumer of bazel-orfs must never resolve a simulator to build a flow,
# so both are dev_dependency and public_surface.py enforces it.
bazel_dep(name = "rules_verilog", version = "1.4.3", dev_dependency = True)
bazel_dep(name = "rules_verilator", version = "1.1.2", dev_dependency = True)

# iverilog: the event-driven simulator, for glitch power (paper, 5.2).
#
# Verilator cannot do this job and never will: it parses $sdf_annotate
# and specify blocks and discards them with a SPECIFYIGN warning, because
# its speed comes from evaluating a cycle as compiled straight-line code
# and intra-cycle delay ordering is exactly what that model throws away.
# A glitch is a transition that happens because two inputs arrive at
# different times, so measuring one needs back-annotated path delays and
# therefore an event-driven simulator.
#
# Dev-only for the same reason as the two above: a consumer of
# bazel-orfs must never resolve a simulator to build a flow.
bazel_dep(name = "iverilog", version = "13.0.bcr.1", dev_dependency = True)

# verilator: rules_verilator pins 5.046.bcr.3, whose cc_binary links
# -latomic unconditionally on Linux. That is a libgcc-era assumption --
# libatomic is GCC's out-of-line fallback, shipped next to libgcc on
# glibc distributions. The llvm toolchain above is zero-sysroot, its
# runtime is compiler-rt, and it ships no libatomic at all, so the tool
# does not link here:
#
#     ld.lld: error: unable to find library -latomic
#
# Nothing in verilator needs it: every atomic in its sources is on a type
# clang lowers inline on x86-64 and aarch64, so the out-of-line __atomic_*
# calls that would require the library are never emitted. On a toolchain
# that does ship libatomic, dropping the flag costs an unused -l.
#
# Later BCR revisions are the first place to look when this can retire.
single_version_override(
    module_name = "verilator",
    patch_strip = 1,
    patches = [
        "//patches:0001-verilator-drop-latomic-under-zero-sysroot-llvm.patch",
    ],
    version = "5.046.bcr.3",
)

# The same problem one level up: verilated_runtime puts -latomic on every
# generated simulator's link line, not only on verilator's own binary.
single_version_override(
    module_name = "rules_verilator",
    patch_strip = 1,
    patches = [
        "//patches:0001-rules_verilator-drop-latomic-under-zero-sysroot-llvm.patch",
    ],
    version = "1.1.2",
)

# 2.3.2, not 2.0.0: every module in the graph that depends on rules_python
# (protobuf, sv-lang, yosys, rules_pkg, ...) asks for 2.3.2, so MVS resolves
# there and a lower root pin only buys a --check_direct_dependencies warning
# on every invocation. Raise this to whatever `bazelisk mod explain
# rules_python` reports once a bump moves the graph again.
bazel_dep(
    name = "rules_python",
    version = "2.3.2",
)

# No implicit __init__.py in any py target of this repo: the behaviour is
# deprecated upstream (bazel-contrib/rules_python#2945) and warns on every
# fresh analysis. Root-honored only, so it covers this repo's own targets;
# the shipped public tools set legacy_create_init on the target instead, so
# downstream consumers running them stay quiet too.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    extra_pip_args = [
        "--index-url=https://pypi.org/simple",
    ],
    hub_name = "bazel-orfs-pip",
    python_version = "3.13",
    quiet = True,
    requirements_lock = "//:requirements_lock_3_13.txt",
)
use_repo(pip, "bazel-orfs-pip")

pip_dev = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip_dev.parse(
    extra_pip_args = [
        "--index-url=https://pypi.org/simple",
    ],
    hub_name = "bazel-orfs-dev-pip",
    python_version = "3.13",
    quiet = True,
    requirements_lock = "//:requirements_dev_lock_3_13.txt",
)
use_repo(pip_dev, "bazel-orfs-dev-pip")

orfs = use_extension("//:extension.bzl", "orfs_repositories")

# The ORFS version. This is the same public API bazel-orfs asks its
# consumers to use -- OpenROAD sets exactly these two attributes and
# carries no patches, no strip_prefix and no URL construction, because
# `patches` on an override is honoured only from the root module and
# would therefore land on whoever is root. Rewritten by //:bump.
orfs.source(
    commit = "a71b115b9b7b95fc843e715bdebd557147ef98fc",
    integrity = "sha256-GD++DHWNHHHcQT/ib4V+fvQoanC3MT/k6iQE2t4oWHc=",
)
orfs.default(
    # Expose the slang yosys plugin (from BCR sv-elab) via
    # YOSYS_PLUGIN_PATH so SYNTH_HDL_FRONTEND=slang works.
    yosys_plugins = ["@sv-elab//src/yosys_plugin:slang.so"],
)
use_repo(orfs, "config")
use_repo(orfs, "gnumake")

# ORFS itself. Created by the extension rather than declared as a
# bazel_dep so that bazel-orfs -- not whichever module happens to be
# root -- owns the patches. See orfs_source.bzl.
use_repo(orfs, "orfs")
use_repo(orfs, "orfs_variable_metadata")

# @orfs's design BUILD files load design() from @orfs_designs, which ORFS
# used to declare in its own MODULE.bazel. With ORFS consumed as an
# archive that file is never read, so the declaration moves here. A
# consumer with its own designs directory still calls orfs_designs()
# itself; this instance is specifically ORFS's.
orfs_designs = use_repo_rule("//private:designs.bzl", "orfs_designs")

orfs_designs(
    name = "orfs_designs",
    designs_dir = "@orfs//flow/designs:BUILD",
    # Only bazel-orfs as root loads @orfs//flow/designs/...; ORFS and
    # OpenROAD instantiate their own orfs_designs, so this one is dev-only
    # and a downstream root never has to resolve it.
    dev_dependency = True,
    # MODULE.bazel cannot load(), so this list is spelled out rather
    # than shared with ORFS_BAZEL_PLATFORMS in orfs_source.bzl, which
    # drives design BUILD generation. //test:orfs_platforms_test holds
    # the two copies in agreement.
    platforms = [
        "asap7",
        "gf180",
        "ihp-sg13g2",
        "nangate45",
        "sky130hd",
        "sky130hs",
    ],
)

# A second designs tree, dev-only, at a depth that is not ORFS's. The
# code that turns a "//" label in a config.mk into a file path has to
# strip as many package components as the tree actually has;
# "test/designs_fixture/designs" is three where "flow/designs" is two,
# so this is the fixture that notices when it strips the wrong number.
# //test/designs_fixture is what asserts the tree was discovered at all.
orfs_designs(
    name = "designs_fixture",
    designs_dir = "//test/designs_fixture/designs:BUILD.bazel",
    dev_dependency = True,
    platforms = ["asap7"],
)

# The config.mk DSL fixtures under flow/designs/ (see flow/BUILD): the same
# repository rule, parsing this repository's own fixture configs, so the
# DSL path every ORFS design takes can be tested here in seconds. Must
# stay below the ORFS instance: //test:orfs_platforms_test reads the
# first orfs_designs() call it finds.
orfs_designs(
    name = "bazel_orfs_test_designs",
    designs_dir = "//flow/designs:BUILD",
    dev_dependency = True,
    platforms = ["asap7"],
)

# --- //test/coremark_joule: the CoreMark-per-Joule study -------------------
#
# Everything below belongs to one study under test/, which is never
# shipped (see public_surface.py), so all of it is dev-only: a consumer
# of bazel-orfs must never resolve a RISC-V toolchain or a CPU core to
# build a flow.
#
# The RTL is fetched, never vendored: an http_archive pinned by sha256
# plus a small BUILD overlay in this repository. That is the pattern the
# retired gallery/ workspace used for every core it hardened.

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# xPack's bare-metal RISC-V GCC. Chosen over a hermetic LLVM because the
# rv32i multilib ships libgcc, and on a core without the M extension
# __mulsi3 is on CoreMark's hot path -- a hand-written replacement would
# make SERV's score a measurement of our shift-add loop rather than of
# SERV. The BCR "llvm" module cannot stand in: its RISC-V support is
# riscv64 Linux, hard-wired to rv64gc.
http_archive(
    name = "riscv_none_elf_gcc",
    build_file = "//test/coremark_joule/sw:toolchain.BUILD.bazel",
    dev_dependency = True,
    sha256 = "52545afb900200fbf65fe05f7ce7090b8a42c64091f4f5d43cae6bb68ea2434a",
    strip_prefix = "xpack-riscv-none-elf-gcc-13.2.0-2",
    urls = ["https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v13.2.0-2/xpack-riscv-none-elf-gcc-13.2.0-2-linux-x64.tar.gz"],
)

# CoreMark, unmodified. The platform lives entirely in
# //test/coremark_joule/sw/port, which is the porting surface CoreMark
# documents; its Acceptable Use Agreement forbids naming the trademark
# in connection with a modified copy of the Software.
http_archive(
    name = "coremark",
    build_file = "//test/coremark_joule/sw:coremark.BUILD.bazel",
    dev_dependency = True,
    sha256 = "4067e7f260218df13f2875d8f821a8ff32a84153c6e0759d7c89f96c0a8bf987",
    strip_prefix = "coremark-1f483d5b8316753a742cbf5590caf5bd0a4e4777",
    urls = ["https://github.com/eembc/coremark/archive/1f483d5b8316753a742cbf5590caf5bd0a4e4777.tar.gz"],
)

# SERV, the bit-serial RV32I core. Its register file lives in an SRAM
# (serv_rf_ram) rather than in flops, which is the core's whole
# architectural trick -- and the reason AUTO_MEMORIES matters most here:
# hardened as flops that register file would dominate the area and power
# of a ~2k-cell core, and the measurement would be of the wrong thing.
http_archive(
    name = "serv",
    build_file = "//test/coremark_joule/rtl:serv.BUILD.bazel",
    dev_dependency = True,
    sha256 = "43d99e7032dc936e5a9cd106be0a46a7d411c2c80e5c0310536f51c905cac3f2",
    strip_prefix = "serv-f200eb2ed7b69ac1c6b8eddd47654522aeee5ce8",
    urls = ["https://github.com/olofk/serv/archive/f200eb2ed7b69ac1c6b8eddd47654522aeee5ce8.tar.gz"],
)

# ibex, from upstream. ORFS ships an ibex_sv whose own README says it is
# a pruned clone of lowRISC at commit 77d8010 -- a years-old snapshot
# whose top is ibex_core.sv rather than upstream's ibex_top.sv, so it is
# a different DUT and not the one lowRISC's own bare-metal CoreMark port
# targets.
http_archive(
    name = "ibex",
    build_file = "//test/coremark_joule/rtl:ibex.BUILD.bazel",
    dev_dependency = True,
    # The vendored OpenTitan tree ships its own BUILD files, which make
    # vendor/lowrisc_ip/ip/prim and its siblings separate Bazel packages
    # -- and a glob cannot cross a package boundary, so the overlay's
    # filegroups would silently match nothing. Removing them lets the
    # overlay own the whole tree. Nothing here builds OpenTitan's own
    # targets; only the .sv files are wanted.
    patch_cmds = [
        "find vendor -name BUILD -o -name BUILD.bazel | xargs -r rm -f",
    ],
    sha256 = "34fba9a683428bbe7ec05258eb1b9a340bf30f5e7804ffedf03afcdb97a37d82",
    strip_prefix = "ibex-405c6d1d8220a18b2f9196141167a5875422dee4",
    urls = ["https://github.com/lowRISC/ibex/archive/405c6d1d8220a18b2f9196141167a5875422dee4.tar.gz"],
)

# VeeR EH1, from upstream chipsalliance -- not from ORFS, whose
# asap7/swerv_wrapper vendors the core as one 6.3 MB mechanically
# sv2v-converted file, snapshotted from the pre-CHIPS-Alliance
# westerndigitalcorporation/swerv_eh1 at 3ef7e65f with a configuration
# that was baked in before the conversion and is recorded nowhere. The
# ICCM, DCCM and icache sizes are what the study's core-plus-L1 boundary
# makes load-bearing, so "the default configuration" is not a claim this
# study can pass on -- especially since upstream's own CoreMark
# configuration is not a target preset at all: it raises the BTB and BHT
# sixteenfold over the default, and that is the configuration its
# published 4.94 CoreMark/MHz was measured on. The configuration
# measured here keeps that branch predictor and runs the benchmark out
# of the 16 kB instruction cache and the 64 kB DCCM rather than out of
# an ICCM, because the ICCM has no store path from the core and the
# hierarchical force upstream's testbench uses to fill it does not
# survive to the gate-level netlist that produces the SAIF. It is
# generated once by upstream's own generator and committed under
# //test/coremark_joule/rtl/veer/config.
http_archive(
    name = "veer",
    build_file = "//test/coremark_joule/rtl:veer.BUILD.bazel",
    dev_dependency = True,
    # VeeR names its three Verilog headers `.h`, and rules_verilog's
    # verilog_library accepts only `.vh`/`.svh` in `hdrs` -- which is the
    # attribute whose file paths become the include search path. Passing
    # them as `data` instead does deliver the files, but contributes no
    # `-I`, and the `includes` attribute is resolved relative to the
    # declaring package, which does not reach an external repository.
    #
    # So: rename the headers and rewrite the four `include directives
    # that name them. This is a filename change and nothing else --
    # mechanically checkable, and deliberately not the kind of
    # wholesale mechanical translation that makes ORFS's vendored copy
    # unusable for this study. Order matters: rewrite the directives
    # before the files move, or the sed finds nothing.
    patch_cmds = [
        "find design -name '*.sv' -o -name '*.v' | xargs sed -i -e 's|include \"build.h\"|include \"build.vh\"|' -e 's|include \"global.h\"|include \"global.vh\"|' -e 's|include \"pic_map_auto.h\"|include \"pic_map_auto.vh\"|'",
        "mv design/include/build.h design/include/build.vh",
        "mv design/include/global.h design/include/global.vh",
    ],
    sha256 = "2a5cb82c7f671d3985d052a3e47c9ff344982a81bb6370798f1846edf47c2517",
    strip_prefix = "Cores-VeeR-EH1-695883a674c4a59cf96fae874ff4bfac5fecf4e8",
    urls = ["https://github.com/chipsalliance/Cores-VeeR-EH1/archive/695883a674c4a59cf96fae874ff4bfac5fecf4e8.tar.gz"],
)

# picorv32, from upstream. ORFS carries no picorv32 at all, so there is
# nothing to choose between.
http_archive(
    name = "picorv32",
    build_file = "//test/coremark_joule/rtl:picorv32.BUILD.bazel",
    dev_dependency = True,
    sha256 = "e19413edc589a9022eb96a8c436170ea5019236bb897ac9eb7813899920ea70c",
    strip_prefix = "picorv32-87c89acc18994c8cf9a2311e871818e87d304568",
    urls = ["https://github.com/YosysHQ/picorv32/archive/87c89acc18994c8cf9a2311e871818e87d304568.tar.gz"],
)

# The study's own designs (//test/coremark_joule/designs): a third
# orfs_designs() instance, so the three cores get the same generated flow
# targets and the same auto_floorplan derivation that every ORFS design
# gets, without patching an ORFS checkout. Must stay below the two
# instances above: //test:orfs_platforms_test reads the first one it
# finds.
orfs_designs(
    name = "coremark_joule_designs",
    designs_dir = "//test/coremark_joule/designs:BUILD",
    dev_dependency = True,
    platforms = ["asap7"],
)
