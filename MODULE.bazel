        # Extracted from //patches:0151-opensta-filtered-endpoints-parallel.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0151-opensta-filtered-endpoints-parallel.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0151-opensta-filtered-endpoints-parallel.patch.' && exit 1)",
        # One lock guarded every tag group lookup and creation
        # (OpenROAD#11999); the set is now 64 shards with a lock each,
        # tag_group_lock_ left guarding indices and tag_groups_. Not
        # upstreamed; retires at a bump onto an OpenSTA that has it.
        # Extracted from //patches:0152-opensta-tag-group-shards.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0152-opensta-tag-group-shards.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0152-opensta-tag-group-shards.patch.' && exit 1)",
    ],
    patch_strip = 1,
    patches = [
        # detailed_placement checks, before its search, that the cells can be
