        # Extracted from //patches:0150-opensta-filter-leftovers-listed.patch
        "echo  | base64 -d | patch -p1 || (echo 'ERROR: Patch //patches:0150-opensta-filter-leftovers-listed.patch failed to apply to submodule. Please rebase the source of truth patch at //patches:0150-opensta-filter-leftovers-listed.patch.' && exit 1)",
        # filteredEndpoints asked isEndpoint of every filtered vertex on
