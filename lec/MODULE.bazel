"""Bazel rules wrapping kepler-formal for logic equivalence checking.

A module of its own, ignored by bazel-orfs's build (.bazelignore):
kepler-formal's dependencies are not all on the Bazel Central Registry
yet, and the registries that stand in for them (.bazelrc here) must not
reach bazel-orfs's consumers. Retires into a dev_dependency of bazel-orfs
once kepler-formal and its dependencies are on BCR.
"""

module(
    name = "bazel-orfs-lec",
    version = "0.0.1",
)

# kepler-formal's main, never an old release: the tool is being fixed
# rapidly. Bump the commit here and the registry URL in .bazelrc together.
bazel_dep(name = "kepler-formal")
git_override(
    module_name = "kepler-formal",
    commit = "acb85ea8eb7b733ee8269d103df7b37f8c28fe4f",
    remote = "https://github.com/keplertech/kepler-formal.git",
)

# kepler-formal builds with its hermetic LLVM toolchain; its registration
# is a dev_dependency there and does not propagate, so register it here.
bazel_dep(name = "llvm", version = "0.8.24")

llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")
