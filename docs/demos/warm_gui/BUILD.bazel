load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# "ORFS, at the speed of your ideas": a short video for ORFS users on what
# bazel-orfs is, ORFS with a memory, and why it is worth a closer look.
# ideas/videos.md has the series it starts and the rules it follows.
#
#   bazelisk build //docs/demos/warm_gui:video     # 1920x1080
#   bazelisk build //docs/demos/warm_gui:sample    # one scene, to judge pace
#
# Narrated offline by Piper's pinned ljspeech voice as a draft (public
# domain, its MODEL_CARD is in the runfiles), encoded by the ffmpeg
# imageio-ffmpeg pins.

py_binary(
    name = "video_bin",
    srcs = [
        "script.py",
        "video.py",
    ],
    data = ["@piper_voice_card//file"],
    main = "video.py",
    deps = [
        "@bazel-orfs-dev-pip//imageio_ffmpeg",
        "@bazel-orfs-dev-pip//pillow",
        "@bazel-orfs-dev-pip//piper_tts",
    ],
)

[genrule(
    name = name,
    srcs = [
        "@piper_voice_json//file",
        "@piper_voice_onnx//file",
    ],
    outs = [
        "warm_gui_%s.mp4" % name,
        "warm_gui_%s.srt" % name,
    ],
    cmd = " ".join([
        "$(execpath :video_bin)",
        "--script",
        script,
        "--format",
        fmt,
        "--voice-onnx $(execpath @piper_voice_onnx//file)",
        "--voice-json $(execpath @piper_voice_json//file)",
        "--out $(execpath warm_gui_%s.mp4)" % name,
        "--srt $(execpath warm_gui_%s.srt)" % name,
    ]),
    tags = ["manual"],
    tools = [":video_bin"],
) for name, script, fmt in [
    ("video", "full", "landscape"),
    # One scene, to judge the pace before a full render.
    ("sample", "sample", "landscape"),
]]

# Two sentences in each format encode, with sound, at the right size.
py_test(
    name = "video_test",
    size = "medium",
    srcs = [
        "script.py",
        "video.py",
        "video_test.py",
    ],
    args = [
        "$(rootpath @piper_voice_onnx//file)",
        "$(rootpath @piper_voice_json//file)",
    ],
    data = [
        "@piper_voice_json//file",
        "@piper_voice_onnx//file",
    ],
    main = "video_test.py",
    deps = [
        "@bazel-orfs-dev-pip//imageio_ffmpeg",
        "@bazel-orfs-dev-pip//pillow",
        "@bazel-orfs-dev-pip//piper_tts",
    ],
)
