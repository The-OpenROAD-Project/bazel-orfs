+    if (!allocated[i]) {
+      t->offset_in_bytes_ = slot * sizeof(T);
+      t->oid_ = obj_oid;
+      const uint32_t next = free_links[next_link++];
+      const uint32_t prev = free_links[next_link++];
+      setFreeLinks(t, next, prev);
+      continue;
+    }
