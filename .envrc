# Loads shell.nix when nix is installed; does nothing otherwise, and
# bazelisk from the host works as before. See README.md, "Optional: nix
# and direnv".
if has nix; then
  if ! has nix_direnv_version || ! nix_direnv_version 3.1.2; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.2/direnvrc" "sha256-Di03ad3a0ueGi6CGrfhrQzyGdQIg9APXIPCAMNQgWYM="
  fi

  # nix-direnv names its cache after the version <nixpkgs> resolves to, so
  # an unpinned NIX_PATH re-evaluates the shell every time the ambient
  # channel moves. Pin it to the nixpkgs shell.nix uses.
  pinned_nixpkgs=$(nix-instantiate --eval --json -E '(import ./npins).nixpkgs.outPath' 2>/dev/null | tr -d '"')
  [ -n "$pinned_nixpkgs" ] && export NIX_PATH="nixpkgs=$pinned_nixpkgs"

  # 3.1.2's use_nix watches a file literally named "files_to_watch", not these.
  watch_file shell.nix npins/sources.json

  use nix

  # A bazel server keeps the environment, and on NixOS the FHS mount
  # namespace, it started in, so after shell.nix changes it would go on
  # building in the old one. The bazelisk wrapper's store path names that
  # environment: when it moves, retire the server.
  wrapper=$(command -v bazelisk 2>/dev/null)
  marker=".direnv/bazelisk"
  if [ -n "$wrapper" ]; then
    if [ -r "$marker" ] && [ "$(cat "$marker")" != "$wrapper" ]; then
      log_status "shell.nix moved: stopping the bazel server started from the old shell"
      bazelisk shutdown >/dev/null 2>&1 || true
    fi
    mkdir -p .direnv
    printf '%s' "$wrapper" >"$marker"
  fi
fi
