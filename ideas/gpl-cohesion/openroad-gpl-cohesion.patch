   const NesterovPlaceVars* npVars_ = nullptr;
+  // per nb_gcells_ index: the -cohesion group it belongs to, or -1
+  std::vector<int> cohesion_group_;
+  std::vector<FloatPoint> cohesion_force_;
+  struct CohesionCluster
+  {
+    std::string name;
+    std::vector<std::string> prefixes;
+    bool has_anchor = false;
+    double anchor_x = 0;  // dbu
+    double anchor_y = 0;
+    double weight = 0;
+  };
+  std::vector<CohesionCluster> cohesion_clusters_;
+  double cohesion_tau_ = 0;
+  int cohesion_iter_ = 0;
 
   float minSumOverflow_ = 1e30;
   float hpwlWithMinSumOverflow_ = 1e30;
