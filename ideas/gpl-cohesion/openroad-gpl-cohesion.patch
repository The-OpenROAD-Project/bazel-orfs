+// -clusters_file: groups of cells, each pulled toward an anchor (or its own
+// centroid). The objective sum is wirelength plus density; a module whose
+// partners sit across the die is spread between them by it, and the paths
+// inside that module pay. The pull is the descent direction of
+// k * |x - a|^2 per cell, k chosen so that a cell one RMS radius from the
+// cluster's centroid is pulled with `weight` times the mean wirelength
+// gradient: the weight is dimensionless and scales with the design. With
+// tau_iter > 0 the pull decays as exp(-iter / tau_iter): a short tau shapes
+// the start of placement and lets it go (DG-RePlAce, Kahng et al., TCAD
+// 2024), tau_iter 0 holds the cluster together to the end.
+//
+// {"tau_iter": 0,
+//  "clusters": [{"name": "CtrlBlock",
+//                "prefixes": ["core/backend/inner_ctrlBlock"],
+//                "anchor_um": [1200, 1250],   // optional
+//                "weight": 1.0}]}
+void NesterovBase::buildCohesionGroups()
+{
+  cohesion_group_.assign(nb_gcells_.size(), -1);
+  cohesion_clusters_.clear();
+  const std::string& path = npVars_->clustersFile;
+  std::ifstream in(path);
+  if (!in) {
+    log_->error(GPL, 343, "-clusters_file: cannot read {}.", path);
+  }
+  const std::string text((std::istreambuf_iterator<char>(in)),
+                         std::istreambuf_iterator<char>());
+  boost::system::error_code ec;
+  const boost::json::value doc = boost::json::parse(text, ec);
+  if (ec || !doc.is_object() || !doc.as_object().contains("clusters")
+      || !doc.as_object().at("clusters").is_array()) {
+    log_->error(
+        GPL, 344, "-clusters_file {}: expected an object with a clusters array.", path);
+  }
+  const auto& top = doc.as_object();
+  if (top.contains("tau_iter")) {
+    cohesion_tau_ = boost::json::value_to<double>(top.at("tau_iter"));
+  }
+  const double dbu = pb_->db()->getChip()->getBlock()->getDbUnitsPerMicron();
+  for (const auto& v : top.at("clusters").as_array()) {
+    const auto& o = v.as_object();
+    CohesionCluster c;
+    c.name = boost::json::value_to<std::string>(o.at("name"));
+    c.prefixes = boost::json::value_to<std::vector<std::string>>(o.at("prefixes"));
+    c.weight = boost::json::value_to<double>(o.at("weight"));
+    if (c.weight < 0 || c.prefixes.empty()) {
+      log_->error(GPL,
+                  344,
+                  "-clusters_file {}: cluster {} needs prefixes and a weight >= 0.",
+                  path,
+                  c.name);
+    }
+    if (o.contains("anchor_um")) {
+      const auto a = boost::json::value_to<std::vector<double>>(o.at("anchor_um"));
+      if (a.size() != 2) {
+        log_->error(GPL, 344, "-clusters_file {}: anchor_um of {} is not [x, y].", path, c.name);
+      }
+      c.has_anchor = true;
+      c.anchor_x = a[0] * dbu;
+      c.anchor_y = a[1] * dbu;
+    }
+    cohesion_clusters_.push_back(std::move(c));
+  }
+  std::vector<int64_t> members(cohesion_clusters_.size(), 0);
+  for (size_t i = 0; i < nb_gcells_.size(); i++) {
+    const GCell* cell = nb_gcells_[i];
+    if (!cell->isInstance() || cell->insts().empty()) {
+      continue;
+    }
+    // The longest matching prefix wins: a module's prefix also covers the
+    // child modules that the clustering put in other clusters.
+    const std::string name = cell->insts()[0]->dbInst()->getName();
+    size_t best_len = 0;
+    for (size_t g = 0; g < cohesion_clusters_.size(); g++) {
+      for (const std::string& prefix : cohesion_clusters_[g].prefixes) {
+        if (prefix.size() > best_len && name.compare(0, prefix.size(), prefix) == 0
+            && (name.size() == prefix.size() || name[prefix.size()] == '/')) {
+          cohesion_group_[i] = static_cast<int>(g);
+          best_len = prefix.size();
+        }
+      }
+    }
+    if (cohesion_group_[i] >= 0) {
+      members[cohesion_group_[i]]++;
+    }
+  }
+  for (size_t g = 0; g < cohesion_clusters_.size(); g++) {
+    const auto& c = cohesion_clusters_[g];
+    if (members[g] == 0) {
+      log_->error(GPL, 342, "-clusters_file {}: cluster {} matches no cell.", path, c.name);
+    }
+    log_->info(GPL,
+               341,
+               "Cluster {} weight {:g}{}: {} cells.",
+               c.name,
+               c.weight,
+               c.has_anchor ? " anchored" : "",
+               members[g]);
+  }
+}
+
+void NesterovBase::addCohesionForces(
+    const std::vector<FloatPoint>& wireLengthGrads,
+    std::vector<FloatPoint>& cohesionForce) const
+{
+  const size_t groups = cohesion_clusters_.size();
+  const size_t n = nb_gcells_.size();
+  cohesionForce.assign(n, FloatPoint(0, 0));
+  const double decay
+      = cohesion_tau_ > 0 ? std::exp(-cohesion_iter_ / cohesion_tau_) : 1.0;
+  if (decay < 1e-6) {
+    return;
+  }
+  std::vector<double> sx(groups, 0), sy(groups, 0);
+  std::vector<int64_t> cnt(groups, 0);
+  double wl_sum = 0;
+  int64_t wl_n = 0;
+  for (size_t i = 0; i < n; i++) {
+    const GCell* cell = nb_gcells_[i];
+    if (cell->isInstance()) {
+      wl_sum += std::fabs(wireLengthGrads[i].x) + std::fabs(wireLengthGrads[i].y);
+      wl_n++;
+    }
+    const int g = cohesion_group_[i];
+    if (g >= 0) {
+      sx[g] += cell->dCx();
+      sy[g] += cell->dCy();
+      cnt[g]++;
+    }
+  }
+  if (wl_n == 0) {
+    return;
+  }
+  const double wl_mean = wl_sum / wl_n;
+  std::vector<double> cx(groups), cy(groups), tx(groups), ty(groups), r2(groups, 0);
+  for (size_t g = 0; g < groups; g++) {
+    cx[g] = cnt[g] ? sx[g] / cnt[g] : 0;
+    cy[g] = cnt[g] ? sy[g] / cnt[g] : 0;
+    const auto& c = cohesion_clusters_[g];
+    tx[g] = c.has_anchor ? c.anchor_x : cx[g];
+    ty[g] = c.has_anchor ? c.anchor_y : cy[g];
+  }
+  for (size_t i = 0; i < n; i++) {
+    const int g = cohesion_group_[i];
+    if (g >= 0) {
+      const double dx = nb_gcells_[i]->dCx() - cx[g];
+      const double dy = nb_gcells_[i]->dCy() - cy[g];
+      r2[g] += dx * dx + dy * dy;
+    }
+  }
+  std::vector<double> k(groups, 0);
+  for (size_t g = 0; g < groups; g++) {
+    if (cnt[g] > 0) {
+      const double rms = std::max(1.0, std::sqrt(r2[g] / cnt[g]));
+      k[g] = decay * cohesion_clusters_[g].weight * wl_mean / rms;
+    }
+  }
+  for (size_t i = 0; i < n; i++) {
+    const int g = cohesion_group_[i];
+    if (g >= 0) {
+      cohesionForce[i] = FloatPoint(k[g] * (tx[g] - nb_gcells_[i]->dCx()),
+                                    k[g] * (ty[g] - nb_gcells_[i]->dCy()));
+    }
+  }
+}
+
 }  // namespace gpl
