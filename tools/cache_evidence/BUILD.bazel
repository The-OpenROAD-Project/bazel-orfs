load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Whether a target is a remote cache hit here, asked without building it:
# .claude/skills/cache-miss/SKILL.md.
py_binary(
    name = "cache_evidence",
    srcs = ["cache_evidence.py"],
    deps = [
        ":killer",
        "@bazel-orfs-pip//zstandard",
    ],
)

# The killer alone, no dependencies: //:export --cached-only runs it too.
py_library(
    name = "killer",
    srcs = ["killer.py"],
    imports = ["."],
    visibility = ["//tools/ramp:__pkg__"],
)

py_test(
    name = "cache_evidence_test",
    srcs = [
        "cache_evidence.py",
        "cache_evidence_test.py",
    ],
    main = "cache_evidence_test.py",
    deps = [
        ":killer",
        "@bazel-orfs-pip//zstandard",
    ],
)
