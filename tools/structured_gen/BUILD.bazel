# structured_gen: placed register files and CAMs as macros, written with
# OpenROAD's own libraries rather than emitted as text for a later flow
# to place. See README.md.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "regfile",
    srcs = [
        "regfile.cc",
        "views.cc",
    ],
    hdrs = [
        "regfile.h",
        "views.h",
    ],
    deps = ["@openroad//:openroad_lib"],
)

cc_binary(
    name = "structured_gen",
    srcs = ["main.cc"],
    deps = [":regfile"],
)

# Against the real asap7 LEF, so the cell names, pins and site the spec
# names are the ones a flow would see.
ASAP7_LEFS = [
    "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
    "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
]

cc_test(
    name = "registered_read_test",
    size = "small",
    srcs = ["registered_read_test.cc"],
    args = ["$(rlocationpath {})".format(l) for l in ASAP7_LEFS],
    data = ASAP7_LEFS,
    deps = [":regfile"],
)

cc_test(
    name = "regfile_test",
    size = "small",
    srcs = ["regfile_test.cc"],
    args = ["$(rlocationpath {})".format(l) for l in ASAP7_LEFS],
    data = ASAP7_LEFS,
    deps = [":regfile"],
)

# OpenROAD's generate_regfile (patch 0010) writes the same views as this
# tool, byte for byte: Verilog, DEF, abstract LEF and model liberty. The
# tiny synthetic specs in golden/ cover every spec feature (banks, bank
# columns, bit folds, registered read with the RTL's names, banked and
# interleaved reads, the zero word, netlist mode) in seconds.
GOLDEN_TINY = glob(["golden/*.regfile"])

# The register-file specs the flow uses, at real size: minutes per spec.
GOLDEN_XIANGSHAN = [
    "//test/coremark_joule/designs/asap7/xiangshan:%s.regfile" % m
    for m in [
        "FpRegFile",
        "FtqEntryQueue",
        "FtqMetaQueueCommit",
        "FtqMetaQueueRedirect",
        "FtqMetaQueueResolve",
        "IntRegFile",
        "RenameBufferFile",
        "RobEntryFile",
        "VfRegFile",
    ]
] + ["//test/structured_netlist:SmallFile.regfile"]

[
    sh_test(
        name = name,
        size = size,
        srcs = ["golden_test.sh"],
        args = [
            "$(rootpath :structured_gen)",
            "$(rootpath @openroad//:openroad)",
        ] + ["$(rootpath {})".format(l) for l in ASAP7_LEFS] + [
            "$(rootpath {})".format(s)
            for s in specs
        ],
        data = [
            ":structured_gen",
            "@openroad",
        ] + ASAP7_LEFS + specs,
        tags = tags,
    )
    for name, size, specs, tags in [
        ("golden_test", "small", GOLDEN_TINY, []),
        (
            "golden_xiangshan_test",
            "enormous",
            GOLDEN_XIANGSHAN,
            ["manual"],
        ),
    ]
]
