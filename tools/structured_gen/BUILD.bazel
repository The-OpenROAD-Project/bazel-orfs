# structured_gen: placed register files and CAMs as macros, written with
# OpenROAD's own libraries rather than emitted as text for a later flow
# to place. See README.md.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "regfile",
    srcs = [
        "regfile.cc",
        "views.cc",
    ],
    hdrs = [
        "regfile.h",
        "views.h",
    ],
    deps = ["@openroad//:openroad_lib"],
)

cc_binary(
    name = "structured_gen",
    srcs = ["main.cc"],
    deps = [":regfile"],
)

# Against the real asap7 LEF, so the cell names, pins and site the spec
# names are the ones a flow would see.
ASAP7_LEFS = [
    "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
    "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
]

# generate_ram matches its cells by their liberty functions.
ASAP7_LIBS = [
    "@orfs//flow:platforms/asap7/lib/NLDM/asap7sc7p5t_%s.lib%s" % (lib, gz)
    for lib, gz in [
        ("AO_RVT_TT_nldm_211120", ".gz"),
        ("INVBUF_RVT_TT_nldm_220122", ".gz"),
        ("OA_RVT_TT_nldm_211120", ".gz"),
        ("SEQ_RVT_TT_nldm_220123", ""),
        ("SIMPLE_RVT_TT_nldm_211120", ".gz"),
    ]
]

cc_test(
    name = "registered_read_test",
    size = "small",
    srcs = ["registered_read_test.cc"],
    args = ["$(rlocationpath {})".format(l) for l in ASAP7_LEFS],
    data = ASAP7_LEFS,
    deps = [":regfile"],
)

cc_test(
    name = "regfile_test",
    size = "small",
    srcs = ["regfile_test.cc"],
    args = ["$(rlocationpath {})".format(l) for l in ASAP7_LEFS],
    data = ASAP7_LEFS,
    deps = [":regfile"],
)

# OpenROAD's generate_ram, through ORFS's regfile_ram.py, builds every
# spec and writes all its views. generate_regfile's output was byte for
# byte this tool's until the read gates and the clock gate moved it on. The tiny synthetic
# specs in golden/ cover every spec feature (banks, bank columns, bit
# folds, registered read with the RTL's names, banked and interleaved
# reads, the zero word, netlist mode) in seconds.
GOLDEN_TINY = glob(["golden/*.regfile"])

# The register-file specs the flow uses, at real size: minutes per spec.
GOLDEN_XIANGSHAN = [
    "//test/coremark_joule/designs/asap7/xiangshan:%s.regfile" % m
    for m in [
        "FpRegFile",
        "FtqEntryQueue",
        "FtqMetaQueueCommit",
        "FtqMetaQueueRedirect",
        "FtqMetaQueueResolve",
        "IntRegFile",
        "RenameBufferFile",
        "RobEntryFile",
        "VfRegFile",
    ]
] + ["//test/structured_netlist:SmallFile.regfile"]

[
    sh_test(
        name = name,
        size = size,
        srcs = ["golden_test.sh"],
        args = [
            "$(rootpath //test/regfile/cores:ram_gen)",
            "$(rootpath @orfs//flow:scripts/memories/regfile_ram.py)",
            "$(rootpath @openroad//:openroad)",
        ] + ["$(rootpath {})".format(l) for l in ASAP7_LEFS] + [
            "'{}'".format(" ".join(["$(rootpath {})".format(l) for l in ASAP7_LIBS])),
        ] + [
            "$(rootpath {})".format(s)
            for s in specs
        ],
        data = [
            "//test/regfile/cores:ram_gen",
            "@openroad",
            "@orfs//flow:scripts/memories/regfile_ram.py",
        ] + ASAP7_LEFS + ASAP7_LIBS + specs,
        tags = tags,
    )
    for name, size, specs, tags in [
        ("golden_test", "medium", GOLDEN_TINY, []),
        (
            "golden_xiangshan_test",
            "enormous",
            GOLDEN_XIANGSHAN,
            ["manual"],
        ),
    ]
]
