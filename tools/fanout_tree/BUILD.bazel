# fanout_tree: rebuild a netlist's buffer trees by construction, balanced
# and sized to their loads, in place of ABC's chains. See fanout_tree.h.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fanout_tree_lib",
    srcs = ["fanout_tree.cc"],
    hdrs = ["fanout_tree.h"],
    deps = ["@openroad//:openroad_lib"],
)

cc_binary(
    name = "fanout_tree",
    srcs = ["main.cc"],
    deps = [":fanout_tree_lib"],
)

ASAP7_LEFS = [
    "@orfs//flow:platforms/asap7/lef/asap7_tech_1x_201209.lef",
    "@orfs//flow:platforms/asap7/lef/asap7sc7p5t_28_R_1x_220121a.lef",
]

cc_test(
    name = "fanout_tree_test",
    size = "small",
    srcs = ["fanout_tree_test.cc"],
    args = ["$(rlocationpath {})".format(l) for l in ASAP7_LEFS],
    data = ASAP7_LEFS,
    deps = [":fanout_tree_lib"],
)
