load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# yosys passes for array structures, loaded as a plugin
# (yosys -m arrays.so): array_reroll turns a packed register vector read
# and written by index back into a memory.
cc_library(
    name = "arrays_lib",
    srcs = [
        "array_reroll.cc",
        "mem_const_priority.cc",
    ],
    copts = [
        "-fPIC",
        "-std=c++20",
        "-Wno-unused-parameter",
    ],
    deps = ["@yosys//:hdrs"],
    alwayslink = True,
)

cc_shared_library(
    name = "arrays.so",
    shared_lib_name = "arrays.so",
    visibility = ["//visibility:public"],
    deps = [":arrays_lib"],
)

py_binary(
    name = "structgen",
    srcs = ["structgen.py"],
    visibility = ["//test/array_toys:__pkg__"],
)

# structgen's Netlist, for generators of other structures
py_library(
    name = "structgen_lib",
    srcs = ["structgen.py"],
    imports = ["."],
    visibility = ["//test/rob_toy:__pkg__"],
)

# structgen's CAM and flags simulated cell by cell against the toys'
# RTL under random stimulus, each with a negative control
py_test(
    name = "structgen_test",
    size = "small",
    srcs = ["structgen_test.py"],
    deps = [":structgen_lib"],
)

# the classifier, for the XiangShan dry runs
# (test/coremark_joule/designs/asap7/xiangshan/arrays)
exports_files(
    ["classify.py"],
    visibility = ["//test/coremark_joule/designs/asap7/xiangshan/arrays:__pkg__"],
)
