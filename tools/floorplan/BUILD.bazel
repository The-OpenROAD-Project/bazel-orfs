load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# The global floorplan planner: extract per block (extract_block.tcl,
# block_json.py; extract_pdk.tcl, pdk_json.py), plan, consume:
# floorplan.bzl.

exports_files(
    [
        "extract_block.tcl",
        "extract_netlist.tcl",
        "extract_parent.tcl",
        "extract_pdk.tcl",
        "probe_congestion.tcl",
        "probe_wire.tcl",
    ] + glob(["testdata/toy/*.json"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "pin_plan",
    srcs = ["pin_plan.py"],
    imports = ["."],
)

