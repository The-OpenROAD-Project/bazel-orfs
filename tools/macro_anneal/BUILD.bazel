# A macro placer for bank groups, XiangShan's for now.
#
# Consumed by the XiangShan design through MACRO_PLACEMENT_TCL:
# dump_macros.tcl and macro_anneal.py arrive as user_sources. Public so a
# XiangShan flow outside this repository can use them too. Once a second
# design says it has wider value, the natural home is a clustering
# pre-pass in RTL-MP itself.
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

exports_files(
    [
        "dump_macros.tcl",
        "macro_anneal.py",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "macro_anneal",
    srcs = ["macro_anneal.py"],
    main = "macro_anneal.py",
)

# Not manual: milliseconds, and what it guards -- an overlapping or
# off-track placement -- would otherwise show up as an MPL error deep in
# a floorplan that took an hour to reach.
py_test(
    name = "macro_anneal_test",
    size = "small",
    srcs = [
        "macro_anneal.py",
        "macro_anneal_test.py",
    ],
    main = "macro_anneal_test.py",
)

py_test(
    name = "macro_anneal_seeds_test",
    size = "small",
    srcs = [
        "macro_anneal.py",
        "macro_anneal_seeds_test.py",
    ],
    data = ["testdata/memblock_inventory.txt"],
    main = "macro_anneal_seeds_test.py",
)
