load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# `bazelisk run //:import -- <ORFS design dir>`: the on-ramp, an ORFS
# design copied into imported/ of this clone with a BUILD.bazel that
# builds it. docs/ramps.md.
py_binary(
    name = "import",
    srcs = ["import_design.py"],
    data = ["@gnumake//:make"],
    env = {"IMPORT_MAKE": "$(rootpath @gnumake//:make)"},
    main = "import_design.py",
    visibility = ["//:__pkg__"],
)

py_test(
    name = "import_design_test",
    srcs = [
        "import_design.py",
        "import_design_test.py",
    ],
    # The pinned ORFS's flow, asap7 and gcd: an ORFS checkout as import
    # reads one, plus designs it has to refuse.
    data = [
        "@gnumake//:make",
        "@orfs//flow:asap7",
        "@orfs//flow:makefile",
        "@orfs//flow/designs/asap7/gcd:design_config",
        "@orfs//flow/designs/src/gcd:verilog",
    ] + glob(["testdata/**"]),
    env = {
        "IMPORT_MAKE": "$(rootpath @gnumake//:make)",
        "ORFS_MAKEFILE": "$(rootpath @orfs//flow:makefile)",
    },
    imports = ["."],
)

# `bazelisk run //:export -- <dest> <orfs_flow target>`: the off-ramp, a
# flow written out as a plain ORFS design, config.mk, inputs/ and run.sh.
py_binary(
    name = "export",
    srcs = ["export_design.py"],
    data = ["snapshot_macros.tcl"],
    main = "export_design.py",
    visibility = ["//:__pkg__"],
)

# `bazelisk run //tools/ramp:export_roundtrip -- <orfs_flow target>`:
# export with the macro placement snapshot, make it with ORFS's make,
# compare the floorplans. Runs bazelisk and make, so a binary, not a
# test: run by hand on //test/regfile/macro:wide_top_hard and on
# //test:lb_32x128_top --abstracts.
py_binary(
    name = "export_roundtrip",
    srcs = [
        "export_design.py",
        "export_roundtrip.py",
    ],
    data = [
        "roundtrip_compare.tcl",
        "snapshot_macros.tcl",
    ],
    imports = ["."],
    main = "export_roundtrip.py",
)

py_test(
    name = "export_design_test",
    srcs = [
        "export_design.py",
        "export_design_test.py",
    ],
    imports = ["."],
)
