load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Macro selection: which modules to harden, and the parent floorplan their
# interfaces dictate. See ideas/ and .claude/commands/macro-selection.md.
py_library(
    name = "plan_floorplan_lib",
    srcs = ["plan_floorplan.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "plan_floorplan",
    srcs = ["plan_floorplan.py"],
    main = "plan_floorplan.py",
    visibility = ["//visibility:public"],
)

py_test(
    name = "plan_floorplan_test",
    srcs = [
        "plan_floorplan.py",
        "plan_floorplan_test.py",
    ],
    main = "plan_floorplan_test.py",
)
