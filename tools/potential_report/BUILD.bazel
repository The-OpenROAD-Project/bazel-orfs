load("@rules_python//python:defs.bzl", "py_binary", "py_test")

# The potential report's pilot: does the RTL or the flow leave a
# repeating structure short of what it should reach? See README.md.

py_binary(
    name = "detect",
    srcs = ["detect.py"],
    main = "detect.py",
    visibility = ["//test/coremark_joule/designs/asap7/xiangshan:__pkg__"],
)

py_binary(
    name = "whatif",
    srcs = ["whatif.py"],
    main = "whatif.py",
    visibility = ["//test/coremark_joule/designs/asap7/xiangshan:__pkg__"],
