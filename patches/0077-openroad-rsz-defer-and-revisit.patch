+int SetupLegacyBase::patience() const
+{
+  std::vector<int> samples = setup_context_.first_improvement_passes;
+  if (static_cast<int>(samples.size()) < kPatienceSamples) {
+    return decreasing_slack_max_passes_;
+  }
+  std::nth_element(
+      samples.begin(), samples.begin() + samples.size() / 2, samples.end());
+  const int median = samples[samples.size() / 2];
+  return std::min(decreasing_slack_max_passes_,
+                  std::max(kMinPatience, 2 * median));
+}
