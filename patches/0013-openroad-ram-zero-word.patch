index 0000000000..83d65a7d08
--- /dev/null
+++ b/src/ram/test/make_8x8_2r1w_zero_asap7.tcl
@@ -0,0 +1,33 @@
+# generate_ram on asap7, which has no tristate cell: the read ports are
+# AND-OR trees, the storage flop's only output is QN, and word 0 reads
+# 0 (a RISC-V x0).
+source "helpers.tcl"
+
+read_liberty ../../../test/asap7/asap7sc7p5t_AO_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_OA_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib
+read_liberty ../../../test/asap7/asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib.gz
+
+read_lef ../../../test/asap7/asap7_tech_1x_201209.lef
+read_lef ../../../test/asap7/asap7sc7p5t_28_R_1x_220121a.lef
+
+set behavioral_file [make_result_file make_8x8_2r1w_zero_asap7_behavioral.v]
+
+generate_ram_netlist \
+  -mask_size 8 \
+  -word_size 8 \
+  -num_words 8 \
+  -r_ports 2 \
+  -w_ports 1 \
+  -storage_cell DFFHQNx1_ASAP7_75t_R \
+  -zero_word 0 \
+  -write_behavioral_verilog $behavioral_file
+
+set def_file [make_result_file make_8x8_2r1w_zero_asap7.def]
+write_def $def_file
+diff_files make_8x8_2r1w_zero_asap7.defok $def_file
+
+diff_files make_8x8_2r1w_zero_asap7_behavioral.vok $behavioral_file
+
+puts "pass"
diff --git a/src/ram/test/make_8x8_2r1w_zero_asap7_behavioral.vok b/src/ram/test/make_8x8_2r1w_zero_asap7_behavioral.vok
new file mode 100644
index 0000000000..373f465efb
--- /dev/null
+++ b/src/ram/test/make_8x8_2r1w_zero_asap7_behavioral.vok
@@ -0,0 +1,42 @@
+module RAM8x8 (
+  clk,
+  D,
+  Q0,
+  Q1,
+  addr_w,
+  addr_r0,
+  addr_r1,
+  we
+);
+  input clk;
+  input [7:0] D;
+  output reg [7:0] Q0;
+  output reg [7:0] Q1;
+  input [2:0] addr_w;
+  input [2:0] addr_r0;
+  input [2:0] addr_r1;
+  input [0:0] we;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we[i] && addr_w != 0) begin
+        mem[addr_w][i*8 +:8] <= D[i*8 +:8];
+      end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q0 = addr_r0 == 0 ? 8'd0 : mem[addr_r0];
+  end
+
+  always @(*) begin
+    Q1 = addr_r1 == 0 ? 8'd0 : mem[addr_r1];
+  end
+
+endmodule
