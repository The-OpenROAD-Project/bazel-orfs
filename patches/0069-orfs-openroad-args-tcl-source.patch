Pass -tcl_source to openroad so a failing flow script reports a Tcl stack
trace naming each proc and the failing line, rather than the single line
sta::include_file produces.  The flag is added by the openroad and
OpenSTA patches carried alongside this one.

OPENROAD_ARGS feeds OPENROAD_CMD and OPENROAD_NO_EXIT_CMD, so this one
line reaches every openroad invocation in flow/Makefile and
flow/util/utils.mk.  OPENROAD_GUI_CMD and OPENROAD_WEB_CMD do not take
OPENROAD_ARGS and do not need it: the gui path already evaluates the
command file with source.

$(OR_ARGS) is still on the line, so a caller can override.

Not upstreamed.  Retires on a //:bump onto an ORFS carrying it.

diff --git a/flow/scripts/variables.mk b/flow/scripts/variables.mk
--- a/flow/scripts/variables.mk
+++ b/flow/scripts/variables.mk
@@ -108,7 +108,7 @@
 
 OPENROAD_IS_VALID := $(if $(OPENROAD_EXE),$(shell test -x $(OPENROAD_EXE) && echo "true"),)
 
-export OPENROAD_ARGS = -no_init -threads $(NUM_CORES) $(OR_ARGS)
+export OPENROAD_ARGS = -no_init -tcl_source -threads $(NUM_CORES) $(OR_ARGS)
 export OPENROAD_CMD = $(OPENROAD_EXE) -exit $(OPENROAD_ARGS)
 export OPENROAD_NO_EXIT_CMD = $(OPENROAD_EXE) $(OPENROAD_ARGS)
 export OPENROAD_GUI_CMD = $(OPENROAD_EXE) -gui -threads $(NUM_CORES) $(OR_ARGS)
