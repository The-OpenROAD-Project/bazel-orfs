index 3ee2b0476c..b372e37e13 100644
--- a/src/grt/include/grt/GlobalRouter.h
+++ b/src/grt/include/grt/GlobalRouter.h
@@ -161,6 +161,11 @@ class GlobalRouter
   void setResAwareNetsPercentage(float percentage);
   void setSnapshotBatchedWidth(int snapshot_batched_width);
   void setBackingFile(const std::string& path);
+  // After a global_route, free what only incremental routing reads.
+  void setNoIncremental(bool no_incremental)
+  {
+    no_incremental_ = no_incremental;
+  }
   int getSnapshotBatchedWidth() const;
   int getSnapshotBatchCount() const;
   bool isResistanceAware() { return resistance_aware_; };
@@ -656,6 +661,7 @@ class GlobalRouter
   bool resistance_aware_{false};
   int snapshot_batched_width_{0};
   std::string backing_file_;
+  bool no_incremental_ = false;
   int num_threads_;
   std::vector<int> vertical_capacities_;
   std::vector<int> horizontal_capacities_;
diff --git a/src/grt/src/GlobalRouter.cpp b/src/grt/src/GlobalRouter.cpp
index 4e9451250f..f572333e02 100644
--- a/src/grt/src/GlobalRouter.cpp
+++ b/src/grt/src/GlobalRouter.cpp
@@ -560,6 +560,13 @@ void GlobalRouter::globalRoute(bool save_guides)
   }
 
   finishGlobalRouting(save_guides);
+  if (no_incremental_) {
+    // Nothing reroutes incrementally: FastRoute's nets, trees and grid are
+    // freed; the routes stay. A later -start_incremental rebuilds them from
+    // the routes, as on a design read from odb.
+    fastroute_->clear();
+    initialized_ = false;
+  }
   if (verbose_) {
     const int elapsed = static_cast<int>(timer.elapsed());
     const int hour = elapsed / 3600;
