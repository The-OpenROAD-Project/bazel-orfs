+# gcd_nangate45 routed with -no_incremental: gcd's guides, and an
+# incremental route afterwards rebuilds the router from the routes
+source "helpers.tcl"
+read_lef "Nangate45/Nangate45.lef"
+read_def "gcd.def"
+
+set guide_file [make_result_file gcd_no_incremental.guide]
+
+global_route -verbose -no_incremental
+global_route -start_incremental
+global_route -end_incremental
+
+write_guides $guide_file
+
+diff_files gcd.guideok $guide_file
