             self.assertEqual((out / "blackboxes.txt").read_text(), "array_64x114\n")
 
+    def test_narrow_macro_spans_a_power_strap_pitch(self):
+        """64x16 folds to 4.18 um, narrower than the M5 strap pitch.
+
+        Between two straps of a net its macro grid has no shapes and
+        pdngen fails the design (PDN-0233), so the backend widens it.
+        """
+        inventory = {
+            "version": 1,
+            "platform": "asap7",
+            "memories": [
+                {
+                    "name": "array_64x16",
+                    "rows": 64,
+                    "bits": 16,
+                    "addr_w": 6,
+                    "read_ports": 0,
+                    "write_ports": 0,
+                    "rw_ports": 1,
+                    "mask_lanes": 0,
+                    "port_convention": "firtool",
+                    "pins": rw0_pins(16, 6, 0),
+                    "idiomatic": True,
+                    "reason": "meets ASAP7 macro floors",
+                },
+            ],
+        }
+        with tempfile.TemporaryDirectory() as d:
+            inv = Path(d) / "memories.json"
+            inv.write_text(json.dumps(inventory))
+            out = Path(d) / "memories"
+            self.assertEqual(run_orfs_asap7("asap7", out, inv), 0)
+            lef = (out / "array_64x16.lef").read_text()
+            size = re.search(r"SIZE ([\d.]+) BY ([\d.]+)", lef)
+            self.assertGreaterEqual(
+                float(size.group(1)), ASAP7_PROCESS_CONFIG["min_width_um"]
+            )
+
     def test_declared_separate_ports_are_refused(self):
         pins = rw0_pins(32, 5, 0)
         for p in pins:
