From c1384d439c54a5b32327897b28213013e84d4df9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Thu, 1 Oct 2026 09:26:33 +0200
Subject: [PATCH] FakeRAM asap7: a macro at least one power-strap pitch wide
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A generated macro's power pins are horizontal M4 rails; the platform's
macro grid connects them to the core's vertical M5 straps, one per net
every 5.4 um (grid_strategy-M1-M2-M5-M6.tcl). The backend sized a macro
from its bit cells alone, with a floor on height and none on width, so
a small memory folded square could come out narrower than the strap
pitch. Such a macro can land between two straps of a net: its macro
grid gets no shapes and pdngen fails the whole design (PDN-0233). A
64x16 array folds to 4.18 um; in the three variants of a test design
with 2, 16 and 64 of them, 13 landed that way and every variant failed
in floorplan.

The process gets a min_width_um floor beside the existing height floor,
and the asap7 backend sets it to one pitch plus one strap plus the
rails' inset at both edges, 5.616 um: a strap of each net then crosses
the rails wherever the macro is placed. Wider macros are unchanged.

Not upstreamed (builds on carried patch 0067).
Retires at a //:bump onto an ORFS whose FakeRAM asap7 backend has a
width floor.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/FakeRAM2.0/orfs_asap7/generate.py   |  9 ++++++
 tools/FakeRAM2.0/test/macro_dim_test.py   | 14 ++++++++
 tools/FakeRAM2.0/test/spsram_mask_test.py | 39 +++++++++++++++++++++++
 tools/FakeRAM2.0/utils/class_process.py   |  4 +++
 4 files changed, 66 insertions(+)

diff --git a/tools/FakeRAM2.0/orfs_asap7/generate.py b/tools/FakeRAM2.0/orfs_asap7/generate.py
--- a/tools/FakeRAM2.0/orfs_asap7/generate.py
+++ b/tools/FakeRAM2.0/orfs_asap7/generate.py
@@ -39,6 +39,15 @@
     "column_mux_factor": 1,
     "snap_width_nm": 190,
     "snap_height_nm": 1400,
+    # A macro's power pins are horizontal M4 rails, which the platform's
+    # macro grid connects to the core's vertical M5 straps
+    # (openRoad/pdn/grid_strategy-M1-M2-M5-M6.tcl: each net every 5.4 um,
+    # 0.12 um wide). A narrower macro can sit between two straps of a
+    # net, its grid gets no shapes and pdngen fails the whole design
+    # (PDN-0233). One pitch plus a strap, plus the rails' 0.048 um inset
+    # at both edges, puts a strap of each net across the rails wherever
+    # the macro lands.
+    "min_width_um": 5.4 + 0.12 + 2 * 0.048,
 }
 
 ASAP7_TIMING_CONFIG = {
diff --git a/tools/FakeRAM2.0/test/macro_dim_test.py b/tools/FakeRAM2.0/test/macro_dim_test.py
--- a/tools/FakeRAM2.0/test/macro_dim_test.py
+++ b/tools/FakeRAM2.0/test/macro_dim_test.py
@@ -71,6 +71,20 @@
             self.assertAlmostEqual(height, exp_height, delta=self._delta)
             self.assertAlmostEqual(width, exp_width, delta=self._delta)
 
+    def test_macro_dim_min_width(self):
+        """A narrow macro is widened to min_width_um; a wide one is not"""
+
+        process_data = TestUtils.get_base_process_data().copy()
+        process_data["min_width_um"] = 10.0
+        process = Process(process_data)
+        # 39 bits at 2048 deep is 5.054 um wide, below the floor
+        width, height = process.get_macro_dimensions(39, 2048, 1, 0)
+        self.assertAlmostEqual(width, 10.0, delta=self._delta)
+        self.assertAlmostEqual(height, 663.552, delta=self._delta)
+        # four banks make it 20.216 um wide, above the floor
+        width, _ = process.get_macro_dimensions(39, 2048, 4, 0)
+        self.assertAlmostEqual(width, 5.054 * 4, delta=self._delta)
+
     def test_macro_dim_invalid_banks(self):
         """Tests detection that an invalid bank value was given"""
 
