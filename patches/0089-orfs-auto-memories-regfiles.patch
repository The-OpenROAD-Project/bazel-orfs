diff --git a/flow/scripts/macro_place.tcl b/flow/scripts/macro_place.tcl
index 0789129e4..556cc30cc 100644
--- a/flow/scripts/macro_place.tcl
+++ b/flow/scripts/macro_place.tcl
@@ -3,10 +3,38 @@ erase_non_stage_variables floorplan
 load_design 2_1_floorplan.odb 2_1_floorplan.sdc
 source_step_tcl PRE MACRO_PLACE
 
+# A register file in `mode netlist` dissolves onto the parent's rows
+# after macro placement, and the rows are then cut MACRO_ROWS_HALO_X/Y
+# around every other macro: a halo that wide keeps them off its core,
+# which fills its outline to the edge.
+set regfile_list "$::env(RESULTS_DIR)/memories/regfiles.txt"
+if { [env_var_equals AUTO_MEMORIES 1] && [file exists $regfile_list] } {
+  set f [open $regfile_list r]
+  set regfile_masters [split [string trim [read $f]] "\n"]
+  close $f
+  set dbu [[ord::get_db_tech] getDbUnitsPerMicron]
+  set halo {}
+  foreach v {MACRO_ROWS_HALO_X MACRO_ROWS_HALO_Y} {
+    set um [expr { [env_var_exists_and_non_empty $v] ? $::env($v) : 0 }]
+    lappend halo [expr { round($um * $dbu) }]
+  }
+  lassign $halo x y
+  foreach inst [[ord::get_db_block] getInsts] {
+    if { [[$inst getMaster] getName] in $regfile_masters } {
+      # the instance's own halo, left bottom right top, which the macro
+      # placer keeps clear of other macros
+      odb::dbBox_create $inst $x $y $x $y
+    }
+  }
+}
+
 source $::env(SCRIPTS_DIR)/macro_place_util.tcl
 
 source_step_tcl POST MACRO_PLACE
 
+# register files in `mode netlist` become their cells
+source $::env(SCRIPTS_DIR)/regfile_dissolve.tcl
+
 report_design_area
 
 orfs_write_db $::env(RESULTS_DIR)/2_2_floorplan_macro.odb
diff --git a/flow/scripts/memories/detect.py b/flow/scripts/memories/detect.py
index 234335042..83ab8ce65 100644
--- a/flow/scripts/memories/detect.py
+++ b/flow/scripts/memories/detect.py
@@ -305,6 +305,23 @@ def scan_yosys_json(
     return dedupe(out)
 
 
+def initialized_modules(data: dict | str | Path, top: str | None = None) -> set[str]:
+    """Modules holding a memory with an initial value: a $mem_v2 whose INIT
+    has a 0 or 1 bit (yosys writes an uninitialized memory's INIT as x)."""
+    if isinstance(data, (str, Path)):
+        data = json.loads(Path(data).read_text())
+    out = set()
+    for mod_name, mod_info in data.get("modules", {}).items():
+        name = mod_name[1:] if mod_name.startswith("\\") else mod_name
+        for cell in mod_info.get("cells", {}).values():
+            if cell.get("type", "") not in ("$mem_v2", "$mem"):
+                continue
+            init = str(cell.get("parameters", {}).get("INIT", ""))
+            if "0" in init or "1" in init:
+                out.add(definition_name(name, top))
+    return out
+
+
 def definition_name(module: str, top: str | None) -> str:
     """`array_64x114$top.u0` -> `array_64x114` for top module `top`.
 
