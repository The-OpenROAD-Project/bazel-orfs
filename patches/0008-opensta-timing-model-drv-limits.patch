From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Sun, 27 Sep 2026 18:00:00 +0200
Subject: [PATCH] sta: write_timing_model port limits are the cells' own
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Model ports had a capacitance and no design rule limits, so a parent
checked nothing on a net whose only driver and loads are model ports.
An input port now takes the tightest max_transition of its loads, an
output port the max_capacitance of its driver, each falling back to the
library default: facts about the cells behind the port, nothing derived.
LibertyWriter already writes both.

The source of parallaxsw/OpenSTA#518. Retires on the //:bump onto an
OpenROAD whose OpenSTA carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
diff --git a/src/sta/search/MakeTimingModel.cc b/src/sta/search/MakeTimingModel.cc
--- a/src/sta/search/MakeTimingModel.cc
+++ b/src/sta/search/MakeTimingModel.cc
@@ -27,6 +27,7 @@
 
 #include <algorithm>
 #include <cstddef>
+#include <limits>
 #include <map>
 #include <memory>
 #include <string>
@@ -218,6 +219,7 @@
         LibertyPort *lib_bit_port = modelPort(pin);
         float load_cap = graph_delay_calc_->loadCap(pin, scene_, min_max_);
         lib_bit_port->setCapacitance(load_cap);
+        setPortLimits(pin, lib_bit_port);
       }
       delete member_iter;
     }
@@ -227,11 +229,60 @@
       Pin *pin = network_->findPin(top_inst, port);
       float load_cap = graph_delay_calc_->loadCap(pin, scene_, min_max_);
       lib_port->setCapacitance(load_cap);
+      setPortLimits(pin, lib_port);
     }
   }
   delete port_iter;
 }
 
+// A port's design rule limits are those of the cells behind it: an
+// input's the tightest max_transition of its loads, an output's the
+// max_capacitance of its driver, each falling back to the library
+// default.
+void
+MakeTimingModel::setPortLimits(const Pin *pin,
+                               LibertyPort *lib_port)
+{
+  const PortDirection *dir = network_->direction(pin);
+  float slew_limit = std::numeric_limits<float>::max();
+  float cap_limit = std::numeric_limits<float>::max();
+  bool slew_exists = false;
+  bool cap_exists = false;
+  PinConnectedPinIterator *pin_iter = network_->connectedPinIterator(pin);
+  while (pin_iter->hasNext()) {
+    const Pin *conn = pin_iter->next();
+    const LibertyPort *port = network_->libertyPort(conn);
+    if (port == nullptr)
+      continue;
+    const LibertyLibrary *lib = port->libertyCell()->libertyLibrary();
+    float limit;
+    bool exists;
+    if (dir->isAnyInput() && network_->isLoad(conn)) {
+      port->slewLimit(min_max_, limit, exists);
+      if (!exists)
+        lib->defaultMaxSlew(limit, exists);
+      if (exists && limit < slew_limit) {
+        slew_limit = limit;
+        slew_exists = true;
+      }
+    }
+    if (dir->isAnyOutput() && network_->isDriver(conn)) {
+      port->capacitanceLimit(min_max_, limit, exists);
+      if (!exists)
+        lib->defaultMaxCapacitance(limit, exists);
+      if (exists && limit < cap_limit) {
+        cap_limit = limit;
+        cap_exists = true;
+      }
+    }
+  }
+  delete pin_iter;
+  if (slew_exists)
+    lib_port->setSlewLimit(slew_limit, min_max_);
+  if (cap_exists)
+    lib_port->setCapacitanceLimit(cap_limit, min_max_);
+}
+
 void
 MakeTimingModel::checkClock(Clock *clk)
 {
