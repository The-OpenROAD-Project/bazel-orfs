From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Sun, 27 Sep 2026 12:00:00 +0200
Subject: [PATCH] sta: write_timing_model port max_transition/max_capacitance
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Model ports had a capacitance and no design rule limits, so a parent
checked nothing on a net whose only driver and loads are model ports.
An input port gets the tightest max_transition of its loads less the
slew the wire adds to reach them, an output port its driver's
max_capacitance less the load already on it inside the block, pins and
wire; each never below half the cell's own limit, and each falls back
to the library default. Without the floors a port whose internal wire
or load took the whole budget got a limit of 0 or nearly, and the
parent's repair_design stopped on RSZ-0090 (inputs) and RSZ-0169
(outputs).

The source half of parallaxsw/OpenSTA#518, whose test is
test/write_timing_model_limits, plus the floors, which #518 does not have
yet. Retires on the //:bump onto an OpenROAD whose OpenSTA carries both.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
diff --git a/src/sta/search/MakeTimingModel.cc b/src/sta/search/MakeTimingModel.cc
--- a/src/sta/search/MakeTimingModel.cc
+++ b/src/sta/search/MakeTimingModel.cc
@@ -27,6 +27,7 @@
 
 #include <algorithm>
 #include <cstddef>
+#include <limits>
 #include <map>
 #include <memory>
 #include <string>
@@ -198,6 +199,8 @@
 void
 MakeTimingModel::makePorts()
 {
+  // Slews for the port limits.
+  sta_->findDelays();
   Instance *top_inst = network_->topInstance();
   Cell *top_cell = network_->cell(top_inst);
   CellPortIterator *port_iter = network_->portIterator(top_cell);
@@ -218,6 +221,7 @@
         LibertyPort *lib_bit_port = modelPort(pin);
         float load_cap = graph_delay_calc_->loadCap(pin, scene_, min_max_);
         lib_bit_port->setCapacitance(load_cap);
+        setPortLimits(pin, lib_bit_port);
       }
       delete member_iter;
     }
@@ -227,11 +231,95 @@
       Pin *pin = network_->findPin(top_inst, port);
       float load_cap = graph_delay_calc_->loadCap(pin, scene_, min_max_);
       lib_port->setCapacitance(load_cap);
+      setPortLimits(pin, lib_port);
     }
   }
   delete port_iter;
 }
 
+// Port design rule limits are derived from the cells behind the port,
+// so a parent checks the nets between model instances. The sdc is set
+// aside at this point, so the slews at input port loads are those of an
+// ideal transition at the port.
+void
+MakeTimingModel::setPortLimits(const Pin *pin,
+                               LibertyPort *lib_port)
+{
+  const PortDirection *dir = network_->direction(pin);
+  if (dir->isAnyInput())
+    setInputSlewLimit(pin, lib_port);
+  if (dir->isAnyOutput())
+    setOutputCapLimit(pin, lib_port);
+}
+
+// The tightest load max_transition less the slew the wire adds on the
+// way to the load, so a port slew within the limit keeps the loads
+// within theirs, and never below half the load's limit.
+void
+MakeTimingModel::setInputSlewLimit(const Pin *pin,
+                                   LibertyPort *lib_port)
+{
+  DcalcAPIndex ap_index = scene_->dcalcAnalysisPtIndex(min_max_);
+  float port_limit = std::numeric_limits<float>::max();
+  bool exists = false;
+  PinConnectedPinIterator *pin_iter = network_->connectedPinIterator(pin);
+  while (pin_iter->hasNext()) {
+    const Pin *load_pin = pin_iter->next();
+    const LibertyPort *load_port = network_->libertyPort(load_pin);
+    if (load_port && network_->isLoad(load_pin)) {
+      float limit;
+      bool limit_exists;
+      load_port->slewLimit(min_max_, limit, limit_exists);
+      if (!limit_exists)
+        load_port->libertyCell()->libertyLibrary()->defaultMaxSlew(limit,
+                                                                   limit_exists);
+      if (limit_exists) {
+        Vertex *vertex = graph_->pinLoadVertex(load_pin);
+        float wire_slew = 0.0;
+        for (const RiseFall *rf : RiseFall::range())
+          wire_slew = std::max(wire_slew,
+                               delayAsFloat(graph_->slew(vertex, rf, ap_index)));
+        // A wire that takes more than half the budget is the block's own
+        // violation, for its input buffer; the port keeps half the limit.
+        port_limit = std::min(port_limit, std::max(limit - wire_slew, limit / 2));
+        exists = true;
+      }
+    }
+  }
+  delete pin_iter;
+  if (exists)
+    lib_port->setSlewLimit(port_limit, min_max_);
+}
+
+// The driver max_capacitance less the load already on it inside the
+// block, pins and wire, and never below half the driver's limit.
+void
+MakeTimingModel::setOutputCapLimit(const Pin *pin,
+                                   LibertyPort *lib_port)
+{
+  PinConnectedPinIterator *pin_iter = network_->connectedPinIterator(pin);
+  while (pin_iter->hasNext()) {
+    const Pin *drvr_pin = pin_iter->next();
+    const LibertyPort *drvr_port = network_->libertyPort(drvr_pin);
+    if (drvr_port && network_->isDriver(drvr_pin)) {
+      float limit;
+      bool exists;
+      drvr_port->capacitanceLimit(min_max_, limit, exists);
+      if (!exists)
+        drvr_port->libertyCell()->libertyLibrary()->defaultMaxCapacitance(limit,
+                                                                          exists);
+      if (exists) {
+        float load_cap = graph_delay_calc_->loadCap(drvr_pin, scene_, min_max_);
+        // A load that takes more than half the driver's limit is the
+        // block's own violation; the port keeps half the limit.
+        lib_port->setCapacitanceLimit(std::max(limit - load_cap, limit / 2),
+                                      min_max_);
+      }
+    }
+  }
+  delete pin_iter;
+}
+
 void
 MakeTimingModel::checkClock(Clock *clk)
 {
diff --git a/src/sta/search/MakeTimingModelPvt.hh b/src/sta/search/MakeTimingModelPvt.hh
