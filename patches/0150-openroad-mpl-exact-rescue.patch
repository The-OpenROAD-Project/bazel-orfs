+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// An annealer started from a legal placement, with legal moves only, ends
+// inside its outline: the rescue mpl falls back on when annealing alone
+// finds no placement.
+
+#include <algorithm>
+#include <memory>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "MplTest.h"
+#include "SACoreHardMacro.h"
+#include "clusterEngine.h"
+#include "gtest/gtest.h"
+#include "object.h"
+#include "odb/geom.h"
+#include "packing.h"
+#include "packingAdapter.h"
+
+namespace mpl {
+namespace {
+
+class SeededAnnealing : public MplTest
+{
+ protected:
+  // Hard macros that tile `outline` exactly: a perfect packing exists and
+  // no annealing move has any slack.
+  std::vector<HardMacro> planted(const int width,
+                                 const int height,
+                                 const int pieces,
+                                 std::mt19937& rng)
+  {
+    struct Piece
+    {
+      int width;
+      int height;
+    };
+    std::vector<Piece> work{{width, height}};
+    while (static_cast<int>(work.size()) < pieces) {
+      const size_t index
+          = std::uniform_int_distribution<size_t>(0, work.size() - 1)(rng);
+      const Piece piece = work[index];
+      const bool vertical = piece.width >= piece.height;
+      const int side = vertical ? piece.width : piece.height;
+      if (side < 2000) {
+        continue;
+      }
+      // Cuts on a 200 DBU grid keep the exact check on its coarse levels.
+      const int at
+          = 200 * std::uniform_int_distribution<int>(5, side / 200 - 5)(rng);
+      work.erase(work.begin() + index);
+      if (vertical) {
+        work.push_back({at, piece.height});
+        work.push_back({piece.width - at, piece.height});
+      } else {
+        work.push_back({piece.width, at});
+        work.push_back({piece.width, piece.height - at});
+      }
+    }
+    std::shuffle(work.begin(), work.end(), rng);
+    std::vector<HardMacro> macros;
+    for (size_t i = 0; i < work.size(); i++) {
+      macros.emplace_back(
+          work[i].width, work[i].height, "m" + std::to_string(i));
+    }
+    return macros;
+  }
+
+  std::unique_ptr<SACoreHardMacro> annealer(
+      const odb::Rect& outline,
+      const std::vector<HardMacro>& macros)
+  {
+    tree_.die_area = outline;
+    SACoreWeights weights;
+    weights.outline = 1.0f;
+    weights.wirelength = 1.0f;
+    return std::make_unique<SACoreHardMacro>(&tree_,
+                                             outline,
+                                             macros,
+                                             weights,
+                                             0.2f,
+                                             0.2f,
+                                             0.2f,
+                                             0.4f,
+                                             0.95f,
+                                             200,
+                                             50,
+                                             1,
+                                             nullptr,
+                                             &logger_,
+                                             db_->getChip()->getBlock());
+  }
+
+  PhysicalHierarchy tree_;
+};
+
+TEST_F(SeededAnnealing, LegalStartStaysInsideTheOutline)
+{
+  std::mt19937 rng(11);
+  const odb::Rect outline(0, 0, 102400, 71600);
+  for (int pieces = 2; pieces <= 10; pieces++) {
+    std::vector<HardMacro> macros
+        = planted(outline.dx(), outline.dy(), pieces, rng);
+    const PackingProblem problem = toPackingProblem(outline, macros, 0);
+    const PackingResult fit = checkPacking(problem);
+    ASSERT_EQ(fit.status, PackingStatus::kFits) << pieces;
+
+    std::vector<odb::Rect> rects;
+    for (size_t i = 0; i < macros.size(); i++) {
+      const PlacedBlock& placed = fit.placement[i];
+      macros[i].setX(placed.x);
+      macros[i].setY(placed.y);
+      rects.emplace_back(placed.x,
+                         placed.y,
+                         placed.x + placed.width,
+                         placed.y + placed.height);
+    }
+    const SequencePair pair = sequencePairOf(rects);
+    ASSERT_EQ(pair.pos_sequence.size(), macros.size()) << pieces;
+
+    std::unique_ptr<SACoreHardMacro> sa = annealer(outline, macros);
+    sa->setInitialSequencePair(pair);
+    sa->disallowInvalidStates();
+    runSA(sa.get());
+    EXPECT_TRUE(sa->isValid()) << pieces << " macros";
+    EXPECT_LE(sa->getWidth(), outline.dx()) << pieces;
+    EXPECT_LE(sa->getHeight(), outline.dy()) << pieces;
+  }
+}
