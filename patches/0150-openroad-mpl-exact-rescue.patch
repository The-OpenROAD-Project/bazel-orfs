+std::vector<SoftMacro> HierRTLMP::seedSoftMacros(
+    std::vector<SoftMacro> macros,
+    const std::vector<PlacedBlock>& placement,
+    const std::vector<int>& macro_of_block)
+{
+  for (size_t k = 0; k < placement.size(); k++) {
+    SoftMacro& macro = macros[macro_of_block[k]];
+    if (macro.isFixed()) {
+      continue;
+    }
+    macro.setShapeF(placement[k].width, placement[k].height);
+    macro.setLocationF(placement[k].x, placement[k].y);
+  }
+  return macros;
+}
+
+template <class T>
+SequencePair HierRTLMP::sequencePairOf(const std::vector<T>& macros,
+                                       const int sequence_pair_macros) const
+{
+  std::vector<odb::Rect> rects;
+  for (int i = 0; i < sequence_pair_macros; i++) {
+    rects.push_back(macros[i].getBBox());
+  }
+  SequencePair pair = mpl::sequencePairOf(rects);
+  if (pair.pos_sequence.empty()) {
+    logger_->error(MPL,
+                   84,
+                   "The exact placement overlaps; please report this "
+                   "internal error.");
+  }
+  return pair;
+}
