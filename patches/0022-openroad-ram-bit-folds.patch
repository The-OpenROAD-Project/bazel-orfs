+  };
+  std::map<std::pair<int, int>, WordWrite> word_write_;
+  int sliceOffset(int slice) const
+  {
+    return bit_folds_ > 1 ? 0 : slice * slice_width_;
+  }
   std::string pin_layer_;
   bool marking_periphery_{false};
   Cell* periphery_cell_{nullptr};
