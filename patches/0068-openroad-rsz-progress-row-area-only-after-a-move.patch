+int MoveCommitter::totalAcceptedMoves() const
+{
+  int total = 0;
+  for (int i = 0; i < static_cast<int>(MoveType::kCount); ++i) {
+    total += totalMoves(static_cast<MoveType>(i));
+  }
+  return total;
+}
