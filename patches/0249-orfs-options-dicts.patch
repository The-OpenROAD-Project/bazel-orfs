-proc repair_design_helper { } {
+# The options a design gives one call of a command. <COMMAND>_OPTIONS is a
+# Tcl dict of the command's options, as `describe_options <command>` lists
+# them; a key @<stage> or @<stage>.<call> holds a dict for that stage or
+# call alone. Returned as -options switches, widest scope first: OpenROAD
+# applies -options left to right, so these go after the flow's.
+proc command_options { cmd call } {
+  set var "[string toupper $cmd]_OPTIONS"
+  if { ![env_var_exists_and_non_empty $var] } {
+    return {}
+  }
+  set stage [lindex [split $call .] 0]
+  set scopes [dict create "" {} @$stage {} @$call {}]
+  dict for {key value} $::env($var) {
+    if { [string index $key 0] ne "@" } {
+      dict set scopes "" $key $value
+      continue
+    }
+    set scope_stage [lindex [split [string range $key 1 end] .] 0]
+    if { $scope_stage ni {synth floorplan place cts grt route final} } {
+      utl::error FLW 51 "$var: '$key' does not name a stage."
+    }
+    if { [dict exists $scopes $key] } {
+      dict set scopes $key [dict merge [dict get $scopes $key] $value]
+    }
+  }
+  set switches {}
+  dict for {scope options} $scopes {
+    if { [dict size $options] > 0 } {
+      lappend switches -options $options
+    }
+  }
+  return $switches
+}
+
+# The value -options switches give an option spelled as a dotted key, the
+# last one deciding as it does in OpenROAD, or default when none does.
+proc options_value { switches option default } {
+  foreach {switch options} $switches {
+    if { [dict exists $options $option] } {
+      set default [dict get $options $option]
+    }
+  }
+  return $default
+}
+
+proc repair_design_helper { call } {
   puts "Perform buffer insertion and gate resizing..."
 
   set additional_args "-verbose"
   append_env_var additional_args CAP_MARGIN -cap_margin 1
   append_env_var additional_args SLEW_MARGIN -slew_margin 1
   append_env_var additional_args MATCH_CELL_FOOTPRINT -match_cell_footprint 0
-  log_cmd repair_design {*}$additional_args
+  log_cmd repair_design {*}$additional_args {*}[command_options repair_design $call]
 }
 
