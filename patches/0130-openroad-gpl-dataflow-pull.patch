+namespace {
+
+// The group a cell is pulled with: the first `depth` components of its
+// hierarchical name, or with depth 0 rtl_macro_placer's cluster
+// (-keep_clustering_data). -1 when it has none.
+class Grouper
+{
+ public:
+  explicit Grouper(int depth) : depth_(depth) {}
+
+  int group(odb::dbInst* inst)
+  {
+    if (depth_ > 0) {
+      const std::string name = inst->getName();
+      size_t end = std::string::npos;
+      size_t pos = 0;
+      for (int d = 0; d < depth_; d++) {
+        const size_t slash = name.find('/', pos);
+        if (slash == std::string::npos) {
+          break;
+        }
+        end = slash;
+        pos = slash + 1;
+      }
+      if (end == std::string::npos) {
+        return -1;
+      }
+      return names_.try_emplace(name.substr(0, end), size()).first->second;
+    }
+    odb::dbGroup* group = inst->getGroup();
+    if (group == nullptr || group->getType() != odb::dbGroupType::VISUAL_DEBUG
+        || group->getParentGroup() == nullptr) {
+      return -1;
+    }
+    return groups_.try_emplace(group, size()).first->second;
+  }
+
+  int size() const { return static_cast<int>(names_.size() + groups_.size()); }
+
+ private:
+  const int depth_;
+  std::unordered_map<std::string, int> names_;
+  std::unordered_map<odb::dbGroup*, int> groups_;
+};
+
+// For each macro, the cells within kStages register stages of it, forward
+// from its outputs and backward from its inputs, through nets of at most
+// kMaxNetPins pins (clock, reset and enable trees are skipped, as
+// rtl_macro_placer skips large nets). A group's affinity to a macro is
+// the mean over its cells of 0.5^stage; it keeps its kMaxTargets
+// strongest macros.
+std::shared_ptr<DataflowTargets> computeDataflowTargets(odb::dbBlock* block,
+                                                        sta::dbNetwork* network,
+                                                        int depth,
+                                                        utl::Logger* log)
+{
+  constexpr int kStages = 3;
+  constexpr int kMaxNetPins = 50;
+  constexpr size_t kMaxTargets = 4;
+  constexpr size_t kMaxVisited = 500000;
+
+  auto targets = std::make_shared<DataflowTargets>();
+  Grouper grouper(depth);
+  std::vector<odb::dbInst*> macros;
+  std::vector<int> group_cells;
+  for (odb::dbInst* inst : block->getInsts()) {
+    if (inst->isBlock()) {
+      macros.push_back(inst);
+      continue;
+    }
+    const int g = grouper.group(inst);
+    if (g < 0) {
+      continue;
+    }
+    targets->inst_group[inst] = g;
+    if (g >= static_cast<int>(group_cells.size())) {
+      group_cells.resize(g + 1, 0);
+    }
+    group_cells[g]++;
+  }
+  const int num_groups = grouper.size();
+  group_cells.resize(num_groups, 0);
+
+  std::unordered_map<odb::dbMaster*, bool> sequential;
+  auto is_sequential = [&](odb::dbInst* inst) {
+    const auto [it, inserted]
+        = sequential.try_emplace(inst->getMaster(), false);
+    if (inserted) {
+      const sta::LibertyCell* cell
+          = network->libertyCell(network->dbToSta(inst));
+      it->second = cell != nullptr && cell->isSequential();
+    }
+    return it->second;
+  };
+
+  // per group: macro index -> summed 0.5^stage
+  std::vector<std::map<int, double>> affinity(num_groups);
+  for (size_t m = 0; m < macros.size(); m++) {
+    std::unordered_map<odb::dbInst*, int> stage;
+    for (const bool forward : {true, false}) {
+      std::deque<std::pair<odb::dbInst*, int>> queue;
+      // From inst at stage s, the cells on the far side of its pins in
+      // the walk's direction.
+      auto expand = [&](odb::dbInst* inst, int s) {
+        for (odb::dbITerm* iterm : inst->getITerms()) {
+          const odb::dbIoType dir = iterm->getIoType();
+          const bool out
+              = dir == odb::dbIoType::OUTPUT || dir == odb::dbIoType::INOUT;
+          const bool in
+              = dir == odb::dbIoType::INPUT || dir == odb::dbIoType::INOUT;
+          if (forward ? !out : !in) {
+            continue;
+          }
+          odb::dbNet* net = iterm->getNet();
+          if (net == nullptr || net->getSigType().isSupply()
+              || net->getSigType() == odb::dbSigType::CLOCK
+              || net->getITerms().size() > kMaxNetPins) {
+            continue;
+          }
+          for (odb::dbITerm* other : net->getITerms()) {
+            const odb::dbIoType odir = other->getIoType();
+            const bool takes = forward ? (odir == odb::dbIoType::INPUT
+                                          || odir == odb::dbIoType::INOUT)
+                                       : (odir == odb::dbIoType::OUTPUT
+                                          || odir == odb::dbIoType::INOUT);
+            odb::dbInst* next = other->getInst();
+            if (!takes || next == inst || next->isBlock()) {
+              continue;
+            }
+            const int ns = s + (is_sequential(next) ? 1 : 0);
+            if (ns > kStages) {
+              continue;
+            }
+            const auto [it, inserted] = stage.try_emplace(next, ns);
+            if (!inserted) {
+              if (it->second <= ns) {
+                continue;
+              }
+              it->second = ns;
+            }
+            queue.emplace_back(next, ns);
+          }
+        }
+      };
+      expand(macros[m], 0);
+      while (!queue.empty() && stage.size() < kMaxVisited) {
+        const auto [inst, s] = queue.front();
+        queue.pop_front();
+        if (stage[inst] < s) {
+          continue;
+        }
+        expand(inst, s);
+      }
+    }
+    for (const auto& [inst, s] : stage) {
+      const auto it = targets->inst_group.find(inst);
+      if (it != targets->inst_group.end()) {
+        affinity[it->second][m] += std::pow(0.5, s);
+      }
+    }
+  }
+
+  // Deterministic: groups in id order, macros by affinity then index.
+  targets->targets.resize(num_groups);
+  int pairs = 0;
+  for (int g = 0; g < num_groups; g++) {
+    std::vector<std::pair<double, int>> ranked;
+    for (const auto& [m, a] : affinity[g]) {
+      ranked.emplace_back(a / std::max(group_cells[g], 1), m);
+    }
+    std::sort(ranked.begin(), ranked.end(), [](const auto& a, const auto& b) {
+      return a.first != b.first ? a.first > b.first : a.second < b.second;
+    });
+    for (size_t k = 0; k < std::min(ranked.size(), kMaxTargets); k++) {
+      const odb::Rect box = macros[ranked[k].second]->getBBox()->getBox();
+      targets->targets[g].emplace_back(
+          odb::Point((box.xMin() + box.xMax()) / 2,
+                     (box.yMin() + box.yMax()) / 2),
+          static_cast<float>(ranked[k].first));
+      pairs++;
+    }
+  }
+  log->info(GPL,
+            9107,
+            "Dataflow pull: {} groups, {} macros, {} group-macro pairs.",
+            num_groups,
+            macros.size(),
+            pairs);
+  return targets;
+}
