+bool NesterovBase::updateDataflowPull()
+{
+  if (nbVars_.dataflowPullWeight <= 0 || !dataflow_
+      || cluster_pull_iter_ >= nbVars_.clusterPullIters) {
+    return false;
+  }
+  const float weight = nbVars_.dataflowPullWeight
+                       * (1.0f
+                          - static_cast<float>(cluster_pull_iter_)
+                                / static_cast<float>(nbVars_.clusterPullIters));
+
+  const size_t numGCells = nb_gcells_.size();
+  if (!dataflow_cached_) {
+    dataflow_group_.assign(numGCells, -1);
+    for (size_t i = 0; i < numGCells; i++) {
+      GCell* gCell = nb_gcells_[i];
+      if (!gCell->isInstance() || gCell->isLocked()) {
+        continue;
+      }
+      const auto it = dataflow_->inst_group.find(gCell->insts()[0]->dbInst());
+      if (it != dataflow_->inst_group.end()
+          && !dataflow_->targets[it->second].empty()) {
+        dataflow_group_[i] = it->second;
+      }
+    }
+    dataflow_grads_.assign(numGCells, FloatPoint(0, 0));
+    dataflow_precond_.assign(numGCells, 0);
+    dataflow_cached_ = true;
+  }
+
+  // Group centroids serially, in cell order.
+  const size_t numGroups = dataflow_->targets.size();
+  std::vector<double> sum_x(numGroups, 0);
+  std::vector<double> sum_y(numGroups, 0);
+  std::vector<double> sum_area(numGroups, 0);
+  for (size_t i = 0; i < numGCells; i++) {
+    const int g = dataflow_group_[i];
+    if (g < 0) {
+      continue;
+    }
+    GCell* gCell = nb_gcells_[i];
+    const double area = static_cast<double>(gCell->dDx()) * gCell->dDy();
+    sum_x[g] += area * gCell->dCx();
+    sum_y[g] += area * gCell->dCy();
+    sum_area[g] += area;
+  }
+
+  // Every cell of a group gets the group's pull toward its macros, so the
+  // group moves as a whole; bounded by weight * affinity per macro.
+  const double density = std::max(targetDensity_, 0.01f);
+  std::vector<FloatPoint> group_grad(numGroups, FloatPoint(0, 0));
+  std::vector<float> group_precond(numGroups, 0);
+  for (size_t g = 0; g < numGroups; g++) {
+    if (sum_area[g] <= 0) {
+      continue;
+    }
+    const double cx = sum_x[g] / sum_area[g];
+    const double cy = sum_y[g] / sum_area[g];
+    const double radius2 = sum_area[g] / density / 4.0;
+    for (const auto& [center, affinity] : dataflow_->targets[g]) {
+      const double dx = center.x() - cx;
+      const double dy = center.y() - cy;
+      const double norm = std::sqrt(dx * dx + dy * dy + radius2);
+      group_grad[g].x += weight * affinity * dx / norm;
+      group_grad[g].y += weight * affinity * dy / norm;
+      group_precond[g] += weight * affinity;
+    }
+  }
+  for (size_t i = 0; i < numGCells; i++) {
+    const int g = dataflow_group_[i];
+    if (g >= 0) {
+      dataflow_grads_[i] = group_grad[g];
+      dataflow_precond_[i] = group_precond[g];
+    }
+  }
+
+  if (!dataflow_reported_) {
+    log_->info(GPL,
+               9106,
+               "Dataflow pull: weight {:g} fading to 0 at iteration {}.",
+               weight,
+               nbVars_.clusterPullIters);
+    dataflow_reported_ = true;
+  }
+  return true;
+}
