diff --git a/flow/Makefile b/flow/Makefile
index 916c8d2..c5d5569 100644
--- a/flow/Makefile
+++ b/flow/Makefile
@@ -271,20 +271,20 @@ do-auto-memories: $(RESULTS_DIR)/memories_inferred.json
 	  --top $(DESIGN_NAME) \
 	  --yosys-json $(RESULTS_DIR)/memories_inferred.json \
 	  --out-dir $(RESULTS_DIR)/memories \
-	  --json $(RESULTS_DIR)/memories.json \
+	  --json $(AUTO_MEMORIES_JSON) \
 	  $(foreach file,$(ADDITIONAL_MEMORIES),--memories $(file)) \
 	  $(foreach file,$(AUTO_MEMORIES_REGFILES),--regfile-spec $(file)) \
 	  $(foreach m,$(AUTO_MEMORIES_MACRO_PLACE),--macro-place $(m)) \
 	  $(if $(AUTO_MEMORIES_REGFILES),--openroad $(OPENROAD_EXE)) \
 	  $(foreach file,$(TECH_LEF) $(SC_LEF),--lef $(file))
 
-$(RESULTS_DIR)/memories.json: $(RESULTS_DIR)/memories_inferred.json $(ADDITIONAL_MEMORIES) \
+$(AUTO_MEMORIES_JSON): $(RESULTS_DIR)/memories_inferred.json $(ADDITIONAL_MEMORIES) \
     $(AUTO_MEMORIES_REGFILES) $(wildcard $(SCRIPTS_DIR)/memories/*.py)
 	$(UNSET_AND_MAKE) do-auto-memories
 
-yosys-dependencies: $(RESULTS_DIR)/memories.json
-$(RESULTS_DIR)/1_1_yosys_canonicalize.rtlil: $(RESULTS_DIR)/memories.json
-$(RESULTS_DIR)/memories/blackboxes.txt: $(RESULTS_DIR)/memories.json ;
+yosys-dependencies: $(AUTO_MEMORIES_JSON)
+$(RESULTS_DIR)/1_1_yosys_canonicalize.rtlil: $(AUTO_MEMORIES_JSON)
+$(RESULTS_DIR)/memories/blackboxes.txt: $(AUTO_MEMORIES_JSON) ;
 # The generated LEFs are part of the KLayout technology the GDS merge
 # reads the final DEF with. Synthesis writes its own memories;
 # AUTO_MEMORIES_DIR is where the stages after it read them, as
diff --git a/flow/scripts/variables.mk b/flow/scripts/variables.mk
index 95e8df8..a600b5e 100644
--- a/flow/scripts/variables.mk
+++ b/flow/scripts/variables.mk
@@ -61,6 +61,8 @@ export INPUT_RESULTS_DIR = $(WORK_HOME)/results/$(PLATFORM)/$(DESIGN_NICKNAME)/$
 # them to its own $(RESULTS_DIR)/memories. Set by a build system that
 # runs a stage of one variant on another variant's synthesis.
 export AUTO_MEMORIES_DIR ?= $(RESULTS_DIR)/memories
+# Where AUTO_MEMORIES' inventory is written.
+export AUTO_MEMORIES_JSON ?= $(RESULTS_DIR)/memories.json
 
 #-------------------------------------------------------------------------------
 ifeq (,$(strip $(NUM_CORES)))
