index 0000000000..bd2b60c9bd
--- /dev/null
+++ b/src/dbSta/test/write_spef_hier_inst_name.tcl
@@ -0,0 +1,38 @@
+# write_spef names every instance pin by an instance that exists, also for
+# a cell whose name inside its module instance has a divider of its own:
+# h1/core\/dispatch/ff0 lives in module instance h1, as a cell of a
+# flattened child keeps its hierarchy in its name.
+source "helpers.tcl"
+
+source Nangate45/Nangate45.vars
+read_liberty Nangate45/Nangate45_typ.lib
+read_lef Nangate45/Nangate45.lef
+read_verilog escape_slash_hier.v
+link_design -hier multi_sink
+read_def -floorplan_initialize escape_slash_hier.def
+
+source Nangate45/Nangate45.rc
+source $layer_rc_file
+set_wire_rc -signal -layer $wire_rc_layer
+set_wire_rc -clock -layer $wire_rc_layer_clk
+
+set block [ord::get_db_block]
+set ff [$block findInst {h1/ff0\/name}]
+$ff rename {h1/core\/dispatch/ff0}
+
+set spef_file [make_result_file write_spef_hier_inst_name.spef]
+estimate_parasitics -placement -spef_file $spef_file
+
+set stream [open $spef_file r]
+set conns 0
+foreach line [split [read $stream] "\n"] {
+  if { [regexp {^\*I (\S+):\S+ } $line -> inst_name] } {
+    incr conns
+    check "*I $inst_name is an instance" {
+      expr { [$block findInst $inst_name] ne "NULL" }
+    } 1
+  }
+}
+close $stream
+check "*I lines" { set conns } 3
+exit_summary
