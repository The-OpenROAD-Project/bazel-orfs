diff --git a/flow/test/test_generate_klayout_tech.py b/flow/test/test_generate_klayout_tech.py
index 92e884cfc..cba8fe242 100644
--- a/flow/test/test_generate_klayout_tech.py
+++ b/flow/test/test_generate_klayout_tech.py
@@ -226,5 +226,34 @@ class TestRealPlatformLyt(unittest.TestCase):
         )
 
 
+class TestBlackboxLefs(unittest.TestCase):
+    def test_lists_the_lef_of_each_macro(self):
+        with tempfile.TemporaryDirectory() as d:
+            blackboxes = os.path.join(d, "blackboxes.txt")
+            with open(blackboxes, "w") as f:
+                f.write("ram_a 12.5\n\nram_b 3.0\n")
+            self.assertEqual(
+                generate_klayout_tech.blackbox_lefs(blackboxes),
+                [os.path.join(d, "ram_a.lef"), os.path.join(d, "ram_b.lef")],
+            )
+
+    def test_ignores_a_lef_the_list_does_not_name(self):
+        with tempfile.TemporaryDirectory() as d:
+            blackboxes = os.path.join(d, "blackboxes.txt")
+            with open(blackboxes, "w") as f:
+                f.write("ram_a 12.5\n")
+            for name in ("ram_a.lef", "stale.lef"):
+                open(os.path.join(d, name), "w").close()
+            self.assertEqual(
+                generate_klayout_tech.blackbox_lefs(blackboxes),
+                [os.path.join(d, "ram_a.lef")],
+            )
+
+    def test_missing_list_fails(self):
+        with tempfile.TemporaryDirectory() as d:
+            with self.assertRaises(FileNotFoundError):
+                generate_klayout_tech.blackbox_lefs(os.path.join(d, "blackboxes.txt"))
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/flow/util/generate_klayout_tech.py b/flow/util/generate_klayout_tech.py
index b23a1e0ab..640bdd8b5 100644
--- a/flow/util/generate_klayout_tech.py
+++ b/flow/util/generate_klayout_tech.py
@@ -30,6 +30,21 @@ def replace_map_files(content, map_files):
     return content
 
 
+def blackbox_lefs(blackboxes):
+    """The LEF of every macro AUTO_MEMORIES' blackboxes.txt lists.
+
+    blackboxes.txt has a `<module> <area>` line per macro, and
+    do-auto-memories writes <module>.lef beside it.
+    """
+    directory = os.path.dirname(blackboxes)
+    with open(blackboxes, encoding="utf-8") as f:
+        return [
+            os.path.join(directory, line.split()[0] + ".lef")
+            for line in f
+            if line.strip()
+        ]
+
+
 def generate_klayout_tech(template_lyt, output_lyt, lef_files, map_files=None):
     """Generate a klayout .lyt file from a platform template.
 
@@ -76,12 +91,21 @@ def main():
     parser.add_argument(
         "--map-files", nargs="*", default=[], help="Map files to include"
     )
+    parser.add_argument(
+        "--blackboxes",
+        help="AUTO_MEMORIES' blackboxes.txt; the LEF of each macro it lists"
+        " is included after --lef-files",
+    )
     args = parser.parse_args()
 
+    lef_files = list(args.lef_files)
+    if args.blackboxes:
+        lef_files += blackbox_lefs(args.blackboxes)
+
     generate_klayout_tech(
         template_lyt=args.template,
         output_lyt=args.output,
-        lef_files=args.lef_files,
+        lef_files=lef_files,
         map_files=args.map_files,
     )
 
