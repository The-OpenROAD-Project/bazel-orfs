From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] asap7/riscv32i: flat synthesis; the size rule kept dmem for its SRAMs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

SYNTH_MINIMUM_KEEP_SIZE=10000 kept one module, dmem: four SRAM macros
(1,376 um^2 of liberty area) and 56 um^2 of address decode. The rule
counts the macros' area, so it kept the wrapper, and the boundary sat
on the worst path, between the ALU's address adder and the SRAMs'
chip-enable decode, which synthesis then optimised apart.

Flat, at 780 ps to global route: the reg2reg period is 791.8 ps against
835.6 (5.2 % shorter); of the reg2reg endpoints within 10 % of the
period, 995 are faster and 3 slower. WNS is -11.8 ps, a reg2reg path.

riscv32i-mock-sram hardens the SRAM as a block and keeps hierarchical
synthesis and the size rule as before.

Upstream as The-OpenROAD-Project/OpenROAD-flow-scripts#4713 (draft).
Retires on the //:bump onto an ORFS that carries it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
---
diff --git a/flow/designs/asap7/riscv32i/config.mk b/flow/designs/asap7/riscv32i/config.mk
index edc6661c..54453839 100644
--- a/flow/designs/asap7/riscv32i/config.mk
+++ b/flow/designs/asap7/riscv32i/config.mk
@@ -2,16 +2,19 @@ export DESIGN_NICKNAME ?= riscv32i
 export DESIGN_NAME = riscv_top
 export PLATFORM    = asap7
 
-export SYNTH_HIERARCHICAL ?= 1
-
-export SYNTH_MINIMUM_KEEP_SIZE ?= 10000
-
 export VERILOG_FILES = $(sort $(wildcard $(DESIGN_HOME)/src/riscv32i/*.v))
 export SDC_FILE     ?= $(DESIGN_HOME)/$(PLATFORM)/riscv32i/constraint.sdc
 
 ifeq ($(BLOCKS),)
 	export ADDITIONAL_LEFS = $(PLATFORM_DIR)/lef/fakeram7_256x32.lef
 	export ADDITIONAL_LIBS = $(PLATFORM_DIR)/lib/NLDM/fakeram7_256x32.lib
+else
+	# A hardened block (riscv32i-mock-sram) needs hierarchical synthesis.
+	# Otherwise flat: SYNTH_MINIMUM_KEEP_SIZE kept dmem for its four SRAMs'
+	# area, and its boundary cut the worst path, from the address adder to
+	# the SRAMs' enable decode.
+	export SYNTH_HIERARCHICAL ?= 1
+	export SYNTH_MINIMUM_KEEP_SIZE ?= 10000
 endif
 
 export CORE_UTILIZATION = 62
