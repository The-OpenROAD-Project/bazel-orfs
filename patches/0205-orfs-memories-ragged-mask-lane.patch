 flow/scripts/memories/schema_test.py          | 24 ++++++++++++++
 tools/FakeRAM2.0/orfs_asap7/generate.py       |  1 +
 tools/FakeRAM2.0/test/spsram_mask_test.py     | 30 ++++++++++++++---
 tools/FakeRAM2.0/utils/class_memory.py        |  5 +++
 tools/FakeRAM2.0/utils/memory_config.py       | 23 +++++++++++--
 .../utils/single_port_ram_verilog_exporter.py | 30 +++++++++++++----
 7 files changed, 132 insertions(+), 14 deletions(-)

diff --git a/flow/scripts/memories/schema.py b/flow/scripts/memories/schema.py
index 9141b9cc76..fc8026963b 100644
--- a/flow/scripts/memories/schema.py
+++ b/flow/scripts/memories/schema.py
@@ -49,6 +49,10 @@ class Memory:
     # Total width of the per-port write mask, 0 if unmasked. Subword-split
     # mask pins (`W0_mask_0..3`) contribute one lane each.
     mask_lanes: int = 0
+    # Bits per mask lane, 0 for the even split (bits / mask_lanes). A
+    # ragged last lane needs it: tc_sram's byte enables over a 25-bit
+    # word are 8, 8, 8 and 1 bit wide (mask_lanes 4, mask_lane_width 8).
+    mask_lane_width: int = 0
     # Read ports yosys inferred without a clock ($mem_v2 RD_CLK_ENABLE=0).
     # An SRAM macro reads on a clock edge, so one of these rules the memory
     # out of conversion; see idiomatic.py.
@@ -124,6 +128,7 @@ def memory_from_dict(d: dict) -> Memory:
         "write_ports",
         "rw_ports",
         "mask_lanes",
+        "mask_lane_width",
         "comb_read_ports",
     ):
         if key in d:
@@ -194,6 +199,7 @@ def merge(detected: list[Memory], overrides: list[Memory]) -> list[Memory]:
             "write_ports",
             "rw_ports",
             "mask_lanes",
+            "mask_lane_width",
             "comb_read_ports",
         ):
             value = getattr(o, key)
@@ -210,6 +216,31 @@ def merge(detected: list[Memory], overrides: list[Memory]) -> list[Memory]:
     return list(by_name.values())
 
 
+def lane_width_check(name: str, bits: int, lanes: int, width: int) -> None:
+    """Raise SchemaError unless `lanes` mask lanes cover `bits` bits.
+
+    Every lane is `width` bits wide but the last, which holds the rest:
+    lanes * width >= bits > (lanes - 1) * width. Without a width the lanes
+    split the word evenly.
+    """
+    if not lanes:
+        if width:
+            raise SchemaError(f"memory {name}: mask_lane_width without mask_lanes")
+        return
+    if not width:
+        if bits % lanes:
+            raise SchemaError(
+                f"memory {name}: {bits} bits are not {lanes} even mask lanes; "
+                f"give mask_lane_width for a ragged last lane"
+            )
+        return
+    if not lanes * width >= bits > (lanes - 1) * width:
+        raise SchemaError(
+            f"memory {name}: {lanes} mask lanes of {width} bits do not cover "
+            f"{bits} bits with a last lane of 1 to {width}"
+        )
+
+
 def validate_emittable(mem: Memory) -> None:
     """Raise SchemaError unless `mem` carries enough to emit .lib/.lef."""
     if not mem.pins:
@@ -219,6 +250,8 @@ def validate_emittable(mem: Memory) -> None:
             f"memory {mem.name}: rows ({mem.rows}) and bits ({mem.bits}) "
             f"must be >= 1"
         )
+    if mem.mask_lane_width:
+        lane_width_check(mem.name, mem.bits, mem.mask_lanes, mem.mask_lane_width)
     port_ids = {p.port_id for p in mem.pins}
     for port_id in port_ids:
         functions = {p.function for p in mem.pins if p.port_id == port_id}
diff --git a/flow/scripts/memories/schema_test.py b/flow/scripts/memories/schema_test.py
index 31775f1b01..d8303e4133 100644
--- a/flow/scripts/memories/schema_test.py
+++ b/flow/scripts/memories/schema_test.py
@@ -115,6 +115,30 @@ class SchemaTest(unittest.TestCase):
         with self.assertRaises(schema.SchemaError):
             schema.validate_emittable(dataless)
 
+    def test_mask_lanes_cover_the_word(self):
+        # even split, ragged last lane (tc_sram's bytes over 25 bits), none
+        schema.lane_width_check("m", 64, 8, 0)
+        schema.lane_width_check("m", 25, 4, 8)
+        schema.lane_width_check("m", 25, 0, 0)
+        for bits, lanes, width in (
+            (25, 4, 0),  # not even, and no width given
+            (25, 4, 6),  # 24 bits of lanes for 25
+            (25, 4, 9),  # the last lane would be empty
+            (25, 0, 8),  # a width with no lanes
+        ):
+            with self.assertRaises(schema.SchemaError):
+                schema.lane_width_check("m", bits, lanes, width)
+
+    def test_mask_lane_width_survives_merge_and_dump(self):
+        base = sample_memory()
+        override = schema.Memory(name=base.name, mask_lanes=4, mask_lane_width=8)
+        [merged] = schema.merge([base], [override])
+        self.assertEqual(merged.mask_lane_width, 8)
+        with tempfile.TemporaryDirectory() as d:
+            path = Path(d) / "memories.json"
+            schema.dump([merged], path, "asap7")
+            self.assertEqual(json.loads(path.read_text())["memories"][0]["mask_lane_width"], 8)
+
 
 if __name__ == "__main__":
     unittest.main()
