diff --git a/tools/FakeRAM2.0/test/spsram_mask_test.py b/tools/FakeRAM2.0/test/spsram_mask_test.py
index b4675ff423..a3b1ad0266 100755
--- a/tools/FakeRAM2.0/test/spsram_mask_test.py
+++ b/tools/FakeRAM2.0/test/spsram_mask_test.py
@@ -140,10 +140,7 @@ class MaskedSinglePortRAMTest(unittest.TestCase):
         self.assertIn("if (RW0_en) begin", v)
         self.assertIn("if (RW0_wmode) begin", v)
         self.assertIn("if (RW0_wmask[0])", v)
-        self.assertIn(
-            "mem[RW0_addr][1*LANE_WIDTH +: LANE_WIDTH] <= RW0_wdata[1*LANE_WIDTH +: LANE_WIDTH];",
-            v,
-        )
+        self.assertIn("mem[RW0_addr][113:57] <= RW0_wdata[113:57];", v)
         # the read is registered under the enable; without it the output holds
         self.assertIn("RW0_rdata <= mem[RW0_addr];", v)
         self.assertNotIn("else", v)
@@ -163,6 +160,31 @@ class MaskedSinglePortRAMTest(unittest.TestCase):
         with self.assertRaises(Exception):
             MemoryConfig("m", 114, 64, 1, 0, RW0_NAMES, 5)
 
+    def test_ragged_last_lane(self):
+        # tc_sram's byte enables over a 25-bit word: 8, 8, 8 and 1 bits
+        cfg = MemoryConfig("tag_64x25", 25, 64, 1, 0, RW0_NAMES, 4, 8)
+        self.assertEqual(cfg.get_mask_lane_width(), 8)
+        ram = MemoryFactory.create(cfg, "RAM", "SP", self.process, self.timing)
+        out = io.StringIO()
+        SinglePortRAMVerilogExporter(ram).export_lec_model(out)
+        v = out.getvalue()
+        self.assertIn("mem[RW0_addr][23:16] <= RW0_wdata[23:16];", v)
+        self.assertIn("if (RW0_wmask[3])", v)
+        self.assertIn("mem[RW0_addr][24:24] <= RW0_wdata[24:24];", v)
+        sim = io.StringIO()
+        SinglePortRAMVerilogExporter(ram).export_module(sim)
+        self.assertIn("mem[RW0_addr][24:24] <= RW0_wdata[24:24];", sim.getvalue())
+
+    def test_lane_width_must_leave_a_last_lane(self):
+        for width in (6, 9):  # 4 x 6 < 25; 3 x 9 >= 25 leaves lane 4 empty
+            with self.assertRaises(Exception):
+                MemoryConfig("m", 25, 64, 1, 0, RW0_NAMES, 4, width)
+
+    def test_even_split_is_unchanged(self):
+        self.assertEqual(
+            MemoryConfig("m", 114, 64, 1, 0, RW0_NAMES, 2).get_mask_lane_width(), 57
+        )
+
 
 class SinglePortPinsTest(unittest.TestCase):
     def test_reads_names_and_lanes(self):
diff --git a/tools/FakeRAM2.0/utils/class_memory.py b/tools/FakeRAM2.0/utils/class_memory.py
index 1cb9046dbc..1ba7f85db7 100644
--- a/tools/FakeRAM2.0/utils/class_memory.py
+++ b/tools/FakeRAM2.0/utils/class_memory.py
@@ -37,6 +37,7 @@ class Memory(NamedObject):
         self.total_size = self.width_in_bytes * self.depth
         self.additional_height = mem_config.get_additional_height()
         self.mask_lanes = mem_config.get_mask_lanes()
+        self.mask_lane_width = mem_config.get_mask_lane_width()
         self.timing_data = timing_data
         self.physical = PhysicalData()
         if self.process.calc_dimensions():
@@ -96,6 +97,10 @@ class Memory(NamedObject):
         """Returns the width in bits"""
         return self.width_in_bits
 
+    def get_mask_lane_width(self):
+        """Returns the bits per write mask lane; the last holds the rest"""
+        return self.mask_lane_width
+
     def get_num_banks(self):
         """Returns the number of banks"""
         return self.num_banks
diff --git a/tools/FakeRAM2.0/utils/memory_config.py b/tools/FakeRAM2.0/utils/memory_config.py
index db202c76d7..411559a1dd 100644
--- a/tools/FakeRAM2.0/utils/memory_config.py
+++ b/tools/FakeRAM2.0/utils/memory_config.py
@@ -13,6 +13,7 @@ class MemoryConfig:
         additional_height,
         pin_names=None,
         mask_lanes=0,
+        mask_lane_width=0,
     ):
         """Initializer"""
 
@@ -27,10 +28,21 @@ class MemoryConfig:
         # and writes whole words.
         self._pin_names = dict(pin_names) if pin_names else {}
         self._mask_lanes = int(mask_lanes or 0)
-        if self._mask_lanes and width_in_bits % self._mask_lanes:
+        # Bits per lane; the last lane holds the rest (tc_sram's byte
+        # enables over a word that is not whole bytes). 0: an even split.
+        self._mask_lane_width = int(mask_lane_width or 0)
+        lanes, width = self._mask_lanes, self._mask_lane_width
+        if lanes and not width:
+            if width_in_bits % lanes:
+                raise Exception(
+                    "Width %d is not a whole number of %d mask lanes (%s)"
+                    % (width_in_bits, lanes, name)
+                )
+            self._mask_lane_width = width_in_bits // lanes
+        elif width and not (lanes * width >= width_in_bits > (lanes - 1) * width):
             raise Exception(
-                "Width %d is not a whole number of %d mask lanes (%s)"
-                % (width_in_bits, self._mask_lanes, name)
+                "%d mask lanes of %d bits do not cover width %d (%s)"
+                % (lanes, width, width_in_bits, name)
             )
 
     def set_name(self, name):
@@ -65,6 +77,10 @@ class MemoryConfig:
         """Returns the number of write mask lanes, 0 when unmasked"""
         return self._mask_lanes
 
+    def get_mask_lane_width(self):
+        """Returns the bits per mask lane; the last lane holds the rest"""
+        return self._mask_lane_width
+
     @staticmethod
     def from_json(json_data):
         return MemoryConfig(
@@ -75,4 +91,5 @@ class MemoryConfig:
             json_data.get("additional_height", 0),
             json_data.get("pin_names"),
             json_data.get("mask_lanes", 0),
+            json_data.get("mask_lane_width", 0),
         )
diff --git a/tools/FakeRAM2.0/utils/single_port_ram_verilog_exporter.py b/tools/FakeRAM2.0/utils/single_port_ram_verilog_exporter.py
index 076494f37f..347d9e6d31 100644
--- a/tools/FakeRAM2.0/utils/single_port_ram_verilog_exporter.py
+++ b/tools/FakeRAM2.0/utils/single_port_ram_verilog_exporter.py
@@ -32,6 +32,14 @@ class SinglePortRAMVerilogExporter(VerilogExporter):
             rw_port_group.get_write_mask_lanes(),
         )
 
+    def _lane_range(self, j):
+        """Bit range [msb:lsb] of mask lane j; the last lane holds the rest"""
+        mem = self.get_memory()
+        width = mem.get_mask_lane_width()
+        lsb = j * width
+        msb = min(lsb + width, mem.get_width()) - 1
+        return f"[{msb}:{lsb}]"
+
     def export_module(self, out_fh):
         """Exports the verilog module to the output stream"""
 
@@ -69,11 +77,19 @@ class SinglePortRAMVerilogExporter(VerilogExporter):
         out_fh.write("         begin\n")
         mask_bus, lanes = self._get_mask()
         if mask_bus:
-            out_fh.write("            for (j = 0; j < MASK_LANES; j = j + 1)\n")
-            out_fh.write(f"               if ({mask_bus}[j])\n")
-            out_fh.write(
-                f"                  mem[{addr_bus}][j*LANE_WIDTH +: LANE_WIDTH] <= {din_bus}[j*LANE_WIDTH +: LANE_WIDTH];\n"
-            )
+            if lanes * mem.get_mask_lane_width() == mem.get_width():
+                out_fh.write("            for (j = 0; j < MASK_LANES; j = j + 1)\n")
+                out_fh.write(f"               if ({mask_bus}[j])\n")
+                out_fh.write(
+                    f"                  mem[{addr_bus}][j*LANE_WIDTH +: LANE_WIDTH] <= {din_bus}[j*LANE_WIDTH +: LANE_WIDTH];\n"
+                )
+            else:
+                for j in range(lanes):
+                    lane = self._lane_range(j)
+                    out_fh.write(f"            if ({mask_bus}[{j}])\n")
+                    out_fh.write(
+                        f"               mem[{addr_bus}]{lane} <= {din_bus}{lane};\n"
+                    )
         else:
             out_fh.write(f"            mem[{addr_bus}] <= {din_bus};\n")
         out_fh.write("         end\n")
@@ -112,7 +128,7 @@ class SinglePortRAMVerilogExporter(VerilogExporter):
         out_fh.write(f"         if ({we_pin}) begin\n")
         if mask_bus:
             for j in range(lanes):
-                lane = f"[{j}*LANE_WIDTH +: LANE_WIDTH]"
+                lane = self._lane_range(j)
                 out_fh.write(f"            if ({mask_bus}[{j}])\n")
                 out_fh.write(
                     f"               mem[{addr_bus}]{lane} <= {din_bus}{lane};\n"
@@ -148,7 +164,7 @@ class SinglePortRAMVerilogExporter(VerilogExporter):
         out_fh.write(f"   parameter corrupt_mem_on_X_p = 1;\n")
         if mask_bus:
             out_fh.write(f"   parameter MASK_LANES = {lanes};\n")
-            out_fh.write(f"   parameter LANE_WIDTH = {mem.get_width() // lanes};\n")
+            out_fh.write(f"   parameter LANE_WIDTH = {mem.get_mask_lane_width()};\n")
         out_fh.write("\n")
         out_fh.write(f"   output reg [BITS-1:0]    {dout_bus};\n")
         out_fh.write(f"   input  [ADDR_WIDTH-1:0]  {addr_bus};\n")
