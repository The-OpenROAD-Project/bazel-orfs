+void SetupLegacyBase::traceDistribution(const ViolatingEnds& violating_ends,
+                                        const std::string_view phase_name,
+                                        const char phase_marker,
+                                        const int max_end_count) const
+{
+  // Twenty-one quantiles of the violating endpoint slacks at phase start,
+  // worst first, so the shape of the histogram is on record for every
+  // phase without printing every endpoint.
+  std::string quantiles;
+  const size_t n = violating_ends.size();
+  if (n > 0) {
+    for (int q = 0; q <= 20; ++q) {
+      const size_t i = std::min(n - 1, (n - 1) * q / 20);
+      quantiles += fmt::format(
+          " q{:02d}={}", q * 5, delayAsString(violating_ends[i].second, 3, sta_));
+    }
+  }
+  logger_->report("[RSZ-ENDPOINTS] phase={}{} n={} max_end={}{}",
+                  phase_name,
+                  phase_marker,
+                  n,
+                  max_end_count,
+                  quantiles);
+}
+
+void SetupLegacyBase::traceBegin(EndpointRepairState& endpoint_state,
+                                 const std::string_view phase_name,
+                                 const char phase_marker,
+                                 const int end_index,
+                                 const int max_end_count,
+                                 const int opto_iteration)
+{
+  const RepairProfile& p = setup_context_.profile;
+  endpoint_state.trace_phase = std::string(phase_name);
+  endpoint_state.trace_marker = phase_marker;
+  endpoint_state.trace_index = end_index;
+  endpoint_state.trace_count = max_end_count;
+  endpoint_state.trace_pass0 = opto_iteration;
+  endpoint_state.trace_slack_in = endpoint_state.end_slack;
+  endpoint_state.trace_wns_in = endpoint_state.worst_slack;
+  endpoint_state.trace_tns_in = sta_->totalNegativeSlack(max_);
+  endpoint_state.trace_passes0 = p.passes;
+  endpoint_state.trace_candidates0 = p.candidates;
+  endpoint_state.trace_attempts0 = p.attempts;
+  endpoint_state.trace_accepted0 = p.accepted;
+  for (size_t t = 0; t < endpoint_state.trace_moves0.size(); ++t) {
+    endpoint_state.trace_moves0[t] = totalMoves(static_cast<MoveType>(t));
+  }
+  endpoint_state.trace_first_gain = 0;
+  endpoint_state.trace_last_gain = 0;
+  endpoint_state.trace_depth = 0;
+  if (sta::Path* path = sta_->vertexWorstSlackPath(endpoint_state.end, max_)) {
+    sta::PathExpanded expanded(path, sta_);
+    endpoint_state.trace_depth = static_cast<int>(expanded.size());
+  }
+  endpoint_state.trace_exit = "max_passes";
+  endpoint_state.trace_t0 = std::chrono::steady_clock::now();
+}
+
+void SetupLegacyBase::traceGain(EndpointRepairState& endpoint_state) const
+{
+  if (endpoint_state.trace_first_gain == 0) {
+    endpoint_state.trace_first_gain = endpoint_state.pass;
+  }
+  endpoint_state.trace_last_gain = endpoint_state.pass;
+}
+
+void SetupLegacyBase::traceEnd(EndpointRepairState& endpoint_state,
+                               const int opto_iteration)
+{
+  const RepairProfile& p = setup_context_.profile;
+  const double seconds
+      = std::chrono::duration<double>(std::chrono::steady_clock::now()
+                                      - endpoint_state.trace_t0)
+            .count();
+  // After a journal restore the timing is whatever the restore left; the
+  // next endpoint's first query would update it anyway. TNS updates the
+  // required times, then the endpoint's own slack and the WNS are read.
+  const float tns_out = sta_->totalNegativeSlack(max_);
+  const sta::Slack slack_out = sta_->slack(endpoint_state.end, max_);
+  sta::Slack wns_out;
+  sta::Vertex* worst_vertex = nullptr;
+  sta_->worstSlack(max_, wns_out, worst_vertex);
+  std::string moves;
+  static constexpr const char* kShort[]
+      = {"buf", "clone", "sizeup", "sizeupm", "sizedn", "swap", "vt",
+         "unbuf", "split", "reroute"};
+  for (size_t t = 0; t < endpoint_state.trace_moves0.size(); ++t) {
+    moves += fmt::format(" {}={}",
+                         kShort[t],
+                         totalMoves(static_cast<MoveType>(t))
+                             - endpoint_state.trace_moves0[t]);
+  }
+  logger_->report(
+      "[RSZ-ENDPOINT] phase={}{} idx={}/{} pass0={} pass1={} passes={} "
+      "s={:.3f} slack_in={} slack_out={} wns_in={} wns_out={} tns_in={} "
+      "tns_out={} gain1={} gainN={} depth={} cand={} att={} acc={}{} "
+      "exit={} end={}",
+      endpoint_state.trace_phase,
+      endpoint_state.trace_marker,
+      endpoint_state.trace_index,
+      endpoint_state.trace_count,
+      endpoint_state.trace_pass0,
+      opto_iteration,
+      p.passes - endpoint_state.trace_passes0,
+      seconds,
+      delayAsString(endpoint_state.trace_slack_in, 3, sta_),
+      delayAsString(slack_out, 3, sta_),
+      delayAsString(endpoint_state.trace_wns_in, 3, sta_),
+      delayAsString(wns_out, 3, sta_),
+      delayAsString(endpoint_state.trace_tns_in, 1, sta_),
+      delayAsString(tns_out, 1, sta_),
+      endpoint_state.trace_first_gain,
+      endpoint_state.trace_last_gain,
+      endpoint_state.trace_depth,
+      p.candidates - endpoint_state.trace_candidates0,
+      p.attempts - endpoint_state.trace_attempts0,
+      p.accepted - endpoint_state.trace_accepted0,
+      moves,
+      endpoint_state.trace_exit,
+      network_->pathName(endpoint_state.end->pin()));
+}
