+// The switches of global_route are generated from GlobalRouteOptions and
+// parsed by optionsFromArgs; the Tcl proc keeps -guide_file, the
+// incremental bracket and -unguided_only.
+//
+// The command selects the engine, the backing file and whether to keep the
+// incremental state on every call; the C++ API keeps the current setting
+// when they are unset.
+static grt::GlobalRouteOptions
+commandRouteOptions(Tcl_Interp* interp, Tcl_Obj* args)
+{
+  grt::GlobalRouteOptions route_options
+      = optionsFromArgs<grt::GlobalRouteOptions>(interp, args, "global_route");
+  if (!route_options.use_cugr) {
+    route_options.use_cugr = false;
+  }
+  if (!route_options.backing_file) {
+    route_options.backing_file = "";
+  }
+  if (!route_options.incremental) {
+    route_options.incremental = true;
+  }
+  return route_options;
+}
