+// Nets by increasing slack, ties by net id, as resizeWorstSlackNets sorts.
+std::vector<std::pair<const sta::Net*, float>> slackSnapshot(rsz::Resizer* rs)
+{
+  rs->setWorstSlackNetsPercent(100);
+  std::vector<std::pair<const sta::Net*, float>> out;
+  for (const sta::Net* net : rs->resizeWorstSlackNets()) {
+    out.emplace_back(net, rs->resizeNetSlack(net).value());
+  }
+  return out;
+}
+
+// Fraction of ref's worst `percent` nets that are among other's worst
+// `percent` nets of the same count.
+double topOverlap(const std::vector<std::pair<const sta::Net*, float>>& ref,
+                  const std::vector<std::pair<const sta::Net*, float>>& other,
+                  double percent)
+{
+  const size_t k = std::max<size_t>(1, std::ceil(ref.size() * percent / 100));
+  std::set<const sta::Net*> top;
+  for (size_t i = 0; i < std::min(k, other.size()); i++) {
+    top.insert(other[i].first);
+  }
+  size_t hit = 0;
+  for (size_t i = 0; i < std::min(k, ref.size()); i++) {
+    hit += top.contains(ref[i].first);
+  }
+  return static_cast<double>(hit) / k;
+}
+
+// Pearson correlation of the two slacks over ref's worst `percent` nets.
+double slackCorrelation(
+    const std::vector<std::pair<const sta::Net*, float>>& ref,
+    const std::vector<std::pair<const sta::Net*, float>>& other,
+    double percent)
+{
+  std::map<const sta::Net*, float> by_net(other.begin(), other.end());
+  const size_t k = std::max<size_t>(1, std::ceil(ref.size() * percent / 100));
+  std::vector<double> a, b;
+  for (size_t i = 0; i < std::min(k, ref.size()); i++) {
+    auto it = by_net.find(ref[i].first);
+    if (it != by_net.end()) {
+      a.push_back(ref[i].second);
+      b.push_back(it->second);
+    }
+  }
+  const size_t n = a.size();
+  if (n < 2) {
+    return 0.0;
+  }
+  double ma = 0, mb = 0;
+  for (size_t i = 0; i < n; i++) {
+    ma += a[i];
+    mb += b[i];
+  }
+  ma /= n;
+  mb /= n;
+  double sab = 0, saa = 0, sbb = 0;
+  for (size_t i = 0; i < n; i++) {
+    sab += (a[i] - ma) * (b[i] - mb);
+    saa += (a[i] - ma) * (a[i] - ma);
+    sbb += (b[i] - mb) * (b[i] - mb);
+  }
+  return (saa > 0 && sbb > 0) ? sab / std::sqrt(saa * sbb) : 0.0;
+}
