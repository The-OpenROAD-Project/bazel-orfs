+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "fastTimer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <utility>
+#include <vector>
+
+#include "db_sta/dbNetwork.hh"
+#include "db_sta/dbSta.hh"
+#include "est/EstimateParasitics.h"
+#include "odb/db.h"
+#include "rsz/Resizer.hh"
+#include "sta/Delay.hh"
+#include "sta/Graph.hh"
+#include "sta/Liberty.hh"
+#include "sta/MinMax.hh"
+#include "sta/Mode.hh"
+#include "sta/Scene.hh"
+#include "sta/Sdc.hh"
+#include "sta/Search.hh"
+#include "sta/TimingArc.hh"
+#include "sta/TimingModel.hh"
+#include "sta/TimingRole.hh"
+#include "sta/Transition.hh"
+#include "utl/Logger.h"
+
+namespace gpl {
+
+using utl::GPL;
+
+namespace {
+
+float finite(float v, float inf)
+{
+  if (std::isnan(v) || v > inf) {
+    return inf;
+  }
+  if (v < -inf) {
+    return -inf;
+  }
+  return v;
+}
+
+// Steiner length from the bounding box: exact up to three pins, then
+// growing slowly with the pin count.
+float steinerFactor(int pins)
+{
+  if (pins <= 3) {
+    return 1.0f;
+  }
+  return 1.0f + 0.25f * std::log2(pins / 3.0f);
+}
+
+}  // namespace
+
+FastTimer::FastTimer(rsz::Resizer* rs, utl::Logger* log) : rs_(rs), log_(log)
+{
+}
+
+void FastTimer::init()
+{
+  sta_ = rs_->sta();
+  sta::dbNetwork* network = sta_->getDbNetwork();
+  sta::Graph* graph = sta_->graph();
+  sta::Scene* scene = sta_->cmdScene();
+  scene_ = scene;
+  const sta::Mode* mode = scene->mode();
+  const sta::MinMax* max = sta::MinMax::max();
+  pvt_ = scene->sdc()->operatingConditions(max);
+  const sta::SceneSeq scenes = sta_->makeSceneSeq(scene);
+  sta_->ensureClkNetwork(scene->mode());
+
+  odb::dbBlock* block = network->block();
+  dbu_to_m_ = 1e-6 / block->getDbUnitsPerMicron();
+  r_per_m_ = rs_->estimateParasitics()->wireSignalResistance(scene);
+  c_per_m_ = rs_->estimateParasitics()->wireSignalCapacitance(scene);
+
+  // Vertices in levelized order, ties by id.
+  std::vector<sta::Vertex*> all;
+  sta::VertexIterator vit(graph);
+  while (vit.hasNext()) {
+    all.push_back(vit.next());
+  }
+  std::ranges::sort(all, [graph](sta::Vertex* a, sta::Vertex* b) {
+    if (a->level() != b->level()) {
+      return a->level() < b->level();
+    }
+    return graph->id(a) < graph->id(b);
+  });
+  vertices_ = std::move(all);
+  vertex_count_ = vertices_.size();
+  std::vector<int> index(graph->vertexCount() + 1, -1);
+  for (int i = 0; i < vertex_count_; i++) {
+    index[graph->id(vertices_[i])] = i;
+  }
+  level_start_.clear();
+  for (int i = 0; i < vertex_count_; i++) {
+    if (i == 0 || vertices_[i]->level() != vertices_[i - 1]->level()) {
+      level_start_.push_back(i);
+    }
+  }
+  level_start_.push_back(vertex_count_);
+
+  const sta::VertexSet& endpoints = sta_->endpoints();
+  frozen_.assign(vertex_count_, 0);
+  is_driver_.assign(vertex_count_, 0);
+  arrival_.assign(vertex_count_, {-kInf, -kInf});
+  slew_.assign(vertex_count_, {0.0f, 0.0f});
+  required_.assign(vertex_count_, {kInf, kInf});
+  frozen_required_.assign(vertex_count_, {kInf, kInf});
+  pin_cap_.assign(vertex_count_, 0.0f);
+  inst_.assign(vertex_count_, nullptr);
+  off_x_.assign(vertex_count_, 0);
+  off_y_.assign(vertex_count_, 0);
+  x_.assign(vertex_count_, 0.0f);
+  y_.assign(vertex_count_, 0.0f);
+  in_start_.assign(1, 0);
+  in_from_.clear();
+  in_is_wire_.clear();
+  in_arc_start_.assign(1, 0);
+  arcs_.clear();
+
+  for (int i = 0; i < vertex_count_; i++) {
+    sta::Vertex* v = vertices_[i];
+    const sta::Pin* pin = v->pin();
+    is_driver_[i] = v->isDriver(network);
+
+    sta::LibertyPort* port = network->libertyPort(pin);
+    if (port) {
+      pin_cap_[i] = port->capacitance(sta::RiseFall::rise(), max);
+    }
+
+    odb::dbITerm* iterm;
+    odb::dbBTerm* bterm;
+    odb::dbModITerm* moditerm;
+    network->staToDb(pin, iterm, bterm, moditerm);
+    int x = 0, y = 0;
+    if (iterm) {
+      odb::dbInst* inst = iterm->getInst();
+      iterm->getAvgXY(&x, &y);
+      const odb::Point loc = inst->getLocation();
+      inst_[i] = inst;
+      off_x_[i] = x - loc.x();
+      off_y_[i] = y - loc.y();
+    } else if (bterm) {
+      bterm->getFirstPinLocation(x, y);
+      off_x_[i] = x;
+      off_y_[i] = y;
+    }
+
+    if (endpoints.contains(v)) {
+      for (const sta::RiseFall* rf : sta::RiseFall::range()) {
+        frozen_required_[i][rf->index()] = finite(
+            sta::delayAsFloat(
+                sta_->required(v, rf->asRiseFallBoth(), scenes, max)),
+            kInf);
+      }
+    }
+
+    const bool clock = sta_->isClock(pin, mode);
+    int edges = 0;
+    if (!clock) {
+      sta::VertexInEdgeIterator eit(v, graph);
+      while (eit.hasNext()) {
+        sta::Edge* edge = eit.next();
+        const sta::TimingRole* role = edge->role();
+        if (role->isTimingCheck() || role == sta::TimingRole::latchDtoQ()
+            || edge->isDisabledLoop()
+            || sta_->isDisabledConstant(edge, scene->mode())) {
+          continue;
+        }
+        const int from = index[graph->id(edge->from(graph))];
+        if (from < 0) {
+          continue;
+        }
+        const bool wire = role->isWire();
+        if (!wire) {
+          const size_t before = arcs_.size();
+          for (sta::TimingArc* arc : edge->timingArcSet()->arcs()) {
+            const sta::RiseFall* from_rf = arc->fromEdge()->asRiseFall();
+            const sta::RiseFall* to_rf = arc->toEdge()->asRiseFall();
+            const sta::GateTimingModel* model = arc->gateModel(scene, max);
+            if (from_rf && to_rf && model) {
+              arcs_.push_back({model,
+                               static_cast<uint8_t>(from_rf->index()),
+                               static_cast<uint8_t>(to_rf->index())});
+            }
+          }
+          if (arcs_.size() == before) {
+            continue;
+          }
+        }
+        in_from_.push_back(from);
+        in_is_wire_.push_back(wire);
+        in_arc_start_.push_back(arcs_.size());
+        edges++;
+      }
+    }
+    in_start_.push_back(in_from_.size());
+    if (clock || edges == 0) {
+      // Clock network and startpoints: OpenSTA's arrival and slew, kept.
+      frozen_[i] = 1;
+      for (const sta::RiseFall* rf : sta::RiseFall::range()) {
+        arrival_[i][rf->index()] = finite(
+            sta::delayAsFloat(
+                sta_->arrival(v, rf->asRiseFallBoth(), scenes, max)),
+            kInf);
+        slew_[i][rf->index()] = finite(
+            sta::delayAsFloat(sta_->slew(v, rf->asRiseFallBoth(), scenes, max)),
+            kInf);
+      }
+    }
+  }
+
+  // Out-edges, for the backward pass.
+  const int edge_count = in_from_.size();
+  out_start_.assign(vertex_count_ + 1, 0);
+  for (int e = 0; e < edge_count; e++) {
+    out_start_[in_from_[e] + 1]++;
+  }
+  for (int i = 0; i < vertex_count_; i++) {
+    out_start_[i + 1] += out_start_[i];
+  }
+  out_edge_.assign(edge_count, 0);
+  out_to_.assign(edge_count, 0);
+  {
+    std::vector<int> fill(out_start_.begin(), out_start_.end() - 1);
+    for (int to = 0; to < vertex_count_; to++) {
+      for (int e = in_start_[to]; e < in_start_[to + 1]; e++) {
+        const int slot = fill[in_from_[e]]++;
+        out_edge_[slot] = e;
+        out_to_[slot] = to;
+      }
+    }
+  }
+
+  // Nets: a driver and the loads its wire edges reach.
+  drvr_net_.assign(vertex_count_, -1);
+  nets_.clear();
+  net_drvr_.clear();
+  net_load_start_.assign(1, 0);
+  net_loads_.clear();
+  for (int i = 0; i < vertex_count_; i++) {
+    if (!is_driver_[i]) {
+      continue;
+    }
+    const sta::Pin* pin = vertices_[i]->pin();
+    odb::dbNet* db_net = network->flatNet(pin);
+    sta::Net* net = db_net ? network->dbToSta(db_net) : nullptr;
+    int loads = 0;
+    for (int o = out_start_[i]; o < out_start_[i + 1]; o++) {
+      if (in_is_wire_[out_edge_[o]]) {
+        net_loads_.push_back(out_to_[o]);
+        loads++;
+      }
+    }
+    if (loads == 0) {
+      continue;
+    }
+    // The nets the ranking reports: as Resizer::findResizeSlacks1 picks them.
+    const bool ranked = net && !sta_->isConstant(pin, sta_->cmdMode())
+                        && !network->isSpecial(net)
+                        && !sta_->isClock(pin, sta_->cmdMode());
+    drvr_net_[i] = nets_.size();
+    nets_.push_back(ranked ? net : nullptr);
+    net_drvr_.push_back(i);
+    net_load_start_.push_back(net_loads_.size());
+  }
+  net_load_cap_.assign(nets_.size(), 0.0f);
+  net_wire_len_.assign(nets_.size(), 0.0f);
+
+  valid_ = true;
+  log_->info(GPL,
+             9910,
+             "Fast timer: {} vertices in {} levels, {} edges, {} arcs, {} nets.",
+             vertex_count_,
+             level_start_.size() - 1,
+             edge_count,
+             arcs_.size(),
+             nets_.size());
+}
+
+void FastTimer::findLocations()
+{
+#pragma omp parallel for schedule(static)
+  for (int i = 0; i < vertex_count_; i++) {
+    int x = off_x_[i];
+    int y = off_y_[i];
+    if (inst_[i]) {
+      const odb::Point loc = inst_[i]->getLocation();
+      x += loc.x();
+      y += loc.y();
+    }
+    x_[i] = x * dbu_to_m_;
+    y_[i] = y * dbu_to_m_;
+  }
+}
+
+void FastTimer::findWireLoads()
+{
+  const int net_count = nets_.size();
+#pragma omp parallel for schedule(static)
+  for (int n = 0; n < net_count; n++) {
+    const int d = net_drvr_[n];
+    float xlo = x_[d], xhi = x_[d], ylo = y_[d], yhi = y_[d];
+    float cap = 0.0f;
+    for (int k = net_load_start_[n]; k < net_load_start_[n + 1]; k++) {
+      const int l = net_loads_[k];
+      xlo = std::min(xlo, x_[l]);
+      xhi = std::max(xhi, x_[l]);
+      ylo = std::min(ylo, y_[l]);
+      yhi = std::max(yhi, y_[l]);
+      cap += pin_cap_[l];
+    }
+    const int pins = net_load_start_[n + 1] - net_load_start_[n] + 1;
+    const float len = (xhi - xlo + yhi - ylo) * steinerFactor(pins);
+    net_wire_len_[n] = len;
+    net_load_cap_[n] = cap + c_per_m_ * len;
+  }
+}
+
+float FastTimer::wireDelay(int drvr, int load, float& slew_degrade) const
+{
+  const float dist = std::abs(x_[drvr] - x_[load]) + std::abs(y_[drvr] - y_[load]);
+  const float elmore
+      = r_per_m_ * dist * (c_per_m_ * dist * 0.5f + pin_cap_[load]);
+  slew_degrade = 2.2f * elmore;
+  return elmore;
+}
+
+void FastTimer::forward()
+{
+  const int levels = level_start_.size() - 1;
+  for (int lv = 0; lv < levels; lv++) {
+#pragma omp parallel for schedule(dynamic, 64)
+    for (int v = level_start_[lv]; v < level_start_[lv + 1]; v++) {
+      if (frozen_[v]) {
+        continue;
+      }
+      std::array<float, kRf> arr = {-kInf, -kInf};
+      std::array<float, kRf> slew = {0.0f, 0.0f};
+      const int net = drvr_net_[v];
+      const float load = net >= 0 ? net_load_cap_[net] : 0.0f;
+      for (int e = in_start_[v]; e < in_start_[v + 1]; e++) {
+        const int u = in_from_[e];
+        if (in_is_wire_[e]) {
+          float degrade;
+          const float d = wireDelay(u, v, degrade);
+          for (int rf = 0; rf < kRf; rf++) {
+            if (arrival_[u][rf] <= -kInf) {
+              continue;
+            }
+            arr[rf] = std::max(arr[rf], arrival_[u][rf] + d);
+            slew[rf] = std::max(
+                slew[rf],
+                std::sqrt(slew_[u][rf] * slew_[u][rf] + degrade * degrade));
+          }
+          continue;
+        }
+        for (int a = in_arc_start_[e]; a < in_arc_start_[e + 1]; a++) {
+          const Arc& arc = arcs_[a];
+          if (arrival_[u][arc.from_rf] <= -kInf) {
+            continue;
+          }
+          float delay, out_slew;
+          arc.model->gateDelay(
+              pvt_, slew_[u][arc.from_rf], load, delay, out_slew);
+          arr[arc.to_rf]
+              = std::max(arr[arc.to_rf], arrival_[u][arc.from_rf] + delay);
+          slew[arc.to_rf] = std::max(slew[arc.to_rf], out_slew);
+        }
+      }
+      arrival_[v] = arr;
+      slew_[v] = slew;
+    }
+  }
+}
+
+void FastTimer::backward()
+{
+  const int levels = level_start_.size() - 1;
+  for (int lv = levels - 1; lv >= 0; lv--) {
+#pragma omp parallel for schedule(dynamic, 64)
+    for (int v = level_start_[lv]; v < level_start_[lv + 1]; v++) {
+      std::array<float, kRf> req = frozen_required_[v];
+      for (int o = out_start_[v]; o < out_start_[v + 1]; o++) {
+        const int e = out_edge_[o];
+        const int w = out_to_[o];
+        if (frozen_[w]) {
+          continue;
+        }
+        if (in_is_wire_[e]) {
+          float degrade;
+          const float d = wireDelay(v, w, degrade);
+          for (int rf = 0; rf < kRf; rf++) {
+            if (required_[w][rf] < kInf) {
+              req[rf] = std::min(req[rf], required_[w][rf] - d);
+            }
+          }
+          continue;
+        }
+        const int net = drvr_net_[w];
+        const float load = net >= 0 ? net_load_cap_[net] : 0.0f;
+        for (int a = in_arc_start_[e]; a < in_arc_start_[e + 1]; a++) {
+          const Arc& arc = arcs_[a];
+          if (required_[w][arc.to_rf] >= kInf) {
+            continue;
+          }
+          float delay, out_slew;
+          arc.model->gateDelay(pvt_, slew_[v][arc.from_rf], load, delay, out_slew);
+          req[arc.from_rf]
+              = std::min(req[arc.from_rf], required_[w][arc.to_rf] - delay);
+        }
+      }
+      required_[v] = req;
+    }
+  }
+}
+
+void FastTimer::update()
+{
+  findLocations();
+  findWireLoads();
+  forward();
+  backward();
+
+  rs_->clearResizeNetSlacks();
+  const int net_count = nets_.size();
+  for (int n = 0; n < net_count; n++) {
+    if (nets_[n] == nullptr) {
+      continue;
+    }
+    const int d = net_drvr_[n];
+    float slack = kInf;
+    for (int rf = 0; rf < kRf; rf++) {
+      if (arrival_[d][rf] > -kInf && required_[d][rf] < kInf) {
+        slack = std::min(slack, required_[d][rf] - arrival_[d][rf]);
+      }
+    }
+    if (slack < kInf) {
+      rs_->setResizeNetSlack(nets_[n], slack);
+    }
+  }
+}
+
+}  // namespace gpl
