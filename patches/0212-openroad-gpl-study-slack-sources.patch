+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <vector>
+
+namespace odb {
+class dbInst;
+class dbBTerm;
+}  // namespace odb
+
+namespace rsz {
+class Resizer;
+}
+
+namespace sta {
+class dbSta;
+class Net;
+class Vertex;
+class GateTimingModel;
+class Scene;
+class Pvt;
+}  // namespace sta
+
+namespace utl {
+class Logger;
+}
+
+namespace gpl {
+
+// A timer for ranking nets during timing-driven global placement, and
+// nothing else. One OpenSTA run (init) gives it the graph, the clock
+// arrivals and the endpoint required times, which it then keeps; each
+// update recomputes cell and wire delays from the placement as it stands
+// and propagates arrivals and required times level by level, in parallel,
+// over flat arrays. Every vertex is written by exactly one thread and
+// reads only lower (or, backwards, higher) levels, so the result does not
+// depend on the thread count.
+class FastTimer
+{
+ public:
+  FastTimer(rsz::Resizer* rs, utl::Logger* log);
+
+  // Builds the arrays. OpenSTA's timing must be valid: arrivals, required
+  // times and slews are read from it once, here.
+  void init();
+  bool valid() const { return valid_; }
+  // The netlist changed (a non-virtual re-weight kept rsz's edits).
+  void invalidate() { valid_ = false; }
+
+  // Recomputes delays from the instances' current locations and writes
+  // each net's driver slack into the resizer's net slack map, as
+  // Resizer::findResizeSlacks1 does.
+  void update();
+
+ private:
+  static constexpr int kRf = 2;
+  static constexpr float kInf = 1e30f;
+
+  struct Arc
+  {
+    const sta::GateTimingModel* model;
+    uint8_t from_rf;
+    uint8_t to_rf;
+  };
+
+  void findLocations();
+  void findWireLoads();
+  void forward();
+  void backward();
+  float wireDelay(int drvr, int load, float& slew_degrade) const;
+
+  rsz::Resizer* rs_;
+  utl::Logger* log_;
+  sta::dbSta* sta_ = nullptr;
+  const sta::Scene* scene_ = nullptr;
+  const sta::Pvt* pvt_ = nullptr;
+  bool valid_ = false;
+
+  // Per vertex, in levelized order.
+  int vertex_count_ = 0;
+  std::vector<int> level_start_;  // vertices of level i: [start[i], start[i+1])
+  std::vector<sta::Vertex*> vertices_;
+  std::vector<uint8_t> frozen_;  // arrival and slew from OpenSTA, kept
+  std::vector<uint8_t> is_driver_;
+  std::vector<std::array<float, kRf>> arrival_;
+  std::vector<std::array<float, kRf>> slew_;
+  std::vector<std::array<float, kRf>> required_;
+  std::vector<std::array<float, kRf>> frozen_required_;
+  std::vector<float> pin_cap_;  // load pin capacitance
+
+  // Pin location: an instance plus an offset, or a fixed point.
+  std::vector<odb::dbInst*> inst_;
+  std::vector<int> off_x_;
+  std::vector<int> off_y_;
+  std::vector<float> x_;  // meters, refreshed by findLocations
+  std::vector<float> y_;
+
+  // In-edges (CSR): source vertex, wire or cell, and for a cell its arcs.
+  std::vector<int> in_start_;
+  std::vector<int> in_from_;
+  std::vector<uint8_t> in_is_wire_;
+  std::vector<int> in_arc_start_;  // per in-edge, into arcs_
+  std::vector<Arc> arcs_;
+
+  // Out-edges (CSR) for the backward pass: index of the in-edge record.
