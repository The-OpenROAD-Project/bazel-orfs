+namespace {
+
+// A deterministic low-discrepancy sweep of the unit square (the R2
+// sequence). Unbiased like the core center, but not degenerate -- which
+// is what separates "the center is special" from "every cell starting
+// on one point is bad for a bound-to-bound net model".
+void r2Point(const int64_t index, double& fx, double& fy)
+{
+  constexpr double kAlpha1 = 0.7548776662466927;
+  constexpr double kAlpha2 = 0.5698402909980532;
+  const double step = static_cast<double>(index + 1);
+  fx = std::fmod(0.5 + kAlpha1 * step, 1.0);
+  fy = std::fmod(0.5 + kAlpha2 * step, 1.0);
+}
+
+int clampToRange(const double value, const int low, const int high)
+{
+  if (value <= static_cast<double>(low)) {
+    return low;
+  }
+  if (value >= static_cast<double>(high)) {
+    return high;
+  }
+  return static_cast<int>(value);
+}
+
+}  // namespace
+
+// Study instrumentation: `global_placement -initial_position_mode <mode>`.
+//
+// The shipped policy above -- every placeable cell on the core center,
+// or wherever the ODB happens to have left it -- arrived with the
+// RePlAce import and has never been measured against any alternative.
+// This gives each candidate distribution a name so an A/B can run
+// without a rebuild between arms. An empty mode is the shipped path and
+// does not reach here.
+//
+// Region membership still wins: a cell in a region draws inside the
+// region's box rather than the core's, because a region is a hard
+// constraint and not part of the question.
+//
+//   center       the box center, as -force_center_initial_place
+//   odb          the ODB location when placed, else the box center
+//   corner_ll    the box's lower-left corner
+//   corner_ur    the box's upper-right corner
+//   uniform      uniform over the box, drawn from -random_seed
+//   gauss_tight  normal at the box center, sigma = 0.10 of the box
+//   gauss_wide   normal at the box center, sigma = 0.25 of the box
+//   spread       the R2 sequence over the box; deterministic
+//   anchored     the centroid of the fixed pins this cell sees through
+//                its own nets, else the box center
+//
+// The report line is the witness the harness reads: an arm whose log
+// does not name its own mode is discarded rather than averaged in.
+void InitialPlace::placeInstsByMode()
+{
+  const std::string& mode = ipVars_.initialPositionMode;
+
+  std::mt19937 rng(static_cast<uint32_t>(ipVars_.perturbationSeed));
+  std::uniform_real_distribution<double> uniform(0.0, 1.0);
+  std::normal_distribution<double> gaussian(0.0, 1.0);
+
+  double sigma_fraction = 0.0;
+  if (mode == "gauss_tight") {
+    sigma_fraction = 0.10;
+  } else if (mode == "gauss_wide") {
+    sigma_fraction = 0.25;
+  } else if (mode != "center" && mode != "odb" && mode != "corner_ll"
+             && mode != "corner_ur" && mode != "uniform" && mode != "spread"
+             && mode != "anchored") {
+    log_->error(utl::GPL,
+                951,
+                "-initial_position_mode {} is not one of center, odb, "
+                "corner_ll, corner_ur, uniform, gauss_tight, gauss_wide, "
+                "spread, anchored.",
+                mode);
+  }
+
+  int count_region = 0;
+  int count_db_location = 0;
+  int count_anchored = 0;
+  int count_placed = 0;
+  int64_t index = 0;
+
+  for (auto& inst : pbc_->placeInsts()) {
+    if (inst->isLocked()) {
+      continue;
+    }
+
+    int box_lx = pbc_->getDie().coreLx();
+    int box_ly = pbc_->getDie().coreLy();
+    int box_ux = pbc_->getDie().coreUx();
+    int box_uy = pbc_->getDie().coreUy();
+
+    const auto db_inst = inst->dbInst();
+    const auto group = db_inst->getGroup();
+    if (group && group->getRegion()) {
+      auto region = group->getRegion();
+      int region_x_min = std::numeric_limits<int>::max();
+      int region_y_min = std::numeric_limits<int>::max();
+      int region_x_max = std::numeric_limits<int>::min();
+      int region_y_max = std::numeric_limits<int>::min();
+
+      for (auto boundary : region->getBoundaries()) {
+        region_x_min = std::min(region_x_min, boundary->xMin());
+        region_y_min = std::min(region_y_min, boundary->yMin());
+        region_x_max = std::max(region_x_max, boundary->xMax());
+        region_y_max = std::max(region_y_max, boundary->yMax());
+      }
+
+      box_lx = region_x_min;
+      box_ly = region_y_min;
+      box_ux = region_x_max;
+      box_uy = region_y_max;
+      ++count_region;
+    }
+
+    const int box_cx = box_ux - (box_ux - box_lx) / 2;
+    const int box_cy = box_uy - (box_uy - box_ly) / 2;
+    const double box_dx = static_cast<double>(box_ux - box_lx);
+    const double box_dy = static_cast<double>(box_uy - box_ly);
+
+    int x = box_cx;
+    int y = box_cy;
+
+    if (mode == "odb") {
+      if (db_inst->isPlaced()) {
+        const auto bbox = db_inst->getBBox()->getBox();
+        x = bbox.xCenter();
+        y = bbox.yCenter();
+        ++count_db_location;
+      }
+    } else if (mode == "corner_ll") {
+      x = box_lx;
+      y = box_ly;
+    } else if (mode == "corner_ur") {
+      x = box_ux;
+      y = box_uy;
+    } else if (mode == "uniform") {
+      x = clampToRange(box_lx + uniform(rng) * box_dx, box_lx, box_ux);
+      y = clampToRange(box_ly + uniform(rng) * box_dy, box_ly, box_uy);
+    } else if (sigma_fraction > 0.0) {
+      x = clampToRange(
+          box_cx + gaussian(rng) * sigma_fraction * box_dx, box_lx, box_ux);
+      y = clampToRange(
+          box_cy + gaussian(rng) * sigma_fraction * box_dy, box_ly, box_uy);
+    } else if (mode == "spread") {
+      double fx = 0.0;
+      double fy = 0.0;
+      r2Point(index, fx, fy);
+      x = clampToRange(box_lx + fx * box_dx, box_lx, box_ux);
+      y = clampToRange(box_ly + fy * box_dy, box_ly, box_uy);
+    } else if (mode == "anchored") {
+      int64_t sum_x = 0;
+      int64_t sum_y = 0;
+      int64_t anchors = 0;
+      for (const Pin* pin : inst->getPins()) {
+        const Net* net = pin->getNet();
+        if (net == nullptr) {
+          continue;
+        }
+        if (static_cast<int>(net->getPins().size()) > ipVars_.maxFanout) {
+          continue;
+        }
+        for (const Pin* other : net->getPins()) {
+          if (other == pin) {
+            continue;
+          }
+          const Instance* other_inst = other->getInstance();
+          if (other_inst != nullptr && !other_inst->isFixed()) {
+            continue;
+          }
+          sum_x += other->cx();
+          sum_y += other->cy();
+          ++anchors;
+        }
+      }
+      if (anchors > 0) {
+        x = clampToRange(
+            static_cast<double>(sum_x) / static_cast<double>(anchors),
+            box_lx,
+            box_ux);
+        y = clampToRange(
+            static_cast<double>(sum_y) / static_cast<double>(anchors),
+            box_ly,
+            box_uy);
+        ++count_anchored;
+      }
+    }
+
+    inst->setCenterLocation(x, y);
+    ++count_placed;
+    ++index;
+  }
+
+  log_->report(
+      "[InitialPlace] initial_position_mode {}: placed {} instances "
+      "(region box {}, odb location {}, anchored {}), seed {}",
+      mode,
+      count_placed,
+      count_region,
+      count_db_location,
+      count_anchored,
+      ipVars_.perturbationSeed);
+}
