diff --git a/src/odb/test/odb_codec_write.tcl b/src/odb/test/odb_codec_write.tcl
new file mode 100644
index 0000000000..638c93f982
--- /dev/null
+++ b/src/odb/test/odb_codec_write.tcl
@@ -0,0 +1,31 @@
+# write_db hands the file it wrote, and where its table slots lie, to
+# ODB_CODEC; without ODB_CODEC it writes the database and nothing else.
+source "helpers.tcl"
+
+proc read_bytes { path } {
+  set f [open $path rb]
+  set bytes [read $f]
+  close $f
+  return $bytes
+}
+
+set ::env(ODB_CODEC) [file normalize "odb_codec_stub.sh"]
+# The stub decodes a file it did not encode to the file itself.
+read_db "data/design.odb"
+
+set encoded [make_result_file "odb_codec_write.odb"]
+write_db $encoded
+set f [open $encoded rb]
+puts "encoded by the codec: [expr { [gets $f] == "odb-codec-stub" }]"
+close $f
+puts "layout left behind: [file exists $encoded.layout]"
+
+unset ::env(ODB_CODEC)
+set plain [make_result_file "odb_codec_write_plain.odb"]
+write_db $plain
+puts "layout written without ODB_CODEC: [file exists $plain.layout]"
+
+# What the codec was handed is what write_db writes without it.
+set decoded [make_result_file "odb_codec_write_decoded.odb"]
+exec [file normalize "odb_codec_stub.sh"] decode $encoded > $decoded
+puts "codec handed what write_db writes: [expr { [read_bytes $plain] eq [read_bytes $decoded] }]"
