+void dbDatabase::write(std::ostream& file, std::ostream& layout)
+{
+  _dbDatabase* db = (_dbDatabase*) this;
+  dbStreamLayout recorder(layout);
+  dbOStream stream(db, file);
+  stream.setLayout(&recorder);
+  stream << *db;
+  stream.flush();
+  file.flush();
+  recorder.finish(stream.tell());
+}
