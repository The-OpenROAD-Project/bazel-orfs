diff --git a/src/ram/test/generate_array_asap7.tcl b/src/ram/test/generate_array_asap7.tcl
new file mode 100644
index 0000000000..90fc554d4f
--- /dev/null
+++ b/src/ram/test/generate_array_asap7.tcl
@@ -0,0 +1,54 @@
+# generate_array: a register-file spec is generate_ram_netlist with the
+# options it states, and the array it builds reads and writes; a part the
+# generator does not have stops, naming it.
+
+source "helpers.tcl"
+source "ram_sim.tcl"
+source "routed.tcl"
+
+routed::read_asap7
+
+proc write_spec { name text } {
+  set file [make_result_file $name]
+  set f [open $file w]
+  puts $f $text
+  close $f
+  return $file
+}
+
+set rf [write_spec rf.spec {
+name regfile
+words 8
+bits 16
+port w0 select=decode op=write mask=8
+port r0 select=decode op=read reduce=mux
+port r1 select=decode op=read
+option -storage_cell DFFHQNx1_ASAP7_75t_R
+}]
+set args [ram::array_netlist_args [ram::read_array_spec $rf]]
+set want [list -word_size 16 -num_words 8 -r_ports 2 -w_ports 1 -mask_size 8 \
+  -name regfile -storage_cell DFFHQNx1_ASAP7_75t_R]
+ram_sim::check { $args eq $want } "the spec's options are $args"
+
+generate_array -spec $rf -tapcell TAPCELL_ASAP7_75t_R -max_tap_dist 25
+ram_sim::check { [[ord::get_db_block] getName] eq "regfile" } \
+  "the block is [[ord::get_db_block] getName]"
+ram_sim::load
+ram_sim::exercise {
+  words 8 bits 16
+  writes {{addr_w D {we[0] we[1]}}}
+  reads {{addr_r0 Q0} {addr_r1 Q1}}
+}
+
+# each names the part it lacks in the message (the log), by its id here
+foreach {text id} {
+  "port w0 select=range op=clear" RAM-0124
+  "port w0 select=decode op=dec" RAM-0127
+  "port r0 select=decode op=read reduce=find_first" RAM-0126
+} {
+  set spec [write_spec part.spec "words 8\nbits 8\n$text"]
+  set rc [catch { ram::array_netlist_args [ram::read_array_spec $spec] } msg]
+  ram_sim::check { $rc && $msg eq $id } "'$text' stopped with $msg, not $id"
+}
+
+puts "pass"
