diff --git a/flow/designs/asap7/tinyRocket-regfile/config.mk b/flow/designs/asap7/tinyRocket-regfile/config.mk
new file mode 100644
index 000000000..b708d2218
--- /dev/null
+++ b/flow/designs/asap7/tinyRocket-regfile/config.mk
@@ -0,0 +1,10 @@
+# tinyRocket with its integer register file generated: the Rocket core
+# keeps the array inline (RocketCore's _T_288, 31 x 32, two combinational
+# reads, one write), with no module of its own. The spec's `memory` key
+# names it, and synthesis makes the seam (memlib + techmap) and reads the
+# generated netlist in its place; the RTL is unchanged.
+export DESIGN_NICKNAME = tinyRocket-regfile
+
+include designs/asap7/tinyRocket/config.mk
+
+export AUTO_MEMORIES_REGFILES = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/rocket_rf.regfile
diff --git a/flow/designs/asap7/tinyRocket-regfile/rocket_rf.regfile b/flow/designs/asap7/tinyRocket-regfile/rocket_rf.regfile
new file mode 100644
index 000000000..f7fdbbf6c
--- /dev/null
+++ b/flow/designs/asap7/tinyRocket-regfile/rocket_rf.regfile
@@ -0,0 +1,20 @@
+# Rocket's integer register file (RocketCore.scala's rf, _T_288 in the
+# generated Verilog) as standard cells, inlined in its place: 32 x 32
+# (Rocket uses 31), two combinational reads, one write through a clock
+# gate per word. Rocket handles x0 itself. The ports are this spec's: the
+# seam synthesis makes connects them.
+module rocket_rf
+memory Rocket._T_288
+words 32
+bits 32
+clock clk
+read raddr0 rdata0
+read raddr1 rdata1
+write waddr wdata wen
+write_style clock_gate
+cell icg ICGx1_ASAP7_75t_R
+cell flop DFFHQNx1_ASAP7_75t_R
+cell and2 AND2x2_ASAP7_75t_R
+cell or2 OR2x2_ASAP7_75t_R
+cell ao22 AO22x2_ASAP7_75t_R
+cell inv INVx1_ASAP7_75t_R
