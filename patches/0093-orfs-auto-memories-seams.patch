@@ -120,12 +124,15 @@ def _file_defining(module: str, verilog: list[Path]) -> Path:
 
 
 def _inline_spec(spec: Path, out: Path) -> Path:
-    """`spec` without its tap cell: an inlined register file's cells
-    land on the parent's rows, whose taps the floorplan places."""
+    """`spec` without its tap cell, an inlined register file's cells
+    landing on the parent's rows, whose taps the floorplan places, and
+    without the `memory` key, which is the flow's and not the
+    generator's."""
     kept = [
         line
         for line in spec.read_text().splitlines()
