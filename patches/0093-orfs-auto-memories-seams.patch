     return out
@@ -144,6 +151,69 @@ def _regfile_memory(spec: Path, module: str, reason: str) -> schema.Memory:
     return mem
 
 
+def _seam_views(spec: Path, module: str, out_dir: Path) -> None:
+    """The memlib entry and techmap wrapper that turn the inferred memory a
+    spec's `memory` key names into an instance of `module`: one clocked
+    write port per `write` (a shared clock, an enable each), one
+    combinational read port per `read`. memory_libmap maps only the
+    memory the flow marks with ram_style <module>."""
+    where = f"gen_memories: {spec}"
+    words = int(_spec_value(spec, "words")[0][0])
+    bits = int(_spec_value(spec, "bits")[0][0])
+    clock = _spec_value(spec, "clock")[0][0]
+    reads = _spec_value(spec, "read")
+    writes = _spec_value(spec, "write")
+    if _spec_value(spec, "read_banked") or any(
+        int(v[0]) != 0 for v in _spec_value(spec, "read_latency")
+    ):
+        raise SystemExit(f"{where}: `memory` needs plain combinational reads")
+    if not reads or not writes or any(len(w) != 3 for w in writes):
+        raise SystemExit(f"{where}: `memory` needs reads and writes with an enable")
+    abits = max(1, (words - 1).bit_length())
+    cell = f"$__{module}_SEAM_"
+    reads_names = " ".join(f'"R{i}"' for i in range(len(reads)))
+    writes_names = " ".join(f'"W{i}"' for i in range(len(writes)))
+    (out_dir / f"{module}.memlib").write_text(
+        f"# {module} behind a seam: {words} x {bits}, {len(reads)} "
+        f"combinational reads, {len(writes)} clocked writes.\n"
+        f"ram distributed {cell} {{\n"
+        f"\tabits {abits};\n\twidth {bits};\n\tcost 1;\n"
+        f'\tstyle "{module}";\n'
+        f'\tport sw {writes_names} {{\n\t\tclock posedge "C";\n\t}}\n'
+        f"\tport ar {reads_names} {{\n\t}}\n"
+        "}\n"
+    )
+    ports = ["\tinput CLK_C"]
+    params = ["\tparameter INIT = 0;", "\tparameter CLK_C_POL = 1;"]
+    conns = [f"\t\t.{clock}(CLK_C)"]
+    for i, (addr, data, en) in enumerate(writes):
+        ports += [
+            f"\tinput PORT_W{i}_CLK",
+            f"\tinput [{abits - 1}:0] PORT_W{i}_ADDR",
+            f"\tinput [{bits - 1}:0] PORT_W{i}_WR_DATA",
+            f"\tinput PORT_W{i}_WR_EN",
+        ]
+        params.append(f"\tparameter PORT_W{i}_CLK_POL = 1;")
+        conns += [
+            f"\t\t.{addr}(PORT_W{i}_ADDR)",
+            f"\t\t.{data}(PORT_W{i}_WR_DATA)",
+            f"\t\t.{en}(PORT_W{i}_WR_EN)",
+        ]
+    for i, (addr, data) in enumerate(reads):
+        ports += [
+            f"\tinput [{abits - 1}:0] PORT_R{i}_ADDR",
+            f"\toutput [{bits - 1}:0] PORT_R{i}_RD_DATA",
+        ]
+        conns += [f"\t\t.{addr}(PORT_R{i}_ADDR)", f"\t\t.{data}(PORT_R{i}_RD_DATA)"]
+    (out_dir / f"{module}_map.v").write_text(
+        f"// The memory_libmap cell for {module}, as an instance of it.\n"
+        f"module {cell} (\n" + ",\n".join(ports) + "\n);\n"
+        + "\n".join(params) + "\n"
+        + f"\t{module} _TECHMAP_REPLACE_ (\n" + ",\n".join(conns) + "\n\t);\n"
+        + "endmodule\n"
+    )
+
+
 def run_regfiles(
     specs: list[Path],
     openroad: str | None,
@@ -175,6 +245,7 @@ def run_regfiles(
     if not specs:
         (out_dir / "regfiles.txt").write_text("")
         (out_dir / "inline.txt").write_text("")
+        (out_dir / "seams.txt").write_text("")
         if macro_place:
             raise SystemExit(
                 "gen_memories: AUTO_MEMORIES_MACRO_PLACE names "
@@ -200,24 +271,43 @@ def run_regfiles(
     memories = []
     dissolve = []
     inline = []
+    seams = []
     for spec, module in zip(specs, modules):
         mode = _spec_mode(spec)
-        rtl = _file_defining(module, verilog)
         tcl = out_dir / f"{module}.generate.tcl"
+        # `memory <module>.<cell>`: the register file replaces a memory
+        # yosys infers inside a module, through a seam synthesis makes
+        # (memlib + techmap); its module and ports are the spec's own,
+        # so there is no RTL module to check them against.
+        seam = _spec_value(spec, "memory")
+        if seam:
+            if module in macro_place or len(seam) != 1 or len(seam[0]) != 1 or "." not in seam[0][0]:
+                raise SystemExit(
+                    f"gen_memories: {spec}: `memory <module>.<cell>` once, and inlined"
+                )
+            owner, cell = seam[0][0].split(".", 1)
+            _seam_views(spec, module, out_dir)
+            seams.append(f"{owner} {cell} {module}")
+            check = ""
+        else:
+            check = f" -check_ports {_file_defining(module, verilog)}"
         if module not in macro_place:
             tcl.write_text(
                 "".join(f"read_lef {lef}\n" for lef in lefs)
                 + f"generate_regfile -spec {_inline_spec(spec, out_dir / f'{module}.inline.regfile')}"
-                + f" -check_ports {rtl} -verilog {out_dir / f'{module}.v'}\n"
+                + f"{check} -verilog {out_dir / f'{module}.v'}\n"
             )
             subprocess.check_call([openroad, "-exit", "-no_init", "-no_splash", str(tcl)])
-            memories.append(_regfile_memory(spec, module, "register file, inlined"))
+            reason = "register file, inlined"
+            if seam:
+                reason += f", in place of {seam[0][0]} through a seam"
+            memories.append(_regfile_memory(spec, module, reason))
             inline.append(module)
             sys.stderr.write(f"gen_memories: {module} -> register file, inlined ({spec.name})\n")
             continue
         tcl.write_text(
             "".join(f"read_lef {lef}\n" for lef in lefs)
-            + f"generate_regfile -spec {spec} -check_ports {rtl}"
+            + f"generate_regfile -spec {spec}{check}"
             + f" -verilog {out_dir / f'{module}.v'} -def {out_dir / f'{module}.def'}"
             + f" -lef {out_dir / f'{module}.lef'} -liberty {out_dir / f'{module}.lib'}\n"
         )
@@ -232,6 +322,7 @@ def run_regfiles(
         f.write("".join(f"{m.name}\n" for m in memories if m.name not in inline))
     (out_dir / "regfiles.txt").write_text("".join(f"{m}\n" for m in dissolve))
     (out_dir / "inline.txt").write_text("".join(f"{m}\n" for m in inline))
+    (out_dir / "seams.txt").write_text("".join(f"{s}\n" for s in seams))
     return memories
 
 
@@ -291,7 +382,15 @@ def run(
     )
     if regfiles:
         listed = {m.name for m in regfiles}
-        memories = [m for m in memories if m.name not in listed] + regfiles
+        # a memory a register file replaces through a seam is that file now
+        seamed = {
+            line.split()[0] + "." + line.split()[1]
+            for line in (out_dir / "seams.txt").read_text().splitlines()
+            if line.strip()
+        }
+        memories = [
+            m for m in memories if m.name not in listed and m.name not in seamed
+        ] + regfiles
         schema.dump(memories, json_path, platform)
 
     for mem in sorted(memories, key=lambda m: m.name):
diff --git a/flow/scripts/synth_preamble.tcl b/flow/scripts/synth_preamble.tcl
index ed343d055..9f10d3b64 100644
--- a/flow/scripts/synth_preamble.tcl
+++ b/flow/scripts/synth_preamble.tcl
@@ -79,6 +79,75 @@ proc auto_memories_inline { } {
   return [regexp -all -inline {\S+} $content]
 }
 
+# AUTO_MEMORIES: inferred memories a register file replaces through a
+# seam, one "<module> <cell> <register file>" per line (seams.txt).
+proc auto_memories_seams { } {
+  if { ![env_var_equals AUTO_MEMORIES 1] } {
+    return {}
+  }
+  set f "$::env(RESULTS_DIR)/memories/seams.txt"
+  if { ![file exists $f] } {
+    return {}
+  }
+  set fh [open $f r]
+  set lines [split [string trim [read $fh]] "\n"]
+  close $fh
+  return [lsearch -all -inline -not $lines {}]
+}
+
+# Make each seam: the memory a spec's `memory` key names becomes an
+# instance of its register file (memory_libmap with the generated memlib
+# entry, then techmap with its wrapper), before hierarchy prunes the
+# register file's module as unused. A memory is found by its cell name and
+# its module's definition (slang names an elaborated module
+# <definition>$<path>), and marked by attribute, which selects without
+# spelling a `$` name. opt -full, scoped to the modules holding one, makes
+# Chisel's per-bit write enables one signal, or memory_libmap splits the
+# memory into one-bit slices. A listed memory that does not map once stops
+# the build.
+proc make_auto_memories_seams { } {
+  set seams [auto_memories_seams]
+  if { [llength $seams] == 0 } {
+    return
+  }
+  yosys proc
+  memory_collect
+  set found [dict create]
+  foreach line [tee -q -s result.string select -list t:\$mem_v2] {
+    set line [string trim $line]
+    set i [string first "/" $line]
+    if { $i < 0 } {
+      continue
+    }
+    set mod [string range $line 0 [expr { $i - 1 }]]
+    set cell [string range $line [expr { $i + 1 }] end]
+    set def [lindex [split $mod "\$"] 0]
+    foreach seam $seams {
+      lassign $seam owner name regfile
+      if { $def eq $owner && $cell eq $name } {
+        rtlil::set_attr -mod -true $mod auto_memories_seam
+        rtlil::set_attr -string $mod $cell ram_style $regfile
+        dict incr found $regfile
+      }
+    }
+  }
+  opt -full A:auto_memories_seam
+  foreach seam $seams {
+    lassign $seam owner name regfile
+    set n [expr { [dict exists $found $regfile] ? [dict get $found $regfile] : 0 }]
+    if { $n != 1 } {
+      error "AUTO_MEMORIES seam: $owner.$name found $n times, not once;\
+        `memory` in $regfile's spec names a memory yosys infers"
+    }
