diff --git a/flow/scripts/synth_preamble.tcl b/flow/scripts/synth_preamble.tcl
index cfacc639dd..e650c1cde2 100644
--- a/flow/scripts/synth_preamble.tcl
+++ b/flow/scripts/synth_preamble.tcl
