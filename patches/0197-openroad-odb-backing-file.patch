+void dbBlock::pageOut(const dbObjectType type)
+{
+  // The block's own tables, named here: getObjectTable passes types it does
+  // not list (the hierarchy's nets and terminals among them) to its owner.
+  _dbBlock* block = (_dbBlock*) this;
+  dbObjectTable* table = nullptr;
+  switch (type) {
+    case dbInstObj:
+      table = block->inst_tbl_;
+      break;
+    case dbNetObj:
+      table = block->net_tbl_;
+      break;
+    case dbITermObj:
+      table = block->iterm_tbl_;
+      break;
+    case dbBTermObj:
+      table = block->bterm_tbl_;
+      break;
+    case dbBPinObj:
+      table = block->bpin_tbl_;
+      break;
+    case dbGuideObj:
+      table = block->guide_tbl_;
+      break;
+    case dbWireObj:
+      table = block->wire_tbl_;
+      break;
+    case dbSWireObj:
+      table = block->swire_tbl_;
+      break;
+    case dbSBoxObj:
+      table = block->sbox_tbl_;
+      break;
+    case dbObstructionObj:
+      table = block->obstruction_tbl_;
+      break;
+    case dbBlockageObj:
+      table = block->blockage_tbl_;
+      break;
+    case dbRowObj:
+      table = block->row_tbl_;
+      break;
+    case dbGCellGridObj:
+      table = block->gcell_grid_tbl_;
+      break;
+    case dbModuleObj:
+      table = block->module_tbl_;
+      break;
+    case dbModInstObj:
+      table = block->modinst_tbl_;
+      break;
+    case dbModNetObj:
+      table = block->modnet_tbl_;
+      break;
+    case dbModITermObj:
+      table = block->moditerm_tbl_;
+      break;
+    case dbModBTermObj:
+      table = block->modbterm_tbl_;
+      break;
+    default:
+      return;
+  }
+  dbBackingPageOut(block->getDatabase(), table);
+}
