+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include <gtest/gtest.h>
+
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <sstream>
+#include <string>
+
+#include "odb/db.h"
+#include "odb/dbObject.h"
+#include "tst/db_fixture.h"
+
+namespace odb {
+namespace {
+
+using DbPtr = std::unique_ptr<dbDatabase, void (*)(dbDatabase*)>;
+
+/// A database read with a backing file (read_db -backing_file) holds the
+/// same design as one read into memory alone, whether or not its pages
+/// were paged out to the file.
+class DbBackingTest : public tst::DbFixture
+{
+ protected:
+  DbPtr read(const std::string& backing_file)
+  {
+    DbPtr db(dbDatabase::create(), dbDatabase::destroy);
+    db->setLogger(getLogger());
+    if (!backing_file.empty()) {
+      db->setBackingFile(backing_file);
+    }
+    std::ifstream in(getFilePath("_main/src/odb/test/data/design.odb"),
+                     std::ios::binary);
+    db->read(in);
+    return db;
+  }
+
+  static std::string write(dbDatabase* db)
+  {
+    std::stringstream out;
+    db->write(out);
+    return out.str();
+  }
+
+  static std::string backingPath(const char* name)
+  {
+    return (std::filesystem::path(testing::TempDir()) / name).string();
+  }
+};
+
+TEST_F(DbBackingTest, PagedOutDatabaseWritesTheSame)
+{
+  const DbPtr plain = read("");
+  const std::string expected = write(plain.get());
+
+  const std::string path = backingPath("paged_out.db");
+  const DbPtr backed = read(path);
+  // the file is unlinked once open: nothing left behind
+  EXPECT_FALSE(std::filesystem::exists(path));
+
+  backed->pageOut();
+  ASSERT_NE(backed->getChip(), nullptr);
+  dbBlock* block = backed->getChip()->getBlock();
+  ASSERT_NE(block, nullptr);
+  EXPECT_EQ(block->getNets().size(),
+            plain->getChip()->getBlock()->getNets().size());
+  EXPECT_EQ(block->getInsts().size(),
+            plain->getChip()->getBlock()->getInsts().size());
+
+  EXPECT_EQ(write(backed.get()), expected);
+  // write_db pages each table out once written; a second write reads them
+  // back again
+  EXPECT_EQ(write(backed.get()), expected);
+}
+
+TEST_F(DbBackingTest, OneTablePagedOutWritesTheSame)
+{
+  const DbPtr plain = read("");
+  const DbPtr backed = read(backingPath("one_table.db"));
+  backed->getChip()->getBlock()->pageOut(dbNetObj);
+  EXPECT_EQ(write(backed.get()), write(plain.get()));
+}
+
+TEST_F(DbBackingTest, PageOutWithoutBackingFileDoesNothing)
+{
+  const DbPtr plain = read("");
+  const std::string expected = write(plain.get());
+  plain->pageOut();
+  plain->getChip()->getBlock()->pageOut(dbInstObj);
+  EXPECT_EQ(write(plain.get()), expected);
+}
+
+}  // namespace
+}  // namespace odb
