+void dbDatabase::setBackingFile(const std::string& path)
+{
+  _dbDatabase* db = (_dbDatabase*) this;
+  if (!getChips().empty() || !getTechs().empty() || !getLibs().empty()) {
+    db->getLogger()->error(utl::ODB,
+                           1227,
+                           "A backing file must be set before anything is "
+                           "read into the database.");
+  }
+  delete db->backing_;
+  db->backing_ = new dbBacking(db->getLogger(), path);
+}
+
+void dbDatabase::pageOut()
+{
+  _dbDatabase* db = (_dbDatabase*) this;
+  if (db->backing_) {
+    db->backing_->pageOutAll();
+  }
+}
