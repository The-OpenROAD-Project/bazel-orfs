diff --git a/src/odb/src/db/dbBacking.cpp b/src/odb/src/db/dbBacking.cpp
new file mode 100644
index 0000000000..0ba9d0bc8b
--- /dev/null
+++ b/src/odb/src/db/dbBacking.cpp
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "dbBacking.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstddef>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "dbDatabase.h"
+#include "utl/Logger.h"
+
+// Linux 5.4; older system headers lack it, older kernels refuse it.
+#ifndef MADV_PAGEOUT
+#define MADV_PAGEOUT 21
+#endif
+
+namespace odb {
+
+namespace {
+constexpr size_t kChunkSize = size_t{64} << 20;
+
+size_t pageRound(size_t size)
+{
+  const size_t page = sysconf(_SC_PAGESIZE);
+  return (size + page - 1) & ~(page - 1);
+}
+}  // namespace
+
+dbBacking::dbBacking(utl::Logger* logger, const std::string& path)
+    : logger_(logger), path_(path)
+{
+  fd_ = open(path.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+  if (fd_ < 0) {
+    logger_->error(utl::ODB,
+                   1222,
+                   "Cannot create the backing file {}: {}.",
+                   path,
+                   strerror(errno));
+  }
+  unlink(path.c_str());
+}
+
+dbBacking::~dbBacking()
+{
+  for (auto& [table, chunks] : tables_) {
+    for (const Chunk& chunk : chunks) {
+      munmap(chunk.base, chunk.size);
+    }
+  }
+  if (fd_ >= 0) {
+    close(fd_);
+  }
+}
+
+void* dbBacking::alloc(const void* table, const size_t size)
+{
+  std::vector<Chunk>& chunks = tables_[table];
+  if (chunks.empty() || chunks.back().size - chunks.back().used < size) {
+    const size_t chunk_size = pageRound(std::max(kChunkSize, size));
+    const int err
+        = posix_fallocate(fd_, static_cast<off_t>(file_size_), chunk_size);
+    if (err != 0) {
+      logger_->error(utl::ODB,
+                     1223,
+                     "Cannot reserve {:.1f} MB more for the database in {}: "
+                     "{}.",
+                     chunk_size / 1e6,
+                     path_,
+                     strerror(err));
+    }
+    void* base = mmap(nullptr,
+                      chunk_size,
+                      PROT_READ | PROT_WRITE,
+                      MAP_PRIVATE | MAP_ANONYMOUS,
+                      -1,
+                      0);
+    if (base == MAP_FAILED) {
+      logger_->error(utl::ODB,
+                     1224,
+                     "Cannot allocate {:.1f} MB for the database: {}.",
+                     chunk_size / 1e6,
+                     strerror(errno));
+    }
+    chunks.push_back(
+        {static_cast<char*>(base), chunk_size, 0, file_size_, false});
+    file_size_ += chunk_size;
+  }
+  Chunk& chunk = chunks.back();
+  // keep the pages aligned as malloc would
+  const size_t aligned = (size + 15) & ~size_t{15};
+  void* page = chunk.base + chunk.used;
+  chunk.used += aligned;
+  return page;
+}
+
+bool dbBacking::owns(const void* table) const
+{
+  return tables_.contains(table);
+}
+
+void dbBacking::release(const void* table)
+{
+  auto it = tables_.find(table);
+  if (it == tables_.end()) {
+    return;
+  }
+  for (const Chunk& chunk : it->second) {
+    munmap(chunk.base, chunk.size);
+  }
+  // Their room in the file stays reserved: the file only grows.
+  tables_.erase(it);
+}
+
+void dbBacking::moveToFile(Chunk& chunk)
+{
+  const size_t len = pageRound(chunk.used);
+  size_t done = 0;
+  while (done < len) {
+    const ssize_t n
+        = pwrite(fd_, chunk.base + done, len - done, chunk.offset + done);
+    if (n <= 0) {
+      logger_->error(utl::ODB,
+                     1225,
+                     "Cannot write the backing file {}: {}.",
+                     path_,
+                     strerror(errno));
+    }
+    done += n;
+  }
+  if (mmap(chunk.base,
+           chunk.size,
+           PROT_READ | PROT_WRITE,
+           MAP_SHARED | MAP_FIXED,
+           fd_,
+           static_cast<off_t>(chunk.offset))
+      == MAP_FAILED) {
+    logger_->error(utl::ODB,
+                   1226,
+                   "Cannot map the backing file {}: {}.",
+                   path_,
+                   strerror(errno));
+  }
+  chunk.in_file = true;
+}
+
+void dbBacking::pageOut(std::vector<Chunk>& chunks)
+{
+  for (Chunk& chunk : chunks) {
+    if (chunk.used == 0) {
+      continue;
+    }
+    if (!chunk.in_file) {
+      moveToFile(chunk);
+    }
+    msync(chunk.base, chunk.size, MS_SYNC);
+    madvise(chunk.base, chunk.size, MADV_PAGEOUT);
+  }
+}
+
+void dbBacking::pageOut(const void* table)
+{
+  auto it = tables_.find(table);
+  if (it != tables_.end()) {
+    pageOut(it->second);
+  }
+}
+
+void dbBacking::pageOutAll()
+{
+  for (auto& [table, chunks] : tables_) {
+    pageOut(chunks);
+  }
+}
+
+void* dbBackingAlloc(_dbDatabase* db, const void* table, const size_t size)
+{
+  return db && db->backing_ ? db->backing_->alloc(table, size) : nullptr;
+}
+
+bool dbBackingOwns(_dbDatabase* db, const void* table)
+{
+  return db && db->backing_ && db->backing_->owns(table);
+}
+
+void dbBackingRelease(_dbDatabase* db, const void* table)
+{
+  if (db && db->backing_) {
+    db->backing_->release(table);
+  }
+}
+
+void dbBackingPageOut(_dbDatabase* db, const void* table)
+{
+  if (db && db->backing_) {
+    db->backing_->pageOut(table);
+  }
+}
+
+}  // namespace odb
diff --git a/src/odb/src/db/dbBacking.h b/src/odb/src/db/dbBacking.h
new file mode 100644
index 0000000000..e18b51dfce
--- /dev/null
+++ b/src/odb/src/db/dbBacking.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#pragma once
+
+#include <cstddef>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace utl {
+class Logger;
+}
+
+namespace odb {
+
+class _dbDatabase;
+
+// The pages of a database's tables, in a file (read_db -backing_file).
+// Each table gets its pages from chunks of its own, so a table pages out in
+// a few calls. A chunk is ordinary memory until its first page-out, when it
+// is copied to its room in the file and mapped there; the room is reserved
+// (posix_fallocate) when the chunk is made, so a disk that cannot hold the
+// database fails then, not when a page is written back. The file is
+// unlinked once open and leaves nothing behind.
+class dbBacking
+{
+ public:
+  dbBacking(utl::Logger* logger, const std::string& path);
+  ~dbBacking();
+  dbBacking(const dbBacking&) = delete;
+  dbBacking& operator=(const dbBacking&) = delete;
+
+  void* alloc(const void* table, size_t size);
+  bool owns(const void* table) const;
+  // Frees a table's chunks: its pages are gone (dbTable::clear).
+  void release(const void* table);
+  // Writes a table's pages to the file and frees them; they are read back
+  // as they are touched.
+  void pageOut(const void* table);
+  void pageOutAll();
+
+ private:
+  struct Chunk
+  {
+    char* base;
+    size_t size;
+    size_t used;
+    size_t offset;  // its room in the file
+    bool in_file;
+  };
+
+  void moveToFile(Chunk& chunk);
+  void pageOut(std::vector<Chunk>& chunks);
+
+  utl::Logger* logger_;
+  std::string path_;
+  int fd_ = -1;
+  size_t file_size_ = 0;
+  std::map<const void*, std::vector<Chunk>> tables_;
+};
+
+// For dbTable, which sees _dbDatabase only through its pointer: each is a
+// no-op, or nullptr / false, without a backing or a database (the table of
+// databases has none).
+void* dbBackingAlloc(_dbDatabase* db, const void* table, size_t size);
+bool dbBackingOwns(_dbDatabase* db, const void* table);
+void dbBackingRelease(_dbDatabase* db, const void* table);
+void dbBackingPageOut(_dbDatabase* db, const void* table);
+
+}  // namespace odb
