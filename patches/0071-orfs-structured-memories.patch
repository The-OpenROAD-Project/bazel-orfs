 import sys
 from pathlib import Path
 
@@ -44,6 +46,75 @@
     return None
 
 
+def _spec_module(spec: Path) -> str:
+    """The `module <name>` line of a register-file spec."""
+    for line in spec.read_text().splitlines():
+        parts = line.split("#", 1)[0].split()
+        if len(parts) == 2 and parts[0] == "module":
+            return parts[1]
+    raise SystemExit(f"gen_memories: {spec}: no `module` line")
+
+
+def _file_defining(module: str, verilog: list[Path]) -> Path:
+    """The Verilog file that declares `module`, for the port check."""
+    pat = re.compile(rf"^\s*module\s+{re.escape(module)}\b", re.M)
+    for path in verilog:
+        if pat.search(path.read_text(errors="replace")):
+            return path
+    raise SystemExit(
+        f"gen_memories: STRUCTURED_MEMORIES names module {module}, "
+        f"which none of the Verilog files declare"
+    )
+
+
+def run_structured(
+    specs: list[Path],
+    generator: str | None,
+    lefs: list[Path],
+    verilog: list[Path],
+    out_dir: Path,
+) -> list[str]:
+    """Generate a placed macro for every listed register file.
+
+    Explicit by design: a module is replaced only because a spec names
+    it, and a spec that does not match the module's ports stops the
+    build here rather than miswire the parent. Views land beside the
+    AUTO_MEMORIES ones and the module joins blackboxes.txt, so synthesis
+    and every later stage treat it as one more memory macro.
+    """
+    if not specs:
+        return []
+    if not generator:
+        raise SystemExit(
+            "gen_memories: STRUCTURED_MEMORIES is set but STRUCTURED_GEN is not; "
+            "the build system that carries the generator has to name it"
+        )
+    if not lefs:
+        raise SystemExit("gen_memories: STRUCTURED_MEMORIES needs TECH_LEF and SC_LEF")
+    modules = []
+    report = []
+    for spec in specs:
+        module = _spec_module(spec)
+        rtl = _file_defining(module, verilog)
+        cmd = [generator, "--spec", str(spec), "--check-ports", str(rtl)]
+        for lef in lefs:
+            cmd += ["--lef", str(lef)]
+        cmd += [
+            "--lef-out", str(out_dir / f"{module}.lef"),
+            "--lib-out", str(out_dir / f"{module}.lib"),
+            "--def", str(out_dir / f"{module}.def"),
+            "--verilog", str(out_dir / f"{module}.v"),
+        ]
+        subprocess.check_call(cmd)
+        modules.append(module)
+        report.append({"module": module, "spec": str(spec)})
+        sys.stderr.write(f"gen_memories: {module} -> structured macro ({spec.name})\n")
+    with (out_dir / "blackboxes.txt").open("a") as f:
+        f.write("".join(f"{m}\n" for m in modules))
+    (out_dir / "structured.json").write_text(json.dumps(report, indent=2) + "\n")
+    return modules
+
+
