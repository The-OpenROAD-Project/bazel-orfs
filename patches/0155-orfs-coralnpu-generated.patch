 export SDC_FILE                = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/constraint.sdc
 
@@ -21,8 +28,14 @@ export SYNTH_HDL_FRONTEND     ?= slang
 
 export CORE_UTILIZATION        = 65
 
+# coralnpu's units, kept by name: the core, its fetch, dispatch,
