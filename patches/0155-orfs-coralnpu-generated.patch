+            done += 1
+        with open(
+            os.path.join(a.out_dir, os.path.basename(path)), "w", encoding="utf-8"
+        ) as f:
+            f.write(text)
+    if done != 1:
+        fail("the register files found in %d files, not one" % done)
+
+
+if __name__ == "__main__":
+    main()
