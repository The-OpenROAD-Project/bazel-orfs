+// The nets a feedthrough joins carry routes already, an earlier dissolve's:
+// the net that is left has the guides of both, as they were, and the
+// feedthrough's own between them.
+TEST_F(DissolveTest, FeedthroughKeepsTheGuidesOfTheNetsItJoins)
+{
+  dbNet* ft = makeFeedthrough("ft", "fi", "fo");
+  dbTechLayer* src_layer = source_db_->getTech()->findLayer("L1");
+  dbGuide::create(ft, src_layer, src_layer, Rect(100, 200, 600, 700), false);
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R0);
+  auto [nin, nout] = makeNets(block_, "nin", "nout");
+  makeInv("drv", "op0", nin);
+  dbITerm* load = makeInv("load", "ip0", nout);
+  m->findITerm("fi")->connect(nin);
+  m->findITerm("fo")->connect(nout);
+  dbTechLayer* layer = db_->getTech()->findLayer("L1");
+  const Rect before(0, 0, 500, 500);
+  const Rect after(90000, 0, 90500, 500);
+  dbGuide::create(nin, layer, layer, before, false);
+  dbGuide::create(nout, layer, layer, after, true);
+
+  dbInst::dissolve(m, source_);
+
+  dbNet* net = load->getNet();
+  ASSERT_NE(net, nullptr);
+  std::vector<Rect> boxes;
+  int congested = 0;
+  for (dbGuide* guide : net->getGuides()) {
+    EXPECT_EQ(guide->getLayer(), layer);
+    EXPECT_EQ(guide->getViaLayer(), layer);
+    boxes.push_back(guide->getBox());
+    if (guide->isCongested()) {
+      ++congested;
+      EXPECT_EQ(guide->getBox(), after);
+    }
+  }
+  EXPECT_EQ(boxes.size(), 3u);
+  EXPECT_EQ(congested, 1);
+  // The macro is at (10000, 20000), its block's die corner at (100, 200).
+  for (const Rect& box : {before, after, Rect(10000, 20000, 10500, 20500)}) {
+    EXPECT_EQ(std::ranges::count(boxes, box), 1) << box;
+  }
+}
