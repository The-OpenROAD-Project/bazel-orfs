+// The net that goes is one an earlier dissolve left its cells on, a
+// dont_touch cell and its guide among them: the cell's pin moves with the
+// net and the cell is still dont_touch, the guide is on the net that is
+// left, and the two instances' pins share the module net between them.
+TEST_F(DissolveTest, FeedthroughJoinsTheNetsOfAnEarlierDissolve)
+{
+  makeFeedthrough("ft", "fi", "fo");
+  dbTechLayer* src_layer = source_db_->getTech()->findLayer("L1");
+  dbGuide::create(source_->findNet("y"),
+                  src_layer,
+                  src_layer,
+                  Rect(3600, 200, 4100, 700),
+                  false);
+  dbInst* m1 = makeMacro(block_->getTopModule(), "m1", dbOrientType::R0);
+  dbInst* m2 = makeMacro(block_->getTopModule(), "m2", dbOrientType::R0);
+  auto [n1, out] = makeNets(block_, "n1", "OUT");
+  dbBTerm::create(out, "OUT")->setIoType(dbIoType::OUTPUT);
+  dbITerm* load = makeInv("load", "ip0", n1);
+  m1->findITerm("y")->connect(n1);
+  m2->findITerm("fi")->connect(n1);
+  m2->findITerm("fo")->connect(out);
+  NetDestroyCounter destroyed;
+  destroyed.addOwner(block_);
+
+  dbModInst* mi1 = dbInst::dissolve(m1, source_);
+  dbModInst* mi2 = dbInst::dissolve(m2, source_);
+
+  EXPECT_EQ(destroyed.count, 1);
+  EXPECT_EQ(block_->findNet("n1"), nullptr);
+  dbNet* kept = block_->findNet("OUT");
+  ASSERT_NE(kept, nullptr);
+  dbInst* u3 = block_->findInst("m1/u3");
+  ASSERT_NE(u3, nullptr);
+  EXPECT_TRUE(u3->isDoNotTouch());
+  EXPECT_EQ(u3->findITerm("op0")->getNet(), kept);
+  EXPECT_EQ(load->getNet(), kept);
+  std::vector<Rect> boxes;
+  for (dbGuide* guide : kept->getGuides()) {
+    boxes.push_back(guide->getBox());
+  }
+  // m1 is at (10000, 20000), its block's die corner at (100, 200).
+  EXPECT_EQ(boxes, (std::vector<Rect>{Rect(13500, 20000, 14000, 20500)}));
+  dbModNet* between = mi1->findModITerm("y")->getModNet();
+  ASSERT_NE(between, nullptr);
+  EXPECT_EQ(mi2->findModITerm("fi")->getModNet(), between);
+  expectModNetsConnect(kept);
+}
