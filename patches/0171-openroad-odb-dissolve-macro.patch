+// The block's own clock tree stripped, as its CTS left it:
+//
+//   clk -> cb0 -c1-> cb1 -c2-> r1, r2 ck, dummy and dummy_inv (no output)
+//               \-c1-> gate (and2, a cloned clock gate; b is n1) -c3->
+//                       cinv (inv1) -c4-> r3 ck
+//   n1 -> rebuf (a data buffer repair_timing inserted) -n5-> nothing
+//
+// All of them TIMING. The buffers on clock nets go and their nets join the
+// clock; the gate, the inverter and the data buffer stay. The clock nets
+// they touched lose their guides; a data net keeps its own.
+TEST_F(DissolveTest, StripClockBuffers)
+{
+  dbLib* src_lib = source_db_->findLib("lib1");
+  auto [c1, c2, c3, c4] = makeNets(source_, "c1", "c2", "c3", "c4");
+  for (dbNet* net : {c1, c2, c3, c4}) {
+    net->setSigType(dbSigType::CLOCK);
+  }
+  dbNet* n5 = dbNet::create(source_, "n5");
+  auto timing = [&](const char* master, const char* name) {
+    dbInst* inst = dbInst::create(source_, src_lib->findMaster(master), name);
+    inst->setSourceType(dbSourceType::TIMING);
+    inst->setLocation(100, 200);
+    inst->setPlacementStatus(dbPlacementStatus::PLACED);
+    return inst;
+  };
+  dbInst* cb0 = timing("buf", "cb0");
+  cb0->findITerm("a")->connect(source_->findNet("clk"));
+  cb0->findITerm("z")->connect(c1);
+  dbInst* cb1 = timing("buf", "cb1");
+  cb1->findITerm("a")->connect(c1);
+  cb1->findITerm("z")->connect(c2);
+  timing("buf", "dummy")->findITerm("a")->connect(c2);
+  // CTS's dummy loads are inverters as often as buffers
+  timing("inv1", "dummy_inv")->findITerm("ip0")->connect(c2);
+  dbInst* gate = timing("and2", "gate");
+  gate->findITerm("a")->connect(c1);
+  gate->findITerm("b")->connect(source_->findNet("n1"));
+  gate->findITerm("o")->connect(c3);
+  dbInst* cinv = timing("inv1", "cinv");
+  cinv->findITerm("ip0")->connect(c3);
+  cinv->findITerm("op0")->connect(c4);
+  dbInst* rebuf = timing("buf", "rebuf");
+  rebuf->findITerm("a")->connect(source_->findNet("n1"));
+  rebuf->findITerm("z")->connect(n5);
+  source_->findInst("r1")->findITerm("ck")->connect(c2);
+  source_->findInst("r2")->findITerm("ck")->connect(c2);
+  source_->findInst("r3")->findITerm("ck")->connect(c4);
+  dbTechLayer* src_layer = source_db_->getTech()->findLayer("L1");
+  dbGuide::create(c2, src_layer, src_layer, Rect(100, 200, 600, 700), false);
+  dbGuide::create(source_->findNet("n3"),
+                  src_layer,
+                  src_layer,
+                  Rect(100, 200, 600, 700),
+                  false);
+
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R0);
+  auto [na, nclk, ny] = makeNets(block_, "na", "nclk", "ny");
+  m->findITerm("a")->connect(na);
+  m->findITerm("clk")->connect(nclk);
+  m->findITerm("y")->connect(ny);
+
+  dbInst::dissolve(m, source_, {"buf"});
+
+  for (const char* name : {"m/cb0", "m/cb1", "m/dummy", "m/dummy_inv"}) {
+    EXPECT_EQ(block_->findInst(name), nullptr) << name;
+  }
+  for (const char* name : {"m/gate", "m/cinv", "m/rebuf"}) {
+    EXPECT_NE(block_->findInst(name), nullptr) << name;
+  }
+  // Every register reaches the parent's clock through what is left.
+  EXPECT_EQ(block_->findInst("m/r1")->findITerm("ck")->getNet(), nclk);
+  EXPECT_EQ(block_->findInst("m/r2")->findITerm("ck")->getNet(), nclk);
+  EXPECT_EQ(block_->findInst("m/gate")->findITerm("a")->getNet(), nclk);
+  EXPECT_EQ(block_->findInst("m/r3")->findITerm("ck")->getNet(),
+            block_->findInst("m/cinv")->findITerm("op0")->getNet());
+  EXPECT_EQ(block_->findNet("m/c1"), nullptr);
+  EXPECT_EQ(block_->findNet("m/c2"), nullptr);
+  EXPECT_NE(block_->findInst("m/rebuf")->findITerm("z")->getNet(), nullptr);
+
+  EXPECT_TRUE(nclk->getGuides().empty());
+  EXPECT_EQ(block_->findNet("m/n3")->getGuides().size(), 1u);
+}
