+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Unit tests for dbInst::dissolve, a placed instance of a block master
+// replaced by the block's cells and nets as a module instance, and for
+// dbModInst::getPortCones.
+//
+// The source block lives in its own database, as a block read from its own
+// ODB does; the two share their library by name only.
+//
+//            +------------------------- blk ---------------------------+
+//   a  ---->| u1 (inv1) -n1-> r1 (dff) -n2-> u2 (and2) -n3-> r2 (dff)  |
+//           |                                         \-n3-> r3 (dff)  |
+//           |                       r2 -n4-> u3 (inv1) ----------------|----> y
+//   clk --->| ck of r1, r2, r3                                         |
+//            +---------------------------------------------------------+
+//
+// The master has more pins than this block has ports (b, fi, fo, gi, go);
+// a test that wants one adds the port: a second input, or a feedthrough, a
+// net of the block's on two of its ports.
+
+#include <algorithm>
+#include <cstddef>
+#include <memory>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "odb/dbBlockCallBackObj.h"
+#include "odb/dbObject.h"
+#include "odb/dbTypes.h"
+#include "odb/geom.h"
+#include "tst/db_fixture.h"
+
+namespace odb {
+
+namespace {
+
+constexpr int kBlkWidth = 4000;
+constexpr int kBlkHeight = 2000;
+
+dbLib* makeLib(dbDatabase* db, bool with_block_master)
+{
+  dbTech* tech = dbTech::create(db, "tech");
+  dbTechLayer::create(tech, "L1", dbTechLayerType::MASTERSLICE);
+  dbLib* lib = dbLib::create(db, "lib1", tech, ',');
+
+  dbMaster* inv = dbMaster::create(lib, "inv1");
+  inv->setWidth(500);
+  inv->setHeight(1000);
+  inv->setType(dbMasterType::CORE);
+  dbMTerm::create(inv, "ip0", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(inv, "op0", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  inv->setFrozen();
+
+  dbMaster* and2 = dbMaster::create(lib, "and2");
+  and2->setWidth(1000);
+  and2->setHeight(1000);
+  and2->setType(dbMasterType::CORE);
+  dbMTerm::create(and2, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(and2, "b", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(and2, "o", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  and2->setFrozen();
+
+  dbMaster* buf = dbMaster::create(lib, "buf");
+  buf->setWidth(500);
+  buf->setHeight(1000);
+  buf->setType(dbMasterType::CORE);
+  dbMTerm::create(buf, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(buf, "z", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  buf->setFrozen();
+
+  // A clock pin makes the master sequential.
+  dbMaster* dff = dbMaster::create(lib, "dff");
+  dff->setWidth(1000);
+  dff->setHeight(1000);
+  dff->setType(dbMasterType::CORE);
+  dbMTerm::create(dff, "d", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(dff, "ck", dbIoType::INPUT, dbSigType::CLOCK);
+  dbMTerm::create(dff, "q", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  dff->setFrozen();
+
+  if (with_block_master) {
+    dbMaster* blk = dbMaster::create(lib, "blk");
+    blk->setWidth(kBlkWidth);
+    blk->setHeight(kBlkHeight);
+    blk->setType(dbMasterType::BLOCK);
+    dbMTerm::create(blk, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "clk", dbIoType::INPUT, dbSigType::CLOCK);
+    dbMTerm::create(blk, "y", dbIoType::OUTPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "b", dbIoType::INPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "fi", dbIoType::INPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "fo", dbIoType::OUTPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "gi", dbIoType::INPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "go", dbIoType::OUTPUT, dbSigType::SIGNAL);
+    blk->setFrozen();
+  }
+  return lib;
+}
