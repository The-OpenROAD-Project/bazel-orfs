+  dbModNet* outer_in = mi->findModITerm("fi")->getModNet();
+  dbModNet* outer_out = mi->findModITerm("fo")->getModNet();
+  ASSERT_NE(outer_in, nullptr);
+  ASSERT_NE(outer_out, nullptr);
+  EXPECT_NE(outer_in, outer_out);
