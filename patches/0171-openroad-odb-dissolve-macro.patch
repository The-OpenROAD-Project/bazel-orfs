diff --git a/src/odb/src/db/dbDissolve.cpp b/src/odb/src/db/dbDissolve.cpp
new file mode 100644
index 0000000..48e85c2
--- /dev/null
+++ b/src/odb/src/db/dbDissolve.cpp
@@ -0,0 +1,681 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// dbInst::dissolve: a placed instance of a block master replaced by the
+// block's own cells, nets and global route guides, as a module instance in
+// the parent's hierarchy. dbModInst::getPortCones: the leaf instances between the ports
+// of a module instance and the first sequential instance.
+
+#include <algorithm>
+#include <cstddef>
+#include <deque>
+#include <map>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "dbBlock.h"
+#include "odb/db.h"
+#include "odb/dbTransform.h"
+#include "odb/dbTypes.h"
+#include "odb/geom.h"
+#include "utl/Logger.h"
+
+namespace odb {
+
+namespace {
+
+bool isSupplyNet(dbNet* net)
+{
+  return net->getSigType().isSupply();
+}
+
+bool isSupplyTerm(dbITerm* iterm)
+{
+  return iterm->getMTerm()->getSigType().isSupply();
+}
+
+// A dont_touch instance's pins cannot be connected, and the dissolve moves
+// the pins of a net to another net, or onto a module net, without changing
+// what they are connected to: the flag is lifted on the instances of the
+// net's pins meanwhile.
+class DontTouchLift
+{
+ public:
+  explicit DontTouchLift(dbNet* net)
+  {
+    for (dbITerm* iterm : net->getITerms()) {
+      dbInst* inst = iterm->getInst();
+      if (inst->isDoNotTouch()) {
+        inst->setDoNotTouch(false);
+        insts_.push_back(inst);
+      }
+    }
+  }
+  ~DontTouchLift()
+  {
+    for (dbInst* inst : insts_) {
+      inst->setDoNotTouch(true);
+    }
+  }
+  DontTouchLift(const DontTouchLift&) = delete;
+  DontTouchLift& operator=(const DontTouchLift&) = delete;
+
+ private:
+  std::vector<dbInst*> insts_;
+};
+
+// The target master of each source master, by name, and the target mterm of
+// each source mterm: the two databases share a library by name only.
+class MasterMap
+{
+ public:
+  MasterMap(dbDatabase* target, utl::Logger* logger)
+      : target_(target), logger_(logger)
+  {
+  }
+
+  dbMaster* master(dbInst* src)
+  {
+    dbMaster* src_master = src->getMaster();
+    auto it = masters_.find(src_master);
+    if (it != masters_.end()) {
+      return it->second;
+    }
+    dbMaster* master = target_->findMaster(src_master->getName().c_str());
+    if (master == nullptr) {
+      logger_->error(utl::ODB,
+                     1221,
+                     "dissolve: master {} of {} is not in the parent's "
+                     "libraries.",
+                     src_master->getName(),
+                     src->getName());
+    }
+    masters_[src_master] = master;
+    return master;
+  }
+
+  dbMTerm* mterm(dbMTerm* src_mterm, dbMaster* master)
+  {
+    auto it = mterms_.find(src_mterm);
+    if (it != mterms_.end()) {
+      return it->second;
+    }
+    dbMTerm* mterm = master->findMTerm(src_mterm->getName().c_str());
+    if (mterm == nullptr) {
+      logger_->error(utl::ODB,
+                     1222,
+                     "dissolve: master {} has no pin {}.",
+                     master->getName(),
+                     src_mterm->getName());
+    }
+    mterms_[src_mterm] = mterm;
+    return mterm;
+  }
+
+ private:
+  dbDatabase* target_;
+  utl::Logger* logger_;
+  std::unordered_map<dbMaster*, dbMaster*> masters_;
+  std::unordered_map<dbMTerm*, dbMTerm*> mterms_;
+};
+
+}  // namespace
+
+dbModInst* dbInst::dissolve(dbInst* inst,
+                            dbBlock* source,
+                            const std::vector<std::string>& strip_clock_buffers)
+{
+  dbBlock* block = inst->getBlock();
+  utl::Logger* logger = ((_dbBlock*) block)->getLogger();
+  const std::string inst_name = inst->getName();
+  dbMaster* macro = inst->getMaster();
+
+  if (!inst->isPlaced()) {
+    logger->error(utl::ODB, 1223, "dissolve: {} is not placed.", inst_name);
+  }
+  // Standard cells sit in rows: a quarter turn of the block would turn its
+  // cells across them.
+  const dbOrientType orient = inst->getOrient();
+  if (orient != dbOrientType::R0 && orient != dbOrientType::MX
+      && orient != dbOrientType::MY && orient != dbOrientType::R180) {
+    logger->error(utl::ODB,
+                  1224,
+                  "dissolve: {} has orientation {}; only R0, MX, MY and R180 "
+                  "keep the block's cells in rows.",
+                  inst_name,
+                  orient.getString());
+  }
+  // The master is the block's abstract: same outline as its die.
+  const Rect die = source->getDieArea();
+  if (static_cast<int64_t>(macro->getWidth()) != die.dx()
+      || static_cast<int64_t>(macro->getHeight()) != die.dy()) {
+    logger->error(utl::ODB,
+                  1225,
+                  "dissolve: master {} is {} x {}, block {}'s die {} x {}.",
+                  macro->getName(),
+                  macro->getWidth(),
+                  macro->getHeight(),
+                  source->getName(),
+                  die.dx(),
+                  die.dy());
+  }
+
+  // What the macro's pins were on in the parent, by pin name.
+  struct ParentConn
+  {
+    dbNet* net;
+    dbModNet* mod_net;
+  };
+  std::unordered_map<std::string, ParentConn> parent_conns;
+  for (dbITerm* iterm : inst->getITerms()) {
+    if (isSupplyTerm(iterm)) {
+      continue;
+    }
+    parent_conns[iterm->getMTerm()->getName()]
+        = {iterm->getNet(), iterm->getModNet()};
+  }
+
+  dbModule* parent = inst->getModule();
+  if (parent == nullptr) {
+    parent = block->getTopModule();
+  }
+
+  // A pin with no module net is on a net that stayed inside the parent's
+  // module, and that net gets its module net there below, with the terms
+  // connectTermsOf finds in the module. A net with a term outside the
+  // module did not stay inside: the hierarchy is not the flat netlist's,
+  // the term would be left off the new module net and the timer's walk
+  // would stop short of it. Such a dissolve is refused here, before
+  // anything is changed.
+  std::unordered_set<dbNet*> checked;
+  for (dbITerm* pin : inst->getITerms()) {
+    dbNet* net = pin->getNet();
+    if (isSupplyTerm(pin) || net == nullptr || pin->getModNet() != nullptr) {
+      continue;
+    }
+    // Only a pin that is a port of the block gets a module net.
+    dbBTerm* port = source->findBTerm(pin->getMTerm()->getName().c_str());
+    if (port == nullptr || port->getSigType().isSupply()
+        || !checked.insert(net).second) {
+      continue;
+    }
+    std::string outside;
+    for (dbITerm* iterm : net->getITerms()) {
+      if (iterm->getInst() != inst && iterm->getInst()->getModule() != parent) {
+        outside = iterm->getName();
+        break;
+      }
+    }
+    if (outside.empty() && block->getTopModule() != parent) {
+      for (dbBTerm* bterm : net->getBTerms()) {
+        outside = bterm->getName();
+        break;
+      }
+    }
+    if (!outside.empty()) {
+      logger->error(utl::ODB,
+                    1238,
+                    "dissolve: pin {} of {} has no module net and its net {} "
+                    "is on {}, outside {}.",
+                    pin->getMTerm()->getName(),
+                    inst_name,
+                    net->getName(),
+                    outside,
+                    parent->getName());
+    }
+  }
+
+  // Source coordinates to parent coordinates: the source die's corner is
+  // the master's origin, which the instance's transform places.
+  dbTransform to_parent(Point(-die.xMin(), -die.yMin()));
+  to_parent.concat(inst->getTransform());
+
+  // The macro's own placement blockages and obstructions (a halo) go with
+  // it; left behind they would name one of the new cells.
+  std::vector<dbBlockage*> blockages;
+  for (dbBlockage* blockage : block->getBlockages()) {
+    if (blockage->getInstance() == inst) {
+      blockages.push_back(blockage);
+    }
+  }
+  for (dbBlockage* blockage : blockages) {
+    dbBlockage::destroy(blockage);
+  }
+  std::vector<dbObstruction*> obstructions;
+  for (dbObstruction* obstruction : block->getObstructions()) {
+    if (obstruction->getInstance() == inst) {
+      obstructions.push_back(obstruction);
+    }
+  }
+  for (dbObstruction* obstruction : obstructions) {
+    dbObstruction::destroy(obstruction);
+  }
+
+  // The block's own clock tree, stripped on request: the buffers its CTS
+  // inserted (TIMING, a named buffer master, on clock nets on both sides)
+  // go, and each one's output net joins its input net, so the block's
+  // registers come in on one clock net for the parent's CTS to build a
+  // single tree over. Its dummy loads go too, whatever their master (an
+  // inverter as often as a buffer): a TIMING cell on a clock net with
+  // nothing on its output drives nothing. A data buffer repair_timing
+  // inserted is TIMING too, but not on a clock net; a cloned clock gate has
+  // two inputs; an inverter that drives something is not a buffer master.
+  // A net that touched a stripped cell loses its guides: its route changed.
+  const std::unordered_set<std::string> strip_masters(
+      strip_clock_buffers.begin(), strip_clock_buffers.end());
+  std::unordered_set<dbInst*> stripped;
+  std::unordered_map<dbNet*, dbNet*> alias;
+  std::unordered_set<dbNet*> rerouted;
+  for (dbInst* src : source->getInsts()) {
+    if (strip_masters.empty()
+        || src->getSourceType() != dbSourceType::TIMING) {
+      continue;
+    }
+    int inputs = 0;
+    int outputs = 0;
+    dbNet* in = nullptr;
+    dbNet* out = nullptr;
+    for (dbITerm* iterm : src->getITerms()) {
+      if (isSupplyTerm(iterm)) {
+        continue;
+      }
+      if (iterm->getIoType() == dbIoType::INPUT) {
+        ++inputs;
+        in = iterm->getNet();
+      } else if (iterm->getIoType() == dbIoType::OUTPUT) {
+        ++outputs;
+        out = iterm->getNet();
+      }
+    }
+    if (out != nullptr
+        && !strip_masters.contains(src->getMaster()->getName())) {
+      continue;
+    }
+    if (inputs != 1 || outputs != 1 || in == nullptr
+        || in->getSigType() != dbSigType::CLOCK
+        || (out != nullptr && out->getSigType() != dbSigType::CLOCK)) {
+      continue;
+    }
+    if (out != nullptr && !out->getBTerms().empty()) {
+      logger->error(utl::ODB,
+                    1236,
+                    "dissolve: clock buffer {} of {} drives port net {}; "
+                    "stripping it would join two ports.",
+                    src->getName(),
+                    source->getName(),
+                    out->getName());
+    }
+    stripped.insert(src);
+    rerouted.insert(in);
+    if (out != nullptr) {
+      alias[out] = in;
+      rerouted.insert(out);
+    }
+  }
+  auto root = [&alias](dbNet* net) {
+    for (auto it = alias.find(net); it != alias.end(); it = alias.find(net)) {
+      net = it->second;
+    }
+    return net;
+  };
+  if (!strip_masters.empty()) {
+    logger->info(utl::ODB,
+                 1237,
+                 "dissolve: stripped {} clock buffers from {}.",
+                 stripped.size(),
+                 source->getName());
+  }
+
+  // The module instance takes the macro's name in its module.
+  const char delimiter = block->getHierarchyDelimiter();
+  std::string base_name = inst_name;
+  if (!parent->isTop()) {
+    const std::string prefix = parent->getHierarchicalName() + delimiter;
+    if (base_name.starts_with(prefix)) {
+      base_name = base_name.substr(prefix.size());
+    }
+  }
+  dbInst::destroy(inst);
+
+  dbModule* module = dbModule::makeUniqueDbModule(
+      source->getName().c_str(), base_name.c_str(), block);
+  // Ports first, then the instance and its pins, as the Verilog reader
+  // builds a module.
+  std::vector<std::pair<dbBTerm*, dbModBTerm*>> ports;
+  for (dbBTerm* bterm : source->getBTerms()) {
+    if (bterm->getSigType().isSupply()) {
+      continue;
+    }
+    if (!parent_conns.contains(bterm->getName())) {
+      logger->error(utl::ODB,
+                    1226,
+                    "dissolve: master {} has no pin for {}'s port {}.",
+                    macro->getName(),
+                    source->getName(),
+                    bterm->getName());
+    }
+    dbModBTerm* mod_bterm = dbModBTerm::create(module, bterm->getName().c_str());
+    mod_bterm->setIoType(bterm->getIoType());
+    mod_bterm->setSigType(bterm->getSigType());
+    ports.emplace_back(bterm, mod_bterm);
+  }
+  dbModInst* mod_inst
+      = dbModInst::create(parent, module, base_name.c_str());
+  if (mod_inst == nullptr) {
+    logger->error(utl::ODB,
+                  1227,
+                  "dissolve: cannot create module instance {} in {}.",
+                  base_name,
+                  parent->getName());
+  }
+  const std::string path = mod_inst->getHierarchicalName() + delimiter;
+
+  // The parent side of each port: the net the macro's pin was on. A net
+  // that stayed inside the parent's module has no module net there yet;
+  // it now crosses into the new instance and gets one, with every term of
+  // the flat net in that module on it. Two pins on one such net share the
+  // module net: the timer walks module nets, and a second one would take
+  // the net's terms from the first and leave it on its pin alone.
+  std::unordered_map<dbBTerm*, dbNet*> port_flat;
+  std::unordered_map<dbNet*, dbModNet*> parent_mod_nets;
+  for (auto [bterm, mod_bterm] : ports) {
+    dbModITerm* mod_iterm
+        = dbModITerm::create(mod_inst, mod_bterm->getName(), mod_bterm);
+    const ParentConn& conn = parent_conns[bterm->getName()];
+    port_flat[bterm] = conn.net;
+    if (conn.net == nullptr) {
+      continue;
+    }
+    dbModNet* mod_net = conn.mod_net;
+    if (mod_net == nullptr) {
+      dbModNet*& made = parent_mod_nets[conn.net];
+      if (made == nullptr) {
+        made = dbModNet::create(parent,
+                                conn.net->getName().c_str(),
+                                dbNameUniquifyType::IF_NEEDED,
+                                conn.net);
+        const DontTouchLift lift(conn.net);
+        made->connectTermsOf(conn.net);
+      }
+      mod_net = made;
+    }
+    mod_iterm->connect(mod_net);
+  }
+
+  // A feedthrough, a source net on two or more ports, joins the parent's
+  // nets on those ports into one of them: one on a port of the parent's
+  // block, since Verilog names a port's net after the port, else the first.
+  // The module nets stay as they are, one on each side of the instance,
+  // joined through the module net inside. mergeNet destroys the net it
+  // merges, so every port that was on that net moves to the one that is
+  // left, and all of it before any net is created: a new net can take a
+  // destroyed net's place in the table, and with it its address. The
+  // guides of the net that goes, an earlier dissolve's routes, would go
+  // with it: they move to the net that is left, where the feedthrough's
+  // own guides join them to that net's. Its pins move with it, those of an
+  // earlier dissolve's dont_touch cells among them.
+  std::unordered_map<dbNet*, dbNet*> merged;
+  auto survivor = [&merged](dbNet* net) {
+    for (auto it = merged.find(net); it != merged.end();
+         it = merged.find(net)) {
+      net = it->second;
+    }
+    return net;
+  };
+  for (dbNet* src_net : source->getNets()) {
+    if (isSupplyNet(src_net) || alias.contains(src_net)) {
+      continue;
+    }
+    // The parent's nets on this net's ports, each once.
+    std::vector<dbNet*> joined;
+    for (dbBTerm* bterm : src_net->getBTerms()) {
+      if (bterm->getSigType().isSupply()) {
+        continue;
+      }
+      dbNet* parent_net = survivor(port_flat[bterm]);
+      if (parent_net != nullptr
+          && std::ranges::find(joined, parent_net) == joined.end()) {
+        joined.push_back(parent_net);
+      }
+    }
+    if (joined.size() < 2) {
+      continue;
+    }
+    dbNet* flat = joined.front();
+    for (dbNet* parent_net : joined) {
+      if (!parent_net->getBTerms().empty()) {
+        flat = parent_net;
+        break;
+      }
+    }
+    for (dbNet* parent_net : joined) {
+      if (parent_net != flat) {
+        for (dbGuide* guide : parent_net->getGuides()) {
+          dbGuide::create(flat,
+                          guide->getLayer(),
+                          guide->getViaLayer(),
+                          guide->getBox(),
+                          guide->isCongested());
+        }
+        const DontTouchLift lift(parent_net);
+        flat->mergeNet(parent_net);
+        merged[parent_net] = flat;
+      }
+    }
+  }
+  for (auto& [bterm, net] : port_flat) {
+    net = survivor(net);
+  }
+
+  // Nets. A source net on ports is the parent's flat net on them, one net
+  // by now, or a new one named under the instance when the parent leaves
+  // all of them open, with a module net inside the new module; a net on no
+  // port is a new flat net, named under the instance, with no module net,
+  // as the Verilog reader leaves a net that does not leave its module.
+  std::unordered_map<std::string, dbModBTerm*> mod_bterms;
+  for (auto [bterm, mod_bterm] : ports) {
+    mod_bterms[bterm->getName()] = mod_bterm;
+  }
+  struct Conn
+  {
+    dbNet* net;
+    dbModNet* mod_net;
+  };
+  std::unordered_map<dbNet*, Conn> nets;
+  for (dbNet* src_net : source->getNets()) {
+    if (isSupplyNet(src_net) || alias.contains(src_net)) {
+      continue;
+    }
+    dbNet* flat = nullptr;
+    dbModNet* mod_net = nullptr;
+    for (dbBTerm* bterm : src_net->getBTerms()) {
+      if (bterm->getSigType().isSupply()) {
+        continue;
+      }
+      if (mod_net == nullptr) {
+        mod_net = dbModNet::create(module, src_net->getName().c_str());
+      }
+      mod_bterms[bterm->getName()]->connect(mod_net);
+      if (flat == nullptr) {
+        flat = port_flat[bterm];
+      }
+    }
+    if (flat == nullptr) {
+      const std::string name = path + src_net->getName();
+      flat = dbNet::create(block, name.c_str());
+      if (flat == nullptr) {
+        logger->error(
+            utl::ODB, 1228, "dissolve: net {} already exists.", name);
+      }
+      flat->setSigType(src_net->getSigType());
+    }
+    nets[src_net] = {flat, mod_net};
+  }
+  for (auto [out, in] : alias) {
+    nets[out] = nets[root(in)];
+  }
+
+  // Cells, where the block placed them, through the macro's transform.
+  MasterMap masters(block->getDataBase(), logger);
+  for (dbInst* src : source->getInsts()) {
+    if (stripped.contains(src)) {
+      continue;
+    }
+    dbMaster* master = masters.master(src);
+    const std::string name = path + src->getName();
+    dbInst* cell = dbInst::create(
+        block, master, name.c_str(), src->isPhysicalOnly(), module);
+    if (cell == nullptr) {
+      logger->error(
+          utl::ODB, 1229, "dissolve: instance {} already exists.", name);
+    }
+    dbTransform t = src->getTransform();
+    t.concat(to_parent);
+    cell->setTransform(t);
+    cell->setPlacementStatus(src->getPlacementStatus());
+    // Keep TIMING: CTS skips a net a TIMING buffer drives (CTS-0105), so a
+    // dissolved clock tree is left as built instead of re-clustered.
+    cell->setSourceType(src->getSourceType());
+    for (dbITerm* src_iterm : src->getITerms()) {
+      dbNet* src_net = src_iterm->getNet();
+      if (src_net == nullptr || isSupplyNet(src_net)) {
+        continue;
+      }
+      const Conn& conn = nets[src_net];
+      dbITerm* iterm
+          = cell->getITerm(masters.mterm(src_iterm->getMTerm(), master));
+      if (conn.mod_net != nullptr) {
+        iterm->connect(conn.net, conn.mod_net);
+      } else {
+        iterm->connect(conn.net);
+      }
+    }
+    // After its pins: a dont_touch instance's pins cannot be connected.
+    if (src->isDoNotTouch()) {
+      cell->setDoNotTouch(true);
+    }
+  }
+
+  // The block's global route guides, through the macro's transform: the
+  // parent's router restores a net from its guides instead of routing it
+  // again, so a block dissolved after its global route keeps its routes.
+  // In the source's net order, so the parent's guides are the same every
+  // run.
+  dbTech* tech = block->getTech();
+  for (dbNet* src_net : source->getNets()) {
+    if (isSupplyNet(src_net) || rerouted.contains(src_net)) {
+      continue;
+    }
+    dbNet* net = nets[src_net].net;
+    for (dbGuide* guide : src_net->getGuides()) {
+      dbTechLayer* layer = tech->findLayer(guide->getLayer()->getName().c_str());
+      dbTechLayer* via_layer = nullptr;
+      if (guide->getViaLayer() != nullptr) {
+        via_layer = tech->findLayer(guide->getViaLayer()->getName().c_str());
+      }
+      Rect box = guide->getBox();
+      to_parent.apply(box);
+      dbGuide::create(net, layer, via_layer, box, guide->isCongested());
+    }
+  }
+  return mod_inst;
+}
+
+std::vector<dbInst*> dbModInst::getPortCones(
+    const size_t max_cone,
+    std::vector<dbModBTerm*>* skipped)
+{
+  dbModule* module = getMaster();
+  std::unordered_set<dbInst*> inside;
+  for (dbInst* inst : module->getLeafInsts()) {
+    inside.insert(inst);
+  }
+
+  std::vector<dbInst*> result;
+  std::unordered_set<dbInst*> in_result;
+  for (dbModBTerm* port : module->getModBTerms()) {
+    if (port->isBusPort() || port->getSigType().isSupply()) {
+      continue;
+    }
+    dbModNet* mod_net = port->getModNet();
+    if (mod_net == nullptr) {
+      continue;
+    }
+    dbNet* start = mod_net->findRelatedNet();
+    if (start == nullptr) {
+      continue;
+    }
+    const dbIoType io = port->getIoType();
+    // Forward from an input, backward from an output; an inout both ways.
+    const bool forward = io == dbIoType::INPUT || io == dbIoType::INOUT;
+    const bool backward = io == dbIoType::OUTPUT || io == dbIoType::INOUT;
+
+    std::vector<dbInst*> cone;
+    std::unordered_set<dbInst*> seen;
+    std::unordered_set<dbNet*> seen_nets;
+    std::deque<std::tuple<dbNet*, bool>> queue;
+    if (forward) {
+      queue.emplace_back(start, true);
+    }
+    if (backward) {
+      queue.emplace_back(start, false);
+    }
+    bool too_big = false;
+    while (!queue.empty() && !too_big) {
+      auto [net, fwd] = queue.front();
+      queue.pop_front();
+      for (dbITerm* iterm : net->getITerms()) {
+        if (isSupplyTerm(iterm)) {
+          continue;
+        }
+        const dbIoType dir = iterm->getIoType();
+        // Forward the loads on the net, backward its drivers.
+        if (fwd ? dir == dbIoType::OUTPUT : dir == dbIoType::INPUT) {
+          continue;
+        }
+        dbInst* inst = iterm->getInst();
+        if (!inside.contains(inst) || !seen.insert(inst).second) {
+          continue;
+        }
+        cone.push_back(inst);
+        if (cone.size() > max_cone) {
+          too_big = true;
+          break;
+        }
+        if (inst->getMaster()->isSequential()) {
+          continue;
+        }
+        for (dbITerm* next : inst->getITerms()) {
+          if (isSupplyTerm(next)) {
+            continue;
+          }
+          const dbIoType next_dir = next->getIoType();
+          if (fwd ? next_dir == dbIoType::INPUT : next_dir == dbIoType::OUTPUT) {
+            continue;
+          }
+          dbNet* next_net = next->getNet();
+          if (next_net != nullptr && seen_nets.insert(next_net).second) {
+            queue.emplace_back(next_net, fwd);
+          }
+        }
+      }
+    }
+    if (too_big) {
+      if (skipped != nullptr) {
+        skipped->push_back(port);
+      }
+      continue;
+    }
+    for (dbInst* inst : cone) {
+      if (in_result.insert(inst).second) {
+        result.push_back(inst);
+      }
+    }
+  }
+  return result;
+}
+
+}  // namespace odb
