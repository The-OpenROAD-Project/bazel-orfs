+// Counts the nets destroyed in a block.
+class NetDestroyCounter : public dbBlockCallBackObj
+{
+ public:
+  void inDbNetDestroy(dbNet* /* net */) override { ++count; }
+  int count = 0;
+};
+
+class DissolveTest : public tst::DbFixture
+{
+ protected:
+  void SetUp() override
+  {
+    lib_ = makeLib(db_.get(), true);
+    dbChip* chip = dbChip::create(db_.get(), db_->getTech());
+    block_ = dbBlock::create(chip, "top");
+    block_->setDieArea(Rect(0, 0, 100000, 100000));
+
+    source_db_ = dbDatabase::create();
+    source_db_->setLogger(&logger_);
+    dbLib* src_lib = makeLib(source_db_, false);
+    dbChip* src_chip = dbChip::create(source_db_, source_db_->getTech());
+    source_ = dbBlock::create(src_chip, "blk");
+    // The die's corner is not the origin: the abstract's origin is.
+    source_->setDieArea(Rect(100, 200, 100 + kBlkWidth, 200 + kBlkHeight));
+    makeSource(src_lib);
+  }
+
+  void TearDown() override { dbDatabase::destroy(source_db_); }
+
+  void makeSource(dbLib* lib)
+  {
+    dbBlock* b = source_;
+    dbNet* a = dbNet::create(b, "a");
+    dbNet* clk = dbNet::create(b, "clk");
+    clk->setSigType(dbSigType::CLOCK);
+    dbNet* y = dbNet::create(b, "y");
+    dbBTerm::create(a, "a")->setIoType(dbIoType::INPUT);
+    dbBTerm* clk_port = dbBTerm::create(clk, "clk");
+    clk_port->setIoType(dbIoType::INPUT);
+    clk_port->setSigType(dbSigType::CLOCK);
+    dbBTerm::create(y, "y")->setIoType(dbIoType::OUTPUT);
+    auto [n1, n2, n3, n4] = makeNets(b, "n1", "n2", "n3", "n4");
+
+    auto cell = [&](const char* master,
+                    const char* name,
+                    int x,
+                    int y_loc,
+                    dbOrientType orient) {
+      dbInst* inst = dbInst::create(b, lib->findMaster(master), name);
+      inst->setOrient(orient);
+      inst->setLocation(x, y_loc);
+      inst->setPlacementStatus(dbPlacementStatus::PLACED);
+      return inst;
+    };
+    dbInst* u1 = cell("inv1", "u1", 100, 200, dbOrientType::R0);
+    dbInst* r1 = cell("dff", "r1", 600, 200, dbOrientType::R0);
+    dbInst* u2 = cell("and2", "u2", 1600, 1200, dbOrientType::MX);
+    dbInst* r2 = cell("dff", "r2", 2600, 1200, dbOrientType::MX);
+    dbInst* r3 = cell("dff", "r3", 2600, 200, dbOrientType::R0);
+    dbInst* u3 = cell("inv1", "u3", 3600, 200, dbOrientType::MY);
+
+    u1->findITerm("ip0")->connect(a);
+    u1->findITerm("op0")->connect(n1);
+    r1->findITerm("d")->connect(n1);
+    r1->findITerm("q")->connect(n2);
+    u2->findITerm("a")->connect(n2);
+    u2->findITerm("b")->connect(n2);
+    u2->findITerm("o")->connect(n3);
+    r2->findITerm("d")->connect(n3);
+    r2->findITerm("q")->connect(n4);
+    r3->findITerm("d")->connect(n3);
+    u3->findITerm("ip0")->connect(n4);
+    u3->findITerm("op0")->connect(y);
+    for (dbInst* r : {r1, r2, r3}) {
+      r->findITerm("ck")->connect(clk);
+    }
+    u3->setDoNotTouch(true);
+  }
+
+  // The macro "m" of blk in `module`, its pins on na, nclk and ny.
+  dbInst* makeMacro(dbModule* module, const char* name, dbOrientType orient)
+  {
+    dbInst* m = dbInst::create(
+        block_, lib_->findMaster("blk"), name, false, module);
+    m->setOrient(orient);
+    m->setLocation(10000, 20000);
+    m->setPlacementStatus(dbPlacementStatus::PLACED);
+    return m;
+  }
+
+  // u2's b on `net` of the block instead of n2.
+  void moveU2b(dbNet* net)
+  {
+    dbITerm* pin = source_->findInst("u2")->findITerm("b");
+    pin->disconnect();
+    pin->connect(net);
+  }
+
+  // A second input port of the block, b, on u2's b.
+  void makePortB()
+  {
+    dbNet* b = dbNet::create(source_, "b");
+    dbBTerm::create(b, "b")->setIoType(dbIoType::INPUT);
+    moveU2b(b);
+  }
+
+  // A feedthrough of the block: one net on input port `in` and output port
+  // `out`.
+  dbNet* makeFeedthrough(const char* name, const char* in, const char* out)
+  {
+    dbNet* net = dbNet::create(source_, name);
+    dbBTerm::create(net, in)->setIoType(dbIoType::INPUT);
+    dbBTerm::create(net, out)->setIoType(dbIoType::OUTPUT);
+    return net;
+  }
+
+  // An inverter of the parent's own with `pin` on `net`.
+  dbITerm* makeInv(const char* name, const char* pin, dbNet* net)
+  {
+    dbInst* inv = dbInst::create(block_, lib_->findMaster("inv1"), name);
+    dbITerm* iterm = inv->findITerm(pin);
+    iterm->connect(net);
+    return iterm;
+  }
+
+  // The id of the error the dissolve of `inst` is refused with, "" when it
+  // is not refused.
+  std::string refusal(dbInst* inst)
+  {
+    try {
+      dbInst::dissolve(inst, source_);
+    } catch (const std::runtime_error& e) {
+      return e.what();
+    }
+    return "";
+  }
+
+  // What a refused dissolve leaves as it found it.
+  std::vector<size_t> census() const
+  {
+    return {block_->getInsts().size(),
+            block_->getNets().size(),
+            block_->getModules().size(),
+            block_->getModInsts().size(),
+            block_->getModNets().size(),
+            block_->getModITerms().size(),
+            block_->getBlockages().size()};
+  }
+
+  // The pins a module net reaches through the hierarchy, as the timer walks
+  // it: down through each pin of a module instance to the net on the port
+  // inside, up through each port to the net on the instance's pin.
+  static void reach(dbModNet* net,
+                    std::set<dbModNet*>& seen,
+                    std::set<dbObject*>& pins)
+  {
+    if (net == nullptr || !seen.insert(net).second) {
+      return;
+    }
+    for (dbITerm* iterm : net->getITerms()) {
+      pins.insert(iterm);
+    }
+    for (dbBTerm* bterm : net->getBTerms()) {
+      pins.insert(bterm);
+    }
+    for (dbModITerm* pin : net->getModITerms()) {
+      if (dbModBTerm* port = pin->getChildModBTerm()) {
+        reach(port->getModNet(), seen, pins);
+      }
+    }
+    for (dbModBTerm* port : net->getModBTerms()) {
+      if (dbModITerm* pin = port->getParentModITerm()) {
+        reach(pin->getModNet(), seen, pins);
+      }
+    }
+  }
+
+  // The timer walks a pin's module net, not its flat net: from every pin of
+  // `net`, the module nets reach all of the net's pins and no other.
+  static void expectModNetsConnect(dbNet* net)
+  {
+    std::set<dbObject*> flat;
+    for (dbITerm* iterm : net->getITerms()) {
+      flat.insert(iterm);
+    }
+    for (dbBTerm* bterm : net->getBTerms()) {
+      flat.insert(bterm);
+    }
+    auto from = [&flat](dbModNet* mod_net, const std::string& name) {
+      ASSERT_NE(mod_net, nullptr) << name << " has no module net";
+      std::set<dbModNet*> seen;
+      std::set<dbObject*> pins;
+      reach(mod_net, seen, pins);
+      EXPECT_EQ(pins, flat) << "from " << name;
+    };
+    for (dbITerm* iterm : net->getITerms()) {
+      from(iterm->getModNet(), iterm->getName());
+    }
+    for (dbBTerm* bterm : net->getBTerms()) {
+      from(bterm->getModNet(), bterm->getName());
+    }
+  }
+
+  dbLib* lib_ = nullptr;
+  dbBlock* block_ = nullptr;
+  dbDatabase* source_db_ = nullptr;
+  dbBlock* source_ = nullptr;
+};
