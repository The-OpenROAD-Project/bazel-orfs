     "remove_buffers1_cugr",
diff --git a/src/grt/test/CMakeLists.txt b/src/grt/test/CMakeLists.txt
index 9fa6dd5714..417470f8a3 100644
--- a/src/grt/test/CMakeLists.txt
+++ b/src/grt/test/CMakeLists.txt
@@ -78,6 +78,7 @@ or_integration_tests(
     read_segments_error5
     read_segments_error6
     region_adjustment
+    global_route_cleanup
     remove_buffers1
     remove_buffers2
     remove_buffers1_cugr
diff --git a/src/grt/test/global_route_cleanup.ok b/src/grt/test/global_route_cleanup.ok
new file mode 100644
index 0000000000..7b5335f3a5
--- /dev/null
+++ b/src/grt/test/global_route_cleanup.ok
@@ -0,0 +1,8 @@
+[INFO ODB-0227] LEF file: Nangate45/Nangate45.lef, created 22 layers, 27 vias, 135 library cells
+[INFO ODB-0128] Design: gcd
+[INFO ODB-0130]     Created 54 pins.
+[INFO ODB-0131]     Created 676 components and 2850 component-terminals.
+[INFO ODB-0133]     Created 579 nets and 1498 connections.
+guides after cleanup: identical
+parasitics after cleanup: identical
+routing again after cleanup: identical
diff --git a/src/grt/test/global_route_cleanup.tcl b/src/grt/test/global_route_cleanup.tcl
new file mode 100644
index 0000000000..8dd0c742c3
--- /dev/null
+++ b/src/grt/test/global_route_cleanup.tcl
@@ -0,0 +1,46 @@
+# global_route -cleanup releases the router's working state; the routes, and
+# the parasitics estimated from them, are unchanged, and routing again works.
+source "helpers.tcl"
+read_lef "Nangate45/Nangate45.lef"
+read_liberty Nangate45/Nangate45_typ.lib
+read_def "gcd.def"
+
+set_routing_layers -signal metal2-metal10
+
+global_route
+estimate_parasitics -global_routing
+
+proc net_report { } {
+  set out ""
+  foreach net {clk resp_msg[0] req_msg[15]} {
+    utl::redirectStringBegin
+    report_net -digits 3 $net
+    append out [utl::redirectStringEnd]
+  }
+  return $out
+}
+
+set guides_before [make_result_file global_route_cleanup_before.guide]
+write_guides $guides_before
+set rc_before [net_report]
+
+global_route -cleanup
+
+set guides_after [make_result_file global_route_cleanup_after.guide]
+write_guides $guides_after
+estimate_parasitics -global_routing
+set rc_after [net_report]
+
+proc read_file { f } {
+  set fp [open $f r]
+  set t [read $fp]
+  close $fp
+  return $t
+}
+puts "guides after cleanup: [expr { [read_file $guides_before] eq [read_file $guides_after] ? "identical" : "differ" }]"
+puts "parasitics after cleanup: [expr { $rc_before eq $rc_after ? "identical" : "differ" }]"
+
+global_route
+set guides_again [make_result_file global_route_cleanup_again.guide]
+write_guides $guides_again
+puts "routing again after cleanup: [expr { [read_file $guides_before] eq [read_file $guides_again] ? "identical" : "differ" }]"
-- 
2.53.0

