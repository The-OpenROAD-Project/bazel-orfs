+          wbus("we", v),
+          wbus("addr_w", v),
+          write_addr,
+          wbus("D", v),
+          mask_size,
+          mask_size);
+    }
     data_declarations += fmt::format(
         "  input [{}:0] {};\n", word_size_bit - 1, wbus("D", w));
     enable_declarations += fmt::format(
         "  input [{}:0] {};\n", slices_per_word - 1, wbus("we", w));
     write_logic += fmt::format(R"(    for (i = 0; i < {}; i = i + 1) begin
       if ({}[i]{}) begin
-        mem[{}][i*{} +:{}] <= {}[i*{} +:{}];
+        mem[{}][i*{} +:{}] <= {};
       end
     end
 )",
@@ -3736,9 +3758,7 @@ void RamGen::writeBehavioralVerilog(const std::string& filename,
