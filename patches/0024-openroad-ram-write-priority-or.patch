index 0000000000..ec70f96878
--- /dev/null
+++ b/src/ram/test/make_8x8_2r2w_or_asap7.tcl
@@ -0,0 +1,35 @@
+# generate_ram on asap7 with two write ports that, writing the same word
+# in one cycle, write the OR of their data (-write_priority or), as
+# firtool's register files merge their writes; each word holds by a mux
+# per bit (-write_style mux).
+source "helpers.tcl"
+
+read_liberty ../../../test/asap7/asap7sc7p5t_AO_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_OA_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib
+read_liberty ../../../test/asap7/asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib.gz
+
+read_lef ../../../test/asap7/asap7_tech_1x_201209.lef
+read_lef ../../../test/asap7/asap7sc7p5t_28_R_1x_220121a.lef
+
+set behavioral_file [make_result_file make_8x8_2r2w_or_asap7_behavioral.v]
+
+generate_ram_netlist \
+  -mask_size 8 \
+  -word_size 8 \
+  -num_words 8 \
+  -r_ports 2 \
+  -w_ports 2 \
+  -storage_cell DFFHQNx1_ASAP7_75t_R \
+  -write_style mux \
+  -write_priority or \
+  -write_behavioral_verilog $behavioral_file
+
+set def_file [make_result_file make_8x8_2r2w_or_asap7.def]
+write_def $def_file
+diff_files make_8x8_2r2w_or_asap7.defok $def_file
+
+diff_files make_8x8_2r2w_or_asap7_behavioral.vok $behavioral_file
+
+puts "pass"
diff --git a/src/ram/test/make_8x8_2r2w_or_asap7_behavioral.vok b/src/ram/test/make_8x8_2r2w_or_asap7_behavioral.vok
new file mode 100644
index 0000000000..c44cea3bdd
--- /dev/null
+++ b/src/ram/test/make_8x8_2r2w_or_asap7_behavioral.vok
@@ -0,0 +1,54 @@
+module RAM8x8 (
+  clk,
+  D0,
+  D1,
+  Q0,
+  Q1,
+  addr_w0,
+  addr_w1,
+  addr_r0,
+  addr_r1,
+  we0,
+  we1
+);
+  input clk;
+  input [7:0] D0;
+  input [7:0] D1;
+  output reg [7:0] Q0;
+  output reg [7:0] Q1;
+  input [2:0] addr_w0;
+  input [2:0] addr_w1;
+  input [2:0] addr_r0;
+  input [2:0] addr_r1;
+  input [0:0] we0;
+  input [0:0] we1;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we0[i]) begin
+        mem[addr_w0][i*8 +:8] <= D0[i*8 +:8];
+      end
+    end
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we1[i]) begin
+        mem[addr_w1][i*8 +:8] <= D1[i*8 +:8]
+          | ({8{we0[i] && addr_w0 == addr_w1}} & D0[i*8 +:8]);
+      end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q0 = mem[addr_r0];
+  end
+
+  always @(*) begin
+    Q1 = mem[addr_r1];
+  end
+
+endmodule
