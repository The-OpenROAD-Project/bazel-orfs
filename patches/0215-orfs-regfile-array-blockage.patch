From e916e14c001d3cde8fed82a68b90409190644513 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Wed, 11 Nov 2026 16:37:24 +0100
Subject: [PATCH] memories: a register file's own flow blocks its array, the
 band is placement's
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A register file's own flow (patch 0172) places generate_ram's array
FIRM, and global placement places what is left: generate_ram's input
buffers, which -periphery unplaced leaves to a parent, and the port
buffers buffer_ports adds. The array fills its rows but for holes a few
sites wide, and global placement put most of those cells into it: on a
25 x 72 1r1w register file at bit_folds 4 on asap7, 102 of 155 started
over the array's cells. Detailed placement's negotiation legalizer
stalled with 14 left (DPL-0700) and needed its diamond-search
recovery, and where it runs out of iterations instead detailed placement
fails (DPL-0701, DPL-0033).

regfile_place_top now puts soft placement blockages over the placed
array, in strips between its free columns: columns of sites free in
nine rows of ten or more, such as the service columns generate_ram
leaves (-service_columns) for the buffers placement puts on the long
nets across the array. Global placement blocks the sites under them, so
the cells left to placement go to the band of rows the outline leaves
around the array and to those columns, not to the scattered holes;
detailed placement and check_placement, which skip a soft blockage, do
not count the array's own FIRM cells under it as violations
(DPL-0041).

The band must hold the cells left to placement by itself; when it
cannot, the array is left unblocked and placement uses its holes, as
before, and the log names both numbers. The free columns are room on
paper only: the cells' nets pull them over the array, into the strips,
where the density force is flat, and global placement cannot push them
out to a column a few sites wide. On XiangShan's FpRegFile (16,944
cells left, 332,160 sites, a band of 70,501) the strips left global
placement without IOs at overflow 0.92 rising to 0.997 until it
diverged (GPL-0305); unblocked, it converges at iteration 408 and the
diamond legalizer that flow uses places every cell.

On the 25 x 72 register file: 13 cells start over the array, phase 1
of the negotiation legalizer converges at iteration 0 with no recovery,
140 moves instead of 297, largest 3.3 um instead of 6.7, HPWL 30,742 um
instead of 31,124.

Not upstreamed: on 0172, carried with it. Retires at a //:bump onto an
ORFS that carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---

 flow/scripts/regfile_place.tcl | 129 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 129 insertions(+)

diff --git a/flow/scripts/regfile_place.tcl b/flow/scripts/regfile_place.tcl
index 65394809e..5fc5bdcbf 100644
--- a/flow/scripts/regfile_place.tcl
+++ b/flow/scripts/regfile_place.tcl
@@ -140,15 +140,144 @@ proc regfile_place_top { } {
     $inst setLocation [expr { $ox + $x - [$gdie xMin] }] [expr { $oy + $y - [$gdie yMin] }]
     $inst setPlacementStatus FIRM
     incr placed
+    set b [$inst getBBox]
+    if { $placed == 1 } {
+      lassign [list [$b xMin] [$b yMin] [$b xMax] [$b yMax]] ax0 ay0 ax1 ay1
+    } else {
+      set ax0 [expr { min($ax0, [$b xMin]) }]
+      set ay0 [expr { min($ay0, [$b yMin]) }]
+      set ax1 [expr { max($ax1, [$b xMax]) }]
+      set ay1 [expr { max($ay1, [$b yMax]) }]
+    }
   }
   odb::dbDatabase_destroy $db
   set left 0
+  set demand 0
   foreach inst [$block getInsts] {
     if { ![$inst isPlaced] } {
       incr left
+      incr demand [expr { [[$inst getMaster] getWidth] / $sw }]
     }
   }
   puts "regfile_place: $m, $placed cells where generate_ram placed them,\
     $removed tap and end cells under them removed, $missing gone in\
     synthesis, $resized resized since, $left left to placement"
+  regfile_block_array $block $ax0 $ay0 $ax1 $ay1 $demand
+}
+
+# Soft placement blockages over the array, in strips between its free
+# columns: a column of sites free in nearly every row of the array, such
+# as the service columns generate_ram leaves (-service_columns) for the
+# buffers placement puts on the long nets across it. The scattered holes
+# between the array's cells stay blocked. Returns the free columns' free
+# sites.
+proc regfile_block_strips { block x0 y0 x1 y1 } {
+  set row [lindex [$block getRows] 0]
+  set sw [[$row getSite] getWidth]
+  set rh [[$row getSite] getHeight]
+  set n [expr { ($x1 - $x0) / $sw }]
+  set nrows [expr { ($y1 - $y0) / $rh }]
+  # per site column, the rows of the array a FIRM cell covers it in
+  set taken [lrepeat $n 0]
+  foreach inst [$block getInsts] {
+    if { [$inst getPlacementStatus] ne "FIRM" } {
+      continue
+    }
+    set b [$inst getBBox]
+    if { [$b xMin] < $x0 || [$b xMax] > $x1 || [$b yMin] < $y0 || [$b yMax] > $y1 } {
+      continue
+    }
+    set h [expr { [$b getDY] / $rh }]
+    for { set c [expr { ([$b xMin] - $x0) / $sw }] } \
+        { $c < ([$b xMax] - $x0 + $sw - 1) / $sw && $c < $n } { incr c } {
+      lset taken $c [expr { [lindex $taken $c] + $h }]
+    }
+  }
+  # a service column is free in at least nine rows of ten
+  set strips {}
+  set start -1
+  set open_sites 0
+  for { set c 0 } { $c <= $n } { incr c } {
+    set open [expr { $c < $n && [lindex $taken $c] * 10 <= $nrows }]
+    if { $open } {
+      incr open_sites [expr { $nrows - [lindex $taken $c] }]
+    }
+    if { !$open && $c < $n && $start < 0 } {
+      set start $c
+    } elseif { ($open || $c == $n) && $start >= 0 } {
+      lappend strips [list $start $c]
+      set start -1
+    }
+  }
+  foreach strip $strips {
+    lassign $strip a b
+    set blockage [odb::dbBlockage_create $block \
+      [expr { $x0 + $a * $sw }] $y0 [expr { $x0 + $b * $sw }] $y1]
+    $blockage setSoft
+  }
+  return $open_sites
+}
+
+# The array is FIRM and nearly full: its free sites are holes a few sites
+# wide between its cells. A placement blockage over it leaves global
+# placement the band of rows around it, so the cells left to placement
+# (generate_ram's periphery, the port buffers buffer_ports adds, repair's
+# buffers) go there, not into the holes, where detailed placement must
+# negotiate them out one by one. Soft: global placement blocks the sites
+# under any blockage at its maximum density, 0 by default, while
+# detailed placement and check_placement would count the array's own
+# FIRM cells under a hard one as violations (DPL-0041).
+#
+# The band must hold the cells left to placement by itself. The free
+# columns between the strips are room on paper only: the cells' nets pull
+# them over the array, into the strips, where the density force is flat
+# and global placement cannot push them out to a column a few sites wide;
+# it diverges (GPL-0305). When the band is too small, the array is left
+# unblocked and placement uses its holes, as before the blockage.
+proc regfile_block_array { block x0 y0 x1 y1 demand } {
+  # the fixed cells outside the array: the band's tap and end cells
+  set band_fixed {}
+  foreach inst [$block getInsts] {
+    set b [$inst getBBox]
+    if { [$inst isFixed] && !([$b xMin] >= $x0 && [$b xMax] <= $x1
+                               && [$b yMin] >= $y0 && [$b yMax] <= $y1) } {
+      lappend band_fixed $b
+    }
+  }
+  set supply 0
+  set rows 0
+  foreach row [$block getRows] {
+    set r [$row getBBox]
+    if { [$r yMin] >= $y0 && [$r yMax] <= $y1 } {
+      if { [$r xMin] >= $x0 && [$r xMax] <= $x1 } {
+        continue
+      }
+    }
+    set sw [[$row getSite] getWidth]
+    set free [expr { [$r dx] }]
+    if { [$r yMin] < $y1 && [$r yMax] > $y0 } {
+      set free [expr { $free - (min([$r xMax], $x1) - max([$r xMin], $x0)) }]
+    }
+    foreach b $band_fixed {
+      if { [$b yMin] < [$r yMax] && [$b yMax] > [$r yMin] } {
+        set free [expr { $free - max(0, min([$b xMax], [$r xMax]) - max([$b xMin], [$r xMin])) }]
+      }
+    }
+    incr rows
+    incr supply [expr { max(0, $free) / $sw }]
+  }
+  set dbu [$block getDbUnitsPerMicron]
+  set where [format "%.2f %.2f %.2f %.2f um" \
+    [expr { double($x0) / $dbu }] [expr { double($y0) / $dbu }] \
+    [expr { double($x1) / $dbu }] [expr { double($y1) / $dbu }]]
+  if { $demand > $supply } {
+    puts "regfile_place: the array, $where, left unblocked: the band\
+      around it, $rows rows, has $supply free sites, the cells left to\
+      placement need $demand"
+    return
+  }
+  set open_sites [regfile_block_strips $block $x0 $y0 $x1 $y1]
+  puts "regfile_place: the array blocked, $where, but for $open_sites\
+    sites of its free columns; the band around it, $rows rows, has\
+    $supply free sites for the $demand sites of the cells left to placement"
 }
