+  const RepairProfile& p = setup_context_.profile;
+  logger_->report(
+      "[RSZ-PROFILE] phase={}{} passes={} collect_s={:.2f} repair_path_s={:.2f} "
+      "generate_s={:.2f} commit_s={:.2f} parasitics_s={:.2f} sta_s={:.2f} "
+      "worst_s={:.2f} journal_s={:.2f} restore_s={:.2f} path_s={:.2f} "
+      "begin_s={:.2f} phase_s={:.2f} progress_s={:.2f} tns_s={:.2f} "
+      "candidates={} attempts={} accepted={}",
+      phase_name,
+      phase_marker,
+      p.passes,
+      p.collect_s,
+      p.repair_path_s,
+      p.generate_s,
+      p.commit_s,
+      p.parasitics_s,
+      p.sta_s,
+      p.worst_s,
+      p.journal_s,
+      p.restore_s,
+      p.path_s,
+      p.begin_s,
+      p.phase_s,
+      p.progress_s,
+      p.tns_s,
+      p.candidates,
+      p.attempts,
+      p.accepted);
+}
