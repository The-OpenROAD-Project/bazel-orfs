From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Mon, 26 Oct 2026 18:58:34 +0100
Subject: [PATCH] search: delete a filter's own tags and tag groups, not scan
 for them
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Search::deleteFilteredArrivals scanned every tag group and every tag
for the ones a filter made, and every clock info, at the end of each
filtered search. write_timing_model runs one filtered search per input
edge, most of them reaching a few hundred vertices, so the scans of the
whole design's tags were repeated for each (OpenROAD#11999).

findTagGroup and findTag now note the index of each filter tag group
and the tags_ slot of each filter tag they make, and
deleteFilterTagGroups and deleteFilterTags visit those, in index
order as the scans did, so tag group indices are freed, and reused, in
the same order. A listed index is checked again before its group is
deleted: deleteUnusedTagGroups may have freed it, and a later group
reused it. findClkInfo notes that it made a clock info that refers to a
filter; deleteFilterClkInfos scans the set as before only then. Its
clock infos are erased by iterator, since comparing one reads its crpr
path's tag, which deleteFilterTags has deleted.

Not upstreamed. Carried in bazel-orfs; retires on the //:bump onto an
OpenROAD whose OpenSTA carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 include/sta/Search.hh |  8 ++++++++
 search/Search.cc      | 28 +++++++++++++++++++++++++---
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/src/sta/include/sta/Search.hh b/src/sta/include/sta/Search.hh
index 5e90a96d..fe0b38fd 100644
--- a/src/sta/include/sta/Search.hh
+++ b/src/sta/include/sta/Search.hh
@@ -629,6 +629,9 @@ protected:
   // Use pointer to clk_info set so Tag.hh does not need to be included.
   ClkInfoSet *clk_info_set_;
   std::mutex clk_info_lock_;
+  // A clock info that refers to a filter was made since the last
+  // deleteFilterClkInfos, which otherwise has nothing to look for.
+  bool made_filter_clk_info_{false};
 
   // Entries in tags_ may be missing where previous filter tags were deleted.
   TagIndex tag_capacity_{128};
@@ -648,6 +651,11 @@ protected:
   // Holes in tag_groups_ left by deleting filter tag groups.
   std::vector<TagIndex> tag_group_free_indices_;
   std::mutex tag_group_lock_;
+  // Indices of the tag groups with a filter tag made, and the tags_ slots
+  // of the filter tags made, so that deleting a filter's leftovers visits
+  // them and not every tag group and tag.
+  std::vector<TagGroupIndex> filter_tag_groups_;
+  std::vector<TagIndex> filter_tags_;
 
   // Arrivals to queue on the next search pass.
   VertexSet pending_arrivals_;
diff --git a/src/sta/search/Search.cc b/src/sta/search/Search.cc
index 560c511a..4ed76246 100644
--- a/src/sta/search/Search.cc
+++ b/src/sta/search/Search.cc
@@ -353,6 +353,9 @@ Search::deleteTags()
   tag_group_next_ = 0;
   tag_group_set_->clear();
   tag_group_free_indices_.clear();
+  filter_tag_groups_.clear();
+  filter_tags_.clear();
+  made_filter_clk_info_ = false;
 
   tag_next_ = 0;
   deleteContents(tag_set_);
@@ -570,11 +573,16 @@ Search::deleteFilteredArrivals()
 void
 Search::deleteFilterTagGroups()
 {
-  for (TagGroupIndex i = 0; i < tag_group_next_; i++) {
-    TagGroup *group = tag_groups_[i];
+  // In index order, as a scan of tag_groups_ would, so that the free
+  // indices are reused in the same order. An index can be listed twice,
+  // or hold a group made since, so the group is checked again.
+  std::ranges::sort(filter_tag_groups_);
+  for (TagGroupIndex i : filter_tag_groups_) {
+    TagGroup *group = i < tag_group_next_ ? tag_groups_[i] : nullptr;
     if (group && group->hasFilterTag())
       deleteTagGroup(group);
   }
+  filter_tag_groups_.clear();
 }
 
 void
@@ -589,7 +597,9 @@ Search::deleteTagGroup(TagGroup *group)
 void
 Search::deleteFilterTags()
 {
-  for (TagIndex i = 0; i < tag_next_; i++) {
+  // Tag slots are not reused, so each filter tag is listed once.
+  std::ranges::sort(filter_tags_);
+  for (TagIndex i : filter_tags_) {
     Tag *tag = tags_[i];
     if (tag && (tag->isFilter() || tag->clkInfo()->crprPathRefsFilter())) {
       tags_[i] = nullptr;
@@ -597,11 +607,16 @@ Search::deleteFilterTags()
       delete tag;
     }
   }
+  filter_tags_.clear();
 }
 
 void
 Search::deleteFilterClkInfos()
 {
+  // Erased by iterator: a filter clock info's crpr path has a filter tag,
+  // deleted by now, that comparing it would read.
+  if (!made_filter_clk_info_)
+    return;
   for (auto itr = clk_info_set_->cbegin(); itr != clk_info_set_->cend();) {
     const ClkInfo *clk_info = *itr;
     if (clk_info->crprPathRefsFilter()) {
@@ -611,6 +626,7 @@ Search::deleteFilterClkInfos()
     else
       itr++;
   }
+  made_filter_clk_info_ = false;
 }
 
 void
@@ -2813,6 +2829,8 @@ Search::findTagGroup(TagGroupBldr *tag_bldr,
     }
     tag_group = tag_bldr->makeTagGroup(tag_group_index, this);
     tag_groups_[tag_group_index] = tag_group;
+    if (tag_group->hasFilterTag())
+      filter_tag_groups_.push_back(tag_group_index);
     tag_group_set_->insert(tag_group);
     // If tag_groups_ needs to grow make the new array and copy the
     // contents into it before updating tags_groups_ so that other threads
@@ -3087,6 +3105,8 @@ Search::findTag(Scene *scene,
       // Make sure tag can be indexed in tags_ before it is visible to
       // other threads via tag_set_.
       tags_[tagsTableRfIndex(tag_index, rf1)] = tag1;
+      if (tag1->isFilter() || clk_info->crprPathRefsFilter())
+        filter_tags_.push_back(tagsTableRfIndex(tag_index, rf1));
       tag_set_->insert(tag1);
       if (tag_cache)
         tag_cache->insert(tag1);
@@ -3169,6 +3189,8 @@ Search::findClkInfo(Scene *scene,
                            gen_clk_src_path, pulse_clk_sense, insertion, latency,
                            uncertainties, min_max, crpr_clk_path, this);
     clk_info_set_->insert(clk_info);
+    if (clk_info->crprPathRefsFilter())
+      made_filter_clk_info_ = true;
   }
   return clk_info;
 }
