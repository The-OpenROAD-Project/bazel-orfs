From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] web: web_server -no_browser reports the url and opens nothing

web_server always runs the platform's browser launcher (xdg-open, open,
start) once it listens. A server started for a program to drive, like
bazel-orfs's odb-debug daemon, wants no browser; on a GNOME desktop
xdg-open ignores $BROWSER, so there is no way around the launch from
outside.

-no_browser skips the launcher; the url is still reported (WEB-0001).
The spelling is OpenROAD#11658's, which adds -no_browser with -browser,
OPENROAD_NO_BROWSER, -web_no_browser and a policy for remote hosts; this
is the one flag of it, a bool in place of its launch mode. Not
upstreamed by us; retires at the //:bump onto an OpenROAD that has
#11658.

---
diff --git a/src/web/include/web/web.h b/src/web/include/web/web.h
index 75d7f97..7caa83f 100644
--- a/src/web/include/web/web.h
+++ b/src/web/include/web/web.h
@@ -126,7 +126,10 @@ class WebServer
   // IP literal, or empty for kDefaultBindAddress; see BindAddressKind.
   // Launches background I/O threads and returns immediately.  A second call is
   // a no-op if the server is already running.
-  void serve(int port, const std::string& bind_address);
+  // launch_browser false (web_server -no_browser) only reports the url.
+  void serve(int port,
+             const std::string& bind_address,
+             bool launch_browser = true);
 
   // For -web startup scripts, called on the main thread before they run.
   // Calls serve(port, bind_address), so the browser follows the scripts'
diff --git a/src/web/src/web.i b/src/web/src/web.i
index cfd7d76..746aa72 100644
--- a/src/web/src/web.i
+++ b/src/web/src/web.i
@@ -16,10 +16,10 @@
 namespace web {
 
 void
-web_server_cmd(int port, const char *bind_address)
+web_server_cmd(int port, const char *bind_address, bool launch_browser)
 {
   web::WebServer *server = ord::OpenRoad::openRoad()->getWebServer();
-  server->serve(port, bind_address);
+  server->serve(port, bind_address, launch_browser);
 }
 
 void
diff --git a/src/web/src/web.tcl b/src/web/src/web.tcl
index cc6d581..510f7b6 100644
--- a/src/web/src/web.tcl
+++ b/src/web/src/web.tcl
@@ -1,11 +1,11 @@
 # SPDX-License-Identifier: BSD-3-Clause
 # Copyright (c) 2019-2026, The OpenROAD Authors
 
-sta::define_cmd_args "web_server" { [-port port] [-bind address] [-dir dir] [-stop] }
+sta::define_cmd_args "web_server" { [-port port] [-bind address] [-dir dir] [-no_browser] [-stop] }
 
 proc web_server { args } {
   sta::parse_key_args "web_server" args \
-    keys {-port -bind -dir} flags {-stop}
+    keys {-port -bind -dir} flags {-stop -no_browser}
 
   if { [info exists flags(-stop)] } {
     web::web_server_stop_cmd
@@ -35,7 +35,7 @@ proc web_server { args } {
     set bind $keys(-bind)
   }
 
-  web::web_server_cmd $port $bind
+  web::web_server_cmd $port $bind [expr { ![info exists flags(-no_browser)] }]
   web::web_server_wait_cmd
 }
 
diff --git a/src/web/src/web_serve.cpp b/src/web/src/web_serve.cpp
index 907c153..59e094c 100644
--- a/src/web/src/web_serve.cpp
+++ b/src/web/src/web_serve.cpp
@@ -220,7 +220,9 @@ void WebServer::endStartupScripts(const bool exiting)
   }
 }
 
-void WebServer::serve(int port, const std::string& bind_address)
+void WebServer::serve(int port,
+                      const std::string& bind_address,
+                      const bool launch_browser)
 {
   if (ioc_) {
     logger_->warn(utl::WEB, 6, "Web server is already running.");
@@ -511,7 +513,7 @@ void WebServer::serve(int port, const std::string& bind_address)
     std::string open_cmd = "setsid -f -w xdg-open " + url
                            + " < /dev/null > /dev/null 2> " + errfile;
 #endif
-    int ret = std::system(open_cmd.c_str());
+    int ret = launch_browser ? std::system(open_cmd.c_str()) : 0;
     if (ret != 0) {
       std::ifstream err(errfile);
       std::string errout = "";
