+// One window of passes has ended. What did it buy, per second?
+bool SetupLegacyBase::controllerSaysStop(const int iteration,
+                                         const std::string_view phase_name,
+                                         const char phase_marker)
+{
+  RepairSetupContext::ReturnController& c = setup_context_.controller;
+  const auto now = std::chrono::steady_clock::now();
+  const float tns = sta_->totalNegativeSlack(max_);
+  sta::Slack wns;
+  sta::Vertex* worst = nullptr;
+  sta_->worstSlack(max_, wns, worst);
+
+  if (!c.armed) {
+    c.armed = true;
+    c.window_start = now;
+    c.window_start_tns = tns;
+    c.window_start_wns = wns;
+    return false;
+  }
+
+  const double seconds
+      = std::chrono::duration<double>(now - c.window_start).count();
+  // TNS is negative and rises toward zero as it improves; WNS likewise.
+  const double tns_gain = static_cast<double>(tns - c.window_start_tns);
+  const double wns_gain = static_cast<double>(wns - c.window_start_wns);
+  const double rate = seconds > 0.0 ? tns_gain / seconds : 0.0;
+  c.window_start = now;
+  c.window_start_tns = tns;
+  c.window_start_wns = wns;
+
+  if (rate > c.peak_rate) {
+    c.peak_rate = rate;
+  }
+  // A window that moved WNS is paying whatever TNS says; a window below
+  // the floor of the run's own best rate, with WNS flat, is not.
+  const bool paying = sta::fuzzyGreater(wns_gain, 0.0f)
+                      || (c.peak_rate > 0.0 && rate > kReturnFloor * c.peak_rate);
+  c.low_windows = paying ? 0 : c.low_windows + 1;
+  debugPrint(logger_,
+             RSZ,
+             "repair_setup",
+             2,
+             "{}{} controller: window to iteration {} gained TNS {:.1f} "
+             "WNS {:.3f} in {:.2f}s, rate {:.1f} ps/s, peak {:.1f}, low "
+             "windows {}",
+             phase_name,
+             phase_marker,
+             iteration,
+             tns_gain,
+             wns_gain,
+             seconds,
+             rate,
+             c.peak_rate,
+             c.low_windows);
+  if (c.peak_rate > 0.0 && c.low_windows >= kLowWindowsToStop) {
+    debugPrint(logger_,
+               RSZ,
+               "repair_setup",
+               1,
+               "{}{} Phase: Exiting at iteration {}: return fell below {:.0f}% "
+               "of the phase's best rate for {} windows",
+               phase_name,
+               phase_marker,
+               iteration,
+               kReturnFloor * 100.0,
+               kLowWindowsToStop);
+    return true;
+  }
+  return false;
+}
+
+// A move type tried a whole window of times in this phase without one
+// acceptance is not going to start paying; it is retired for the rest of
+// the phase and comes back at the next.
+void SetupLegacyBase::noteMoveAttempt(const MoveType type, const bool accepted)
+{
+  const size_t index = static_cast<size_t>(type);
+  ++setup_context_.type_attempts[index];
+  if (accepted) {
+    ++setup_context_.type_accepts[index];
+    return;
+  }
+  if (!setup_context_.type_retired[index]
+      && setup_context_.type_accepts[index] == 0
+      && setup_context_.type_attempts[index] >= kTypeWindow) {
+    setup_context_.type_retired[index] = true;
+    debugPrint(logger_,
+               RSZ,
+               "repair_setup",
+               1,
+               "Retiring move type {} for this phase: {} attempts, none "
+               "accepted",
+               static_cast<int>(type),
+               setup_context_.type_attempts[index]);
+  }
+}
