+  // The return controller. A phase measures what each window of passes
+  // bought, in TNS and WNS, remembers the best window the run has had,
+  // and stops when a window has fallen to a small fraction of that best
+  // for two windows running. Gains are per window of passes, never per
+  // second: the decision must not depend on the machine or its load, or
+  // the result would. Every constant is a ratio of the run's own
+  // measurements or a scale the optimizer already uses; nothing is a
+  // knob. The best window is kept across the phases of one run, so a
+  // second phase chasing crumbs after a productive first one stops
+  // quickly.
+  struct ReturnController
+  {
+    float window_start_tns{0.0f};
+    float window_start_wns{0.0f};
+    double peak_gain{0.0};  // TNS ps gained in the best window so far
+    int low_windows{0};
+    bool armed{false};
+    // The controller has decided this phase is over: the loops break.
+    bool stop_phase{false};
+    // Set when a phase stopped for lack of return (this controller or the
+    // legacy fix-rate test). Reported at the handover to last gasp.
+    bool stopped_for_return{false};
+  };
+  ReturnController controller;
+
+  // Per move type, this phase: attempts and acceptances. A type that has
+  // been tried a window's worth of times with no acceptance is retired
+  // for the rest of the phase.
+  std::array<int, static_cast<size_t>(MoveType::kCount)> type_attempts{};
+  std::array<int, static_cast<size_t>(MoveType::kCount)> type_accepts{};
+  std::array<bool, static_cast<size_t>(MoveType::kCount)> type_retired{};
 };
 
