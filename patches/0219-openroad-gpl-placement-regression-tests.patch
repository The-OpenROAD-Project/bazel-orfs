+# Timing paths through global placement on synthetic designs whose good
+# shape is known: the designs, metrics and runs path_shape_test and
+# path_shape_targets_test share.
+cc_library(
+    name = "path_shape",
+    testonly = True,
+    srcs = ["path_shape.cpp"],
+    hdrs = ["path_shape.h"],
+    deps = [
+        ":gpl_design_builder",
+        "//src/gpl:gpl_impl",
+        "//src/odb/src/db",
+        "//src/tst",
+        "@googletest//:gtest",
+    ],
+)
+
+# The invariants: what gpl gets right on those paths today, and must keep.
+cc_test(
+    name = "path_shape_test",
+    srcs = ["path_shape_test.cpp"],
+    env = GPU_ENV_OFF,
+    deps = [
+        ":gpl_design_builder",
+        ":path_shape",
+        "//src/gpl:gpl_impl",
+        "//src/odb/src/db",
+        "@googletest//:gtest",
+        "@googletest//:gtest_main",
+    ],
+)
+
+# The targets: what a robust gpl must do on those paths and does not do
+# yet. Every test in it fails today by design, hence manual; run it by
+# name: bazel test //src/gpl/test:path_shape_targets_test
+cc_test(
+    name = "path_shape_targets_test",
+    srcs = ["path_shape_targets_test.cpp"],
+    env = GPU_ENV_OFF,
+    tags = ["manual"],
+    deps = [
+        ":gpl_design_builder",
+        ":path_shape",
+        "//src/gpl:gpl_impl",
+        "@googletest//:gtest",
