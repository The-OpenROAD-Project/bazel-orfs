+
+PlaceResult PathShapeFixture::place(const PlaceOptions& options,
+                                    const int threads)
+{
+  Replace replace{db_.get(), sta_.get(), nullptr, nullptr, nullptr, &logger_};
+  logger_.redirectStringBegin();
+  const PlaceResult result = replace.doPlace(threads, options);
+  endLog();
+  checkRan(result);
+  return result;
+}
+
+PlaceResult PathShapeFixture::placeWeighted(
+    const PlaceOptions& options,
+    const std::unordered_set<odb::dbNet*>& nets,
+    const float weight)
+{
+  odb::dbDatabase* db = db_.get();
+  logger_.redirectStringBegin();
+  // Initial placement writes its result to the database, where the
+  // weighted Nesterov placement below picks it up.
+  Replace initial{db, sta_.get(), nullptr, nullptr, nullptr, &logger_};
+  initial.doInitialPlace(1, options);
+  auto pbc = std::make_shared<PlacerBaseCommon>(
+      db, PlacerBaseVars(options), &logger_);
+  std::vector<std::shared_ptr<PlacerBase>> pbs{
+      std::make_shared<PlacerBase>(db, pbc, &logger_, true)};
+
+  const NesterovBaseVars nb_vars(options);
+  auto nbc = std::make_shared<NesterovBaseCommon>(
+      nb_vars, pbc, &logger_, 1, Clusters{});
+  std::vector<std::shared_ptr<NesterovBase>> nbs{
+      std::make_shared<NesterovBase>(nb_vars, pbs[0], nbc, &logger_)};
+  std::size_t weighted = 0;
+  for (GNet* gnet : nbc->getGNets()) {
+    if (nets.contains(gnet->getPbNet()->getDbNet())) {
+      gnet->setTimingWeight(weight);
+      ++weighted;
+    }
+  }
+  NesterovPlaceVars np_vars(options, nbc->getHpwl());
+  nbs[0]->setNpVars(&np_vars);
+  auto rb = std::make_shared<RouteBase>(
+      RouteBaseVars(options), db, nullptr, nbc, nbs, &logger_);
+  auto tb = std::make_shared<TimingBase>(nbc, nullptr, nullptr, &logger_);
+  NesterovPlace np(np_vars,
+                   pbc,
+                   nbc,
+                   pbs,
+                   nbs,
+                   rb,
+                   tb,
+                   nullptr,
+                   nullptr,
+                   std::make_unique<GraphicsNone>(),
+                   &logger_);
+  np.setTargetOverflow(options.overflow);
+  np.setMaxIters(options.nesterovPlaceMaxIter);
+  const PlaceResult result = np.doNesterovPlace(0);
+  endLog();
+  if (weighted != nets.size()) {
+    constructionFailure("weight " + format(weight) + " reached "
+                        + std::to_string(weighted) + " of "
+                        + std::to_string(nets.size()) + " nets");
+  }
+  checkRan(result);
+  return result;
+}
+
+void PathShapeFixture::endLog()
+{
+  log_ = logger_.redirectStringEnd();
+  if (std::getenv("PATH_SHAPE_LOG") != nullptr) {
+    std::cout << log_;
+  }
+}
+
+void PathShapeFixture::checkRan(const PlaceResult& result)
+{
+  if (result.stop == PlaceStop::kNotRun
+      || result.stop == PlaceStop::kDiverged) {
+    constructionFailure("placement did not run to an end");
+  }
+}
