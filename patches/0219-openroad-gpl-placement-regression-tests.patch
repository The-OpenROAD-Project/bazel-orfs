+class BroadcastTest : public PathShapeFixture,
+                      public testing::WithParamInterface<BroadcastCase>
+{
+};
+
+// Controls for the broadcast family: a path whose nets have no side loads,
+// or one, comes out straight from the flow's start, and 37 side loads do
+// not pull a path that starts straight off its line when Nesterov runs
+// alone from there.
+TEST_P(BroadcastTest, FewSideLoadsStayOnThePath)
+{
+  const BroadcastShape shape = placeBroadcast(GetParam());
+  // Measured 1.01 and 1.07; from the straight seed 1.09 and 1.04.
+  expectMetric("detour", shape.detour, Op::kLess, 1.1);
+  expectMetric("period_over_straight",
+               shape.period / shape.straight_period,
+               Op::kLess,
+               1.1);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Placement,
+    BroadcastTest,
+    testing::Values(BroadcastCase{0, false, Start::kFlow, false},
+                    BroadcastCase{1, false, Start::kFlow, false},
+                    BroadcastCase{0, false, Start::kFlow, true},
+                    BroadcastCase{1, false, Start::kFlow, true},
+                    BroadcastCase{37, false, Start::kNesterovFromSeed, false},
+                    BroadcastCase{37, false, Start::kNesterovFromSeed, true}),
+    broadcastParamName);
+
+// Side inputs from the far edges make the zigzag the HPWL optimum: plain
+// wirelength-driven placement finds a placement with no more HPWL on the
+// path's cells than the straight one. Only timing can say the path
+// matters, so these are not targets: a fix in timing-driven placement must
+// not change what plain wirelength placement does here.
+class ObjectiveTest : public BroadcastTest
+{
+};
+
+TEST_P(ObjectiveTest, ZigzagIsTheWirelengthOptimum)
+{
+  const BroadcastShape shape = placeBroadcast(GetParam());
+  expectMetric("hpwl_over_straight",
+               static_cast<double>(shape.hpwl) / shape.straight_hpwl,
+               Op::kAtMost,
+               1.0);
+}
+
+std::vector<BroadcastCase> objectiveCases()
+{
+  std::vector<BroadcastCase> cases;
+  for (const bool dense : {false, true}) {
+    for (const int m : {0, 4, 16, 37}) {
+      cases.push_back({m, true, Start::kFlow, dense});
+    }
+  }
+  return cases;
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         ObjectiveTest,
+                         testing::ValuesIn(objectiveCases()),
+                         broadcastParamName);
