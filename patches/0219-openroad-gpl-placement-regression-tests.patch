+         + " overflow=" + format(result.overflow);
+}
+
+void expectMetric(const std::string& name,
+                  const double value,
+                  const Op op,
+                  const double threshold)
+{
+  bool ok = false;
+  const char* symbol = "";
+  switch (op) {
+    case Op::kLess:
+      ok = value < threshold;
+      symbol = "<";
+      break;
+    case Op::kAtMost:
+      ok = value <= threshold;
+      symbol = "<=";
+      break;
+    case Op::kAtLeast:
+      ok = value >= threshold;
+      symbol = ">=";
+      break;
+    case Op::kEqual:
+      ok = value == threshold;
+      symbol = "==";
+      break;
+  }
+  std::cout << "METRIC " << currentTest() << " " << name << "=" << format(value)
+            << " " << symbol << " " << format(threshold)
+            << (ok ? " pass" : " FAIL") << "\n";
+  if (!ok) {
+    ADD_FAILURE() << "metric " << name << " = " << format(value)
+                  << ", the threshold is " << symbol << " "
+                  << format(threshold);
+  }
+}
+
+void constructionFailure(const std::string& what)
+{
+  std::cout << "CONSTRUCTION " << currentTest() << " " << what << "\n";
+  ADD_FAILURE() << "construction: " << what;
+}
