@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Timing paths through global placement, on synthetic designs whose good
+// shape is known: the designs, the metrics and the placement runs shared
+// by path_shape_test (invariants that hold today) and
+// path_shape_targets_test (targets that fail today).
+//
+// A path runs from a fixed launch register to a fixed capture register
+// through movable cells; at zero wire its logic fits the clock, so its
+// period is set by how far its pins wander from the straight line between
+// the registers. Two ways a placement lands in a stable but worse shape:
+//
+// - Order: the path runs through k tightly connected clusters. In path
+//   order the path is straight and the HPWL lowest; in another order each
+//   swap costs wire, and a placement that starts swapped can stay swapped.
+//
+// - Broadcast drivers: the path's cells drive nets whose other loads are
+//   anchored far from the path. HPWL counts a net once, whichever of its
+//   loads is critical, so the path can zigzag between its side loads.
+//
+// Designs come in two densities. Sparse: the path and its clusters alone,
+// a few percent of the core. Dense: the same plus a sea of other logic, a
+// lattice anchored on all four die edges that covers the core.
+//
+// PATH_SHAPE_LOG=1 in the environment prints gpl's log of every run.
+
+#pragma once
+
+#include <cstdint>
+#include <ostream>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+#include "gpl/Replace.h"
+#include "gpl_design_builder.h"
+#include "odb/db.h"
+#include "odb/dbTypes.h"
+#include "odb/geom.h"
+#include "tst/fixture.h"
+
+namespace gpl::path_shape {
+
+using Edge = DesignBuilder::Edge;
+
+// Cells are 4 sites wide; the registers sit in row kLineRow of rows 0 to 9.
+inline constexpr int kCellWidth = 4 * DesignBuilder::kSiteWidth;
+inline constexpr int kRowHeight = DesignBuilder::kRowHeight;
+inline constexpr int kLineRow = 4;
+// The sea: kSeaCols x kSeaRows cells, 40% of the core.
+inline constexpr int kSeaCols = 10;
+inline constexpr int kSeaRows = 10;
+
+// Period proxy: a fixed delay per stage plus wire at a buffered wire's
+// rate. Only ratios to a known placement's proxy are checked, so the
+// constants only set how much of the period is wire on a straight path,
+// here about half.
+inline constexpr double kStagePs = 20.0;
+inline constexpr double kWirePsPerUm = 10.0;
+
+// Two orders whose weighted wirelengths differ by less than this, as a
+// fraction of the lower, are a tie that no test may depend on.
+inline constexpr double kOrderTieMargin = 0.05;
+
+odb::Point pinAt(odb::dbInst* inst, const char* pin);
+int64_t manhattan(const odb::Point& a, const odb::Point& b);
+
+// A timing path: launch register, cells in path order, capture register.
+// Each cell takes the path in on W and drives it on E.
+struct Path
+{
+  odb::dbInst* launch = nullptr;
+  std::vector<odb::dbInst*> cells;
+  odb::dbInst* capture = nullptr;
+
+  // The pins the signal visits, in order: launch E, W and E of each cell,
+  // capture W. Pins 2i and 2i+1 are the ends of the path's i-th net.
+  std::vector<odb::Point> pins() const;
+  // Wire on the path's nets, each from its driver to the path's sink.
+  int64_t netWire() const;
+  // Wire along the path, pin to pin, over the Manhattan distance between
+  // the registers' pins. 1.0 is straight.
+  double detour() const;
+  // kStagePs per stage (the cells and the launch register) plus
+  // kWirePsPerUm of netWire().
+  double periodPs() const;
+  std::unordered_set<odb::dbNet*> nets() const;
+};
+
+// HPWL of the nets on a path's cells: the part of the objective the path's
+// placement changes, so that a placement can be compared with one placed
+// by hand when the rest of the design differs.
+int64_t pathCellHpwl(const Path& path);
+
+int lineY(const DesignBuilder& builder);
+void putAt(odb::dbInst* inst, int x, int y);
+odb::dbInst* addFixed(DesignBuilder& builder,
+                      const std::string& name,
+                      int x,
+                      int y);
+// The registers: fixed, in the line row at the core's left and right edges.
+void addRegisters(DesignBuilder& builder, Path& path);
+// Moves a path's cells onto the straight line between its registers,
+// evenly spaced: the shape the tests compare against.
+void placeStraight(const DesignBuilder& builder, const Path& path);
+
+// A cols x rows lattice of cells joined to their four neighbors (E to W, N
+// to S). grid[i][j] is column i, row j.
+using Grid = std::vector<std::vector<odb::dbInst*>>;
+Grid makeGrid(DesignBuilder& builder,
+              int cols,
+              int rows,
+              const std::string& prefix);
+std::vector<odb::dbInst*> flatten(const Grid& grid);
+
+// Other logic: a lattice whose boundary cells are tied to IO pins at
+// matching places on all four die edges, so that placed it covers the core
+// and the path's cells have to push it aside.
+Grid addSea(DesignBuilder& builder);
+// The sea spread over the core in its lattice shape, one lattice row per
+// core row.
+void seedSea(const DesignBuilder& builder, const Grid& sea);
+
+// A plain chain of `length` cells between the registers, no side nets.
+Path makeAnchoredChain(DesignBuilder& builder, int length);
+
+// A path through k clusters, each a side x side lattice. The path enters a
+// cluster at the west end of its middle row, follows the row and leaves at
+// the east end; one net joins each cluster to the next.
+struct ClusterPath
+{
+  Path path;
+  int side = 0;
+  // Cluster c in path order.
+  std::vector<Grid> grid;
+};
+ClusterPath makeClusterPath(DesignBuilder& builder, int k, int side);
+
+enum class Seed
+{
+  // Each cluster laid out as its lattice, centered on its slot.
+  kCompact,
+  // Each cluster's cells stacked on its slot's center, as an initial
+  // placement collapses them.
+  kPile,
+};
+
+// Puts cluster c at slots[c] of k slots evenly spaced across the core.
+void seedClusters(const DesignBuilder& builder,
+                  const ClusterPath& cp,
+                  const std::vector<int>& slots,
+                  Seed seed);
+// The clusters in the order their centroids sit along x, as indices in
+// path order. {0, 1, ..., k-1} is the straight order.
+std::vector<int> clusterOrder(const ClusterPath& cp);
+// Pairs out of path order: 0 straight, k(k-1)/2 reversed.
+int inversions(const std::vector<int>& order);
+std::string str(const std::vector<int>& v);
+
+// A path of `length` cells whose every net also drives side_loads fixed
+// pins far from the path: IO pins on the die's top edge for even nets and
+// its bottom edge for odd ones, 100 DBU apart around the x where the net
+// sits on the straight path. Loads anchored elsewhere, as the broadcast
+// drivers on a large design's failing paths have (median 37). With
+// side_inputs, each path cell's S input is also driven from an IO pin on
+// the edge its own side loads are on: a non-critical side input, which
+// makes the zigzag the strict HPWL optimum.
+Path makeBroadcastPath(DesignBuilder& builder,
+                       int length,
+                       int side_loads,
+                       bool side_inputs);
+
+// s side nets on each of two clusters pulling it to the far side: from
+// cluster 0's edge cells to an IO pin on the right die edge, from cluster
+// 1's to one on the left. Swapping the clusters shortens 2s side nets and
+// lengthens the path's nets by the same distance: for clusters that were
+// points, with the path's nets at weight w the straight order would be the
+// weighted wirelength optimum iff s < w. These are 2,400 DBU wide and the
+// path enters one 2,300 DBU before it leaves it, so the rule has a margin
+// that depends on how far apart they are; clusterOrderCosts has the
+// answer.
+void addCrossSideNets(DesignBuilder& builder, const ClusterPath& cp, int s);
+
+// The weighted wirelength of the best legal placement of the two clusters
+// of a ClusterPath, with cluster 0 left of cluster 1 (the straight order)
+// and with it right of it (swapped): the path's nets at `weight`, every
+// other net at 1. Each cluster stays the lattice it is, on the site grid,
+// inside the core and off the registers and the other cluster, and every
+// such pair of places is tried. Which order is cheaper is what the
+// weighted wirelength optimum is; it does not follow from s and w alone,
+// because the clusters are wide: s < w is the rule for points. The sea is
+// left out, it is movable and no net joins it to the clusters. The cells
+// are put back where they were.
+struct OrderCosts
+{
+  double straight = 0;
+  double swapped = 0;
+};
+OrderCosts clusterOrderCosts(const DesignBuilder& builder,
+                             const ClusterPath& cp,
+                             double weight);
+
+// How a run starts.
+enum class Start
+{
+  // As the flow places a netlist: the cells unplaced, initial placement,
+  // then Nesterov placement.
+  kFlow,
+  // From the cells' current places, Nesterov placement only, as
+  // global_placement -skip_initial_place does.
+  kNesterovFromSeed,
+  // From the cells' current places, initial placement first.
+  kFullFromSeed,
+};
+
+std::string startName(Start start);
+std::string seedName(Seed seed);
+std::string densityName(bool dense);
+std::string runInfo(const PlaceResult& result);
+// The running gtest test as gtest prints it: <suite>.<test>.
+std::string currentTest();
+
+// How a metric is compared with its threshold.
+enum class Op
+{
+  kLess,
+  kAtMost,
+  kAtLeast,
+  kEqual,
+};
+
+// Checks one metric against its threshold, as a gtest expectation, and
+// prints it on one line whether it passes or not:
+//
+//   METRIC <suite>.<test> <name>=<value> <op> <threshold> pass|FAIL
+//
+// so that every run records what each case measured and what it had to
+// reach, and every failure names its metric.
+void expectMetric(const std::string& name,
+                  double value,
+                  Op op,
+                  double threshold);
+
+// A failure of the test's own construction, not of placement: a reference
+// shape that is not what it should be, a placement that did not run, a
+// weight that reached no net. Printed as "CONSTRUCTION ..." so that a
+// target can be told apart from a broken test.
+void constructionFailure(const std::string& what);
+
+struct CellState
+{
+  odb::dbInst* inst;
+  odb::Point location;
+  odb::dbPlacementStatus status;
+
+  bool operator==(const CellState& other) const = default;
+};
+
+// The k-cluster family: k clusters started in each of their k! orders.
+struct FamilyCase
+{
+  int k;
+  Start start;
+  Seed seed;
+  bool dense;
+};
+std::string familyName(const FamilyCase& c);
+
+struct BroadcastCase
+{
+  int side_loads;
+  bool side_inputs;
+  Start start;
+  bool dense;
+};
+std::string broadcastName(const BroadcastCase& c);
+
+struct WeightCase
+{
+  float weight;
+  bool dense;
+};
+std::string weightName(const WeightCase& c);
+
+struct SideNetCase
+{
+  int s;
+  float weight;
+  bool dense;
+};
+std::string sideNetName(const SideNetCase& c);
+
+// gtest prints a case by its test name suffix with these, not as bytes.
+void PrintTo(const FamilyCase& c, std::ostream* os);
+void PrintTo(const BroadcastCase& c, std::ostream* os);
+void PrintTo(const WeightCase& c, std::ostream* os);
+void PrintTo(const SideNetCase& c, std::ostream* os);
+
+// The broadcast path placed, against the straight placement of the same
+// design.
+struct BroadcastShape
+{
+  double detour = 0;
+  double period = 0;
+  double straight_period = 0;
+  int64_t hpwl = 0;
+  int64_t straight_hpwl = 0;
+};
+
+class PathShapeFixture : public tst::Fixture
+{
+ protected:
+  // Global placement as global_placement runs it.
+  PlaceResult place(const PlaceOptions& options, int threads = 1);
+
+  // Global placement as Replace::doPlace runs it, with the given nets'
+  // timing weight set before the Nesterov loop starts and kept throughout:
+  // what timing-driven placement would do if it weighted the path's nets
+  // from the start. Initial placement does not see the weights, as it does
+  // not in timing-driven placement either. A weight that reaches no net,
+  // or not all of them, is a construction failure.
+  PlaceResult placeWeighted(const PlaceOptions& options,
+                            const std::unordered_set<odb::dbNet*>& nets,
+                            float weight);
+
+  static PlaceOptions optionsFor(Start start);
+  static void unplace(const std::vector<odb::dbInst*>& cells);
+  std::vector<CellState> cells() const;
+  static void restore(const std::vector<CellState>& saved);
+  int64_t hpwl() const;
+
+  // Places the k clusters from every one of their k! orders and checks
+  // that at least 90% of the starts end in the straight order and that
+  // none ends with more pairs out of order than it started with.
+  void untangle(const FamilyCase& param);
+
+  // Builds the broadcast path of 6 cells, measures its straight placement,
+  // then places it from the case's start.
+  BroadcastShape placeBroadcast(const BroadcastCase& param);
+
+  // Two clusters with s side nets each pulling the wrong way, the path's
+  // nets at weight w, from the flow's start: checks that the clusters end
+  // in the order clusterOrderCosts says has the lower weighted wirelength.
+  // A case whose two orders are within kOrderTieMargin of each other is a
+  // construction failure: it would pass or fail on the length of the
+  // Nesterov run, not on the objective.
+  void checkSideNetOrder(const SideNetCase& param);
+
+ private:
+  void endLog();
+  static void checkRan(const PlaceResult& result);
+
+  std::string log_;
+};
+
+}  // namespace gpl::path_shape
diff --git a/src/gpl/test/path_shape_targets_test.cpp b/src/gpl/test/path_shape_targets_test.cpp
new file mode 100644
index 0000000000..5041c7f645
--- /dev/null
+++ b/src/gpl/test/path_shape_targets_test.cpp
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Targets for global placement on timing paths whose good shape is known
+// (path_shape.h): what a robust placer must do and gpl does not do today.
+// Every test here fails today, on its own threshold, and its cc_test is
+// tagged manual so that it does not fail `bazel test //...`. A change that
+// makes one pass moves it to path_shape_test.cpp, where it becomes an
+// invariant.
+//
+// Every check prints a "METRIC <test> <name>=<value> <op> <threshold>
+// pass|FAIL" line, and every placement a "SHAPE <test> ..." line with its
+// numbers, the iteration gpl stopped at among them.
+//
+// Most of these fail for one reason: Nesterov placement stops as soon as
+// the overflow is at or under its target, with no minimum number of
+// iterations, and on these designs the initial placement's result, or a
+// legal seed, is already under the target. The shape is then whatever
+// initial placement (which sees no density and no timing) or the seed left.
+
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "gpl/Replace.h"
+#include "gpl_design_builder.h"
+#include "gtest/gtest.h"
+#include "path_shape.h"
+
+namespace gpl::path_shape {
+namespace {
+
+class PathShapeTargetTest : public PathShapeFixture
+{
+};
+
+// Nesterov placement alone from a pile of 8 cells at the core's center,
+// with nothing else in the core: the pile is under the overflow target on
+// gpl's bin grid, so placement stops at iteration 0 with every cell still
+// in the pile. The smallest case of "Nesterov stops before wirelength is
+// optimized". TARGET: the chain placed straight, as initial placement
+// places it.
+TEST_F(PathShapeTargetTest, PileUnderTheTargetIsStillPlaced)
+{
+  DesignBuilder builder(db_.get());
+  const Path path = makeAnchoredChain(builder, 8);
+  PlaceOptions options;
+  options.initialPlaceMaxIter = 0;
+  const PlaceResult result = place(options);
+  std::cout << "SHAPE " << currentTest() << " detour=" << path.detour()
+            << runInfo(result) << "\n";
+  // Measured 1.50 at iteration 0.
+  expectMetric("detour", path.detour(), Op::kLess, 1.1);
+}
+
+class StuckFamilyTest : public PathShapeFixture,
+                        public testing::WithParamInterface<FamilyCase>
+{
+};
+
+// The k-cluster family, k = 2 to 5, with Nesterov placement only (as
+// global_placement -skip_initial_place) from every one of the k! orders,
+// compact or piled; sparse, and dense with two or three clusters. These
+// starts are under the overflow target, so Nesterov stops at once and
+// every order stays as it started; from the dense starts with four and
+// five clusters, which are over the target, Nesterov runs and untangles
+// every order (path_shape_test). TARGET: at least 90% of the starts end in
+// path order, none ends with more pairs out of order than it started with.
+TEST_P(StuckFamilyTest, NesterovUntanglesAnyOrder)
+{
+  untangle(GetParam());
+}
+
+std::vector<FamilyCase> stuckCases()
+{
+  std::vector<FamilyCase> cases;
+  for (const Seed seed : {Seed::kCompact, Seed::kPile}) {
+    for (int k = 2; k <= 5; ++k) {
+      cases.push_back({k, Start::kNesterovFromSeed, seed, false});
+    }
+    for (int k = 2; k <= 3; ++k) {
+      cases.push_back({k, Start::kNesterovFromSeed, seed, true});
+    }
+  }
+  return cases;
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         StuckFamilyTest,
+                         testing::ValuesIn(stuckCases()),
+                         [](const testing::TestParamInfo<FamilyCase>& info) {
+                           return familyName(info.param);
+                         });
+
+class BroadcastSearchTest : public PathShapeFixture,
+                            public testing::WithParamInterface<BroadcastCase>
+{
+};
+
+// Broadcast drivers with 4, 16 or 37 side loads on alternating die edges
+// and no side inputs. The straight placement has less HPWL on the path's
+// cells than what gpl finds, so this is a search failure in gpl's own
+// objective, not a mismatch of objectives: initial placement leaves the
+// path's cells between their side loads and Nesterov never runs. TARGET:
+// the path within 1.3 of straight, its period within 10% of the straight
+// placement's, and no more HPWL on the path's cells than the straight
+// placement.
+TEST_P(BroadcastSearchTest, BroadcastDriversStayOnThePath)
+{
+  const BroadcastShape shape = placeBroadcast(GetParam());
+  expectMetric("detour", shape.detour, Op::kLess, 1.3);
+  expectMetric("period_over_straight",
+               shape.period / shape.straight_period,
+               Op::kLess,
+               1.1);
+  expectMetric("hpwl_over_straight",
+               static_cast<double>(shape.hpwl) / shape.straight_hpwl,
+               Op::kAtMost,
+               1.0);
+}
+
+std::vector<BroadcastCase> broadcastSearchCases()
+{
+  std::vector<BroadcastCase> cases;
+  for (const bool dense : {false, true}) {
+    for (const int m : {4, 16, 37}) {
+      cases.push_back({m, false, Start::kFlow, dense});
+    }
+    cases.push_back({37, false, Start::kFullFromSeed, dense});
+  }
+  return cases;
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         BroadcastSearchTest,
+                         testing::ValuesIn(broadcastSearchCases()),
+                         [](const testing::TestParamInfo<BroadcastCase>& info) {
+                           return broadcastName(info.param);
+                         });
+
+// Net weights. Timing-driven placement weights the nets of critical paths
+// from STA's slacks. These tests set a timing weight on the path's nets
+// directly (placeWeighted), so they need no liberty and no STA: given the
+// weights timing-driven placement would compute, does placement use them?
+
+std::string weightParamName(const testing::TestParamInfo<WeightCase>& info)
+{
+  return weightName(info.param);
+}
+
+class BroadcastWeightTest : public PathShapeFixture,
+                            public testing::WithParamInterface<WeightCase>
+{
+};
+
+// The broadcast path with 37 side loads and side inputs, from the flow's
+// start, its nets weighted 5 (timing-driven placement's default maximum),
+// 20 or 100. Unweighted it reads 1.67, and that zigzag is the HPWL
+// optimum (path_shape_test's ObjectiveTest). TARGET: within 1.3 of
+// straight. A net weight scales the side loads on the path's nets as much
+// as the path's next cell, so this likely needs a weight per connection,
+// not per net.
+TEST_P(BroadcastWeightTest, WeightedPathStraightens)
+{
+  DesignBuilder builder(db_.get());
+  const Path path = makeBroadcastPath(builder, 6, 37, true);
+  if (GetParam().dense) {
+    addSea(builder);
+  }
+  const PlaceResult result
+      = placeWeighted(PlaceOptions{}, path.nets(), GetParam().weight);
+  std::cout << "SHAPE " << currentTest() << " detour=" << path.detour()
+            << " hpwl=" << hpwl() << runInfo(result) << "\n";
+  // Measured 1.31 (weight 5) to 1.34 (weight 100).
+  expectMetric("detour", path.detour(), Op::kLess, 1.3);
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         BroadcastWeightTest,
+                         testing::Values(WeightCase{5, false},
+                                         WeightCase{20, false},
+                                         WeightCase{100, false},
+                                         WeightCase{5, true},
+                                         WeightCase{20, true},
+                                         WeightCase{100, true}),
+                         weightParamName);
+
+class ClusterWeightTest : public PathShapeFixture,
+                          public testing::WithParamInterface<WeightCase>
+{
+};
+
+// Two clusters started swapped, Nesterov only, the path's nets weighted 5,
+// 20 or 100: the weighted wirelength wants them swapped back. Nesterov
+// stops at iteration 0 and the weights never act. TARGET: path order.
+TEST_P(ClusterWeightTest, WeightedPathUntangles)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, 2, 3);
+  if (GetParam().dense) {
+    seedSea(builder, addSea(builder));
+  }
+  seedClusters(builder, cp, {1, 0}, Seed::kCompact);
+  if (inversions(clusterOrder(cp)) != 1) {
+    constructionFailure("the seed is not swapped");
+  }
+  PlaceOptions options;
+  options.initialPlaceMaxIter = 0;
+  const PlaceResult result
+      = placeWeighted(options, cp.path.nets(), GetParam().weight);
+  std::cout << "SHAPE " << currentTest() << " order=" << str(clusterOrder(cp))
+            << " detour=" << cp.path.detour() << " hpwl=" << hpwl()
+            << runInfo(result) << "\n";
+  expectMetric("inversions", inversions(clusterOrder(cp)), Op::kEqual, 0);
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         ClusterWeightTest,
+                         testing::Values(WeightCase{5, false},
+                                         WeightCase{20, false},
+                                         WeightCase{100, false},
+                                         WeightCase{5, true},
+                                         WeightCase{20, true},
+                                         WeightCase{100, true}),
+                         weightParamName);
+
+class WeightedSideNetTest : public PathShapeFixture,
+                            public testing::WithParamInterface<SideNetCase>
+{
+};
+
+// Two clusters with s side nets each pulling the wrong way, the path's
+// nets at weight w, from the flow's start: the order is the weighted
+// wirelength optimum, which the test computes (clusterOrderCosts). In every
+// case here that is the path order, and gpl leaves the clusters swapped:
+// initial placement puts them in the unweighted order without the weights,
+// and Nesterov stops at once. TARGET: the cheaper order. S6W5 is here
+// because straight is cheaper by 6.8 %, not swapped as the rule s < w for
+// points says: the clusters are wide. s = 2 at w = 5 on the sparse design
+// already holds and is in path_shape_test.
+TEST_P(WeightedSideNetTest, OrderFollowsTheWeightedOptimum)
+{
+  checkSideNetOrder(GetParam());
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         WeightedSideNetTest,
+                         testing::Values(SideNetCase{4, 5, false},
+                                         SideNetCase{6, 5, false},
+                                         SideNetCase{4, 20, false},
+                                         SideNetCase{6, 20, false},
+                                         SideNetCase{6, 100, false},
+                                         SideNetCase{2, 5, true},
+                                         SideNetCase{4, 5, true},
+                                         SideNetCase{6, 5, true},
+                                         SideNetCase{4, 20, true},
+                                         SideNetCase{6, 20, true},
+                                         SideNetCase{6, 100, true}),
+                         [](const testing::TestParamInfo<SideNetCase>& info) {
+                           return sideNetName(info.param);
+                         });
+
+}  // namespace
+}  // namespace gpl::path_shape
diff --git a/src/gpl/test/path_shape_test.cpp b/src/gpl/test/path_shape_test.cpp
new file mode 100644
index 0000000000..d2fa10c1c9
--- /dev/null
+++ b/src/gpl/test/path_shape_test.cpp
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Invariants of global placement on timing paths whose good shape is
+// known (path_shape.h): what gpl gets right today and must keep getting
+// right after any change that makes it more robust. The targets it does
+// not reach yet are in path_shape_targets_test.cpp.
+//
+// Every check prints a "METRIC <test> <name>=<value> <op> <threshold>"
+// line, and every placement a "SHAPE <test> ..." line with its numbers.
+
+#include "path_shape.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <iostream>
+#include <ostream>
+#include <string>
+#include <vector>
+
+#include "gpl/Replace.h"
+#include "gpl_design_builder.h"
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "odb/geom.h"
+
+namespace gpl::path_shape {
+namespace {
+
+class PathShapeTest : public PathShapeFixture
+{
+};
+
+class StraightPathTest : public PathShapeFixture,
+                         public testing::WithParamInterface<bool>
+{
+};
+
+// The negative control: a path with no side nets has nothing pulling it
+// off the line between its registers. Placed as the flow places it, it
+// comes out straight, and the metric reads it as straight.
+TEST_P(StraightPathTest, NoSideNetsReadsStraight)
+{
+  DesignBuilder builder(db_.get());
+  const Path path = makeAnchoredChain(builder, 8);
+  if (GetParam()) {
+    addSea(builder);
+  }
+  const PlaceResult result = place(PlaceOptions{});
+  const double detour = path.detour();
+  const double period = path.periodPs();
+  placeStraight(builder, path);
+  std::cout << "SHAPE " << currentTest() << " detour=" << detour
+            << " period=" << period << " straight_period=" << path.periodPs()
+            << runInfo(result) << "\n";
+  // Measured 1.015 in both.
+  expectMetric("detour", detour, Op::kLess, 1.1);
+  expectMetric(
+      "period_over_straight", period / path.periodPs(), Op::kLess, 1.1);
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         StraightPathTest,
+                         testing::Bool(),
+                         [](const testing::TestParamInfo<bool>& info) {
+                           return densityName(info.param);
+                         });
+
+struct DeterminismCase
+{
+  int k;
+  bool dense;
+};
+
+void PrintTo(const DeterminismCase& c, std::ostream* os)
+{
+  *os << "K" << c.k << densityName(c.dense);
+}
+
+class DeterminismTest : public PathShapeFixture,
+                        public testing::WithParamInterface<DeterminismCase>
+{
+ protected:
+  static int changed(const std::vector<CellState>& a,
+                     const std::vector<CellState>& b)
+  {
+    int count = 0;
+    for (std::size_t i = 0; i < a.size(); ++i) {
+      count += !(a[i] == b[i]);
+    }
+    return count;
+  }
+};
+
+// Same input, same placement: run to run, and with 8 threads against 1.
+// The dense design with five clusters is one where Nesterov placement runs
+// (about 230 iterations), the sparse one with three one where it does not.
+TEST_P(DeterminismTest, ClusterPathIsDeterministic)
+{
+  DesignBuilder builder(db_.get());
+  makeClusterPath(builder, GetParam().k, 3);
+  if (GetParam().dense) {
+    addSea(builder);
+  }
+  const std::vector<CellState> input = cells();
+
+  const PlaceResult result = place(PlaceOptions{});
+  std::cout << "SHAPE " << currentTest() << runInfo(result) << "\n";
+  const std::vector<CellState> first = cells();
+  restore(input);
+  place(PlaceOptions{});
+  expectMetric(
+      "cells_differing_run_to_run", changed(cells(), first), Op::kEqual, 0);
+  restore(input);
+  place(PlaceOptions{}, 8);
+  expectMetric(
+      "cells_differing_8_threads_vs_1", changed(cells(), first), Op::kEqual, 0);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Placement,
+    DeterminismTest,
+    testing::Values(DeterminismCase{3, false}, DeterminismCase{5, true}),
+    [](const testing::TestParamInfo<DeterminismCase>& info) {
+      return "K" + std::to_string(info.param.k) + densityName(info.param.dense);
+    });
+
+// A chain between registers in opposite corners: wirelength is convex
+// here, and its minimum is a monotone staircase whose HPWL is the
+// registers' Manhattan distance less the cells' own pin spans.
+TEST_F(PathShapeTest, DiagonalChainReachesTheConvexOptimum)
+{
+  DesignBuilder builder(db_.get());
+  Path path;
+  const odb::Rect core = builder.core();
+  path.launch = addFixed(builder, "launch", core.xMin(), core.yMin());
+  path.capture = addFixed(
+      builder, "capture", core.xMax() - kCellWidth, core.yMax() - kRowHeight);
+  constexpr int kLength = 8;
+  std::string net = "path0";
+  builder.connect(path.launch, "E", net);
+  for (int i = 0; i < kLength; ++i) {
+    odb::dbInst* cell = builder.addCell("p" + std::to_string(i));
+    builder.connect(cell, "W", net);
+    net = "path" + std::to_string(i + 1);
+    builder.connect(cell, "E", net);
+    path.cells.push_back(cell);
+  }
+  builder.connect(path.capture, "W", net);
+
+  const PlaceResult result = place(PlaceOptions{});
+  const int64_t span
+      = pinAt(path.cells[0], "E").x() - pinAt(path.cells[0], "W").x();
+  const int64_t optimum
+      = manhattan(pinAt(path.launch, "E"), pinAt(path.capture, "W"))
+        - kLength * span;
+  std::cout << "SHAPE " << currentTest() << " hpwl=" << hpwl()
+            << " optimum=" << optimum << " detour=" << path.detour()
+            << runInfo(result) << "\n";
+  // Measured exactly the optimum.
+  expectMetric("hpwl_over_optimum",
+               static_cast<double>(hpwl()) / optimum,
+               Op::kLess,
+               1.05);
+  expectMetric("detour", path.detour(), Op::kLess, 1.1);
+}
+
+struct StartCase
+{
+  Start start;
+  bool dense;
+};
+
+void PrintTo(const StartCase& c, std::ostream* os)
+{
+  *os << startName(c.start) << densityName(c.dense);
+}
+
+class GoodStartTest : public PathShapeFixture,
+                      public testing::WithParamInterface<StartCase>
+{
+};
+
+// A placement that is already good, given as the start, is not destroyed:
+// the clusters stay in path order and the path stays about as straight.
+// A change that makes gpl move more must still keep it.
+TEST_P(GoodStartTest, StraightOrderIsKept)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, 3, 3);
+  if (GetParam().dense) {
+    seedSea(builder, addSea(builder));
+  }
+  seedClusters(builder, cp, {0, 1, 2}, Seed::kCompact);
+  const double seed_period = cp.path.periodPs();
+  const int64_t seed_hpwl = hpwl();
+
+  const PlaceResult result = place(optionsFor(GetParam().start));
+  std::cout << "SHAPE " << currentTest() << " order=" << str(clusterOrder(cp))
+            << " detour=" << cp.path.detour() << " hpwl=" << hpwl()
+            << " seed_hpwl=" << seed_hpwl << " period=" << cp.path.periodPs()
+            << " seed_period=" << seed_period << runInfo(result) << "\n";
+  // Measured detour 1.03 to 1.05, period 1.02 to 1.03 times the seed's.
+  expectMetric("inversions", inversions(clusterOrder(cp)), Op::kEqual, 0);
+  expectMetric("detour", cp.path.detour(), Op::kLess, 1.1);
+  expectMetric(
+      "period_over_seed", cp.path.periodPs() / seed_period, Op::kLess, 1.1);
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Placement,
+    GoodStartTest,
+    testing::Values(StartCase{Start::kNesterovFromSeed, false},
+                    StartCase{Start::kFullFromSeed, false},
+                    StartCase{Start::kNesterovFromSeed, true},
+                    StartCase{Start::kFullFromSeed, true}),
+    [](const testing::TestParamInfo<StartCase>& info) {
+      return startName(info.param.start) + densityName(info.param.dense);
+    });
+
+struct CountCase
+{
+  int k;
+  bool dense;
+};
+
+void PrintTo(const CountCase& c, std::ostream* os)
+{
+  *os << "K" << c.k << densityName(c.dense);
+}
+
+class ClusterCountTest : public PathShapeFixture,
+                         public testing::WithParamInterface<CountCase>
+{
+};
+
+// Placed as the flow places a netlist, the clusters come out in path
+// order: initial placement solves for wirelength alone, where the order
+// follows the path, before density pushes back.
+TEST_P(ClusterCountTest, FlowFindsTheStraightOrder)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, GetParam().k, 3);
+  if (GetParam().dense) {
+    addSea(builder);
+  }
+  const PlaceResult result = place(PlaceOptions{});
+  std::cout << "SHAPE " << currentTest() << " order=" << str(clusterOrder(cp))
+            << " detour=" << cp.path.detour() << " hpwl=" << hpwl()
+            << runInfo(result) << "\n";
+  // Measured detour 1.02 to 1.06.
+  expectMetric("inversions", inversions(clusterOrder(cp)), Op::kEqual, 0);
+  expectMetric("detour", cp.path.detour(), Op::kLess, 1.3);
+}
