+PlaceOptions PathShapeFixture::optionsFor(const Start start)
+{
+  PlaceOptions options;
+  if (start == Start::kNesterovFromSeed) {
+    options.initialPlaceMaxIter = 0;
+  }
+  return options;
+}
+
+void PathShapeFixture::unplace(const std::vector<odb::dbInst*>& cells)
+{
+  for (odb::dbInst* inst : cells) {
+    inst->setPlacementStatus(odb::dbPlacementStatus::NONE);
+  }
+}
+
+std::vector<CellState> PathShapeFixture::cells() const
+{
+  std::vector<CellState> result;
+  for (odb::dbInst* inst : db_->getChip()->getBlock()->getInsts()) {
+    result.push_back({inst, inst->getLocation(), inst->getPlacementStatus()});
+  }
+  return result;
+}
+
+void PathShapeFixture::restore(const std::vector<CellState>& saved)
+{
+  for (const CellState& cell : saved) {
+    cell.inst->setLocation(cell.location.x(), cell.location.y());
+    cell.inst->setPlacementStatus(cell.status);
+  }
+}
+
+int64_t PathShapeFixture::hpwl() const
+{
+  return odb::WireLengthEvaluator(db_->getChip()->getBlock()).hpwl();
+}
+
+void PathShapeFixture::untangle(const FamilyCase& param)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, param.k, 3);
+  if (param.dense) {
+    seedSea(builder, addSea(builder));
+  }
+  const std::vector<CellState> sea_and_registers = cells();
+  std::vector<int> slots(param.k);
+  std::iota(slots.begin(), slots.end(), 0);
+  int starts = 0;
+  int straight = 0;
+  int worse = 0;
+  int sum_inversions = 0;
+  int sum_start_inversions = 0;
+  int sum_iterations = 0;
+  double sum_detour = 0;
+  std::unordered_set<std::string> start_orders;
+  do {
+    restore(sea_and_registers);
+    seedClusters(builder, cp, slots, param.seed);
+    const std::vector<int> start_order = clusterOrder(cp);
+    start_orders.insert(str(start_order));
+    const int start_inversions = inversions(start_order);
+    const PlaceResult result = place(optionsFor(param.start));
+    const int end_inversions = inversions(clusterOrder(cp));
+    ++starts;
+    straight += end_inversions == 0;
+    worse += end_inversions > start_inversions;
+    sum_inversions += end_inversions;
+    sum_start_inversions += start_inversions;
+    sum_iterations += result.final_iteration;
+    sum_detour += cp.path.detour();
+  } while (std::ranges::next_permutation(slots).found);
+  // Every order is started from exactly once.
+  if (start_orders.size() != static_cast<std::size_t>(starts)) {
+    constructionFailure(std::to_string(starts) + " starts from "
+                        + std::to_string(start_orders.size()) + " orders");
+  }
+  std::cout << "SHAPE " << currentTest() << " starts=" << starts
+            << " straight=" << straight << " worse=" << worse
+            << " inversions=" << sum_start_inversions << "->" << sum_inversions
+            << " mean_detour=" << format(sum_detour / starts) << " mean_iter="
+            << format(static_cast<double>(sum_iterations) / starts) << "\n";
+  expectMetric("straight_fraction",
+               static_cast<double>(straight) / starts,
+               Op::kAtLeast,
+               0.9);
+  expectMetric("starts_ending_worse", worse, Op::kEqual, 0);
+}
+
+BroadcastShape PathShapeFixture::placeBroadcast(const BroadcastCase& param)
+{
+  DesignBuilder builder(db_.get());
+  const Path path
+      = makeBroadcastPath(builder, 6, param.side_loads, param.side_inputs);
+  Grid sea;
+  if (param.dense) {
+    sea = addSea(builder);
+    seedSea(builder, sea);
+  }
+  placeStraight(builder, path);
+  if (path.detour() > 1.01) {
+    constructionFailure("the straight placement reads detour "
+                        + format(path.detour()));
+  }
+  BroadcastShape shape;
+  shape.straight_hpwl = pathCellHpwl(path);
+  shape.straight_period = path.periodPs();
+  if (param.start == Start::kFlow) {
+    unplace(path.cells);
+    unplace(flatten(sea));
+  }
+  const PlaceResult result = place(optionsFor(param.start));
+  shape.detour = path.detour();
+  shape.period = path.periodPs();
+  shape.hpwl = pathCellHpwl(path);
+  std::cout << "SHAPE " << currentTest() << " detour=" << format(shape.detour)
+            << " hpwl=" << shape.hpwl
+            << " straight_hpwl=" << shape.straight_hpwl
+            << " period=" << format(shape.period)
+            << " straight_period=" << format(shape.straight_period)
+            << runInfo(result) << "\n";
+  return shape;
+}
+
+void PathShapeFixture::checkSideNetOrder(const SideNetCase& param)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, 2, 3);
+  addCrossSideNets(builder, cp, param.s);
+  if (param.dense) {
+    addSea(builder);
+  }
+  const OrderCosts costs = clusterOrderCosts(builder, cp, param.weight);
+  const double lower = std::min(costs.straight, costs.swapped);
+  const double gap = std::abs(costs.straight - costs.swapped) / lower;
+  if (!(gap > kOrderTieMargin)) {
+    constructionFailure("the orders' weighted wirelengths, "
+                        + format(costs.straight) + " straight and "
+                        + format(costs.swapped) + " swapped, are within "
+                        + format(kOrderTieMargin * 100) + " % of each other");
+  }
+  const PlaceResult result
+      = placeWeighted(PlaceOptions{}, cp.path.nets(), param.weight);
+  std::cout << "SHAPE " << currentTest() << " order=" << str(clusterOrder(cp))
+            << " detour=" << format(cp.path.detour()) << " hpwl=" << hpwl()
+            << " cost_straight=" << format(costs.straight)
+            << " cost_swapped=" << format(costs.swapped) << runInfo(result)
+            << "\n";
+  // The weighted wirelength optimum: the cheaper order.
+  expectMetric("inversions",
+               inversions(clusterOrder(cp)),
+               Op::kEqual,
+               costs.straight < costs.swapped ? 0 : 1);
+}
+
