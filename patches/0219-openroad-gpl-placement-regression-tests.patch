+namespace gpl::path_shape {
+
+odb::Point pinAt(odb::dbInst* inst, const char* pin)
+{
+  int x = 0;
+  int y = 0;
+  inst->findITerm(pin)->getAvgXY(&x, &y);
+  return {x, y};
+}
+
+int64_t manhattan(const odb::Point& a, const odb::Point& b)
+{
+  return std::abs(int64_t{a.x()} - b.x()) + std::abs(int64_t{a.y()} - b.y());
+}
+
+std::vector<odb::Point> Path::pins() const
+{
+  std::vector<odb::Point> points{pinAt(launch, "E")};
+  for (odb::dbInst* cell : cells) {
+    points.push_back(pinAt(cell, "W"));
+    points.push_back(pinAt(cell, "E"));
+  }
+  points.push_back(pinAt(capture, "W"));
+  return points;
+}
+
+int64_t Path::netWire() const
+{
+  const std::vector<odb::Point> p = pins();
+  int64_t wire = 0;
+  for (std::size_t i = 0; i + 1 < p.size(); i += 2) {
+    wire += manhattan(p[i], p[i + 1]);
+  }
+  return wire;
+}
+
+double Path::detour() const
+{
+  const std::vector<odb::Point> p = pins();
+  int64_t chain = 0;
+  for (std::size_t i = 0; i + 1 < p.size(); ++i) {
+    chain += manhattan(p[i], p[i + 1]);
+  }
+  return static_cast<double>(chain) / manhattan(p.front(), p.back());
+}
+
+double Path::periodPs() const
+{
+  return kStagePs * static_cast<double>(cells.size() + 1)
+         + kWirePsPerUm * static_cast<double>(netWire())
+               / DesignBuilder::kDbuPerMicron;
+}
+
+std::unordered_set<odb::dbNet*> Path::nets() const
+{
+  std::unordered_set<odb::dbNet*> result{launch->findITerm("E")->getNet()};
+  for (odb::dbInst* cell : cells) {
+    result.insert(cell->findITerm("E")->getNet());
+  }
+  return result;
+}
+
+int64_t pathCellHpwl(const Path& path)
+{
+  std::unordered_set<odb::dbNet*> nets;
+  for (odb::dbInst* cell : path.cells) {
+    for (odb::dbITerm* iterm : cell->getITerms()) {
+      if (iterm->getNet() != nullptr) {
+        nets.insert(iterm->getNet());
+      }
+    }
+  }
+  const odb::WireLengthEvaluator evaluator(path.cells[0]->getBlock());
+  int64_t total = 0;
+  for (odb::dbNet* net : nets) {
+    int64_t x = 0;
+    int64_t y = 0;
+    total += evaluator.hpwl(net, x, y);
+  }
+  return total;
+}
+
+int lineY(const DesignBuilder& builder)
+{
+  return builder.core().yMin() + kLineRow * kRowHeight;
+}
+
+void putAt(odb::dbInst* inst, const int x, const int y)
+{
+  inst->setLocation(x, y);
+  inst->setPlacementStatus(odb::dbPlacementStatus::PLACED);
+}
+
+odb::dbInst* addFixed(DesignBuilder& builder,
+                      const std::string& name,
+                      const int x,
+                      const int y)
+{
+  odb::dbInst* inst = builder.addCell(name);
+  inst->setLocation(x, y);
+  inst->setPlacementStatus(odb::dbPlacementStatus::FIRM);
+  return inst;
+}
+
+void addRegisters(DesignBuilder& builder, Path& path)
+{
+  const odb::Rect core = builder.core();
+  path.launch = addFixed(builder, "launch", core.xMin(), lineY(builder));
+  path.capture
+      = addFixed(builder, "capture", core.xMax() - kCellWidth, lineY(builder));
+}
+
+void placeStraight(const DesignBuilder& builder, const Path& path)
+{
+  const int x0 = path.launch->getLocation().x();
+  const int x1 = path.capture->getLocation().x();
+  const int n = path.cells.size();
+  for (int i = 0; i < n; ++i) {
+    putAt(path.cells[i], x0 + (i + 1) * (x1 - x0) / (n + 1), lineY(builder));
+  }
+}
+
+Grid makeGrid(DesignBuilder& builder,
+              const int cols,
+              const int rows,
+              const std::string& prefix)
+{
+  Grid cells(cols);
+  for (int i = 0; i < cols; ++i) {
+    for (int j = 0; j < rows; ++j) {
+      cells[i].push_back(builder.addCell(prefix + "_" + std::to_string(i) + "_"
+                                         + std::to_string(j)));
+    }
+  }
+  for (int i = 0; i < cols; ++i) {
+    for (int j = 0; j < rows; ++j) {
+      const std::string at
+          = prefix + "_" + std::to_string(i) + "_" + std::to_string(j);
+      if (i + 1 < cols) {
+        builder.connect(cells[i][j], "E", at + "_h");
+        builder.connect(cells[i + 1][j], "W", at + "_h");
+      }
+      if (j + 1 < rows) {
+        builder.connect(cells[i][j], "N", at + "_v");
+        builder.connect(cells[i][j + 1], "S", at + "_v");
+      }
+    }
+  }
+  return cells;
+}
+
+std::vector<odb::dbInst*> flatten(const Grid& grid)
+{
+  std::vector<odb::dbInst*> cells;
+  for (const auto& column : grid) {
+    cells.insert(cells.end(), column.begin(), column.end());
+  }
+  return cells;
+}
+
+Grid addSea(DesignBuilder& builder)
+{
+  Grid sea = makeGrid(builder, kSeaCols, kSeaRows, "sea");
+  for (int j = 0; j < kSeaRows; ++j) {
+    const double t = (j + 0.5) / kSeaRows;
+    const std::string at = std::to_string(j);
+    builder.connect(
+        sea[0][j], "W", builder.addIo("sea_w" + at, Edge::kLeft, t));
+    builder.connect(sea[kSeaCols - 1][j],
+                    "E",
+                    builder.addIo("sea_e" + at, Edge::kRight, t));
+  }
+  for (int i = 0; i < kSeaCols; ++i) {
+    const double t = (i + 0.5) / kSeaCols;
+    const std::string at = std::to_string(i);
+    builder.connect(
+        sea[i][0], "S", builder.addIo("sea_s" + at, Edge::kBottom, t));
+    builder.connect(
+        sea[i][kSeaRows - 1], "N", builder.addIo("sea_n" + at, Edge::kTop, t));
+  }
+  return sea;
+}
+
+void seedSea(const DesignBuilder& builder, const Grid& sea)
+{
+  const odb::Rect core = builder.core();
+  for (int i = 0; i < kSeaCols; ++i) {
+    for (int j = 0; j < kSeaRows; ++j) {
+      putAt(sea[i][j],
+            core.xMin() + i * core.dx() / kSeaCols,
+            core.yMin() + j * kRowHeight);
+    }
+  }
+}
+
+Path makeAnchoredChain(DesignBuilder& builder, const int length)
+{
+  Path path;
+  addRegisters(builder, path);
+  std::string net = "path0";
+  builder.connect(path.launch, "E", net);
+  for (int i = 0; i < length; ++i) {
+    odb::dbInst* cell = builder.addCell("p" + std::to_string(i));
+    builder.connect(cell, "W", net);
+    net = "path" + std::to_string(i + 1);
+    builder.connect(cell, "E", net);
+    path.cells.push_back(cell);
+  }
+  builder.connect(path.capture, "W", net);
+  return path;
+}
+
+ClusterPath makeClusterPath(DesignBuilder& builder, const int k, const int side)
+{
+  ClusterPath cp;
+  cp.side = side;
+  addRegisters(builder, cp.path);
+  const int mid = side / 2;
+  std::string net = "path_in";
+  builder.connect(cp.path.launch, "E", net);
+  for (int c = 0; c < k; ++c) {
+    const std::string prefix = "k" + std::to_string(c);
+    Grid cells = makeGrid(builder, side, side, prefix);
+    builder.connect(cells[0][mid], "W", net);
+    for (int i = 0; i < side; ++i) {
+      cp.path.cells.push_back(cells[i][mid]);
+    }
+    net = prefix + "_out";
+    builder.connect(cells[side - 1][mid], "E", net);
+    cp.grid.push_back(std::move(cells));
+  }
+  builder.connect(cp.path.capture, "W", net);
+  return cp;
+}
+
+void seedClusters(const DesignBuilder& builder,
+                  const ClusterPath& cp,
+                  const std::vector<int>& slots,
+                  const Seed seed)
+{
+  const odb::Rect core = builder.core();
+  const int k = cp.grid.size();
+  const int mid = cp.side / 2;
+  for (int c = 0; c < k; ++c) {
+    const int cx = core.xMin() + (slots[c] + 1) * core.dx() / (k + 1);
+    for (int i = 0; i < cp.side; ++i) {
+      for (int j = 0; j < cp.side; ++j) {
+        int x = cx - kCellWidth / 2;
+        int y = lineY(builder);
+        if (seed == Seed::kCompact) {
+          x = cx - cp.side * kCellWidth / 2 + i * kCellWidth;
+          y = lineY(builder) + (j - mid) * kRowHeight;
+        }
+        putAt(cp.grid[c][i][j], x, y);
+      }
+    }
+  }
+}
+
+std::vector<int> clusterOrder(const ClusterPath& cp)
+{
+  std::vector<double> cx;
+  for (const Grid& cluster : cp.grid) {
+    double sum = 0;
+    const std::vector<odb::dbInst*> cells = flatten(cluster);
+    for (odb::dbInst* inst : cells) {
+      sum += inst->getBBox()->getBox().xCenter();
+    }
+    cx.push_back(sum / cells.size());
+  }
+  std::vector<int> order(cx.size());
+  std::iota(order.begin(), order.end(), 0);
+  std::ranges::stable_sort(
+      order, [&](const int a, const int b) { return cx[a] < cx[b]; });
+  return order;
+}
+
+int inversions(const std::vector<int>& order)
+{
+  int count = 0;
+  for (std::size_t i = 0; i < order.size(); ++i) {
+    for (std::size_t j = i + 1; j < order.size(); ++j) {
+      count += order[i] > order[j];
+    }
+  }
+  return count;
+}
+
+std::string str(const std::vector<int>& v)
+{
+  std::string s;
+  for (const int x : v) {
+    s += std::to_string(x);
+  }
+  return s;
+}
+
+namespace {
+
+// An IO pin named name on the given net.
+void addIoOnNet(DesignBuilder& builder,
+                const std::string& name,
+                const Edge edge,
+                const double t,
+                const std::string& net)
+{
+  odb::dbBTerm* io = builder.addIo(name, edge, std::clamp(t, 0.0, 1.0));
+  odb::dbNet* own = io->getNet();
+  io->disconnect();
+  io->connect(builder.block()->findNet(net.c_str()));
+  odb::dbNet::destroy(own);
+}
+
+std::string format(const double value)
+{
+  std::ostringstream out;
+  if (std::abs(value) < 1e15 && value == std::floor(value)) {
+    out << static_cast<int64_t>(value);
+  } else {
+    out.precision(6);
+    out << value;
+  }
+  return out.str();
+}
+
+}  // namespace
+
+std::string currentTest()
+{
+  const testing::TestInfo* info
+      = testing::UnitTest::GetInstance()->current_test_info();
+  return std::string(info->test_suite_name()) + "." + info->name();
+}
+
+Path makeBroadcastPath(DesignBuilder& builder,
+                       const int length,
+                       const int side_loads,
+                       const bool side_inputs)
+{
+  Path path;
+  addRegisters(builder, path);
+  builder.connect(path.launch, "E", "path0");
+  for (int i = 0; i < length; ++i) {
+    path.cells.push_back(builder.addCell("p" + std::to_string(i)));
+  }
+  builder.connect(path.cells[0], "W", "path0");
+  for (int i = 0; i < length; ++i) {
+    const std::string net = "path" + std::to_string(i + 1);
+    builder.connect(path.cells[i], "E", net);
+    builder.connect(
+        i + 1 < length ? path.cells[i + 1] : path.capture, "W", net);
+    const Edge edge = i % 2 == 0 ? Edge::kTop : Edge::kBottom;
+    const double t = (i + 1.5) / (length + 1);
+    for (int s = 0; s < side_loads; ++s) {
+      const double offset
+          = (s - (side_loads - 1) / 2.0) * 100.0 / DesignBuilder::kCoreSize;
+      addIoOnNet(
+          builder, net + "_load" + std::to_string(s), edge, t + offset, net);
+    }
+    if (side_inputs) {
+      builder.connect(path.cells[i],
+                      "S",
+                      builder.addIo("side_in" + std::to_string(i), edge, t));
+    }
+  }
+  return path;
+}
+
+void addCrossSideNets(DesignBuilder& builder,
+                      const ClusterPath& cp,
+                      const int s)
+{
+  for (int c = 0; c < 2; ++c) {
+    const Edge edge = c == 0 ? Edge::kRight : Edge::kLeft;
+    for (int n = 0; n < s; ++n) {
+      const bool top = n >= cp.side;
+      odb::dbInst* cell = cp.grid[c][n % cp.side][top ? cp.side - 1 : 0];
+      builder.connect(
+          cell,
+          top ? "N" : "S",
+          builder.addIo(
+              "side" + std::to_string(c) + "_" + std::to_string(n), edge, 0.5));
+    }
+  }
+}
+
+OrderCosts clusterOrderCosts(const DesignBuilder& builder,
+                             const ClusterPath& cp,
+                             const double weight)
+{
+  if (cp.grid.size() != 2) {
+    constructionFailure("clusterOrderCosts takes two clusters");
+  }
+  const odb::Rect core = builder.core();
+  const int width = cp.side * kCellWidth;
+  const int height = cp.side * kRowHeight;
+  // The one net between the clusters is priced from its two pins' offsets
+  // to their cluster's lattice corner; every other net touches one cluster.
+  odb::dbInst* from_cell = cp.path.cells[cp.side - 1];
+  odb::dbInst* to_cell = cp.path.cells[cp.side];
+  odb::dbNet* between = from_cell->findITerm("E")->getNet();
+  const std::unordered_set<odb::dbNet*> weighted = cp.path.nets();
+  const auto netWeight
+      = [&](odb::dbNet* net) { return weighted.contains(net) ? weight : 1.0; };
+  const int mid = cp.side / 2;
+  const auto pinOffset
+      = [](odb::dbInst* cell, const char* pin, const int i, const int j) {
+          const odb::Point at = pinAt(cell, pin);
+          const odb::Point origin = cell->getLocation();
+          return odb::Point(at.x() - origin.x() + i * kCellWidth,
+                            at.y() - origin.y() + j * kRowHeight);
+        };
+  const odb::Point from_offset = pinOffset(from_cell, "E", cp.side - 1, mid);
+  const odb::Point to_offset = pinOffset(to_cell, "W", 0, mid);
+
+  std::vector<CellState> saved;
+  std::vector<std::unordered_set<odb::dbNet*>> nets(2);
+  for (int c = 0; c < 2; ++c) {
+    for (odb::dbInst* inst : flatten(cp.grid[c])) {
+      saved.push_back({inst, inst->getLocation(), inst->getPlacementStatus()});
+      for (odb::dbITerm* iterm : inst->getITerms()) {
+        if (iterm->getNet() != nullptr && iterm->getNet() != between) {
+          nets[c].insert(iterm->getNet());
+        }
+      }
+    }
+  }
+
+  // The places a cluster can take: its lower left corner.
+  std::vector<odb::Point> spots;
+  for (int y = core.yMin(); y + height <= core.yMax(); y += kRowHeight) {
+    for (int x = core.xMin(); x + width <= core.xMax();
+         x += DesignBuilder::kSiteWidth) {
+      spots.emplace_back(x, y);
+    }
+  }
+  const auto overlap = [&](const odb::Point& a, const odb::Rect& r) {
+    return a.x() < r.xMax() && r.xMin() < a.x() + width && a.y() < r.yMax()
+           && r.yMin() < a.y() + height;
+  };
+  const odb::Rect launch = cp.path.launch->getBBox()->getBox();
+  const odb::Rect capture = cp.path.capture->getBBox()->getBox();
+
+  // What a cluster's own nets cost at each place, with the cluster moved
+  // there; kInf where the place is not legal.
+  constexpr double kInf = std::numeric_limits<double>::infinity();
+  const odb::WireLengthEvaluator evaluator(builder.block());
+  std::vector<std::vector<double>> own(2, std::vector<double>(spots.size()));
+  for (int c = 0; c < 2; ++c) {
+    for (std::size_t n = 0; n < spots.size(); ++n) {
+      if (overlap(spots[n], launch) || overlap(spots[n], capture)) {
+        own[c][n] = kInf;
+        continue;
+      }
+      for (int i = 0; i < cp.side; ++i) {
+        for (int j = 0; j < cp.side; ++j) {
+          putAt(cp.grid[c][i][j],
+                spots[n].x() + i * kCellWidth,
+                spots[n].y() + j * kRowHeight);
+        }
+      }
+      double cost = 0;
+      for (odb::dbNet* net : nets[c]) {
+        int64_t x = 0;
+        int64_t y = 0;
+        cost += netWeight(net) * static_cast<double>(evaluator.hpwl(net, x, y));
+      }
+      own[c][n] = cost;
+    }
+  }
+  for (const CellState& cell : saved) {
+    cell.inst->setLocation(cell.location.x(), cell.location.y());
+    cell.inst->setPlacementStatus(cell.status);
+  }
+
+  OrderCosts best{kInf, kInf};
+  for (std::size_t a = 0; a < spots.size(); ++a) {
+    for (std::size_t b = 0; b < spots.size(); ++b) {
+      const odb::Point& pa = spots[a];
+      const odb::Point& pb = spots[b];
+      if (own[0][a] == kInf || own[1][b] == kInf || pa.x() == pb.x()
+          || overlap(
+              pa, odb::Rect(pb.x(), pb.y(), pb.x() + width, pb.y() + height))) {
+        continue;
+      }
+      const odb::Point from(pa.x() + from_offset.x(), pa.y() + from_offset.y());
+      const odb::Point to(pb.x() + to_offset.x(), pb.y() + to_offset.y());
+      const double cost
+          = own[0][a] + own[1][b]
+            + netWeight(between) * static_cast<double>(manhattan(from, to));
+      double& slot = pa.x() < pb.x() ? best.straight : best.swapped;
+      slot = std::min(slot, cost);
+    }
+  }
+  return best;
+}
