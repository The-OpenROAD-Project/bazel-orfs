--- /dev/null
+++ b/flow/designs/asap7/coralnpu-exmem/config.mk
@@ -0,0 +1,10 @@
+export DESIGN_NICKNAME = coralnpu-exmem
+
+include designs/asap7/coralnpu/config.mk
+
+# LsuV1's inputs registered by surgery.py --address-register: the
+# EX/MEM register between dispatch and the load/store unit.
+export SYNTH_VERILOG_SURGERY_ARGS = --address-register
+
+# The clock, just under what the EX/MEM register lets the design reach.
+export SDC_FILE = $(DESIGN_HOME)/$(PLATFORM)/coralnpu-exmem/constraint.sdc
diff --git a/flow/designs/asap7/coralnpu-exmem/constraint.sdc b/flow/designs/asap7/coralnpu-exmem/constraint.sdc
new file mode 100644
index 000000000..c65aafa7c
--- /dev/null
+++ b/flow/designs/asap7/coralnpu-exmem/constraint.sdc
@@ -0,0 +1,26 @@
+current_design CoreMiniAxi
+
+set clk_name io_aclk
+set clk_port_name io_aclk
+# coralnpu's constraints with this design's clock: just under the
+# 1,701 ps it reaches at global route against a 1,700 ps target, so
+# repair has a real target.
+set clk_period 1700
+
+# IO budgets as optimization targets, the platform's set_max_delay
+# model: 0.8 of the period for a path with a register at one end, 0.6
+# for a combinational path straight through.
+set in2reg_max [expr { $clk_period * 0.8 }]
+set reg2out_max [expr { $clk_period * 0.8 }]
+set in2out_max [expr { $clk_period * 0.6 }]
+
+# Functional mode: io_te, the test enable, selects the reset bypass and
+# opens every clock gate in test.
+set_case_analysis 0 [get_ports io_te]
+
+# io_aresetn is asynchronous and reaches the core through RstSync's
+# synchroniser; its recovery and removal are not what sets the core's
+# frequency.
+set_false_path -from [get_ports io_aresetn]
+
+source $::env(PLATFORM_DIR)/constraints.sdc
