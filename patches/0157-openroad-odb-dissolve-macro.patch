@@ -0,0 +1,463 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// Unit tests for dbInst::dissolve, a placed instance of a block master
+// replaced by the block's cells and nets as a module instance, and for
+// dbModInst::getPortCones.
+//
+// The source block lives in its own database, as a block read from its own
+// ODB does; the two share their library by name only.
+//
+//            +------------------------- blk ---------------------------+
+//   a  ---->| u1 (inv1) -n1-> r1 (dff) -n2-> u2 (and2) -n3-> r2 (dff)  |
+//           |                                         \-n3-> r3 (dff)  |
+//           |                       r2 -n4-> u3 (inv1) ----------------|----> y
+//   clk --->| ck of r1, r2, r3                                         |
+//            +---------------------------------------------------------+
+
+#include <algorithm>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "odb/dbTypes.h"
+#include "odb/geom.h"
+#include "tst/db_fixture.h"
+
+namespace odb {
+
+namespace {
+
+constexpr int kBlkWidth = 4000;
+constexpr int kBlkHeight = 2000;
+
+dbLib* makeLib(dbDatabase* db, bool with_block_master)
+{
+  dbTech* tech = dbTech::create(db, "tech");
+  dbTechLayer::create(tech, "L1", dbTechLayerType::MASTERSLICE);
+  dbLib* lib = dbLib::create(db, "lib1", tech, ',');
+
+  dbMaster* inv = dbMaster::create(lib, "inv1");
+  inv->setWidth(500);
+  inv->setHeight(1000);
+  inv->setType(dbMasterType::CORE);
+  dbMTerm::create(inv, "ip0", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(inv, "op0", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  inv->setFrozen();
+
+  dbMaster* and2 = dbMaster::create(lib, "and2");
+  and2->setWidth(1000);
+  and2->setHeight(1000);
+  and2->setType(dbMasterType::CORE);
+  dbMTerm::create(and2, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(and2, "b", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(and2, "o", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  and2->setFrozen();
+
+  dbMaster* buf = dbMaster::create(lib, "buf");
+  buf->setWidth(500);
+  buf->setHeight(1000);
+  buf->setType(dbMasterType::CORE);
+  dbMTerm::create(buf, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(buf, "z", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  buf->setFrozen();
+
+  // A clock pin makes the master sequential.
+  dbMaster* dff = dbMaster::create(lib, "dff");
+  dff->setWidth(1000);
+  dff->setHeight(1000);
+  dff->setType(dbMasterType::CORE);
+  dbMTerm::create(dff, "d", dbIoType::INPUT, dbSigType::SIGNAL);
+  dbMTerm::create(dff, "ck", dbIoType::INPUT, dbSigType::CLOCK);
+  dbMTerm::create(dff, "q", dbIoType::OUTPUT, dbSigType::SIGNAL);
+  dff->setFrozen();
+
+  if (with_block_master) {
+    dbMaster* blk = dbMaster::create(lib, "blk");
+    blk->setWidth(kBlkWidth);
+    blk->setHeight(kBlkHeight);
+    blk->setType(dbMasterType::BLOCK);
+    dbMTerm::create(blk, "a", dbIoType::INPUT, dbSigType::SIGNAL);
+    dbMTerm::create(blk, "clk", dbIoType::INPUT, dbSigType::CLOCK);
+    dbMTerm::create(blk, "y", dbIoType::OUTPUT, dbSigType::SIGNAL);
+    blk->setFrozen();
+  }
+  return lib;
+}
+
+class DissolveTest : public tst::DbFixture
+{
+ protected:
+  void SetUp() override
+  {
+    lib_ = makeLib(db_.get(), true);
+    dbChip* chip = dbChip::create(db_.get(), db_->getTech());
+    block_ = dbBlock::create(chip, "top");
+    block_->setDieArea(Rect(0, 0, 100000, 100000));
+
+    source_db_ = dbDatabase::create();
+    source_db_->setLogger(&logger_);
+    dbLib* src_lib = makeLib(source_db_, false);
+    dbChip* src_chip = dbChip::create(source_db_, source_db_->getTech());
+    source_ = dbBlock::create(src_chip, "blk");
+    // The die's corner is not the origin: the abstract's origin is.
+    source_->setDieArea(Rect(100, 200, 100 + kBlkWidth, 200 + kBlkHeight));
+    makeSource(src_lib);
+  }
+
+  void TearDown() override { dbDatabase::destroy(source_db_); }
+
+  void makeSource(dbLib* lib)
+  {
+    dbBlock* b = source_;
+    dbNet* a = dbNet::create(b, "a");
+    dbNet* clk = dbNet::create(b, "clk");
+    clk->setSigType(dbSigType::CLOCK);
+    dbNet* y = dbNet::create(b, "y");
+    dbBTerm::create(a, "a")->setIoType(dbIoType::INPUT);
+    dbBTerm* clk_port = dbBTerm::create(clk, "clk");
+    clk_port->setIoType(dbIoType::INPUT);
+    clk_port->setSigType(dbSigType::CLOCK);
+    dbBTerm::create(y, "y")->setIoType(dbIoType::OUTPUT);
+    auto [n1, n2, n3, n4] = makeNets(b, "n1", "n2", "n3", "n4");
+
+    auto cell = [&](const char* master,
+                    const char* name,
+                    int x,
+                    int y_loc,
+                    dbOrientType orient) {
+      dbInst* inst = dbInst::create(b, lib->findMaster(master), name);
+      inst->setOrient(orient);
+      inst->setLocation(x, y_loc);
+      inst->setPlacementStatus(dbPlacementStatus::PLACED);
+      return inst;
+    };
+    dbInst* u1 = cell("inv1", "u1", 100, 200, dbOrientType::R0);
+    dbInst* r1 = cell("dff", "r1", 600, 200, dbOrientType::R0);
+    dbInst* u2 = cell("and2", "u2", 1600, 1200, dbOrientType::MX);
+    dbInst* r2 = cell("dff", "r2", 2600, 1200, dbOrientType::MX);
+    dbInst* r3 = cell("dff", "r3", 2600, 200, dbOrientType::R0);
+    dbInst* u3 = cell("inv1", "u3", 3600, 200, dbOrientType::MY);
+
+    u1->findITerm("ip0")->connect(a);
+    u1->findITerm("op0")->connect(n1);
+    r1->findITerm("d")->connect(n1);
+    r1->findITerm("q")->connect(n2);
+    u2->findITerm("a")->connect(n2);
+    u2->findITerm("b")->connect(n2);
+    u2->findITerm("o")->connect(n3);
+    r2->findITerm("d")->connect(n3);
+    r2->findITerm("q")->connect(n4);
+    r3->findITerm("d")->connect(n3);
+    u3->findITerm("ip0")->connect(n4);
+    u3->findITerm("op0")->connect(y);
+    for (dbInst* r : {r1, r2, r3}) {
+      r->findITerm("ck")->connect(clk);
+    }
+    u3->setDoNotTouch(true);
+  }
+
+  // The macro "m" of blk in `module`, its pins on na, nclk and ny.
+  dbInst* makeMacro(dbModule* module, const char* name, dbOrientType orient)
+  {
+    dbInst* m = dbInst::create(
+        block_, lib_->findMaster("blk"), name, false, module);
+    m->setOrient(orient);
+    m->setLocation(10000, 20000);
+    m->setPlacementStatus(dbPlacementStatus::PLACED);
+    return m;
+  }
+
+  dbLib* lib_ = nullptr;
+  dbBlock* block_ = nullptr;
+  dbDatabase* source_db_ = nullptr;
+  dbBlock* source_ = nullptr;
+};
+
+// In the top module: the macro becomes a module instance of its name, its
+// cells and nets under it, its ports on the parent's nets.
+TEST_F(DissolveTest, TopLevelMacroBecomesModuleInstance)
+{
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R0);
+  auto [na, nclk, ny] = makeNets(block_, "na", "nclk", "ny");
+  dbBTerm::create(na, "A")->setIoType(dbIoType::INPUT);
+  dbBTerm::create(nclk, "CLK")->setIoType(dbIoType::INPUT);
+  dbBTerm::create(ny, "Y")->setIoType(dbIoType::OUTPUT);
+  m->findITerm("a")->connect(na);
+  m->findITerm("clk")->connect(nclk);
+  m->findITerm("y")->connect(ny);
+
+  dbModInst* mi = dbInst::dissolve(m, source_);
+
+  ASSERT_NE(mi, nullptr);
+  EXPECT_STREQ(mi->getName(), "m");
+  EXPECT_EQ(mi->getParent(), block_->getTopModule());
+  EXPECT_STREQ(mi->getMaster()->getName(), "blk");
+  EXPECT_EQ(block_->findInst("m"), nullptr);
+  EXPECT_EQ(mi->getMaster()->getDbInstCount(), 6);
+
+  // Port nets are the parent's flat nets, with a module net on each side.
+  dbInst* u1 = block_->findInst("m/u1");
+  ASSERT_NE(u1, nullptr);
+  EXPECT_EQ(u1->getModule(), mi->getMaster());
+  EXPECT_EQ(u1->findITerm("ip0")->getNet(), na);
+  dbModNet* inner_a = u1->findITerm("ip0")->getModNet();
+  ASSERT_NE(inner_a, nullptr);
+  EXPECT_EQ(inner_a->getParent(), mi->getMaster());
+  EXPECT_EQ(inner_a->getModBTerms().size(), 1u);
+  dbModITerm* pin_a = mi->findModITerm("a");
+  ASSERT_NE(pin_a, nullptr);
+  dbModNet* outer_a = pin_a->getModNet();
+  ASSERT_NE(outer_a, nullptr);
+  EXPECT_EQ(outer_a->getParent(), block_->getTopModule());
+  EXPECT_EQ(outer_a->findRelatedNet(), na);
+  // The parent's own terms on the net joined the new module net.
+  EXPECT_EQ(block_->findBTerm("A")->getModNet(), outer_a);
+
+  // An internal net is a new flat net under the instance, no module net.
+  dbInst* u2 = block_->findInst("m/u2");
+  ASSERT_NE(u2, nullptr);
+  dbNet* n3 = u2->findITerm("o")->getNet();
+  ASSERT_NE(n3, nullptr);
+  EXPECT_EQ(n3->getName(), "m/n3");
+  EXPECT_EQ(u2->findITerm("o")->getModNet(), nullptr);
+  EXPECT_EQ(block_->findInst("m/r3")->findITerm("d")->getNet(), n3);
+
+  // The output port drives the parent's net, from a dont_touch cell.
+  EXPECT_EQ(block_->findInst("m/u3")->findITerm("op0")->getNet(), ny);
+  EXPECT_TRUE(block_->findInst("m/u3")->isDoNotTouch());
+  EXPECT_EQ(block_->findInst("m/r1")->findITerm("ck")->getNet(), nclk);
+}
+
+// Every cell lands where the block placed it, through the macro's location
+// and orientation, relative to the block's die corner.
+TEST_F(DissolveTest, CellsPlacedThroughMacroTransform)
+{
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::MY);
+  dbInst::dissolve(m, source_);
+
+  // u1: inv1 500 wide at source (100, 200) R0, the die's corner. Mirrored
+  // about the y axis within the 4000-wide block: x 4000 - 0 - 500.
+  dbInst* u1 = block_->findInst("m/u1");
+  EXPECT_EQ(u1->getOrient(), dbOrientType::MY);
+  EXPECT_EQ(u1->getBBox()->getBox(),
+            Rect(10000 + 3500, 20000, 10000 + 4000, 21000));
+  EXPECT_EQ(u1->getPlacementStatus(), dbPlacementStatus::PLACED);
+
+  // u2: and2 at (1500, 1000) relative, MX; mirrored about y it is R180.
+  dbInst* u2 = block_->findInst("m/u2");
+  EXPECT_EQ(u2->getOrient(), dbOrientType::R180);
+  EXPECT_EQ(u2->getBBox()->getBox(),
+            Rect(10000 + 1500, 21000, 10000 + 2500, 22000));
+
+  // u3: inv1 MY at (3500, 0) relative: back to R0 at the left edge.
+  dbInst* u3 = block_->findInst("m/u3");
+  EXPECT_EQ(u3->getOrient(), dbOrientType::R0);
+  EXPECT_EQ(u3->getBBox()->getBox(), Rect(10000, 20000, 10500, 21000));
+}
+
+// Inside a submodule whose net already crosses its boundary: the existing
+// module net is reused and the instance is named in the submodule.
+TEST_F(DissolveTest, MacroInSubmoduleUsesItsModuleNets)
+{
+  dbModule* sub = dbModule::create(block_, "sub");
+  dbModBTerm* sub_in = dbModBTerm::create(sub, "in");
+  sub_in->setIoType(dbIoType::INPUT);
+  dbModInst* sub_inst
+      = dbModInst::create(block_->getTopModule(), sub, "s");
+  dbModITerm* s_in = dbModITerm::create(sub_inst, "in", sub_in);
+
+  dbNet* na = dbNet::create(block_, "na");
+  dbModNet* top_na = dbModNet::create(block_->getTopModule(), "na");
+  dbBTerm* port_a = dbBTerm::create(na, "A");
+  port_a->setIoType(dbIoType::INPUT);
+  port_a->connect(top_na);
+  s_in->connect(top_na);
+  dbModNet* sub_na = dbModNet::create(sub, "in");
+  sub_in->connect(sub_na);
+
+  dbInst* m = makeMacro(sub, "s/m", dbOrientType::R0);
+  m->findITerm("a")->connect(na, sub_na);
+
+  dbModInst* mi = dbInst::dissolve(m, source_);
+
+  EXPECT_STREQ(mi->getName(), "m");
+  EXPECT_EQ(mi->getParent(), sub);
+  EXPECT_EQ(mi->getHierarchicalName(), "s/m");
+  EXPECT_EQ(mi->findModITerm("a")->getModNet(), sub_na);
+  dbInst* u1 = block_->findInst("s/m/u1");
+  ASSERT_NE(u1, nullptr);
+  EXPECT_EQ(u1->findITerm("ip0")->getNet(), na);
+  // y is on no net in the parent: inside it is a new flat net.
+  dbNet* y = block_->findInst("s/m/u3")->findITerm("op0")->getNet();
+  ASSERT_NE(y, nullptr);
+  EXPECT_EQ(y->getName(), "s/m/y");
+}
+
+// Two instances of one block master: two modules, two sets of cells.
+TEST_F(DissolveTest, TwoInstancesOfOneMaster)
+{
+  dbInst* m1 = makeMacro(block_->getTopModule(), "m1", dbOrientType::R0);
+  dbInst* m2 = makeMacro(block_->getTopModule(), "m2", dbOrientType::MX);
+  dbModInst* mi1 = dbInst::dissolve(m1, source_);
+  dbModInst* mi2 = dbInst::dissolve(m2, source_);
+  EXPECT_NE(mi1->getMaster(), mi2->getMaster());
+  EXPECT_NE(block_->findInst("m1/u1"), nullptr);
+  EXPECT_NE(block_->findInst("m2/u1"), nullptr);
+}
+
+// A quarter turn would turn the block's cells across the rows.
+TEST_F(DissolveTest, RotatedMacroIsRefused)
+{
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R90);
+  EXPECT_THROW(dbInst::dissolve(m, source_), std::runtime_error);
+  EXPECT_NE(block_->findInst("m"), nullptr);
+}
+
+// The macro's halo goes with it.
+TEST_F(DissolveTest, HaloBlockageRemoved)
+{
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R0);
+  dbBlockage* halo = dbBlockage::create(block_, 9000, 19000, 15000, 23000, m);
+  ASSERT_EQ(halo->getInstance(), m);
+  dbInst::dissolve(m, source_);
+  EXPECT_EQ(block_->getBlockages().size(), 0u);
+}
+
+// Port cones: forward from an input to the first flop, backward from an
+// output to the first flop. The clock reaches every flop and is skipped.
+TEST_F(DissolveTest, PortConesStopAtTheFirstFlop)
+{
+  dbInst* m = makeMacro(block_->getTopModule(), "m", dbOrientType::R0);
+  dbModInst* mi = dbInst::dissolve(m, source_);
+
+  std::vector<dbModBTerm*> skipped;
+  std::vector<dbInst*> cones = mi->getPortCones(2, &skipped);
+  std::vector<std::string> names;
+  for (dbInst* inst : cones) {
+    names.push_back(inst->getName());
+  }
+  std::ranges::sort(names);
+  EXPECT_EQ(names, (std::vector<std::string>{"m/r1", "m/r2", "m/u1", "m/u3"}));
+  ASSERT_EQ(skipped.size(), 1u);
+  EXPECT_STREQ(skipped[0]->getName(), "clk");
+
+  // With room for the clock's three flops, it is a cone too.
+  skipped.clear();
+  EXPECT_EQ(mi->getPortCones(3, &skipped).size(), 5u);
+  EXPECT_TRUE(skipped.empty());
+}
