+sta::define_cmd_args "dissolve_macro" {-inst inst_name -db odb_file\
+                                         [-strip_clock_buffers masters]}
+
+proc dissolve_macro { args } {
+  sta::parse_key_args "dissolve_macro" args \
+    keys {-inst -db -strip_clock_buffers} flags {}
+  sta::check_argc_eq0 "dissolve_macro" $args
+  if { ![info exists keys(-inst)] || ![info exists keys(-db)] } {
+    utl::error ODB 1230 "dissolve_macro needs -inst and -db."
+  }
+  set block [ord::get_db_block]
+  set inst [$block findInst $keys(-inst)]
+  if { $inst == "NULL" } {
+    utl::error ODB 1231 "dissolve_macro: no instance $keys(-inst)."
+  }
+  set source_db [odb::read_db NULL $keys(-db)]
+  if { $source_db == "NULL" } {
+    utl::error ODB 1232 "dissolve_macro: cannot read $keys(-db)."
+  }
+  set source [[$source_db getChip] getBlock]
+  set strip [odb::vector_str]
+  if { [info exists keys(-strip_clock_buffers)] } {
+    foreach master $keys(-strip_clock_buffers) {
+      $strip push $master
+    }
+  }
+  set mod_inst [odb::dbInst_dissolve $inst $source $strip]
+  odb::dbDatabase_destroy $source_db
+  return $mod_inst
+}
+
+sta::define_cmd_args "get_port_cones" {-modinst path [-max_cone count]}
+
+proc get_port_cones { args } {
+  sta::parse_key_args "get_port_cones" args keys {-modinst -max_cone} flags {}
+  sta::check_argc_eq0 "get_port_cones" $args
+  if { ![info exists keys(-modinst)] } {
+    utl::error ODB 1233 "get_port_cones needs -modinst."
+  }
+  set block [ord::get_db_block]
+  set mod_inst [$block findModInst $keys(-modinst)]
+  if { $mod_inst == "NULL" } {
+    utl::error ODB 1234 "get_port_cones: no module instance $keys(-modinst)."
+  }
+  set max_cone 1000
+  if { [info exists keys(-max_cone)] } {
+    set max_cone $keys(-max_cone)
+    sta::check_positive_integer "-max_cone" $max_cone
+  }
+  return [$mod_inst getPortCones $max_cone NULL]
+}
