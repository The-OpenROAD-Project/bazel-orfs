diff --git a/src/dbSta/test/sdc_in_db9.sdc b/src/dbSta/test/sdc_in_db9.sdc
new file mode 100644
index 0000000000..44404130a2
--- /dev/null
+++ b/src/dbSta/test/sdc_in_db9.sdc
@@ -0,0 +1,7 @@
+# Two constructs the native form does not carry, both detected from the
+# Sdc itself rather than from write_sdc text: a generated clock and a
+# port load. The whole Sdc rides as text, and nothing is dropped.
+create_clock -name clk -period 10 [get_ports clk1]
+create_generated_clock -name gclk -source [get_ports clk1] -divide_by 2 [get_pins r1/Q]
+set_input_delay 1 -clock clk [get_ports in1]
+set_load 0.5 [get_ports out]
diff --git a/src/dbSta/test/sdc_in_db9.tcl b/src/dbSta/test/sdc_in_db9.tcl
new file mode 100644
index 0000000000..81579408db
--- /dev/null
+++ b/src/dbSta/test/sdc_in_db9.tcl
@@ -0,0 +1,23 @@
+# Round trip through the text fallback for constructs the Sdc inspection
+# flags (a generated clock, a port load): the constraints ride as
+# write_sdc text, are replayed, and still equal what was written.
+source "helpers.tcl"
+read_lef liberty1.lef
+read_liberty liberty1.lib
+read_verilog reg1.v
+link_design top
+read_sdc sdc_in_db9.sdc
+
+set odb [make_result_file sdc_in_db9.odb]
+write_db $odb
+puts "stored form: [ord::sdc_in_db_kind]"
+set before [make_result_file sdc_in_db9_before.sdc]
+write_sdc -no_timestamp $before
+
+set after [make_result_file sdc_in_db9_after.sdc]
+set ::env(SDC_IN_DB_ODB) $odb
+set ::env(SDC_IN_DB_SDC) $after
+puts [exec $argv0 -no_init -no_splash -exit sdc_in_db_restore.tcl]
+
+report_file $after
+diff_files $before $after
diff --git a/src/dbSta/test/sdc_in_db_restore.tcl b/src/dbSta/test/sdc_in_db_restore.tcl
new file mode 100644
index 0000000000..3abc1ce099
--- /dev/null
+++ b/src/dbSta/test/sdc_in_db_restore.tcl
@@ -0,0 +1,8 @@
+# Second process of the sdc_in_db round-trip tests: the design and its
+# constraints must come from the .odb alone. Writes the restored
+# constraints back out for the parent to diff against what it wrote.
+read_lef liberty1.lef
+read_liberty liberty1.lib
+set found [read_db -sdc $::env(SDC_IN_DB_ODB)]
+puts "read_db -sdc returned $found, stored form: [ord::sdc_in_db_kind]"
+write_sdc -no_timestamp $::env(SDC_IN_DB_SDC)
diff --git a/src/dbSta/test/sdc_in_db_rewrite.tcl b/src/dbSta/test/sdc_in_db_rewrite.tcl
