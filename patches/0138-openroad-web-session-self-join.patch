From 36406b8daa97ba9c3663440f89b9f4248e9272ad Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Sat, 17 Oct 2026 23:46:16 +0200
Subject: [PATCH] web: a session destroyed on its own init thread detaches it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A WebSocketSession builds its search indices on init_thread_, whose
lambda holds the session by shared_from_this(). When the client goes
away before the indices are built, that lambda holds the last
reference, and the session is destroyed on the init thread itself:
~WebSocketSession then calls init_thread_.join() from the thread being
joined, std::thread throws std::system_error (resource deadlock
avoided) out of a destructor, and openroad aborts on signal 6. A client
that opens a connection per request, on a loaded machine, hits it.

The destructor now detaches the thread when it runs on it, and joins
it otherwise.

Not upstreamed. Retires at a //:bump onto an OpenROAD whose web
session does not join its own thread.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 src/web/src/web.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/web/src/web.cpp b/src/web/src/web.cpp
index 5baf61a8a4..678e364bad 100644
--- a/src/web/src/web.cpp
+++ b/src/web/src/web.cpp
@@ -932,7 +932,15 @@ WebSocketSession::~WebSocketSession()
     viewer_hook_->sessions().remove(viewer_token_);
   }
   if (init_thread_.joinable()) {
-    init_thread_.join();
+    // The init thread holds a reference to the session. When it holds the
+    // last one, the session is destroyed on that thread, which cannot join
+    // itself (std::system_error, resource deadlock avoided): it is ending,
+    // so let it go.
+    if (init_thread_.get_id() == std::this_thread::get_id()) {
+      init_thread_.detach();
+    } else {
+      init_thread_.join();
+    }
   }
   std::lock_guard<std::mutex> lock(state_.heatmap_mutex);
   if (!state_.active_heatmap.empty()) {
-- 
