From cb9e62a9e5f436d2fd16ef20e705e0c1473fdc81 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Sat, 31 Oct 2026 14:07:22 +0100
Subject: [PATCH] ram: a read select's group buffer beside the bits it selects
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

An AND-OR read's word select reaches its bits a group of eight at a
time, a buffer a group (read side per group). Every group's buffer was
made in the word's cell of the buffer column, beside the decoder, so
each group's select ran from there across the word to its eight bits:
a 256-bit word's 32 selects all spanned the row. Placed as generate_ram
lays it out, a 64 x 256 register file's global route took 2.7 times
the wire (1.48e9 against 7.7e8 DBU of guides, 5.85e8 on the group
selects alone) and ended with 5,579 overflows on M2 and M4, where it
had none.

Each group's buffer is now made in the bit cell of the group's first
bit, in every word, the netlist unchanged: the same buffers, names and
connections, the first group's still in the buffer column.

Not upstreamed: on the read side per group, carried with it. Retires at
a //:bump onto an OpenROAD that carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 src/ram/include/ram/ram.h | 11 +++++++++++
 src/ram/src/ram.cpp       | 39 +++++++++++++++++++++++++--------------
 2 files changed, 36 insertions(+), 14 deletions(-)

diff --git a/src/ram/include/ram/ram.h b/src/ram/include/ram/ram.h
index 15db2c1b16..70e97a0620 100644
--- a/src/ram/include/ram/ram.h
+++ b/src/ram/include/ram/ram.h
@@ -191,6 +191,17 @@ class RamGen
   // its own buffer: the first is the select itself. Keyed by the select,
   // only ever looked up, never walked.
   std::unordered_map<odb::dbNet*, std::vector<odb::dbNet*>> select_groups_;
+  // Where a read select's group buffers come from: the buffer column's
+  // prefix, the select's word and the decoder output its buffers take.
+  // Each group's buffer is made in the bit cell of the group's first bit,
+  // beside the bits it selects.
+  struct SelectSource
+  {
+    std::string prefix;
+    int word;
+    odb::dbNet* decoder_output;
+  };
+  std::unordered_map<odb::dbNet*, SelectSource> select_sources_;
   // An address literal's cells for a group of kDriveGroup words: a buffer
   // or an inverter from the address, made in the decoder cell of the
   // group's first word. Keyed by the port's decoder prefix and that word.
diff --git a/src/ram/src/ram.cpp b/src/ram/src/ram.cpp
index 36ceb76bd9..9af000886f 100644
--- a/src/ram/src/ram.cpp
+++ b/src/ram/src/ram.cpp
@@ -934,20 +934,7 @@ void RamGen::makeBufferColumn(const std::string& prefix,
           {{buffer_ports_[{PortRoleType::DataIn, 0}],
             decoder_output_nets[word]},
            {buffer_ports_[{PortRoleType::DataOut, 0}], select_nets[word]}});
-      // a read select's other groups, each its own buffer
-      auto groups = select_groups_.find(select_nets[word]);
-      if (groups != select_groups_.end()) {
-        for (size_t g = 1; g < groups->second.size(); ++g) {
-          makeInst(buf_cell.get(),
-                   prefix,
-                   fmt::format("sel_buf_{}_g{}", word, g),
-                   buffer_cell_,
-                   {{buffer_ports_[{PortRoleType::DataIn, 0}],
-                     decoder_output_nets[word]},
-                    {buffer_ports_[{PortRoleType::DataOut, 0}],
-                     groups->second[g]}});
-        }
-      }
+      // a read select's other groups' buffers are in their bit cells
     }
     buffer_layout->addCell(std::move(buf_cell));
     for (int f = 1; f < bit_folds_; ++f) {
@@ -2608,6 +2595,7 @@ void RamGen::generate(const int mask_size,
   word_write_.clear();
   super_nets_.clear();
   select_groups_.clear();
+  select_sources_.clear();
   literal_cells_.clear();
   storage_cell_ = storage_cell;
   tristate_cell_ = tristate_cell;
@@ -3030,6 +3018,9 @@ void RamGen::generate(const int mask_size,
           dbNet* select = read_select_nets[r_sel_idx - 1][slot];
           auto& copies = select_groups_[select];
           copies.push_back(select);
+          select_sources_[select] = {fmt::format("sel_buf_r_p{}", p),
+                                     slot,
+                                     decoder_output_nets[p][slot]};
           for (int g = 1; g < groups; ++g) {
             copies.push_back(makeNet(fmt::format("r_sel_p{}", p),
                                      fmt::format("select_r{}_g{}", slot, g)));
@@ -3047,6 +3038,7 @@ void RamGen::generate(const int mask_size,
               dbNet::destroy(groups->second[g]);
             }
             select_groups_.erase(groups);
+            select_sources_.erase(read_select_nets[r_sel_idx - 1][slot]);
           }
           dbNet::destroy(decoder_output_nets[p][slot]);
           dbNet::destroy(read_select_nets[r_sel_idx - 1][slot]);
@@ -3239,6 +3231,25 @@ void RamGen::generate(const int mask_size,
               term.select = groups->second[bit / kDriveGroup];
             }
           }
+          // a group's buffer, in its first bit's cell of each word
+          if (bit % kDriveGroup == 0 && bit > 0) {
+            const size_t g = bit / kDriveGroup;
+            for (const Term& term : terms) {
+              auto groups = select_groups_.find(term.select);
+              if (groups == select_groups_.end()) {
+                continue;
+              }
+              const SelectSource& source = select_sources_.at(term.select);
+              tree_nodes_[{term.row, term.word_idx, bit}].push_back(
+                  {buffer_cell_,
+                   source.prefix,
+                   fmt::format("sel_buf_{}_g{}", source.word, g),
+                   {{buffer_ports_[{PortRoleType::DataIn, 0}],
+                     source.decoder_output},
+                    {buffer_ports_[{PortRoleType::DataOut, 0}],
+                     groups->second[g]}}});
+            }
+          }
           const TreeEnd root = planReadTree(
               prefix, bit, bit_terms, 0, n, flip ? nullptr : out);
           if (flip) {
-- 
