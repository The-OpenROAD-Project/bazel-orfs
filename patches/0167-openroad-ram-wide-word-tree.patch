From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] ram: a wide word's enable and takes, a second level of
 buffers
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A word's write enable and each write port's take reach its bits through
a buffer per group of eight bits. A word of more than eight groups had
its enable, or a port's take, drive every group's buffer: a 128-bit
word's 16, and in a flow repair_timing chained buffers on it, the worst
path left on a two-write-port 128-bit register file.

A word of more than eight groups now has a buffer per eight groups
between the enable (or take) and the group buffers, shared by the
word's folds; neither drives more than eight buffers.

Carried in bazel-orfs, not upstreamed; retires with the //:bump onto an
OpenROAD that has it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 src/ram/include/ram/ram.h         |  5 ++++
 src/ram/src/ram.cpp               | 31 ++++++++++++++++++++--
 src/ram/test/BUILD                |  1 +
 src/ram/test/CMakeLists.txt       |  1 +
 src/ram/test/regression_tests.tcl |  1 +
 src/ram/test/wide_word_asap7.tcl  | 44 +++++++++++++++++++++++++++++++
 6 files changed, 81 insertions(+), 2 deletions(-)
 create mode 100644 src/ram/test/wide_word_asap7.tcl

diff --git a/src/ram/include/ram/ram.h b/src/ram/include/ram/ram.h
index dcb3e9d4c1..15db2c1b16 100644
--- a/src/ram/include/ram/ram.h
+++ b/src/ram/include/ram/ram.h
@@ -449,6 +449,11 @@ class RamGen
     std::vector<odb::dbNet*> select_b;
   };
   std::map<std::pair<int, int>, WordWrite> word_write_;
+  // A word of more than kDriveGroup groups: a buffer between its enable
+  // (or a port's take, -1 for the enable) and each kDriveGroup of its
+  // group buffers, shared by the word's folds. Keyed by row, word, the
+  // port or -1, and the group of groups.
+  std::map<std::tuple<int, int, int, int>, odb::dbNet*> super_nets_;
   int sliceOffset(int slice) const
   {
     return bit_folds_ > 1 ? 0 : slice * slice_width_;
diff --git a/src/ram/src/ram.cpp b/src/ram/src/ram.cpp
index 5d19ffc8a6..dc0d758e19 100644
--- a/src/ram/src/ram.cpp
+++ b/src/ram/src/ram.cpp
@@ -561,6 +561,30 @@ void RamGen::makeSlice(const int slice_idx,
     // a word of one group: its nets drive no more than a group's pins
     // already, and a buffer would only add a level
     const bool one_group = word_bits_ <= kDriveGroup;
+    // a word of more than kDriveGroup groups: its group buffers take the
+    // enable or take through a buffer per kDriveGroup groups, so the
+    // enable drives no more than kDriveGroup buffers either
+    const int word_groups = (word_bits_ + kDriveGroup - 1) / kDriveGroup;
+    const int word_group = (start_bit_idx + local_bit) / kDriveGroup;
+    auto group_source = [&](dbNet* root, const int port) {
+      if (word_groups <= kDriveGroup) {
+        return root;
+      }
+      const int super = word_group / kDriveGroup;
+      dbNet*& net = super_nets_[{row_idx, word_idx, port, super}];
+      if (net == nullptr) {
+        const std::string what
+            = port < 0 ? "we" : fmt::format("take{}", port);
+        net = makeNet(prefix, fmt::format("{}_s{}", what, super));
+        makeInst(bit_cell.get(),
+                 prefix,
+                 fmt::format("{}_sbuf{}", what, super),
+                 buffer_cell_,
+                 {{buffer_ports_[{PortRoleType::DataIn, 0}], root},
+                  {buffer_ports_[{PortRoleType::DataOut, 0}], net}});
+      }
+      return net;
+    };
     if (n_writers > 1 && one_group && take_group.empty()) {
       take_group = take;
     } else if (n_writers > 1
@@ -573,7 +597,8 @@ void RamGen::makeSlice(const int slice_idx,
                  prefix,
                  fmt::format("take_buf{}_g{}", i, group),
                  buffer_cell_,
-                 {{buffer_ports_[{PortRoleType::DataIn, 0}], take[i]},
+                 {{buffer_ports_[{PortRoleType::DataIn, 0}],
+                   group_source(take[i], i)},
                   {buffer_ports_[{PortRoleType::DataOut, 0}],
                    take_group[i]}});
       }
@@ -591,7 +616,8 @@ void RamGen::makeSlice(const int slice_idx,
                  prefix,
                  fmt::format("we_buf{}", group),
                  buffer_cell_,
-                 {{buffer_ports_[{PortRoleType::DataIn, 0}], we_net},
+                 {{buffer_ports_[{PortRoleType::DataIn, 0}],
+                   group_source(we_net, -1)},
                   {buffer_ports_[{PortRoleType::DataOut, 0}], we_group}});
       }
       makeInst(bit_cell.get(),
@@ -2525,6 +2551,7 @@ void RamGen::generate(const int mask_size,
   storage_nets_.clear();
   tree_nodes_.clear();
   word_write_.clear();
+  super_nets_.clear();
   select_groups_.clear();
   literal_cells_.clear();
   storage_cell_ = storage_cell;
