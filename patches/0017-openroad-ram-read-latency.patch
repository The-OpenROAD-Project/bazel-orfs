+module RAM8x8 (
+  clk,
+  D,
+  Q,
+  addr_w,
+  addr_r0,
+  addr_rb0_b0,
+  addr_rb0_b1,
+  addr_rb0_b2,
+  addr_rb0_b3,
+  we,
+  Qrb0_b0,
+  Qrb0_b1,
+  Qrb0_b2,
+  Qrb0_b3
+);
+  input clk;
+  input [7:0] D;
+  output reg [7:0] Q;
+  output reg [7:0] Qrb0_b0;
+  output reg [7:0] Qrb0_b1;
+  output reg [7:0] Qrb0_b2;
+  output reg [7:0] Qrb0_b3;
+  input [2:0] addr_w;
+  input [2:0] addr_r0;
+  input [0:0] addr_rb0_b0;
+  input [0:0] addr_rb0_b1;
+  input [0:0] addr_rb0_b2;
+  input [0:0] addr_rb0_b3;
+  input [0:0] we;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we[i] && addr_w != 0) begin
+        mem[addr_w][i*8 +:8] <= D[i*8 +:8];
+      end
+    end
+  end
+
+  // read logic
+  reg [2:0] addr_r0_q;
+  always @(posedge clk) addr_r0_q <= addr_r0;
+  reg [0:0] addr_rb0_b0_q;
+  always @(posedge clk) addr_rb0_b0_q <= addr_rb0_b0;
+  reg [0:0] addr_rb0_b1_q;
+  always @(posedge clk) addr_rb0_b1_q <= addr_rb0_b1;
+  reg [0:0] addr_rb0_b2_q;
+  always @(posedge clk) addr_rb0_b2_q <= addr_rb0_b2;
+  reg [0:0] addr_rb0_b3_q;
+  always @(posedge clk) addr_rb0_b3_q <= addr_rb0_b3;
+
+  always @(*) begin
+    Qrb0_b0 = (0 + addr_rb0_b0_q) == 0 ? 8'd0 : mem[0 + addr_rb0_b0_q];
+  end
+
+  always @(*) begin
+    Qrb0_b1 = (2 + addr_rb0_b1_q) == 0 ? 8'd0 : mem[2 + addr_rb0_b1_q];
+  end
+
+  always @(*) begin
+    Qrb0_b2 = (4 + addr_rb0_b2_q) == 0 ? 8'd0 : mem[4 + addr_rb0_b2_q];
+  end
+
+  always @(*) begin
+    Qrb0_b3 = (6 + addr_rb0_b3_q) == 0 ? 8'd0 : mem[6 + addr_rb0_b3_q];
+  end
+
+  always @(*) begin
+    Q = addr_r0_q == 0 ? 8'd0 : mem[addr_r0_q];
+  end
+
+endmodule
