       makeInst(inv_grid_cell.get(),
                fmt::format("decoder_p{}", p),
                fmt::format("inv_p{}_a{}", p, bit),
                inv_cell_,
                {{inv_ports_[{PortRoleType::DataIn, 0}],
-                 addr_inputs_[p][num_word_bits + bit]->getNet()},
