diff --git a/src/ram/test/make_8x8_rb_latency_asap7.tcl b/src/ram/test/make_8x8_rb_latency_asap7.tcl
new file mode 100644
index 0000000000..3f3a9845ef
--- /dev/null
+++ b/src/ram/test/make_8x8_rb_latency_asap7.tcl
@@ -0,0 +1,38 @@
+# generate_ram on asap7, which has no tristate cell: the read ports are
+# AND-OR trees: a plain one and a banked one, an address and data per
+# bank, over 4 banks of 2 words, word 0 reading 0, their addresses
+# registered (-read_latency 1) through flops whose output is QN.
+source "helpers.tcl"
+
+read_liberty ../../../test/asap7/asap7sc7p5t_AO_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_INVBUF_RVT_FF_nldm_220122.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_OA_RVT_FF_nldm_211120.lib.gz
+read_liberty ../../../test/asap7/asap7sc7p5t_SEQ_RVT_FF_nldm_220123.lib
+read_liberty ../../../test/asap7/asap7sc7p5t_SIMPLE_RVT_FF_nldm_211120.lib.gz
+
+read_lef ../../../test/asap7/asap7_tech_1x_201209.lef
+read_lef ../../../test/asap7/asap7sc7p5t_28_R_1x_220121a.lef
+
+set behavioral_file [make_result_file make_8x8_rb_latency_asap7_behavioral.v]
+
+generate_ram_netlist \
+  -mask_size 8 \
+  -word_size 8 \
+  -num_words 8 \
+  -r_ports 1 \
+  -rb_ports 1 \
+  -read_latency 1 \
+  -w_ports 1 \
+  -storage_cell DFFHQNx1_ASAP7_75t_R \
+  -banks 4 \
+  -bank_columns 2 \
+  -zero_word 0 \
+  -write_behavioral_verilog $behavioral_file
+
+set def_file [make_result_file make_8x8_rb_latency_asap7.def]
+write_def $def_file
+diff_files make_8x8_rb_latency_asap7.defok $def_file
+
+diff_files make_8x8_rb_latency_asap7_behavioral.vok $behavioral_file
+
+puts "pass"
