 );
   input clk;
-{}{}{}{}
+{}{}{}{}{}
   // memory array declaration
   reg [{}:0] mem[0:{}];
 
   // write logic
   integer i;
-  always @(posedge clk) begin
-{}  end
+{}{}  end
 
   // read logic
 {}
@@ -2588,12 +2747,14 @@ endmodule
 )",
                                          module_name,
                                          port_list,
+                                         reset_declaration,
                                          data_declarations,
                                          output_declaration,
                                          addr_declarations,
