+  input [7:0] D;
+  output reg [7:0] Q0;
+  output reg [7:0] Q1;
+  input [2:0] addr_w;
+  input [2:0] addr_r0;
+  input [2:0] addr_r1;
+  input [0:0] we;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk or negedge rst_n) begin
+    if (!rst_n) begin
+      for (i = 0; i < 8; i = i + 1) begin
+        mem[i] <= 8'd165;
+      end
+    end else begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we[i]) begin
+        mem[addr_w][i*8 +:8] <= D[i*8 +:8];
+      end
+    end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q0 = mem[addr_r0];
+  end
+
+  always @(*) begin
+    Q1 = mem[addr_r1];
+  end
+
+endmodule
