--- /dev/null
+++ b/src/ram/test/make_8x8_2r1w_service_asap7_behavioral.vok
@@ -0,0 +1,42 @@
+module RAM8x8 (
+  clk,
+  D,
+  Q0,
+  Q1,
+  addr_w,
+  addr_r0,
+  addr_r1,
+  we
+);
+  input clk;
+  input [7:0] D;
+  output reg [7:0] Q0;
+  output reg [7:0] Q1;
+  input [2:0] addr_w;
+  input [2:0] addr_r0;
+  input [2:0] addr_r1;
+  input [0:0] we;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we[i]) begin
+        mem[addr_w][i*8 +:8] <= D[i*8 +:8];
+      end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q0 = mem[addr_r0];
+  end
+
+  always @(*) begin
+    Q1 = mem[addr_r1];
+  end
+
+endmodule
