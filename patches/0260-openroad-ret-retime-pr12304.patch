+  odb::dbMaster* master = nullptr;
+  odb::dbMTerm* data = nullptr;
+  odb::dbMTerm* output = nullptr;  // the one the loads read
+  odb::dbNet* clock = nullptr;
+  SupplyPins supply;
+  std::vector<EnablePin> enables;
+  bool negedge = false;
+  bool scan = false;
+};
