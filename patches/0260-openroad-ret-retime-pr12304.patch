+
+void movePin(odb::dbITerm* pin,
+             odb::dbNet* net,
+             odb::dbModNet* mod_net = nullptr);
+void connectPin(
+    odb::dbITerm* pin,
+    odb::dbNet* net,
+    const std::unordered_map<odb::dbNet*, odb::dbModNet*>& mod_nets);
+
+std::vector<odb::dbInst*> inIdOrder(
+    const std::unordered_set<odb::dbInst*>& cells);
