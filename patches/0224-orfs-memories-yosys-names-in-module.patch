From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Mon, 16 Nov 2026 22:49:58 +0100
Subject: [PATCH] memories: number yosys's own memory names within their module
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A memory yosys names itself -- a ROM proc_rom makes of a case statement
is `$auto$proc_rom.cc:155:do_switch$12665` -- carries yosys's
design-wide counter, so its name depends on everything yosys numbered
before it elsewhere in the design. One definition elaborated once per
instance (slang's per-instance modules) gets differently numbered ROMs
in each copy, which dedupe then keeps as separate memories, and the
same module elaborated alone numbers them differently again.

The counter in such a name is now the memory's rank, in yosys's order,
among the module's yosys-named memories: the same in every copy and in
every context. Copies collapse into one entry, and dedupe still
refuses copies that differ in shape.

Not upstreamed; carried by bazel-orfs. Retires at a //:bump onto an
ORFS that carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/memories/detect.py      | 29 ++++++++++++++++++++++++-
 flow/scripts/memories/detect_test.py | 32 ++++++++++++++++++++++++++++
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/flow/scripts/memories/detect.py b/flow/scripts/memories/detect.py
index 83ab8ce..1a89e88 100644
--- a/flow/scripts/memories/detect.py
+++ b/flow/scripts/memories/detect.py
@@ -112,6 +112,30 @@ def _clock_enable_bits(val, ports: int) -> str:
     return val
 
 
+# yosys names a cell it creates itself `$<origin>$<n>`, n from one counter
+# that runs through the whole design: proc_rom's ROMs are
+# `$auto$proc_rom.cc:155:do_switch$12665`.
+_AUTO_NAME = re.compile(r"^(\$.*\$)(\d+)$")
+
+
+def canonical_cell_names(cell_names) -> dict[str, str]:
+    """A module's memory cells' names, yosys's own numbered in the order
+    yosys created them in that module, from 0.
+
+    The counter in a yosys name depends on everything yosys numbered
+    before it, elsewhere in the design: the same module elaborated alone,
+    or once per instance, numbers its memories differently. Their order
+    within the module is the module's own.
+    """
+    numbered = sorted(
+        (int(m.group(2)), name) for name in cell_names if (m := _AUTO_NAME.match(name))
+    )
+    names = {name: name for name in cell_names}
+    for i, (_, name) in enumerate(numbered):
+        names[name] = _AUTO_NAME.sub(lambda m: m.group(1) + str(i), name)
+    return names
+
+
 def scan_yosys_json(
     data: dict | str | Path, top: str | None = None
 ) -> list[schema.Memory]:
@@ -139,6 +163,7 @@ def scan_yosys_json(
         mem_cells = [
             n for n, c in cells.items() if c.get("type", "") in ("$mem_v2", "$mem")
         ]
+        canonical = canonical_cell_names(mem_cells)
         for cell_name, cell_info in cells.items():
             cell_type = cell_info.get("type", "")
             if cell_type not in ("$mem_v2", "$mem"):
@@ -279,7 +304,9 @@ def scan_yosys_json(
             # array inside a module that also does something else is the
             # design asking for flip-flops, and idiomatic.judge refuses a
             # memory that is not named for its module.
-            clean_cell = cell_name[1:] if cell_name.startswith("\\") else cell_name
+            clean_cell = canonical[cell_name]
+            if clean_cell.startswith("\\"):
+                clean_cell = clean_cell[1:]
             if len(mem_cells) == 1 and (port_convention or len(cells) == 1):
                 mem_name = clean_mod_name
             else:
diff --git a/flow/scripts/memories/detect_test.py b/flow/scripts/memories/detect_test.py
index dd5940b..4e8ad01 100644
--- a/flow/scripts/memories/detect_test.py
+++ b/flow/scripts/memories/detect_test.py
@@ -258,6 +258,38 @@ class FirtoolConventionTest(unittest.TestCase):
         )
         self.assertEqual(names, ["m.Memory", "m.Other"])
 
+    def test_yosys_numbered_memories_are_numbered_within_their_module(self):
+        # proc_rom names a ROM by a counter that runs through the design:
+        # each copy of a module, and the module elaborated alone, number
+        # theirs differently, in the same order.
+        def rom_module(*numbers):
+            return {
+                "cells": {
+                    "$auto$proc_rom.cc:155:do_switch$%d" % n: _mem_cell(16, 4)
+                    for n in numbers
+                }
+                | {"\\glue": {"type": "$and"}}
+            }
+
+        whole = detect.scan_yosys_json(
+            {
+                "modules": {
+                    "\\MSHR$top.u0": rom_module(12673, 12669),
+                    "\\MSHR$top.u1": rom_module(12681, 12677),
+                }
+            },
+            top="top",
+        )
+        alone = detect.scan_yosys_json(
+            {"modules": {"\\MSHR": rom_module(12665, 12669)}}, top="MSHR"
+        )
+        names = [
+            "MSHR.$auto$proc_rom.cc:155:do_switch$0",
+            "MSHR.$auto$proc_rom.cc:155:do_switch$1",
+        ]
+        self.assertEqual(sorted(m.name for m in whole), names)
+        self.assertEqual(sorted(m.name for m in alone), names)
+
     def test_inline_array_with_other_logic_is_named_per_cell(self):
         # One memory among other logic, ports not firtool's: the module is
         # not a memory, so the entry must not take its name.
