From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] AUTO_MEMORIES_REGFILES: read the surgered Verilog

gen_memories looks up the module an AUTO_MEMORIES_REGFILES spec names
in the Verilog files it is given, and was given VERILOG_FILES: with
SYNTH_VERILOG_SURGERY, the originals, not the copies synthesis reads. A
module that surgery creates (coralnpu-regfile's Regfile_rf) was then
never found, and the build stopped. It now gets the surgered copies.

Fixes 0089 together with 0094. Not upstreamed: AUTO_MEMORIES_REGFILES
is carried here only. Retires with 0089.

---
diff --git a/flow/Makefile b/flow/Makefile
index 80a634877..db1149f8e 100644
--- a/flow/Makefile
+++ b/flow/Makefile
@@ -277,7 +277,7 @@ do-auto-memories: $(RESULTS_DIR)/memories_inferred.json
 	  --yosys-json $(RESULTS_DIR)/memories_inferred.json \
 	  --out-dir $(RESULTS_DIR)/memories \
 	  --json $(RESULTS_DIR)/memories.json \
-	  $(foreach file,$(VERILOG_FILES),--verilog $(file)) \
+	  $(foreach file,$(if $(SYNTH_VERILOG_SURGERY),$(addprefix $(OBJECTS_DIR)/surgery/,$(notdir $(VERILOG_FILES))),$(VERILOG_FILES)),--verilog $(file)) \
 	  $(foreach file,$(ADDITIONAL_MEMORIES),--memories $(file)) \
 	  $(foreach file,$(AUTO_MEMORIES_REGFILES),--regfile-spec $(file)) \
 	  $(foreach m,$(AUTO_MEMORIES_MACRO_PLACE),--macro-place $(m)) \
