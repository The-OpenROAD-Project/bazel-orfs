diff --git a/src/odb/test/replace_hier_mod7.tcl b/src/odb/test/replace_hier_mod7.tcl
new file mode 100644
index 0000000000..09817fa4e1
--- /dev/null
+++ b/src/odb/test/replace_hier_mod7.tcl
@@ -0,0 +1,46 @@
+# Test hier module swap with modules that have child module instances:
+# Outer (one child) -> Outer_new (two levels of children) -> Outer, and an
+# undone swap.  Child modules have instance and net names (_1_, _013_) that
+# their parents also have.  Outer_new is copied from instance outer2 in the
+# top block, Outer from the child block the first swap saved it to.
+
+source "helpers.tcl"
+read_liberty Nangate45/Nangate45_typ.lib
+read_lef Nangate45/Nangate45.lef
+
+read_verilog replace_hier_mod7.v
+link_design top -hier
+create_clock -period 1 clk
+
+proc report_design { } {
+  set block [ord::get_db_block]
+  puts "modules: [lsort [lmap m [$block getModules] { $m getName }]]"
+  puts "nets: [lsort [lmap n [$block getNets] { $n getName }]]"
+  report_cell_usage outer
+  report_checks -through r2/D -digits 4
+}
+
+puts "### Initial outer is Outer ###"
+report_design
+
+set_debug_level ODB replace_design_check_sanity 1
+
+puts "### swap outer to Outer_new ###"
+replace_hier_module outer Outer_new
+report_design
+
+puts "### swap outer back to Outer ###"
+replace_hier_module outer Outer
+report_design
+
+puts "### swap outer to Outer_new and undo ###"
+set block [ord::get_db_block]
+odb::dbDatabase_beginEco $block
+replace_hier_module outer Outer_new
+odb::dbDatabase_endEco $block
+odb::dbDatabase_undoEco $block
+report_design
+
+puts "### swap outer to Outer_new again ###"
+replace_hier_module outer Outer_new
+report_design
