From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Wed, 14 Oct 2026 22:30:00 +0200
Subject: [PATCH] sta: an enabled cond arc set missing an edge does not disable
 the default set
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ASAP7's ICGx1_ASAP7_75t_R has a CLK->GCLK set conditioned on ENA and
SE that carries only the falling edge, beside an unconditioned set
with both. With ENA tied high, Sim disabled the default set whole: the
rising CLK->GCLK arc went with it, nothing behind the gate was clocked,
and its flops were untimed. The library is what is broken; Sim now
tolerates it by leaving the default set enabled when the conditioned
set lacks a rise or fall edge the default set has.

parallaxsw/OpenSTA@fdb00f48 (resolves parallaxsw/OpenSTA#532),
verbatim. Retires on the //:bump onto an OpenROAD whose OpenSTA
carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 src/sta/search/Sim.cc | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/sta/search/Sim.cc b/src/sta/search/Sim.cc
index 58f9ade..f874218 100644
--- a/src/sta/search/Sim.cc
+++ b/src/sta/search/Sim.cc
@@ -51,6 +51,9 @@ logicNot(LogicValue value);
 static const Pin *
 findDrvrPin(const Pin *pin,
             Network *network);
+static bool
+arcEdgesMatch(const TimingArcSet *arc_set,
+              const TimingArcSet *cond_set);
 
 Sim::Sim(StaState *sta) :
   StaState(sta),
@@ -834,7 +837,9 @@ Sim::isDisabledCond(Edge *edge,
     is_disabled = false;
     for (TimingArcSet *cond_set : cell->timingArcSets(from_port, to_port)) {
       FuncExpr *cond = cond_set->cond();
-      if (cond && evalExpr(cond, inst) == LogicValue::one) {
+      if (cond
+          && evalExpr(cond, inst) == LogicValue::one
+          && arcEdgesMatch(arc_set, cond_set)) {
         disable_cond = cond;
         is_disabled = true;
         break;
@@ -843,6 +848,20 @@ Sim::isDisabledCond(Edge *edge,
   }
 }
 
+// asap7 ICG cells like ICGx1_ASAP7_75t_R have broken conditional timing arcs
+// that only have one rise/fall edge. If the condition is true, disabling the
+// default timing arcs blocks a rise/fall edge, breaking downstream timing.
+static bool
+arcEdgesMatch(const TimingArcSet *arc_set,
+              const TimingArcSet *cond_set)
+{
+  for (const RiseFall *rf : RiseFall::range()) {
+    if (arc_set->arcTo(rf) && !cond_set->arcTo(rf))
+      return false;
+  }
+  return true;
+}
+
 bool
 Sim::isDisabledMode(Edge *edge,
                     const Instance *inst)
