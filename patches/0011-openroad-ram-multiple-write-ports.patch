+source "helpers.tcl"
+
+set_thread_count [expr [cpu_count] / 4]
+
+read_liberty Nangate45/Nangate45_typ.lib
+
+read_lef Nangate45/Nangate45_tech.lef
+read_lef Nangate45/Nangate45.lef
+
+set behavioral_file [make_result_file make_7x7_1r2w_nangate45_behavioral.v]
+
+generate_ram \
+  -mask_size 7 \
+  -word_size 7 \
+  -num_words 7 \
+  -r_ports 1 \
+  -w_ports 2 \
+  -storage_cell DFF_X1 \
+  -routing_layer {metal1 0.08} \
+  -ver_layer {metal4 0.14 9} \
+  -hor_layer {metal3 0.08 8} \
+  -filler_cells {FILLCELL_X1 FILLCELL_X2 FILLCELL_X4 FILLCELL_X8} \
+  -tapcell TAPCELL_X1 \
+  -max_tap_dist 10 \
+  -write_behavioral_verilog $behavioral_file
+
+set lef_file [make_result_file make_7x7_1r2w_nangate45.lef]
+write_abstract_lef -bloat_occupied_layers $lef_file
+diff_files make_7x7_1r2w_nangate45.lefok $lef_file
+
+set def_file [make_result_file make_7x7_1r2w_nangate45.def]
+write_def $def_file
+diff_files make_7x7_1r2w_nangate45.defok $def_file
+
+diff_files make_7x7_1r2w_nangate45_behavioral.vok $behavioral_file
+puts "pass"
diff --git a/src/ram/test/make_7x7_1r2w_nangate45_behavioral.vok b/src/ram/test/make_7x7_1r2w_nangate45_behavioral.vok
new file mode 100644
index 0000000000..99a9a13805
--- /dev/null
+++ b/src/ram/test/make_7x7_1r2w_nangate45_behavioral.vok
@@ -0,0 +1,45 @@
+module RAM7x7 (
+  clk,
+  D0,
+  D1,
+  Q,
+  addr_w0,
+  addr_w1,
+  addr_r0,
+  we0,
+  we1
+);
+  input clk;
+  input [6:0] D0;
+  input [6:0] D1;
+  output reg [6:0] Q;
+  input [2:0] addr_w0;
+  input [2:0] addr_w1;
+  input [2:0] addr_r0;
+  input [0:0] we0;
+  input [0:0] we1;
+
+  // memory array declaration
+  reg [6:0] mem[0:6];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we0[i]) begin
+        mem[addr_w0][i*7 +:7] <= D0[i*7 +:7];
+      end
+    end
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we1[i]) begin
+        mem[addr_w1][i*7 +:7] <= D1[i*7 +:7];
+      end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q = mem[addr_r0];
+  end
+
+endmodule
