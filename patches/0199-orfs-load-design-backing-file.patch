From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] grt: read the design with a backing file in OBJECTS_DIR
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

load_design takes an optional -backing_file and passes it to read_db,
which keeps the database's table pages in that file instead of memory
alone. Global route reads its design with one in OBJECTS_DIR and pages
the database out once it has built the nets, and while it routes.

Carried in bazel-orfs for OpenROAD#12075, not upstreamed; retires with
the //:bump onto an ORFS that has it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/global_route.tcl |  2 +-
 flow/scripts/load.tcl         | 11 +++++++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/flow/scripts/global_route.tcl b/flow/scripts/global_route.tcl
index 8542e58fe..402d4547f 100644
--- a/flow/scripts/global_route.tcl
+++ b/flow/scripts/global_route.tcl
@@ -1,7 +1,7 @@
 utl::set_metrics_stage "globalroute__{}"
 source $::env(SCRIPTS_DIR)/load.tcl
 erase_non_stage_variables grt
-load_design 4_cts.odb 4_cts.sdc
+load_design 4_cts.odb 4_cts.sdc -backing_file $::env(OBJECTS_DIR)/grt.db
 
 # This proc is here to allow us to use 'return' to return early from this
 # file which is sourced
diff --git a/flow/scripts/load.tcl b/flow/scripts/load.tcl
index 7d70b6776..8401ffa90 100644
--- a/flow/scripts/load.tcl
+++ b/flow/scripts/load.tcl
@@ -2,7 +2,14 @@ source $::env(SCRIPTS_DIR)/util.tcl
 
 source $::env(SCRIPTS_DIR)/report_metrics.tcl
 
-proc load_design { design_file sdc_file } {
+# -backing_file <file>: an .odb's table pages kept in that file (read_db
+# -backing_file), so a stage can page out what it is done reading.
+proc load_design { design_file sdc_file args } {
+  sta::parse_key_args "load_design" args keys {-backing_file} flags {}
+  set backing {}
+  if { [info exists keys(-backing_file)] } {
+    set backing [list -backing_file $keys(-backing_file)]
+  }
   # Do not reload if design is already loaded
   set db [ord::get_db]
   if { [$db getChip] != "NULL" && [[$db getChip] getBlock] != "NULL" } {
@@ -33,7 +40,7 @@ proc load_design { design_file sdc_file } {
     read_verilog $::env(RESULTS_DIR)/$design_file
     log_cmd link_design {*}[hier_options] $::env(DESIGN_NAME)
   } elseif { $ext == ".odb" } {
-    log_cmd read_db {*}[hier_options] $::env(RESULTS_DIR)/$design_file
+    log_cmd read_db {*}[hier_options] {*}$backing $::env(RESULTS_DIR)/$design_file
   } else {
     error "Unrecognized input file $design_file"
   }
-- 
