From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] grt: read the design with a backing file in OBJECTS_DIR
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

load_design takes an optional -backing_file and passes it to read_db,
which keeps the database's table pages in that file instead of memory
alone. load_stage_input and load_design_from take it too. Global route
reads its design with one in OBJECTS_DIR and pages the database out
once it has built the nets, and while it routes.

Any other argument is an error: load_design reads the .sdc beside the
design file (#4751), and a second positional argument, the .sdc that
load_design took before, would otherwise be ignored without a word.

Carried in bazel-orfs for OpenROAD#12075, not upstreamed; retires with
the //:bump onto an ORFS that has it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/global_route.tcl |  2 +-
 flow/scripts/load.tcl         | 20 ++++++++++++++------
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/flow/scripts/global_route.tcl b/flow/scripts/global_route.tcl
index 4e6e8f5..8ee3c77 100644
--- a/flow/scripts/global_route.tcl
+++ b/flow/scripts/global_route.tcl
@@ -1,7 +1,7 @@
 utl::set_metrics_stage "globalroute__{}"
 source $::env(SCRIPTS_DIR)/load.tcl
 erase_non_stage_variables grt
-load_stage_input 4_cts.odb
+load_stage_input 4_cts.odb -backing_file $::env(OBJECTS_DIR)/grt.db
 
 source_step_tcl PRE GLOBAL_ROUTE
 
diff --git a/flow/scripts/load.tcl b/flow/scripts/load.tcl
index a557493..b04e244 100644
--- a/flow/scripts/load.tcl
+++ b/flow/scripts/load.tcl
@@ -3,13 +3,13 @@ source $::env(SCRIPTS_DIR)/util.tcl
 source $::env(SCRIPTS_DIR)/report_metrics.tcl
 
 # A step's input is the result of an earlier step of its stage.
-proc load_design { design_file } {
-  load_design_from $::env(RESULTS_DIR) $design_file
+proc load_design { design_file args } {
+  load_design_from $::env(RESULTS_DIR) $design_file {*}$args
 }
 
 # A stage's input is the previous stage's result, read from the
 # variant FLOW_INPUT_VARIANT names.
-proc load_stage_input { design_file } {
+proc load_stage_input { design_file args } {
   if { $::env(INPUT_RESULTS_DIR) ne $::env(RESULTS_DIR) } {
     if {
       $::env(AUTO_MEMORIES)
@@ -28,10 +28,18 @@ proc load_stage_input { design_file } {
         FLOW_INPUT_VARIANT unset, and remove a copy left from an earlier run."
     }
   }
-  load_design_from $::env(INPUT_RESULTS_DIR) $design_file
+  load_design_from $::env(INPUT_RESULTS_DIR) $design_file {*}$args
 }
 
-proc load_design_from { dir design_file } {
+# -backing_file <file>: an .odb's table pages kept in that file (read_db
+# -backing_file), so a stage can page out what it is done reading.
+proc load_design_from { dir design_file args } {
+  sta::parse_key_args "load_design" args keys {-backing_file} flags {}
+  sta::check_argc_eq0 "load_design" $args
+  set backing {}
+  if { [info exists keys(-backing_file)] } {
+    set backing [list -backing_file $keys(-backing_file)]
+  }
   # Do not reload if design is already loaded
   set db [ord::get_db]
   if { [$db getChip] != "NULL" && [[$db getChip] getBlock] != "NULL" } {
@@ -59,7 +67,7 @@ proc load_design_from { dir design_file } {
     read_verilog $dir/$design_file
     log_cmd link_design {*}[hier_options] $::env(DESIGN_NAME)
   } elseif { $ext == ".odb" } {
-    log_cmd read_db {*}[hier_options] $dir/$design_file
+    log_cmd read_db {*}[hier_options] {*}$backing $dir/$design_file
   } else {
     error "Unrecognized input file $design_file"
   }
-- 
