From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Tue, 13 Oct 2026 16:00:00 +0200
Subject: [PATCH] sta: write_timing_model writes a constant output as that
 constant
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

An output a constant drives, a tie cell or logic the constant reaches,
had no arc to it in the model and nothing else either. A parent saw an
output that nothing arrives at, and check_setup reported every endpoint
it alone feeds as unconstrained.

Such an output now gets the constant as its function, as a tie cell's
output has, so the parent's constant propagation carries it to what it
feeds.

Not upstreamed: to be proposed after parallaxsw/OpenSTA#535, which
changes the same file. Retires on the //:bump onto an OpenROAD whose
OpenSTA carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
diff --git a/src/sta/search/MakeTimingModel.cc b/src/sta/search/MakeTimingModel.cc
index 1b79848..03253dc 100644
--- a/src/sta/search/MakeTimingModel.cc
+++ b/src/sta/search/MakeTimingModel.cc
@@ -40,11 +40,13 @@
 #include "ContainerHelpers.hh"
 #include "Debug.hh"
 #include "Delay.hh"
+#include "FuncExpr.hh"
 #include "Graph.hh"
 #include "GraphClass.hh"
 #include "GraphDelayCalc.hh"
 #include "Liberty.hh"
 #include "LibertyClass.hh"
+#include "Mode.hh"
 #include "Network.hh"
 #include "NetworkClass.hh"
 #include "Path.hh"
@@ -55,6 +57,7 @@
 #include "Sdc.hh"
 #include "SdcClass.hh"
 #include "Search.hh"
+#include "Sim.hh"
 #include "Sta.hh"
 #include "StaState.hh"
 #include "TableModel.hh"
@@ -111,6 +114,7 @@ MakeTimingModel::makeTimingModel()
 
   sta_->searchPreamble();
 
+  setConstantOutputs();
   findTimingFromInputs();
   findClkedOutputPaths();
   findClkTreeDelays();
@@ -234,6 +238,28 @@ MakeTimingModel::makePorts()
   delete port_iter;
 }
 
+// An output a constant drives is that constant in the model, as a tie
+// cell's output is: a parent propagates it, where an output with no
+// arc to it would leave what it feeds unconstrained.
+void
+MakeTimingModel::setConstantOutputs()
+{
+  Sim *sim = scene_->mode()->sim();
+  sim->ensureConstantsPropagated();
+  InstancePinIterator *pin_iter = network_->pinIterator(network_->topInstance());
+  while (pin_iter->hasNext()) {
+    const Pin *pin = pin_iter->next();
+    if (!network_->direction(pin)->isOutput())
+      continue;
+    LogicValue value = sim->simValue(pin);
+    if (value == LogicValue::zero)
+      modelPort(pin)->setFunction(FuncExpr::makeZero());
+    else if (value == LogicValue::one)
+      modelPort(pin)->setFunction(FuncExpr::makeOne());
+  }
+  delete pin_iter;
+}
+
 // Find port max_cap/max_slew limits.
 void
 MakeTimingModel::setPortLimits(const Pin *pin,
diff --git a/src/sta/search/MakeTimingModelPvt.hh b/src/sta/search/MakeTimingModelPvt.hh
index 4d7afc9..87cc0a7 100644
--- a/src/sta/search/MakeTimingModelPvt.hh
+++ b/src/sta/search/MakeTimingModelPvt.hh
@@ -72,6 +72,7 @@ private:
   void makeCell();
   float findArea();
   void makePorts();
+  void setConstantOutputs();
   void setPortLimits(const Pin *pin,
                      LibertyPort *lib_port);
   void checkClock(Clock *clk);
