From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] ram: stop on out-of-range option values
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A value out of range stopped nothing: -banks, -bank_columns and
-bit_folds below 1 were clamped to 1, a negative -read_latency read as
0, a negative -zero_word as no zero word, -service_columns below 1 was
ignored, and a negative -rb_ports went into the read port count.
-rb_ports 0 with no other read port also passed the check for at least
one read port. Each now stops with its own message (RAM-0036, RAM-0071,
RAM-0092 to RAM-0096).

Tested: src/ram/test/option_errors_asap7.tcl.

Commit 17 of 23 in OpenROAD #11723, carried here from it. Not
upstreamed; retires at a //:bump onto an OpenROAD that has it.
---
 src/ram/src/ram.cpp                  | 25 +++++++++++++-----
 src/ram/src/ram.tcl                  | 14 +++++++++-
 src/ram/test/BUILD                   |  5 ++++
 src/ram/test/CMakeLists.txt          |  1 +
 src/ram/test/option_errors_asap7.tcl | 38 ++++++++++++++++++++++++++++
 src/ram/test/regression_tests.tcl    |  1 +
 6 files changed, 77 insertions(+), 7 deletions(-)
 create mode 100644 src/ram/test/option_errors_asap7.tcl

diff --git a/src/ram/src/ram.cpp b/src/ram/src/ram.cpp
index f9f9131104..f442b4fc4f 100644
--- a/src/ram/src/ram.cpp
+++ b/src/ram/src/ram.cpp
@@ -1954,14 +1954,27 @@ void RamGen::generate(const int mask_size,
                       const int service_sites,
                       const std::string& bank_column_layout)
 {
+  if (banks < 1 || bank_columns < 1) {
+    logger_->error(RAM,
+                   92,
+                   "-banks {} and -bank_columns {} must be at least 1.",
+                   banks,
+                   bank_columns);
+  }
+  if (bit_folds < 1) {
+    logger_->error(RAM, 93, "-bit_folds {} must be at least 1.", bit_folds);
+  }
+  if (rb_ports < 0) {
+    logger_->error(RAM, 94, "-rb_ports {} must not be negative.", rb_ports);
+  }
   // Banks: every port decodes every word's whole address, and a row holds
   // bank_columns words, laid out as the column mux lays out its words;
   // without banks, the column mux as it was.
   // -decoder word: each port decodes every word's whole address through
   // a balanced AND2 tree per word, the banks' decoders, banks or none
   banked_ = banks > 1 || bank_columns > 1 || decoder == "word";
-  banks_ = std::max(banks, 1);
-  bank_columns_ = std::max(bank_columns, 1);
+  banks_ = banks;
+  bank_columns_ = bank_columns;
   bank_interleaved_ = bank_order == "interleaved";
   if (banked_) {
     if (column_mux_ratio_arg != 1) {
@@ -2001,10 +2014,10 @@ void RamGen::generate(const int mask_size,
     logger_->error(
         RAM, 73, "-write_style mux is not supported with -use_latch.");
   }
+  if (read_latency_ != 0 && read_latency_ != 1) {
+    logger_->error(RAM, 71, "-read_latency is 0 or 1.");
+  }
   if (read_latency_ > 0) {
-    if (read_latency_ != 1) {
-      logger_->error(RAM, 71, "-read_latency is 0 or 1.");
-    }
     if (column_mux_ratio_arg > 1 || rw_ports > 0) {
       logger_->error(RAM,
                      72,
@@ -2032,7 +2045,7 @@ void RamGen::generate(const int mask_size,
                    "or -decoder word: the column mux reads a row's words "
                    "interleaved.");
   }
-  bit_folds_ = std::max(bit_folds, 1);
+  bit_folds_ = bit_folds;
   slice_width_ = mask_size * column_mux_ratio + column_mux_ratio;
   // the word's own bits; with -bit_folds the last fold may be short, its
   // missing bits pads: columns with no port, flop or read tree
diff --git a/src/ram/src/ram.tcl b/src/ram/src/ram.tcl
index 84044c935c..56b221e732 100644
--- a/src/ram/src/ram.tcl
+++ b/src/ram/src/ram.tcl
@@ -119,7 +119,12 @@ proc generate_ram_netlist { args } {
     utl::error RAM 53 "A read/write port is the only write port."
   }
 
-  if { $rw_ports + $r_ports < 1 && ![info exists keys(-rb_ports)] } {
+  # banked read ports count as read ports
+  set rb_given 0
+  if { [info exists keys(-rb_ports)] } {
+    set rb_given $keys(-rb_ports)
+  }
+  if { $rw_ports + $r_ports + max($rb_given, 0) < 1 } {
     utl::error RAM 36 "Must specify at least one read output port"
   }
 
@@ -171,6 +176,9 @@ proc generate_ram_netlist { args } {
   set zero_word -1
   if { [info exists keys(-zero_word)] } {
     set zero_word $keys(-zero_word)
+    if { $zero_word < 0 } {
+      utl::error RAM 96 "-zero_word $zero_word is not a word."
+    }
   }
 
   # An asynchronous reset of every word to this value.
@@ -232,6 +240,10 @@ proc generate_ram_netlist { args } {
       utl::error RAM 89 "-service_columns is {every sites}."
     }
     lassign $keys(-service_columns) service_every service_sites
+    if { $service_every < 1 || $service_sites < 1 } {
+      utl::error RAM 95 "-service_columns {$service_every $service_sites} needs\
+        two counts of at least 1."
+    }
   }
 
   # A row's words interleaved bit by bit (the column mux's order) or each
