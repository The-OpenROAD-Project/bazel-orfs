+  input [2:0] addr_w;
+  input [2:0] addr_r0;
+  input [2:0] addr_r1;
+  input [0:0] we;
+
+  // memory array declaration
+  reg [7:0] mem[0:7];
+
+  // write logic
+  integer i;
+  always @(posedge clk) begin
+    for (i = 0; i < 1; i = i + 1) begin
+      if (we[i] && addr_w != 0) begin
+        mem[addr_w][i*8 +:8] <= D[i*8 +:8];
+      end
+    end
+  end
+
+  // read logic
+  always @(*) begin
+    Q0 = addr_r0 == 0 ? 8'd0 : mem[addr_r0];
+  end
+
+  always @(*) begin
+    Q1 = addr_r1 == 0 ? 8'd0 : mem[addr_r1];
+  end
+
+endmodule
