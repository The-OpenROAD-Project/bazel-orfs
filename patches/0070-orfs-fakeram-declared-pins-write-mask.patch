 class MemoryConfig:
     """Container for functional memory configuration"""
 
-    def __init__(self, name, width_in_bits, depth, num_banks, additional_height):
+    def __init__(
+        self,
+        name,
+        width_in_bits,
+        depth,
+        num_banks,
+        additional_height,
+        pin_names=None,
+        mask_lanes=0,
