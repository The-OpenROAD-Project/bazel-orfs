diff --git a/tools/FakeRAM2.0/utils/rw_port_group.py b/tools/FakeRAM2.0/utils/rw_port_group.py
index 3f3c454..8b71ff4 100644
--- a/tools/FakeRAM2.0/utils/rw_port_group.py
+++ b/tools/FakeRAM2.0/utils/rw_port_group.py
@@ -37,6 +37,9 @@ class RWPortGroup:
             self._clk_name = None
         self._related_pin_list = []
