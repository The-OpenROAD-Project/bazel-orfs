From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] grt: back the routing grid with a file in OBJECTS_DIR
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

global_route needs more memory than many machines have on a large
design, and without swap set up for it the stage fails hours in.
global_route -backing_file reserves a file for the routing grid when the
grid is set up, failing at once when the disk cannot hold it, and the
kernel pages the grid to that file instead of to swap. The routes are
the same; the file is removed as soon as it is created.

Carried in bazel-orfs for OpenROAD#12075, not upstreamed; retires with
the //:bump onto an ORFS that has it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/global_route.tcl | 27 +++++++++++----------------
 1 file changed, 11 insertions(+), 16 deletions(-)

diff --git a/flow/scripts/global_route.tcl b/flow/scripts/global_route.tcl
index 4a69730..4e6e8f5 100644
--- a/flow/scripts/global_route.tcl
+++ b/flow/scripts/global_route.tcl
@@ -38,25 +38,14 @@ proc do_global_route { res_aware use_cugr } {
     -congestion_report_file $::global_route_congestion_report] \
     $cong_iters $::env(GLOBAL_ROUTE_ARGS) {*}$res_aware {*}$use_cugr]
 
-  log_cmd global_route {*}$all_args
+  log_cmd global_route -backing_file $::env(OBJECTS_DIR)/grt.grid {*}$all_args
 }
 set additional_args ""
 append_env_var additional_args dbProcessNode -db_process_node 1
 append_env_var additional_args VIA_IN_PIN_MIN_LAYER -via_in_pin_bottom_layer 1
 append_env_var additional_args VIA_IN_PIN_MAX_LAYER -via_in_pin_top_layer 1
 
-# SKIP_PIN_ACCESS: run the global route without building access points.
-# pin_access fails on a macro pin it cannot reach (DRT-0073), and on a
-# hierarchical design that is one pin of one block between a placement
-# and the congestion map the stage exists to produce. The guide the
-# router writes without access points is not a routable result, so this
-# is a knob for a study, not for a flow that goes on to detailed route.
-if { [env_var_equals SKIP_PIN_ACCESS 1] } {
-  utl::warn FLW 21 "SKIP_PIN_ACCESS=1: pin access skipped; the global route's\
-    guides have no access points and detailed route will not take them."
-} else {
-  log_cmd pin_access {*}$additional_args
-}
+log_cmd pin_access {*}$additional_args
 
 do_global_route $res_aware $use_cugr
 
@@ -86,10 +75,12 @@ if { !$::env(SKIP_INCREMENTAL_REPAIR) } {
   # Running DPL to fix overlapped instances
   # Run to get modified net by DPL
   utl::push_metrics_stage "globalroute__repair_design__{}"
-  log_cmd global_route -start_incremental {*}$allow_congestion
+  log_cmd global_route -start_incremental {*}$allow_congestion \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid
   detailed_placement_helper -quiet
   # Route only the modified net by DPL
   log_cmd global_route -end_incremental {*}$res_aware \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid \
     {*}$allow_congestion \
     -congestion_report_file $::env(REPORTS_DIR)/congestion_post_repair_design.rpt
   utl::pop_metrics_stage
@@ -105,11 +96,13 @@ if { !$::env(SKIP_INCREMENTAL_REPAIR) } {
   }
 
   utl::push_metrics_stage "globalroute__repair_timing__{}"
-  log_cmd global_route -start_incremental {*}$allow_congestion
+  log_cmd global_route -start_incremental {*}$allow_congestion \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid
   detailed_placement_helper -quiet
   log_cmd check_placement -placeable -verbose
   # Route only the modified net by DPL
   log_cmd global_route -end_incremental {*}$res_aware \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid \
     {*}$allow_congestion \
     -congestion_report_file $::env(REPORTS_DIR)/congestion_post_repair_timing.rpt
   utl::pop_metrics_stage
@@ -135,10 +128,12 @@ if { !$::env(SKIP_INCREMENTAL_REPAIR) } {
 
 if { !$::env(OPT_POST_GRT_WNS) } {
   utl::push_metrics_stage "globalroute__recover_power__{}"
-  log_cmd global_route -start_incremental {*}$allow_congestion
+  log_cmd global_route -start_incremental {*}$allow_congestion \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid
   recover_power_helper
   # Route the modified nets by rsz journal restore
   log_cmd global_route -end_incremental {*}$res_aware \
+    -backing_file $::env(OBJECTS_DIR)/grt.grid \
     {*}$allow_congestion \
     -congestion_report_file $::env(REPORTS_DIR)/congestion_post_recover_power.rpt
   utl::pop_metrics_stage
