From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] mpl: the smallest outline at which a packing fits

smallestHeight(), smallestWidth() and smallestSameAspect() bisect over
exact checks for the one outline change that makes a problem fit, on a
given grid (rows, sites); a bigger outline never makes a packing
impossible, so a bisection is exact. The questions share one budget, and
an undecided one widens the reported range instead of stalling.

Not upstreamed; retires at the //:bump onto an OpenROAD that has it.

---
diff --git a/src/mpl/src/packing.cpp b/src/mpl/src/packing.cpp
index 44a1142a79..bca8e2c6c3 100644
--- a/src/mpl/src/packing.cpp
+++ b/src/mpl/src/packing.cpp
@@ -678,6 +678,158 @@ PackingResult checkPacking(const PackingProblem& problem,
   return ladder(problem, used);
 }
 
+namespace {
+
+int64_t roundUp(const int64_t value, const int step)
+{
+  return (value + step - 1) / step * step;
+}
+
+// Bisect over multiples of `step` for the smallest value at which
+// `resize(value)` fits. `fits(value)` must be monotone.
+template <typename Resize>
+DimensionFix bisect(const PackingProblem& problem,
+                    const int step,
+                    const int64_t limit,
+                    const PackingLimits& limits,
+                    Resize resize)
+{
+  // A bisection asks some 30 questions; they share one budget, and an
+  // undecided one widens the range rather than stalling the error.
+  PackingLimits each = limits;
+  each.deterministic_time = limits.deterministic_time / 30;
+  auto check = [&](const int64_t value) {
+    return checkPacking(resize(problem, static_cast<int>(value)), each).status;
+  };
+  // proven_lo: largest value proven not to fit; lo: largest value not
+  // known to fit (proven or undecided); hi: smallest value proven to fit.
+  DimensionFix fix;
+  int64_t proven_lo = 0;
+  int64_t lo = 0;
+  int64_t hi = step;
+  const int64_t top = roundUp(limit, step);
+  for (;; hi = std::min(roundUp(hi * 2, step), top)) {
+    if (hi <= lo) {
+      return fix;  // nothing up to the search limit fits
+    }
+    const PackingStatus status = check(hi);
+    if (status == PackingStatus::kFits) {
+      break;
+    }
+    if (status == PackingStatus::kDoesNotFit) {
+      proven_lo = hi;
+    }
+    lo = hi;
+  }
+  while (hi - lo > step) {
+    const int64_t probe
+        = std::min(roundUp(lo + (hi - lo) / 2, step), hi - step);
+    switch (check(probe)) {
+      case PackingStatus::kFits:
+        hi = probe;
+        break;
+      case PackingStatus::kDoesNotFit:
+        proven_lo = std::max(proven_lo, probe);
+        lo = probe;
+        break;
+      case PackingStatus::kUndecided:
+        lo = probe;
+        break;
+    }
+  }
+  fix.found = true;
+  fix.upper = static_cast<int>(hi);
+  fix.lower = static_cast<int>(std::min(proven_lo + step, hi));
+  return fix;
+}
+
+int64_t searchLimit(const PackingProblem& problem)
+{
+  int64_t limit = std::max(problem.width, problem.height);
+  for (const PackingBlock& block : problem.blocks) {
+    int64_t largest = 0;
+    for (const Tiling& shape : block.shapes) {
+      largest = std::max<int64_t>(largest, shape.width() + shape.height());
+    }
+    for (const SoftShape& shape : block.soft_shapes) {
+      largest = std::max<int64_t>(largest, shape.area);
+    }
+    if (block.isFixed()) {
+      largest += std::max(*block.fixed_x, *block.fixed_y);
+    }
+    limit += largest;
+  }
+  return std::min<int64_t>(limit, std::numeric_limits<int>::max() / 2);
+}
+
+}  // namespace
+
+DimensionFix smallestHeight(const PackingProblem& problem,
+                            const int step,
+                            const PackingLimits& limits)
+{
+  return bisect(problem,
+                step,
+                searchLimit(problem),
+                limits,
+                [](PackingProblem copy, const int value) {
+                  copy.height = value;
+                  return copy;
+                });
+}
+
+DimensionFix smallestWidth(const PackingProblem& problem,
+                           const int step,
+                           const PackingLimits& limits)
+{
+  return bisect(problem,
+                step,
+                searchLimit(problem),
+                limits,
+                [](PackingProblem copy, const int value) {
+                  copy.width = value;
+                  return copy;
+                });
+}
+
+int sameAspectHeight(const PackingProblem& problem,
+                     const int width,
+                     const int height_step)
+{
+  const int64_t w = problem.width;
+  return static_cast<int>(roundUp(
+      (width * static_cast<int64_t>(problem.height) + w - 1) / w, height_step));
+}
+
+DimensionFix smallestSameAspect(const PackingProblem& problem,
+                                const int width_step,
+                                const int height_step,
+                                const PackingLimits& limits)
+{
+  return bisect(problem,
+                width_step,
+                searchLimit(problem),
+                limits,
+                [&problem, height_step](PackingProblem copy, const int value) {
+                  copy.width = value;
+                  copy.height = sameAspectHeight(problem, value, height_step);
+                  return copy;
+                });
+}
+
+PackingFixes findFixes(const PackingProblem& problem,
+                       const int width_step,
+                       const int height_step,
+                       const PackingLimits& limits)
+{
+  PackingFixes fixes;
+  fixes.height = smallestHeight(problem, height_step, limits);
+  fixes.width = smallestWidth(problem, width_step, limits);
+  fixes.same_aspect
+      = smallestSameAspect(problem, width_step, height_step, limits);
+  return fixes;
+}
+
 void writePackingProblem(std::ostream& out,
                          const std::string& tag,
                          const PackingProblem& problem)
diff --git a/src/mpl/src/packing.h b/src/mpl/src/packing.h
index e4cdc11ca8..b858a1a19a 100644
--- a/src/mpl/src/packing.h
+++ b/src/mpl/src/packing.h
@@ -100,6 +100,50 @@ struct PackingLimits
 PackingResult checkPacking(const PackingProblem& problem,
                            const PackingLimits& limits = {});
 
+// The smallest outline dimension at which the problem fits, searched on
+// multiples of `step` (a row height, a site width). `lower` is proven not to
+// fit below it, `upper` proven to fit; they are equal unless a check was
+// undecided. A bigger outline never makes a packing impossible, so the
+// search is a bisection over exact checks.
+struct DimensionFix
+{
+  bool found{false};  // no outline up to the search limit fits
+  int lower{0};
+  int upper{0};
+};
+
+// Keep the width, grow or shrink the height.
+DimensionFix smallestHeight(const PackingProblem& problem,
+                            int step,
+                            const PackingLimits& limits = {});
+// Keep the height, grow or shrink the width.
+DimensionFix smallestWidth(const PackingProblem& problem,
+                           int step,
+                           const PackingLimits& limits = {});
+// Keep the aspect ratio; the result is the width, on multiples of
+// `width_step`; the height follows as ceil(width * height / problem.width)
+// rounded up to `height_step`.
+DimensionFix smallestSameAspect(const PackingProblem& problem,
+                                int width_step,
+                                int height_step,
+                                const PackingLimits& limits = {});
+
+// The three single changes to the outline that make a problem fit.
+struct PackingFixes
+{
+  DimensionFix height;       // at the same width
+  DimensionFix width;        // at the same height
+  DimensionFix same_aspect;  // the width; the height keeps the ratio
+};
+
+PackingFixes findFixes(const PackingProblem& problem,
+                       int width_step,
+                       int height_step,
+                       const PackingLimits& limits = {});
+
+// The height that goes with `width` under smallestSameAspect().
+int sameAspectHeight(const PackingProblem& problem, int width, int height_step);
+
 // A plain-text form of a problem, one line per item, for reproducers:
 //   P <tag> <width> <height> <blocks>
 //   B <name> F <x> <y> <width> <height>        a fixed block
diff --git a/src/mpl/test/cpp/TestPacking.cpp b/src/mpl/test/cpp/TestPacking.cpp
index 782bab9788..3fef7ee559 100644
--- a/src/mpl/test/cpp/TestPacking.cpp
+++ b/src/mpl/test/cpp/TestPacking.cpp
@@ -7,10 +7,12 @@
 
 #include <algorithm>
 #include <cstdint>
+#include <functional>
 #include <random>
 #include <sstream>
 #include <stdexcept>
 #include <string>
+#include <tuple>
 #include <utility>
 #include <vector>
 
@@ -340,5 +342,76 @@ TEST(Packing, IdenticalBlocksAgreeWithExhaustiveSearch)
   }
 }
 
+// A planted W x H perfect packing kept at width W must need exactly
+// height H: the area alone forbids less, the plant proves H suffices.
+TEST(PackingFix, SmallestHeightOfPlantedPackingIsItsHeight)
+{
+  std::mt19937 rng(4);
+  for (int pieces = 2; pieces <= 8; pieces++) {
+    const PackingProblem problem{
+        1000, 300, plantGuillotine(1000, 700, pieces, rng)};
+    const DimensionFix fix = smallestHeight(problem, 1);
+    ASSERT_TRUE(fix.found) << pieces;
+    EXPECT_EQ(fix.lower, 700) << pieces;
+    EXPECT_EQ(fix.upper, 700) << pieces;
+  }
+}
+
+TEST(PackingFix, SmallestWidthOfPlantedPackingIsItsWidth)
+{
+  std::mt19937 rng(5);
+  for (int pieces = 2; pieces <= 8; pieces++) {
+    const PackingProblem problem{
+        3000, 700, plantGuillotine(1000, 700, pieces, rng)};
+    const DimensionFix fix = smallestWidth(problem, 1);
+    ASSERT_TRUE(fix.found) << pieces;
+    EXPECT_EQ(fix.lower, 1000) << pieces;
+    EXPECT_EQ(fix.upper, 1000) << pieces;
+  }
+}
+
+// Every proposed fix, applied, fits; one step less does not.
+TEST(PackingFix, FixesAreTightOnTheGrid)
+{
+  const int step = 7;
+  const PackingProblem problem{
+      50, 50, {rigid(30, 30), rigid(30, 30), rigid(20, 45)}};
+  for (const auto& [name, fix, apply] :
+       std::vector<std::tuple<std::string,
+                              DimensionFix,
+                              std::function<PackingProblem(int)>>>{
+           {"height",
+            smallestHeight(problem, step),
+            [&](int v) { return PackingProblem{50, v, problem.blocks}; }},
+           {"width",
+            smallestWidth(problem, step),
+            [&](int v) { return PackingProblem{v, 50, problem.blocks}; }},
+       }) {
+    ASSERT_TRUE(fix.found) << name;
+    EXPECT_EQ(fix.lower, fix.upper) << name;
+    EXPECT_EQ(fix.upper % step, 0) << name;
+    EXPECT_EQ(checkPacking(apply(fix.upper)).status, PackingStatus::kFits)
+        << name;
+    EXPECT_EQ(checkPacking(apply(fix.upper - step)).status,
+              PackingStatus::kDoesNotFit)
+        << name;
+  }
+}
+
+TEST(PackingFix, SameAspectKeepsTheRatio)
+{
+  // 2:1 outline; two 60 x 60 squares need 120 wide, so 120 x 60.
+  const PackingProblem problem{100, 50, {rigid(60, 60), rigid(60, 60)}};
+  const DimensionFix fix = smallestSameAspect(problem, 1, 1);
+  ASSERT_TRUE(fix.found);
+  EXPECT_EQ(fix.upper, 120);
+}
+
+TEST(PackingFix, BlockWiderThanAnyHeightAllowsIsNotFixedByHeight)
+{
+  const PackingProblem problem{100, 100, {rigid(150, 10)}};
+  EXPECT_FALSE(smallestHeight(problem, 1).found);
+}
+
 }  // namespace
 }  // namespace mpl
