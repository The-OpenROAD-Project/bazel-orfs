From e75e2cc5ecb3b63b537226296ea21af97fd8ac15 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Wed, 7 Oct 2026 21:08:28 +0200
Subject: [PATCH] asap7/cva6-regfile: cva6's integer register file, generated
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

cva6's ariane_regfile keeps its array behind packed bus ports with
widths in a struct parameter, which a spec cannot name. A
SYNTH_VERILOG_SURGERY script (surgery.py, a hack) recognises the module
token for token and keeps its parameters and ports, moving the array
into ariane_regfile_rf: 32 x 32, x0 zero, four reads, two writes of
which the later wins, reset to zero. An elaboration-time $error stops a
configuration of another shape. An AUTO_MEMORIES_REGFILES module spec
with write_priority last replaces ariane_regfile_rf. cva6's config.mk
names its source directory rather than DESIGN_NICKNAME's, so the
variant can include it.

Not upstreamed: carried in bazel-orfs for the register-file campaign;
needs ORFS 0094 and OpenROAD 0010 (async_reset, write_priority).

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 .../cva6-regfile/ariane_regfile_rf.regfile    |  28 ++++
 flow/designs/asap7/cva6-regfile/config.mk     |  11 ++
 flow/designs/asap7/cva6-regfile/surgery.py    | 131 ++++++++++++++++++
 flow/designs/asap7/cva6/config.mk             |   8 +-
 4 files changed, 174 insertions(+), 4 deletions(-)
 create mode 100644 flow/designs/asap7/cva6-regfile/ariane_regfile_rf.regfile
 create mode 100644 flow/designs/asap7/cva6-regfile/config.mk
 create mode 100644 flow/designs/asap7/cva6-regfile/surgery.py

diff --git a/flow/designs/asap7/cva6-regfile/ariane_regfile_rf.regfile b/flow/designs/asap7/cva6-regfile/ariane_regfile_rf.regfile
new file mode 100644
index 000000000..0ca0e9e74
--- /dev/null
+++ b/flow/designs/asap7/cva6-regfile/ariane_regfile_rf.regfile
@@ -0,0 +1,28 @@
+# cva6's integer register file as standard cells, inlined in its place:
+# ariane_regfile_rf, the module surgery.py moves the array of
+# ariane_regfile into. 32 x 32 with x0 reading zero, four combinational
+# reads, two writes of which the later port wins (cv32a65x commits two
+# instructions a cycle, which may write one register), a clock gate per
+# word, every word reset to zero by rst_ni.
+module ariane_regfile_rf
+words 32
+bits 32
+clock clk_i
+async_reset rst_ni low
+read raddr0 rdata0
+read raddr1 rdata1
+read raddr2 rdata2
+read raddr3 rdata3
+write waddr0 wdata0 we0
+write waddr1 wdata1 we1
+write_priority last
+zero_word 0
+write_style clock_gate
+cell icg ICGx1_ASAP7_75t_R
+cell flop DFFHQNx1_ASAP7_75t_R
+cell flop_r DFFASRHQNx1_ASAP7_75t_R
+cell tie_hi TIEHIx1_ASAP7_75t_R
+cell and2 AND2x2_ASAP7_75t_R
+cell or2 OR2x2_ASAP7_75t_R
+cell ao22 AO22x2_ASAP7_75t_R
+cell inv INVx1_ASAP7_75t_R
diff --git a/flow/designs/asap7/cva6-regfile/config.mk b/flow/designs/asap7/cva6-regfile/config.mk
new file mode 100644
index 000000000..54749adbf
--- /dev/null
+++ b/flow/designs/asap7/cva6-regfile/config.mk
@@ -0,0 +1,11 @@
+# cva6 with its integer register file built by AUTO_MEMORIES_REGFILES: a
+# SYNTH_VERILOG_SURGERY script (surgery.py, a hack) moves the array of
+# ariane_regfile into ariane_regfile_rf, and the spec replaces that
+# module, inlined. The same RTL otherwise, constraints and utilisation.
+export DESIGN_NICKNAME = cva6-regfile
+
+include designs/asap7/cva6/config.mk
+
+export SYNTH_VERILOG_SURGERY  = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/surgery.py
+export AUTO_MEMORIES          = 1
+export AUTO_MEMORIES_REGFILES = $(DESIGN_HOME)/$(PLATFORM)/$(DESIGN_NICKNAME)/ariane_regfile_rf.regfile
diff --git a/flow/designs/asap7/cva6-regfile/surgery.py b/flow/designs/asap7/cva6-regfile/surgery.py
new file mode 100644
index 000000000..06f02b6eb
--- /dev/null
+++ b/flow/designs/asap7/cva6-regfile/surgery.py
@@ -0,0 +1,131 @@
+"""SYNTH_VERILOG_SURGERY for cva6: its integer register file into a module.
+
+A hack. cva6's ariane_regfile (core/ariane_regfile_ff.sv) keeps its
+array behind packed bus ports and widths in a struct parameter
+(CVA6Cfg), which an AUTO_MEMORIES_REGFILES spec cannot name. This keeps
+ariane_regfile's parameters and ports and moves the array into
+ariane_regfile_rf: 32 words of 32 bits, x0 reading zero, four
+combinational reads, two writes of which the later port wins (two
+commits writing one register), every word reset to zero by rst_ni. An
+elaboration-time $error stops a configuration that is not that shape
+(cv32a65x is). test_en_i is unused, as upstream.
+
+The module is recognised by its text, token for token, comments and
+whitespace aside: anything else stops the build. Every other file is
+copied unchanged.
+"""
+
+import argparse
+import os
+import re
+import sys
+
+MODULE = "ariane_regfile"
+
+EXPECTED = "module ariane_regfile #( parameter config_pkg::cva6_cfg_t CVA6Cfg = config_pkg::cva6_cfg_empty, parameter int unsigned DATA_WIDTH = 32, parameter int unsigned NR_READ_PORTS = 2, parameter bit ZERO_REG_ZERO = 0 ) ( input logic clk_i, input logic rst_ni, input logic test_en_i, input logic [ NR_READ_PORTS-1:0][ 4:0] raddr_i, output logic [ NR_READ_PORTS-1:0][DATA_WIDTH-1:0] rdata_o, input logic [CVA6Cfg.NrCommitPorts-1:0][ 4:0] waddr_i, input logic [CVA6Cfg.NrCommitPorts-1:0][DATA_WIDTH-1:0] wdata_i, input logic [CVA6Cfg.NrCommitPorts-1:0] we_i ); localparam ADDR_WIDTH = 5; localparam NUM_WORDS = 2 ** ADDR_WIDTH; logic [ NUM_WORDS-1:0][DATA_WIDTH-1:0] mem; logic [CVA6Cfg.NrCommitPorts-1:0][ NUM_WORDS-1:0] we_dec; always_comb begin : we_decoder for (int unsigned j = 0; j < CVA6Cfg.NrCommitPorts; j++) begin for (int unsigned i = 0; i < NUM_WORDS; i++) begin if (waddr_i[j] == i) we_dec[j][i] = we_i[j]; else we_dec[j][i] = 1'b0; end end end always_ff @(posedge clk_i, negedge rst_ni) begin : register_write_behavioral if (~rst_ni) begin mem <= '{default: '0}; end else begin for (int unsigned j = 0; j < CVA6Cfg.NrCommitPorts; j++) begin for (int unsigned i = 0; i < NUM_WORDS; i++) begin if (we_dec[j][i]) begin mem[i] <= wdata_i[j]; end end if (ZERO_REG_ZERO) begin mem[0] <= '0; end end end end for (genvar i = 0; i < NR_READ_PORTS; i++) begin assign rdata_o[i] = mem[raddr_i[i]]; end endmodule"
+
+REPLACEMENT = """module ariane_regfile #(
+    parameter config_pkg::cva6_cfg_t CVA6Cfg       = config_pkg::cva6_cfg_empty,
+    parameter int unsigned           DATA_WIDTH    = 32,
+    parameter int unsigned           NR_READ_PORTS = 2,
+    parameter bit                    ZERO_REG_ZERO = 0
+) (
+    input  logic                                             clk_i,
+    input  logic                                             rst_ni,
+    input  logic                                             test_en_i,
+    input  logic [        NR_READ_PORTS-1:0][           4:0] raddr_i,
+    output logic [        NR_READ_PORTS-1:0][DATA_WIDTH-1:0] rdata_o,
+    input  logic [CVA6Cfg.NrCommitPorts-1:0][           4:0] waddr_i,
+    input  logic [CVA6Cfg.NrCommitPorts-1:0][DATA_WIDTH-1:0] wdata_i,
+    input  logic [CVA6Cfg.NrCommitPorts-1:0]                 we_i
+);
+  // SYNTH_VERILOG_SURGERY (asap7/cva6-regfile/surgery.py): the array in
+  // ariane_regfile_rf, for the shape it was written for.
+  if (DATA_WIDTH != 32 || NR_READ_PORTS != 4 || CVA6Cfg.NrCommitPorts != 2
+      || ZERO_REG_ZERO != 1) begin : gen_surgery_shape
+    $error("cva6 surgery: ariane_regfile rewritten for 32 bits, 4 reads, 2 writes, x0 zero");
+  end
+  ariane_regfile_rf rf (
+      .clk_i (clk_i),
+      .rst_ni(rst_ni),
+      .raddr0(raddr_i[0]), .rdata0(rdata_o[0]),
+      .raddr1(raddr_i[1]), .rdata1(rdata_o[1]),
+      .raddr2(raddr_i[2]), .rdata2(rdata_o[2]),
+      .raddr3(raddr_i[3]), .rdata3(rdata_o[3]),
+      .waddr0(waddr_i[0]), .wdata0(wdata_i[0]), .we0(we_i[0]),
+      .waddr1(waddr_i[1]), .wdata1(wdata_i[1]), .we1(we_i[1])
+  );
+endmodule
+
+// The register file, behavioural; AUTO_MEMORIES_REGFILES replaces it.
+module ariane_regfile_rf (
+    input clk_i,
+    input rst_ni,
+    input [4:0] raddr0,
+    output [31:0] rdata0,
+    input [4:0] raddr1,
+    output [31:0] rdata1,
+    input [4:0] raddr2,
+    output [31:0] rdata2,
+    input [4:0] raddr3,
+    output [31:0] rdata3,
+    input [4:0] waddr0,
+    input [31:0] wdata0,
+    input we0,
+    input [4:0] waddr1,
+    input [31:0] wdata1,
+    input we1
+);
+  reg [31:0] mem [1:31];
+  integer i;
+  always @(posedge clk_i or negedge rst_ni) begin
+    if (!rst_ni) begin
+      for (i = 1; i < 32; i = i + 1) mem[i] <= 32'd0;
+    end else begin
+      if (we0 && waddr0 != 5'd0) mem[waddr0] <= wdata0;
+      if (we1 && waddr1 != 5'd0) mem[waddr1] <= wdata1;
+    end
+  end
+  assign rdata0 = raddr0 == 5'd0 ? 32'd0 : mem[raddr0];
+  assign rdata1 = raddr1 == 5'd0 ? 32'd0 : mem[raddr1];
+  assign rdata2 = raddr2 == 5'd0 ? 32'd0 : mem[raddr2];
+  assign rdata3 = raddr3 == 5'd0 ? 32'd0 : mem[raddr3];
+endmodule"""
+
+
+def norm(text):
+    text = re.sub(r"//[^\n]*", "", text)
+    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
+    return " ".join(text.split())
+
+
+def fail(msg):
+    sys.exit("cva6 surgery: " + msg)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--out-dir", required=True)
+    p.add_argument("files", nargs="+")
+    a = p.parse_args()
+    done = 0
+    for path in a.files:
+        with open(path) as f:
+            text = f.read()
+        found = list(re.finditer(r"^module\s+%s\b.*?^endmodule\b" % MODULE, text, re.M | re.S))
+        if len(found) > 1:
+            fail("%s defines %s %d times" % (path, MODULE, len(found)))
+        if found:
+            m = found[0]
+            if norm(m.group(0)) != EXPECTED:
+                fail("%s in %s is not the ariane_regfile this rewrite knows" % (MODULE, path))
+            text = text[: m.start()] + REPLACEMENT + text[m.end() :]
+            done += 1
+        with open(os.path.join(a.out_dir, os.path.basename(path)), "w") as f:
+            f.write(text)
+    if done != 1:
+        fail("%s found in %d files, not one" % (MODULE, done))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/flow/designs/asap7/cva6/config.mk b/flow/designs/asap7/cva6/config.mk
index 363f55e6a..1bc3f7ff3 100644
--- a/flow/designs/asap7/cva6/config.mk
+++ b/flow/designs/asap7/cva6/config.mk
@@ -4,7 +4,7 @@ export DESIGN_NAME            = cva6
 
 # Some files are listed specifically vs. sorted wildcard to control the order
 # (makes Verific happy)
-export SRC_HOME = $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)
+export SRC_HOME = $(DESIGN_HOME)/src/cva6
 export VERILOG_FILES          = $(sort $(wildcard $(SRC_HOME)/common/local/util/*.sv)) \
 	$(SRC_HOME)/core/include/config_pkg.sv \
 	$(SRC_HOME)/core/include/cv32a65x_config_pkg.sv \
@@ -70,9 +70,9 @@ export VERILOG_FILES          = $(sort $(wildcard $(SRC_HOME)/common/local/util/
 	$(PLATFORM_DIR)/verilog/fakeram7_64x28.sv \
 	$(PLATFORM_DIR)/verilog/fakeram7_64x25.sv
 
-export VERILOG_INCLUDE_DIRS = $(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/core/include \
-	$(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/core/cvfpu/src/common_cells/include \
-	$(DESIGN_HOME)/src/$(DESIGN_NICKNAME)/core/cache_subsystem/hpdcache/rtl/include
+export VERILOG_INCLUDE_DIRS = $(DESIGN_HOME)/src/cva6/core/include \
+	$(DESIGN_HOME)/src/cva6/core/cvfpu/src/common_cells/include \
+	$(DESIGN_HOME)/src/cva6/core/cache_subsystem/hpdcache/rtl/include
 
 export VERILOG_DEFINES += -D HPDCACHE_ASSERT_OFF
 
-- 
