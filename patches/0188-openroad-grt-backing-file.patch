+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#pragma once
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "utl/Logger.h"
+
+namespace grt {
+
+// Backs arrays already allocated with a file: the page-aligned interior of
+// each is copied to the file and mapped there, shared, at the same address,
+// so an array keeps its type, address and contents while the kernel pages
+// it to the file rather than to swap. The whole file is reserved up front,
+// so a disk that cannot hold it fails when the grid is set up, not when a
+// page is first written back. The file is unlinked once reserved and leaves
+// nothing behind.
+class FileBacking
+{
+ public:
+  FileBacking() = default;
+  FileBacking(const FileBacking&) = delete;
+  FileBacking& operator=(const FileBacking&) = delete;
+  ~FileBacking() { release(); }
+
+  void reserve(utl::Logger* logger, const std::string& path, size_t bytes);
+  // Maps the page-aligned interior of [data, data + bytes) to the file.
+  void map(utl::Logger* logger, void* data, size_t bytes);
+  // Before the arrays are freed or reallocated: each range becomes a
+  // private copy-on-write mapping of its contents in the file, so the
+  // allocator can reuse the addresses as ordinary memory and nothing more
+  // is written to the file.
+  void release();
+
+  static size_t pageSlack();
+
+ private:
+  struct Range
+  {
+    char* data;
+    size_t len;
+    size_t offset;
+  };
+
+  int fd_ = -1;
+  size_t size_ = 0;
+  size_t offset_ = 0;
+  std::vector<Range> ranges_;
+};
+
+}  // namespace grt
