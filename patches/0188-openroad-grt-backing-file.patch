diff --git a/src/grt/src/fastroute/src/FileBacking.cpp b/src/grt/src/fastroute/src/FileBacking.cpp
new file mode 100644
index 0000000000..ca999b308e
--- /dev/null
+++ b/src/grt/src/fastroute/src/FileBacking.cpp
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "FileBacking.h"
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+#include "utl/Logger.h"
+
+namespace grt {
+
+void FileBacking::reserve(utl::Logger* logger,
+                          const std::string& path,
+                          size_t bytes)
+{
+  release();
+  fd_ = open(path.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+  if (fd_ < 0) {
+    logger->error(utl::GRT,
+                  1255,
+                  "Cannot create the backing file {}: {}.",
+                  path,
+                  strerror(errno));
+  }
+  unlink(path.c_str());
+  const int err = posix_fallocate(fd_, 0, static_cast<off_t>(bytes));
+  if (err != 0) {
+    close(fd_);
+    fd_ = -1;
+    logger->error(utl::GRT,
+                  1256,
+                  "Cannot reserve {:.1f} MB for the routing grid in {}: {}.",
+                  bytes / 1e6,
+                  path,
+                  strerror(err));
+  }
+  size_ = bytes;
+  offset_ = 0;
+  logger->info(utl::GRT,
+               1257,
+               "Routing grid backed by a file of {:.1f} MB.",
+               bytes / 1e6);
+}
+
+void FileBacking::map(utl::Logger* logger, void* data, size_t bytes)
+{
+  if (fd_ < 0 || bytes == 0) {
+    return;
+  }
+  const uintptr_t page = sysconf(_SC_PAGESIZE);
+  const uintptr_t begin
+      = (reinterpret_cast<uintptr_t>(data) + page - 1) & ~(page - 1);
+  const uintptr_t end
+      = (reinterpret_cast<uintptr_t>(data) + bytes) & ~(page - 1);
+  if (end <= begin) {
+    return;
+  }
+  const size_t len = end - begin;
+  if (offset_ + len > size_) {
+    logger->error(utl::GRT,
+                  1258,
+                  "The backing file of {} bytes has no room for {} more.",
+                  size_,
+                  len);
+  }
+  char* p = reinterpret_cast<char*>(begin);
+  size_t done = 0;
+  while (done < len) {
+    const ssize_t n = pwrite(fd_, p + done, len - done, offset_ + done);
+    if (n <= 0) {
+      logger->error(utl::GRT,
+                    1259,
+                    "Cannot write the backing file: {}.",
+                    strerror(errno));
+    }
+    done += n;
+  }
+  if (mmap(p,
+           len,
+           PROT_READ | PROT_WRITE,
+           MAP_SHARED | MAP_FIXED,
+           fd_,
+           static_cast<off_t>(offset_))
+      == MAP_FAILED) {
+    logger->error(
+        utl::GRT, 1260, "Cannot map the backing file: {}.", strerror(errno));
+  }
+  ranges_.push_back({p, len, offset_});
+  offset_ += len;
+}
+
+void FileBacking::release()
+{
+  if (fd_ < 0) {
+    return;
+  }
+  for (const Range& range : ranges_) {
+    mmap(range.data,
+         range.len,
+         PROT_READ | PROT_WRITE,
+         MAP_PRIVATE | MAP_FIXED,
+         fd_,
+         static_cast<off_t>(range.offset));
+  }
+  ranges_.clear();
+  close(fd_);
+  fd_ = -1;
+}
+
+size_t FileBacking::pageSlack()
+{
+  return 2 * sysconf(_SC_PAGESIZE);
+}
+
+}  // namespace grt
diff --git a/src/grt/src/fastroute/src/graph2d.cpp b/src/grt/src/fastroute/src/graph2d.cpp
index 0de3e2bb22..3b3a7b62ae 100644
--- a/src/grt/src/fastroute/src/graph2d.cpp
+++ b/src/grt/src/fastroute/src/graph2d.cpp
@@ -1232,4 +1232,36 @@ void Graph2D::resetNDRCap()
   }
 }
 
+void Graph2D::mapEdges(FileBacking& backing, utl::Logger* logger)
+{
+  backing.map(logger, h_edges_.data(), h_edges_.num_elements() * sizeof(Edge));
+  backing.map(logger, v_edges_.data(), v_edges_.num_elements() * sizeof(Edge));
+}
+
+void Graph2D::mapCap3D(FileBacking& backing, utl::Logger* logger)
+{
+  backing.map(
+      logger, h_cap_3D_.data(), h_cap_3D_.num_elements() * sizeof(Cap3D));
+  backing.map(
+      logger, v_cap_3D_.data(), v_cap_3D_.num_elements() * sizeof(Cap3D));
+  backing.map(logger,
+              h_ndr_nets_.data(),
+              h_ndr_nets_.num_elements() * sizeof(*h_ndr_nets_.data()));
+  backing.map(logger,
+              v_ndr_nets_.data(),
+              v_ndr_nets_.num_elements() * sizeof(*v_ndr_nets_.data()));
+}
+
+size_t Graph2D::backingBytes(const int x_grid,
+                             const int y_grid,
+                             const int num_layers)
+{
+  const size_t cells = static_cast<size_t>(x_grid) * y_grid;
+  const size_t edges = static_cast<size_t>(x_grid - 1) * y_grid
+                       + static_cast<size_t>(x_grid) * (y_grid - 1);
+  return edges * sizeof(Edge) + 2 * cells * num_layers * sizeof(Cap3D)
+         + 2 * cells * sizeof(std::map<FrNet*, NDRUsage>)
+         + 6 * FileBacking::pageSlack();
+}
+
 }  // namespace grt
