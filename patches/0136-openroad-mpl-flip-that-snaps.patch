+  bool snapMacro(bool report = true);
 
  private:
   struct LayerData
@@ -45,7 +48,7 @@ class Snapper
   using TrackGridToPinListMap
       = odb::PtrMap<odb::dbTrackGrid, std::vector<odb::dbITerm*>>;
 
-  void snap(const odb::dbTechLayerDir& target_direction);
+  bool snap(const odb::dbTechLayerDir& target_direction, bool report);
   void alignWithManufacturingGrid(int& origin);
   void setOrigin(int origin, const odb::dbTechLayerDir& target_direction);
   int totalAlignedPins(const LayerDataList& layers_data_list,
@@ -64,9 +67,12 @@ class Snapper
   void snapPinToPosition(odb::dbITerm* pin,
                          int position,
                          const odb::dbTechLayerDir& direction);
-  void attemptSnapToExtraPatterns(int start_index,
+  bool attemptSnapToExtraPatterns(int start_index,
                                   const LayerDataList& layers_data_list,
-                                  const odb::dbTechLayerDir& target_direction);
+                                  const odb::dbTechLayerDir& target_direction,
+                                  bool report);
+  bool rightWayOnGridAligned(const LayerDataList& layers_data_list,
+                             const odb::dbTechLayerDir& direction);
 
   utl::Logger* logger_;
   odb::dbInst* inst_;
