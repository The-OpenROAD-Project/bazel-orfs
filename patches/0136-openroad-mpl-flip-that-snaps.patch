   void setMacro(odb::dbInst* inst) { inst_ = inst; }
-  void snapMacro();
+  // Snaps the macro's pins onto the track grid. Returns false when a pin on
+  // a RightWayOnGridOnly layer cannot be aligned; with report, that is an
