new file mode 100644
index 000000000..289546bd1
--- /dev/null
+++ b/flow/scripts/args.py
@@ -0,0 +1,235 @@
+#!/usr/bin/env python3
+"""Command arguments for the stage scripts: docs/user/CommandArguments.md.
+
+The stage scripts call this with $PYTHON_EXE, so that the handling of
+arguments is in Python with unit tests (flow/test/test_args.py) instead of
+in Tcl. The grammar itself is in args_grammar.bzl, which a Bazel build
+load()s too.
+
+    args.py check STAGE
+        Checks every <COMMAND>_ARGS and PLATFORM_ARGS, and warns about each
+        deprecated variable STAGE reads that is set. Run before a stage
+        erases its non-stage variables.
+
+    args.py runs COMMAND CALL RUN
+        Prints 1 or 0: whether the call runs. RUN is the flow's choice.
+
+    args.py resolve COMMAND CALL RUN N FLOW... M DEPRECATED... [LEGACY]
+        Prints 1 or 0, whether the call runs, then the arguments it gets,
+        one per line, and names the call in the log. CALL is stage.name. FLOW is the command line the flow
+        passes when no <COMMAND>_ARGS is set, deprecated variables included,
+        DEPRECATED the part of it that deprecated variables add: they rank
+        above PLATFORM_ARGS. LEGACY names a variable that replaces the
+        flow's arguments when it holds a plain command line; LEGACY:N keeps
+        the first N words of FLOW.
+"""
+
+import os
+import sys
+
+import yaml
+
+DIR = os.path.dirname(os.path.realpath(__file__))
+
+
+class ArgsError(Exception):
+    pass
+
+
+def _fail(msg):
+    raise ArgsError(msg)
+
+
+def load_grammar():
+    """args_grammar.bzl as a Python module, with Starlark's fail()."""
+    scope = {"fail": _fail}
+    with open(os.path.join(DIR, "args_grammar.bzl")) as f:
+        exec(compile(f.read(), "args_grammar.bzl", "exec"), scope)
+    return scope
+
+
+G = load_grammar()
+
+
+def tcl_split(text):
+    """Splits a value the way Tcl's {*} splits a list."""
+    words = []
+    i = 0
+    n = len(text)
+    while i < n:
+        while i < n and text[i].isspace():
+            i += 1
+        if i >= n:
+            break
+        if text[i] == "{":
+            depth = 1
+            j = i + 1
+            while j < n and depth:
+                if text[j] == "{":
+                    depth += 1
+                elif text[j] == "}":
+                    depth -= 1
+                j += 1
+            if depth:
+                raise ArgsError("unbalanced '{' in: " + text)
+            words.append(text[i + 1 : j - 1])
+            i = j
+        elif text[i] == '"':
+            j = text.find('"', i + 1)
+            if j < 0:
+                raise ArgsError("unbalanced '\"' in: " + text)
+            words.append(text[i + 1 : j])
+            i = j + 1
+        else:
+            j = i
+            while j < n and not text[j].isspace():
+                j += 1
+            words.append(text[i:j])
+            i = j
+    return words
+
+
+def edits_of(env, name, platform=False):
+    return G["parse_args"](name, env.get(name, ""), G["STAGES"], platform)
+
+
+def is_command_line(edits):
+    """True when a value uses nothing a plain command line can't say."""
+    return all(e["op"] in ("set", "flag") and not e["stage"] for e in edits)
+
+
+def check(env, stage, variables):
+    """Returns warnings; raises ArgsError on the first syntax error."""
+    for command in sorted(G["COMMANDS"]):
+        edits_of(env, G["args_variable"](command))
+    for e in edits_of(env, "PLATFORM_ARGS", platform=True):
+        if e["command"] not in G["COMMANDS"]:
+            raise ArgsError(
+                "PLATFORM_ARGS: '{}' is not a command with arguments here ({})".format(
+                    e["command"], ", ".join(sorted(G["COMMANDS"]))
+                )
+            )
+    warnings = []
+    for name in sorted(variables):
+        meta = variables[name]
+        if not meta.get("deprecated") or name not in env or env[name] == "":
+            continue
+        if str(meta.get("default", "")) == env[name]:
+            continue
+        stages = meta.get("stages", [])
+        if stages and "All stages" not in stages and stage not in stages:
+            continue
+        replacement = meta["replacement"]
+        if isinstance(replacement, dict):
+            if env[name] not in replacement:
+                continue
+            replacement = replacement[env[name]]
+        else:
+            replacement = replacement.format(value=G["quote_value"](env[name]))
+        warnings.append(
+            "{}={} is deprecated: write {}".format(name, env[name], replacement)
+        )
+    return warnings
+
+
+def resolve(env, command, stage, call, run, flow, deprecated, legacy=None, defaults={}):
+    """What one call of a command gets: [run, args, notes].
+
+    defaults are the variables.yaml defaults: a <COMMAND>_ARGS at its
+    default is the flow's own choice, and its edits get no note.
+    """
+    variable = G["args_variable"](command)
+    flow_edits = G["args_layer"](flow)
+    # A deprecated variable's option ranks above PLATFORM_ARGS where it
+    # survives in the flow's command line, as it does today; where the flow
+    # passes the option again after it, the flow's value wins, as today.
+    passed = G["resolve"]([["", flow_edits]], command, stage, call, True)["args"]
+    survives = dict(zip(passed, passed[1:] + [None]))
+    deprecated = [
+        e
+        for e in G["args_layer"](deprecated)
+        if e["option"] in survives
+        and (e["value"] is None or survives[e["option"]] == e["value"])
+    ]
+    layers = [
+        ["the flow", flow_edits],
+        ["PLATFORM_ARGS", edits_of(env, "PLATFORM_ARGS", platform=True)],
+        ["deprecated variables", deprecated],
+        [variable, edits_of(env, variable)],
+    ]
+    r = G["resolve"](layers, command, stage, call, run)
+    notes = [
+        "[{}.{}] {}: {} ({})".format(stage, call, command, G["format_args"]([e]), layer)
+        for layer, e in r["changes"]
+        if layer == "PLATFORM_ARGS"
+        or (layer == variable and env.get(variable) != defaults.get(variable))
+    ]
+    legacy, _, fixed = (legacy or "").partition(":")
+    if legacy and env.get(legacy) and is_command_line(layers[3][1]):
+        old = flow[: int(fixed or 0)] + tcl_split(env[legacy])
+        if old != r["args"]:
+            gone = [w for w in r["args"] if w.startswith("-") and w not in old]
+            notes = [
+                "{} replaces the flow's arguments to {}; it will edit them"
+                " instead, so to keep this command line add {}".format(
+                    legacy, command, " ".join("~" + w for w in gone)
+                )
+            ]
+            return [r["run"], old, notes]
+    return [r["run"], r["args"], notes]
+
+
+def _counted(argv):
+    n = int(argv[0])
+    return argv[1 : 1 + n], argv[1 + n :]
+
+
+def load_variables():
+    """variables.yaml, the metadata of every variable."""
+    with open(os.path.join(DIR, "variables.yaml")) as f:
+        return yaml.safe_load(f)
+
+
+def main(argv, env):
+    if argv[:1] == ["check"] and len(argv) == 2:
+        for w in check(env, argv[1], load_variables()):
+            print("[WARNING] " + w, file=sys.stderr)
+        return 0
+    if argv[:1] == ["resolve"] and len(argv) >= 6:
+        command, where, run = argv[1:4]
+        stage, _, call = where.partition(".")
+        flow, rest = _counted(argv[4:])
+        deprecated, rest = _counted(rest)
+        legacy = rest[0] if rest else None
+        defaults = {
+            k: str(v["default"]) for k, v in load_variables().items() if "default" in v
+        }
+        run, args, notes = resolve(
+            env, command, stage, call, run == "1", flow, deprecated, legacy, defaults
+        )
+        # The call's name goes in the log in front of the command, so a user
+        # can copy it into a scope.
+        for note in notes or ["[{}] {}".format(where, command)]:
+            print(note, file=sys.stderr)
+        print("1" if run else "0")
+        for w in args:
+            print(w)
+        return 0
+    if argv[:1] == ["runs"] and len(argv) == 4:
+        command, where, run = argv[1:4]
+        stage, _, call = where.partition(".")
+        run, _, notes = resolve(env, command, stage, call, run == "1", [], [])
+        for note in notes:
+            print(note, file=sys.stderr)
+        print("1" if run else "0")
+        return 0
+    print(__doc__, file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main(sys.argv[1:], os.environ))
+    except ArgsError as e:
+        print("[ERROR] " + str(e), file=sys.stderr)
+        sys.exit(1)
diff --git a/flow/scripts/args_grammar.bzl b/flow/scripts/args_grammar.bzl
new file mode 100644
index 000000000..d7f159fa4
--- /dev/null
+++ b/flow/scripts/args_grammar.bzl
@@ -0,0 +1,373 @@
+"""The <COMMAND>_ARGS grammar: edits to the arguments ORFS passes to a command.
+
+See docs/user/CommandArguments.md for the user's view. In short:
+
+    -option value     set the value
+    -flag             add the flag
+    ~-option          delete the option, and its value if it has one
+    1 / 0             run the command / do not run it; right after an
+                      option, 1 or 0 is its value, as in -setup_margin 0
+    stage:            in front of an edit: only in that stage
+    stage.call:       in front of an edit: only at that call
+    command:          in front of an edit: the command it is for; only in
+                      PLATFORM_ARGS, where every edit names one
+    {a b} or "a b"    a value with spaces in it, as in Tcl
+
+Layers merge lowest first. For each option the highest layer that mentions
+it decides; within a layer a call edit beats a stage edit, a stage edit
+beats an unscoped one, and later beats earlier.
+
+This file is Python and Starlark both: ORFS runs it as Python (args.py),
+and a Bazel build load()s it to check the grammar at analysis and to give
+each stage only its own edits. Keep it in the common subset: no while,
+recursion, classes, exceptions, sets, f-strings or iteration over a string,
+and nothing at the top level but assignments and defs. Errors go through
+fail(), a Starlark builtin that args.py provides when it runs this file.
+"""
+
+# The commands a <COMMAND>_ARGS variable can edit, each read in the stages
+# that run it. The variable's name is the command's in upper case.
+COMMANDS = {
+    "balance_row_usage": ["place"],
+    "buffer_ports": ["place"],
+    "clock_tree_synthesis": ["cts"],
+    "cluster_flops": ["place"],
+    "detailed_placement": ["place", "cts", "grt"],
+    "detailed_route": ["route"],
+    "global_placement": ["place"],
+    "global_route": ["grt"],
+    "improve_placement": ["place"],
+    "place_pins": ["place"],
+    "repair_antennas": ["grt", "route"],
+    "repair_design": ["place", "grt"],
+    "repair_tie_fanout": ["floorplan"],
+    "repair_timing": ["floorplan", "place", "cts", "grt"],
+    "report_metrics": ["synth", "floorplan", "place", "cts", "grt", "route", "final"],
+    "rtl_macro_placer": ["floorplan"],
+}
+
+# The stages a scope can name, in flow order.
+STAGES = ["synth", "floorplan", "place", "cts", "grt", "route", "final"]
+
+def args_variable(command):
+    return command.upper() + "_ARGS"
+
+_IDENT_START ="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
+_IDENT_REST = _IDENT_START + "0123456789"
+_SPACE = " \t\n\r"
+
+def _is_ident(s):
+    if not s or s[0] not in _IDENT_START:
+        return False
+    for i in range(1, len(s)):
+        if s[i] not in _IDENT_REST:
+            return False
+    return True
+
+def _is_option(token):
+    # -name, not -5 or -0.5: a negative number is a value.
+    return len(token) > 1 and token[0] == "-" and _is_ident(token[1:])
+
+_CLOSE = {"{": "}", "\"": "\""}
+
+def _tokenize(name, text):
+    """Splits on whitespace into (word, quoted) pairs.
+
+    {...} or "..." around a value makes it one word, as in Tcl.
+    """
+    tokens = []
+    current = ""
+    braced = False
+    close = ""
+    for i in range(len(text)):
+        c = text[i]
+        if close:
+            if c == close:
+                close = ""
+            elif c == "{" or (c == "\"" and close == "}"):
+                fail("{}: '{}' inside a quoted value at character {}; a value is quoted once".format(name, c, i))
+            else:
+                current += c
+        elif c in _CLOSE:
+            if current:
+                fail("{}: '{}' inside a word at character {}; quotes go around a whole value".format(name, c, i))
+            close = _CLOSE[c]
+            braced = True
+        elif c == "}":
+            fail("{}: '}}' with no '{{' before it, at character {}".format(name, i))
+        elif c in _SPACE:
+            if current or braced:
+                tokens.append((current, braced))
+            current = ""
+            braced = False
+        else:
+            if braced:
+                fail("{}: text right after a quoted value at character {}; put a space after it".format(name, i))
+            current += c
+    if close:
+        fail("{}: '{}' is never closed".format(name, "{" if close == "}" else "\""))
+    if current or braced:
+        tokens.append((current, braced))
+    return tokens
+
+# The run switch, as written and as the op of the edit it makes. 1 and 0
+# are the values ORFS variables take.
+_SWITCH = {"1": "on", "0": "off"}
+
+def _is_edit_word(word):
+    return word in _SWITCH or _is_option(word) or (word.startswith("~") and len(word) > 1)
+
+def _check_not_on_off(name, token):
+    """Fails on the run switch written on or off, which it is not."""
+    parts = token.split(":")
+    if parts[-1] in ("on", "off"):
+        parts[-1] = "1" if parts[-1] == "on" else "0"
+        fail("{}: '{}': the run switch is 1 or 0, as in ORFS variables; write {}, or {{{}}} for a value".format(
+            name,
+            token,
+            ":".join(parts),
+            token,
+        ))
+
+def _split_scope(name, token, platform, stages):
+    """Returns [command, stage, call, edit] for a scoped token, else None."""
+    parts = token.split(":")
+    if len(parts) == 1 or not _is_edit_word(parts[-1]):
+        # No edit after the last colon, so no scope: a value such as a:b.
+        return None
+    edit = parts[-1]
+    scopes = parts[:-1]
+    command = ""
+    if platform:
+        if not _is_ident(scopes[0]) or scopes[0] in stages:
+            fail("{}: '{}' must start with the command it is for, as in clock_tree_synthesis:{}".format(name, token, edit))
+        command = scopes[0]
+        scopes = scopes[1:]
+    if len(scopes) > 1:
+        fail("{}: '{}' has too many scopes; write {}stage:edit or {}stage.call:edit".format(
+            name,
+            token,
+            "command:" if platform else "",
+            "command:" if platform else "",
+        ))
+    stage = ""
+    call = ""
+    if scopes:
+        where = scopes[0].split(".")
+        if len(where) > 2:
+            fail("{}: '{}': a scope is a stage or stage.call".format(name, token))
+        stage = where[0]
+        if stage not in stages:
+            fail("{}: '{}': '{}' is not a stage ({}){}".format(
+                name,
+                token,
+                stage,
+                ", ".join(stages),
+                "" if platform else "; only PLATFORM_ARGS names a command",
+            ))
+        if len(where) == 2:
+            call = where[1]
+            if not _is_ident(call):
+                fail("{}: '{}': '{}' is not a call name".format(name, token, call))
+    return [command, stage, call, edit]
+
+def parse_args(name, text, stages, platform = False):
+    """Parses a variable's value into a list of edits.
+
+    Args:
+      name: the variable's name, for error messages.
+      text: the variable's value.
+      stages: the stage names a scope may use.
+      platform: True for PLATFORM_ARGS, where every edit names its command.
+
+    Returns:
+      A list of dicts with keys command, stage, call, op ("set", "flag",
+      "delete", "on" for 1 or "off" for 0), option and value. Fails on a
+      syntax error.
+
+    A 1 or 0 right after an option waiting for its value is that value, as
+    in -setup_margin 0; anywhere else, or after a scope, it is the run
+    switch.
+    """
+    edits = []
+    pending = None
+    for token, braced in _tokenize(name, text):
+        scoped = None
+        if not braced:
+            _check_not_on_off(name, token)
+            scoped = _split_scope(name, token, platform, stages)
+        if scoped != None:
+            command, stage, call, word = scoped
+        else:
+            command, stage, call, word = "", "", "", token
+        is_value = scoped == None and (not _is_edit_word(word) or (pending != None and word in _SWITCH))
+        if braced or is_value:
+            if pending == None:
+                fail("{}: '{}' is a value with no option before it; a value with spaces goes in braces".format(name, token))
+            pending["op"] = "set"
+            pending["value"] = token
+            pending = None
+            continue
+        if platform and not command:
+            fail("{}: '{}' must start with the command it is for, as in clock_tree_synthesis:{}".format(name, token, token))
+        pending = None
+        e = {"command": command, "stage": stage, "call": call, "op": "", "option": "", "value": None}
+        if word in _SWITCH:
+            e["op"] = _SWITCH[word]
+        elif word.startswith("~"):
+            if not _is_option(word[1:]):
+                fail("{}: '{}': '~' deletes an option, as in ~-repair_clock_nets".format(name, token))
+            e["op"] = "delete"
+            e["option"] = word[1:]
+        else:
+            e["op"] = "flag"
+            e["option"] = word
+            pending = e
+        edits.append(e)
+    return edits
+
+def quote_value(value):
+    """A value as the grammar writes it, in braces when it needs them."""
+    if value == "" or value in ("on", "off") or value.startswith("~") or _is_option(value) or ":" in value:
+        return "{" + value + "}"
+    for i in range(len(value)):
+        if value[i] in _SPACE or value[i] in "{}":
+            return "{" + value + "}"
+    return value
+
+def format_args(edits, platform = False):
+    """Writes edits back in the grammar: the inverse of parse_args().
+
+    The run switches go first, in their order, so that a 0 or 1 is never
+    read back as the value of a flag before it. resolve() evaluates switches
+    apart from options, so moving them changes nothing it returns but the
+    order of its changes.
+    """
+    words = []
+    switches = [e for e in edits if e["op"] in ("on", "off")]
+    options = [e for e in edits if e["op"] not in ("on", "off")]
+    for e in switches + options:
+        prefix = ""
+        if platform:
+            prefix = e["command"] + ":"
+        if e["stage"]:
+            prefix += e["stage"]
+            if e["call"]:
+                prefix += "." + e["call"]
+            prefix += ":"
+        if e["op"] in ("on", "off"):
+            words.append(prefix + ("1" if e["op"] == "on" else "0"))
+        elif e["op"] == "delete":
+            words.append(prefix + "~" + e["option"])
+        else:
+            words.append(prefix + e["option"])
+            if e["op"] == "set":
+                words.append(quote_value(e["value"]))
+    return " ".join(words)
+
+def stage_args(name, text, stage, stages, platform = False):
+    """The part of a variable's value that can matter in one stage.
+
+    An unscoped edit matters in every stage, a scoped one only in its own,
+    so a build that keys each stage on its inputs can give each stage this
+    and leave the other stages' keys alone.
+    """
+    if stage not in stages:
+        fail("{}: '{}' is not a stage ({})".format(name, stage, ", ".join(stages)))
+    edits = parse_args(name, text, stages, platform)
+    return format_args([e for e in edits if e["stage"] in ("", stage)], platform)
+
+def args_layer(words):
+    """A list of words, as a command line takes them, as a layer of edits."""
+    edits = []
+    pending = None
+    for w in words:
+        if pending != None and not _is_option(w):
+            pending["op"] = "set"
+            pending["value"] = w
+            pending = None
+            continue
+        if not _is_option(w):
+            fail("'{}' is a value with no option before it in {}".format(w, " ".join(words)))
+        e = {"command": "", "stage": "", "call": "", "op": "flag", "option": w, "value": None}
+        edits.append(e)
+        pending = e
+    return edits
+
+def _specificity(e):
+    if e["call"]:
+        return 2
+    if e["stage"]:
+        return 1
+    return 0
+
+def resolve(layers, command, stage, call, run = True):
+    """Merges layers of edits into what one call of a command gets.
+
+    Args:
+      layers: a list of [name, edits] pairs, lowest priority first, with
+        edits as parse_args() or args_layer() returns them. An edit that
+        names a command applies only to that command.
+      command: the command being called.
+      stage: the stage it is called in.
+      call: the call's name within the stage.
+      run: whether the command runs when no layer says 1 or 0.
+
+    Returns:
+      A dict: "run", a bool; "args", the words to pass, in the order the
+      options were first set; "changes", a list of [layer, edit] for each
+      edit that changed what the layers below it gave.
+    """
+    values = {}
+    kinds = {}
+    order = []
+    changes = []
+    for layer in layers:
+        layer_name = layer[0]
+        edits = layer[1]
+        applicable = []
+        for i in range(len(edits)):
+            e = edits[i]
+            if e["command"] and e["command"] != command:
+                continue
+            if e["stage"] and e["stage"] != stage:
+                continue
+            if e["call"] and e["call"] != call:
+                continue
+            applicable.append([_specificity(e), i, e])
+        for _, _, e in sorted(applicable, key = lambda t: (t[0], t[1])):
+            op = e["op"]
+            if op in ("on", "off"):
+                if run != (op == "on"):
+                    changes.append([layer_name, e])
+                run = op == "on"
+                continue
+            option = e["option"]
+            if op == "delete":
+                if option in values:
+                    changes.append([layer_name, e])
+                    values.pop(option)
+                    order.remove(option)
+                continue
+            kind = "flag" if op == "flag" else "value"
+            if option in kinds and kinds[option] != kind:
+                fail("{}: {} {} {} here, and {} below".format(
+                    layer_name,
+                    command,
+                    option,
+                    "takes no value" if kind == "flag" else "takes a value",
+                    "a value" if kind == "flag" else "no value",
+                ))
+            kinds[option] = kind
+            if option not in values:
+                order.append(option)
+            elif values[option] == e["value"]:
+                continue
+            changes.append([layer_name, e])
+            values[option] = e["value"]
+    words = []
+    for option in order:
+        words.append(option)
+        if values[option] != None:
+            words.append(values[option])
+    return {"run": run, "args": words, "changes": changes}
