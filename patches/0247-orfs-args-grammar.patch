+    def test_one_or_zero_elsewhere_is_the_run_switch(self):
+        e = parse("0 -flag -x 2 1 ~-y 0 -z cts:0 grt.wns:1")
+        self.assertEqual(
+            [(x["op"], x["stage"], x["option"]) for x in e],
