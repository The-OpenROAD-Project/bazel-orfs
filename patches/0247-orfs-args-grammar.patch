+    def test_one_or_zero_after_an_option_is_its_value(self):
+        e = parse("-setup_margin 0 -x 1")
+        self.assertEqual(
+            [(x["op"], x["option"], x["value"]) for x in e],
+            [("set", "-setup_margin", "0"), ("set", "-x", "1")],
