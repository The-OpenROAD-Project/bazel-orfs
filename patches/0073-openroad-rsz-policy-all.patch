+int SetupLegacyBase::committedMovesTotal() const
+{
+  int total = 0;
+  for (int i = 0; i < static_cast<int>(MoveType::kCount); ++i) {
+    total += committer_.committedMoves(static_cast<MoveType>(i));
+  }
+  return total;
+}
+
+int SetupLegacyBase::yieldWindow()
+{
+  static const int window = [] {
+    const char* env = std::getenv("RSZ_YIELD_WINDOW");
+    return env != nullptr ? std::atoi(env) : 20;
+  }();
+  return window;
+}
+
+int SetupLegacyBase::moveBudget()
+{
+  static const int budget = [] {
+    const char* env = std::getenv("RSZ_MOVE_BUDGET");
+    return env != nullptr ? std::atoi(env) : 200;
+  }();
+  return budget;
+}
+
+// A move type that has been tried a whole window of times in this phase
+// without one acceptance is not going to start paying: on the designs
+// where repair grinds, 90-96% of all candidates are rejected, and the
+// rejected ones are dominated by the types that never fit the design.
+// Retiring such a type for the rest of the phase saves the generation
+// and the trial commit for every later target; it comes back at the
+// next phase.
+void SetupLegacyBase::noteMoveAttempt(const MoveType type, const bool accepted)
+{
+  const size_t index = static_cast<size_t>(type);
+  ++setup_context_.budget_attempts[index];
+  if (accepted) {
+    ++setup_context_.budget_accepts[index];
+    return;
+  }
+  if (!setup_context_.budget_exhausted[index]
+      && setup_context_.budget_accepts[index] == 0
+      && setup_context_.budget_attempts[index] >= moveBudget()) {
+    setup_context_.budget_exhausted[index] = true;
+    debugPrint(logger_,
+               RSZ,
+               "repair_setup",
+               1,
+               "Retiring move type {} for this phase: {} attempts, none "
+               "accepted",
+               static_cast<int>(type),
+               setup_context_.budget_attempts[index]);
+  }
+}
+
