index 06f02b6ebe..0000000000
--- a/flow/designs/asap7/cva6-regfile/surgery.py
+++ /dev/null
@@ -1,131 +0,0 @@
-"""SYNTH_VERILOG_SURGERY for cva6: its integer register file into a module.
-
-A hack. cva6's ariane_regfile (core/ariane_regfile_ff.sv) keeps its
-array behind packed bus ports and widths in a struct parameter
-(CVA6Cfg), which an AUTO_MEMORIES_REGFILES spec cannot name. This keeps
-ariane_regfile's parameters and ports and moves the array into
-ariane_regfile_rf: 32 words of 32 bits, x0 reading zero, four
-combinational reads, two writes of which the later port wins (two
-commits writing one register), every word reset to zero by rst_ni. An
-elaboration-time $error stops a configuration that is not that shape
-(cv32a65x is). test_en_i is unused, as upstream.
-
-The module is recognised by its text, token for token, comments and
-whitespace aside: anything else stops the build. Every other file is
-copied unchanged.
-"""
-
-import argparse
-import os
-import re
-import sys
-
-MODULE = "ariane_regfile"
-
-EXPECTED = "module ariane_regfile #( parameter config_pkg::cva6_cfg_t CVA6Cfg = config_pkg::cva6_cfg_empty, parameter int unsigned DATA_WIDTH = 32, parameter int unsigned NR_READ_PORTS = 2, parameter bit ZERO_REG_ZERO = 0 ) ( input logic clk_i, input logic rst_ni, input logic test_en_i, input logic [ NR_READ_PORTS-1:0][ 4:0] raddr_i, output logic [ NR_READ_PORTS-1:0][DATA_WIDTH-1:0] rdata_o, input logic [CVA6Cfg.NrCommitPorts-1:0][ 4:0] waddr_i, input logic [CVA6Cfg.NrCommitPorts-1:0][DATA_WIDTH-1:0] wdata_i, input logic [CVA6Cfg.NrCommitPorts-1:0] we_i ); localparam ADDR_WIDTH = 5; localparam NUM_WORDS = 2 ** ADDR_WIDTH; logic [ NUM_WORDS-1:0][DATA_WIDTH-1:0] mem; logic [CVA6Cfg.NrCommitPorts-1:0][ NUM_WORDS-1:0] we_dec; always_comb begin : we_decoder for (int unsigned j = 0; j < CVA6Cfg.NrCommitPorts; j++) begin for (int unsigned i = 0; i < NUM_WORDS; i++) begin if (waddr_i[j] == i) we_dec[j][i] = we_i[j]; else we_dec[j][i] = 1'b0; end end end always_ff @(posedge clk_i, negedge rst_ni) begin : register_write_behavioral if (~rst_ni) begin mem <= '{default: '0}; end else begin for (int unsigned j = 0; j < CVA6Cfg.NrCommitPorts; j++) begin for (int unsigned i = 0; i < NUM_WORDS; i++) begin if (we_dec[j][i]) begin mem[i] <= wdata_i[j]; end end if (ZERO_REG_ZERO) begin mem[0] <= '0; end end end end for (genvar i = 0; i < NR_READ_PORTS; i++) begin assign rdata_o[i] = mem[raddr_i[i]]; end endmodule"
-
-REPLACEMENT = """module ariane_regfile #(
-    parameter config_pkg::cva6_cfg_t CVA6Cfg       = config_pkg::cva6_cfg_empty,
-    parameter int unsigned           DATA_WIDTH    = 32,
-    parameter int unsigned           NR_READ_PORTS = 2,
-    parameter bit                    ZERO_REG_ZERO = 0
-) (
-    input  logic                                             clk_i,
-    input  logic                                             rst_ni,
-    input  logic                                             test_en_i,
-    input  logic [        NR_READ_PORTS-1:0][           4:0] raddr_i,
-    output logic [        NR_READ_PORTS-1:0][DATA_WIDTH-1:0] rdata_o,
-    input  logic [CVA6Cfg.NrCommitPorts-1:0][           4:0] waddr_i,
-    input  logic [CVA6Cfg.NrCommitPorts-1:0][DATA_WIDTH-1:0] wdata_i,
-    input  logic [CVA6Cfg.NrCommitPorts-1:0]                 we_i
-);
-  // SYNTH_VERILOG_SURGERY (asap7/cva6-regfile/surgery.py): the array in
-  // ariane_regfile_rf, for the shape it was written for.
-  if (DATA_WIDTH != 32 || NR_READ_PORTS != 4 || CVA6Cfg.NrCommitPorts != 2
-      || ZERO_REG_ZERO != 1) begin : gen_surgery_shape
-    $error("cva6 surgery: ariane_regfile rewritten for 32 bits, 4 reads, 2 writes, x0 zero");
-  end
-  ariane_regfile_rf rf (
-      .clk_i (clk_i),
-      .rst_ni(rst_ni),
-      .raddr0(raddr_i[0]), .rdata0(rdata_o[0]),
-      .raddr1(raddr_i[1]), .rdata1(rdata_o[1]),
-      .raddr2(raddr_i[2]), .rdata2(rdata_o[2]),
-      .raddr3(raddr_i[3]), .rdata3(rdata_o[3]),
-      .waddr0(waddr_i[0]), .wdata0(wdata_i[0]), .we0(we_i[0]),
-      .waddr1(waddr_i[1]), .wdata1(wdata_i[1]), .we1(we_i[1])
-  );
-endmodule
-
-// The register file, behavioural; AUTO_MEMORIES_REGFILES replaces it.
-module ariane_regfile_rf (
-    input clk_i,
-    input rst_ni,
-    input [4:0] raddr0,
-    output [31:0] rdata0,
-    input [4:0] raddr1,
-    output [31:0] rdata1,
-    input [4:0] raddr2,
-    output [31:0] rdata2,
-    input [4:0] raddr3,
-    output [31:0] rdata3,
-    input [4:0] waddr0,
-    input [31:0] wdata0,
-    input we0,
-    input [4:0] waddr1,
-    input [31:0] wdata1,
-    input we1
-);
-  reg [31:0] mem [1:31];
-  integer i;
-  always @(posedge clk_i or negedge rst_ni) begin
-    if (!rst_ni) begin
-      for (i = 1; i < 32; i = i + 1) mem[i] <= 32'd0;
-    end else begin
-      if (we0 && waddr0 != 5'd0) mem[waddr0] <= wdata0;
-      if (we1 && waddr1 != 5'd0) mem[waddr1] <= wdata1;
-    end
-  end
-  assign rdata0 = raddr0 == 5'd0 ? 32'd0 : mem[raddr0];
-  assign rdata1 = raddr1 == 5'd0 ? 32'd0 : mem[raddr1];
-  assign rdata2 = raddr2 == 5'd0 ? 32'd0 : mem[raddr2];
-  assign rdata3 = raddr3 == 5'd0 ? 32'd0 : mem[raddr3];
-endmodule"""
-
-
-def norm(text):
-    text = re.sub(r"//[^\n]*", "", text)
-    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
-    return " ".join(text.split())
-
-
-def fail(msg):
-    sys.exit("cva6 surgery: " + msg)
-
-
-def main():
-    p = argparse.ArgumentParser()
-    p.add_argument("--out-dir", required=True)
-    p.add_argument("files", nargs="+")
-    a = p.parse_args()
-    done = 0
-    for path in a.files:
-        with open(path) as f:
-            text = f.read()
-        found = list(re.finditer(r"^module\s+%s\b.*?^endmodule\b" % MODULE, text, re.M | re.S))
-        if len(found) > 1:
-            fail("%s defines %s %d times" % (path, MODULE, len(found)))
-        if found:
-            m = found[0]
-            if norm(m.group(0)) != EXPECTED:
-                fail("%s in %s is not the ariane_regfile this rewrite knows" % (MODULE, path))
-            text = text[: m.start()] + REPLACEMENT + text[m.end() :]
-            done += 1
-        with open(os.path.join(a.out_dir, os.path.basename(path)), "w") as f:
-            f.write(text)
-    if done != 1:
-        fail("%s found in %d files, not one" % (MODULE, done))
-
-
-if __name__ == "__main__":
-    main()
