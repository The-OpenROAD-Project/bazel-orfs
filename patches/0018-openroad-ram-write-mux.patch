+    ao22_cell_ = findMaster4(
+        0xF888, "ao22", ao22_in_, ao22_out_, /*required=*/false);
+  }
   if (num_write_ > 1) {
-    if (!ao22_cell_) {
-      // AO22 truth table: Y = A1&A2 | B1&B2
-      ao22_cell_ = findMaster4(
-          0xF888, "ao22", ao22_in_, ao22_out_, /*required=*/false);
-    }
