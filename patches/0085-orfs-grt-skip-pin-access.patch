From b2f4343490d02cccd230df1f1ca14399a3e78d54 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Wed, 23 Sep 2026 18:41:03 +0200
Subject: [PATCH] grt: SKIP_PIN_ACCESS, a global route without access points
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

pin_access fails on a macro pin it cannot reach (DRT-0073). On a
hierarchical design that is one pin of one hardened block standing
between a finished placement and the congestion map the global route
stage exists to produce: XiangShan's planned parent stopped on exactly
one pin per block, four pins of 28 134.

The knob skips it and warns that the guides have no access points, so it
is a knob for a study rather than for a flow that goes on to detailed
route. Declared in variables.yaml, scoped to grt.

Not upstreamed. Retires when DRT-0073 is fixed; a five-second reproducer
is in bazel-orfs test/planned_parent.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/global_route.tcl | 13 ++++++++++++-
 flow/scripts/variables.yaml   | 10 ++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/flow/scripts/global_route.tcl b/flow/scripts/global_route.tcl
index f0e3a195b..a9a8d36cb 100644
--- a/flow/scripts/global_route.tcl
+++ b/flow/scripts/global_route.tcl
@@ -54,7 +54,18 @@ proc global_route_helper { } {
   append_env_var additional_args VIA_IN_PIN_MIN_LAYER -via_in_pin_bottom_layer 1
   append_env_var additional_args VIA_IN_PIN_MAX_LAYER -via_in_pin_top_layer 1
 
-  log_cmd pin_access {*}$additional_args
+  # SKIP_PIN_ACCESS: run the global route without building access points.
+  # pin_access fails on a macro pin it cannot reach (DRT-0073), and on a
+  # hierarchical design that is one pin of one block between a placement
+  # and the congestion map the stage exists to produce. The guide the
+  # router writes without access points is not a routable result, so this
+  # is a knob for a study, not for a flow that goes on to detailed route.
+  if { [env_var_equals SKIP_PIN_ACCESS 1] } {
+    utl::warn FLW 21 "SKIP_PIN_ACCESS=1: pin access skipped; the global route's\
+      guides have no access points and detailed route will not take them."
+  } else {
+    log_cmd pin_access {*}$additional_args
+  }
 
   if { ![do_global_route $res_aware $use_cugr] } {
     return
diff --git a/flow/scripts/variables.yaml b/flow/scripts/variables.yaml
index d19071996..83c21c294 100644
--- a/flow/scripts/variables.yaml
+++ b/flow/scripts/variables.yaml
@@ -920,6 +920,16 @@ SKIP_LAST_GASP:
     - cts
     - floorplan
     - grt
+SKIP_PIN_ACCESS:
+  description: >
+    Run the global route without building access points. pin_access fails on
+    a macro pin it cannot reach (DRT-0073); on a hierarchical design that can
+    be one pin of one block between a placement and the congestion map the
+    stage exists to produce. The guides it writes then have no access points
+    and detailed route will not take them, so this is a knob for a study, not
+    for a flow that goes on to route.
+  stages:
+    - grt
 SKIP_BUFFER_REMOVAL:
   description: >
     Passed as -skip_buffer_removal to repair_timing. Do not remove buffers
-- 
2.53.0

