+// The B2B spring of the two-pin net {pin1, pin2} with net weight netWeight
+// on one axis (pos and inst_pos read that axis): the four cases of the net
+// loop in createSparseMatrix.
+template <typename PinPos, typename InstPos>
+static void addTwoPinSpring(const Pin* pin1,
+                            const Pin* pin2,
+                            const float netWeight,
+                            const int minDiffLength,
+                            const PinPos& pos,
+                            const InstPos& inst_pos,
+                            std::vector<T>& list,
+                            Eigen::VectorXf& fixedForce)
+{
+  const int diff = std::abs(pos(pin1) - pos(pin2));
+  const float weight = netWeight / std::max(diff, minDiffLength);
+  const bool placed1 = pin1->isPlaceInstConnected();
+  const bool placed2 = pin2->isPlaceInstConnected();
+  if (placed1 && placed2) {
+    const Instance* instance1 = pin1->getInstance();
+    const Instance* instance2 = pin2->getInstance();
+    const int inst1 = instance1->getExtId();
+    const int inst2 = instance2->getExtId();
+    const bool locked1 = instance1->isLocked();
+    const bool locked2 = instance2->isLocked();
+    const int offset1 = pos(pin1) - inst_pos(instance1);
+    const int offset2 = pos(pin2) - inst_pos(instance2);
+    if (!locked1 && !locked2) {
+      list.emplace_back(inst1, inst1, weight);
+      list.emplace_back(inst2, inst2, weight);
+      list.emplace_back(inst1, inst2, -weight);
+      list.emplace_back(inst2, inst1, -weight);
+      fixedForce(inst1) += -weight * (offset1 - offset2);
+      fixedForce(inst2) += -weight * (offset2 - offset1);
+    } else if (locked1 && !locked2) {
+      list.emplace_back(inst2, inst2, weight);
+      fixedForce(inst2) += weight * (pos(pin1) - offset2);
+    } else if (!locked1 && locked2) {
+      list.emplace_back(inst1, inst1, weight);
+      fixedForce(inst1) += weight * (pos(pin2) - offset1);
+    }
+  } else if (!placed1 && placed2) {
+    const int inst2 = pin2->getInstance()->getExtId();
+    list.emplace_back(inst2, inst2, weight);
+    fixedForce(inst2)
+        += weight * (pos(pin1) - (pos(pin2) - inst_pos(pin2->getInstance())));
+  } else if (placed1 && !placed2) {
+    const int inst1 = pin1->getInstance()->getExtId();
+    list.emplace_back(inst1, inst1, weight);
+    fixedForce(inst1)
+        += weight * (pos(pin2) - (pos(pin1) - inst_pos(pin1->getInstance())));
+  }
+}
+
+// Unlike nets, pulls are not skipped above the fan-out limit: a critical
+// sink of a very large net still gets its spring.
+void InitialPlace::addPinPullSprings(std::vector<T>& listX,
+                                     std::vector<T>& listY)
+{
+  const auto pin_x = [](const Pin* pin) { return pin->cx(); };
+  const auto pin_y = [](const Pin* pin) { return pin->cy(); };
+  const auto inst_x = [](const Instance* inst) { return inst->cx(); };
+  const auto inst_y = [](const Instance* inst) { return inst->cy(); };
+  for (const PinSpring& pull : pin_pulls_) {
+    if (isMovableIoPin(pull.driver, ipVars_.placeIosMode)
+        || isMovableIoPin(pull.sink, ipVars_.placeIosMode)) {
+      continue;
+    }
+    // A two-pin net's B2B weight is netWeightScale / (2 - 1).
+    const float netWeight = pull.weight * ipVars_.netWeightScale;
+    addTwoPinSpring(pull.driver,
+                    pull.sink,
+                    netWeight,
+                    ipVars_.minDiffLength,
+                    pin_x,
+                    inst_x,
+                    listX,
+                    fixedInstForceVecX_);
+    addTwoPinSpring(pull.driver,
+                    pull.sink,
+                    netWeight,
+                    ipVars_.minDiffLength,
+                    pin_y,
+                    inst_y,
+                    listY,
+                    fixedInstForceVecY_);
+  }
+}
