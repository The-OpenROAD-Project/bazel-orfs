+
+// d/da of the weighted-average length of the two-pin net {a, b} on one axis,
+// d = a - b, wlCoeff = 1 / gamma: with u = d / (2 gamma) the length is
+// d tanh(u), so the derivative is tanh(u) + u sech^2(u), in (-1.2, 1.2).
+// It equals the exp-sum gradient getWireLengthGradientPinWA gives a two-pin
+// net.
+static float twoPinWaGradient(const float d, const float wlCoeff)
+{
+  const float u = d * wlCoeff * 0.5f;
+  const float t = std::tanh(u);
+  return t + u * (1.0f - t * t);
+}
+
+int64_t NesterovBaseCommon::pinPullCellIndex(const GPin* gPin) const
+{
+  const GCell* gCell = gPin->getGCell();
+  if (gCell == nullptr || !gCell->isInstance()) {
+    return -1;
+  }
+  const size_t index = getGCellIndex(gCell);
+  if (index >= pin_pull_force_.size()) {
+    return -1;
+  }
+  return static_cast<int64_t>(index);
+}
+
+void NesterovBaseCommon::updatePinPullForce(const float wlCoeffX,
+                                            const float wlCoeffY)
+{
+  const size_t pull_count = pin_pulls_.size();
+#pragma omp parallel for num_threads(num_threads_)
+  for (size_t i = 0; i < pull_count; i++) {
+    const GPinPull& pull = pin_pulls_[i];
+    pin_pull_grad_[i] = FloatPoint(
+        pull.weight
+            * twoPinWaGradient(pull.driver->cx() - pull.sink->cx(), wlCoeffX),
+        pull.weight
+            * twoPinWaGradient(pull.driver->cy() - pull.sink->cy(), wlCoeffY));
+  }
+
+  // Serial accumulation, in pull order, for determinism. The gradient
+  // vectors hold -df/dx.
+  std::ranges::fill(pin_pull_force_, FloatPoint());
+  for (size_t i = 0; i < pull_count; i++) {
+    const GPinPull& pull = pin_pulls_[i];
+    const FloatPoint& grad = pin_pull_grad_[i];
+    if (const int64_t driver = pinPullCellIndex(pull.driver); driver >= 0) {
+      pin_pull_force_[driver].x -= grad.x;
+      pin_pull_force_[driver].y -= grad.y;
+    }
+    if (const int64_t sink = pinPullCellIndex(pull.sink); sink >= 0) {
+      pin_pull_force_[sink].x += grad.x;
+      pin_pull_force_[sink].y += grad.y;
+    }
+  }
+}
+
+void NesterovBaseCommon::setPinPulls(
+    const std::vector<PinPullConnection>& pulls)
+{
+  pin_pulls_.clear();
+  pin_pull_force_.clear();
+  pin_pull_precond_.clear();
