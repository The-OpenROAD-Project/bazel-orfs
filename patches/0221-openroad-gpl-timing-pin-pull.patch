+
+// The initial placement is timing-blind and sets the order Nesterov keeps,
+// so the pull starts here: analyze the first pass, then place again with
+// the critical connections as springs.
+void Replace::runInitialPinPull(const int threads, const PlaceOptions& options)
+{
+  const int rounds = options.timingDrivenPinPullInitialRounds;
+  for (int round = 1; round <= rounds; round++) {
+    log_->info(GPL,
+               199,
+               "Timing-driven pin pull: initial placement pass {} of {}.",
+               round,
+               rounds);
+    findPinPullSlacks();
+    ip_->setPinPulls(pin_pull_->update(*pbc_));
+    ip_->doPinPullPass(threads);
+  }
+}
+
+// Hands the pulls to Nesterov, finding them first if the initial placement
+// did not.
+void Replace::startNesterovPinPull()
+{
+  if (nbc_->getDeviceState() != nullptr) {
+    log_->error(GPL,
+                197,
+                "-timing_driven_pin_pull is not supported with the GPU "
+                "wirelength backend.");
+  }
+  // Timing analysis needs placed cells: with the initial placement skipped
+  // on an unplaced design, the pulls start at the first reweight instead.
+  const bool placed
+      = std::ranges::all_of(pbc_->placeInsts(), [](const Instance* inst) {
+          return inst->dbInst() == nullptr || inst->dbInst()->isPlaced();
+        });
+  if (pin_pull_->updateCount() == 0 && placed) {
+    findPinPullSlacks();
+    pin_pull_->update(*nbc_);
+  }
+  nbc_->setPinPulls(pin_pull_->pulls());
