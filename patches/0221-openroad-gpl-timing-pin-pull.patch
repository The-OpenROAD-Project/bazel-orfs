+    return it == db_bterm_to_index_map_.end() ? nullptr
+                                              : &gPinStor_[it->second];
+  };
+  for (const PinPullConnection& pull : pulls) {
+    GPin* driver = find_gpin(pull.driver);
+    GPin* sink = find_gpin(pull.sink);
+    if (driver == nullptr || sink == nullptr) {
+      continue;
+    }
+    pin_pulls_.push_back({driver, sink, pull.weight});
+  }
+  if (pin_pulls_.empty()) {
+    return;
+  }
+  pin_pull_grad_.resize(pin_pulls_.size());
+  pin_pull_force_.resize(gCellStor_.size());
+  pin_pull_precond_.resize(gCellStor_.size(), 0.0f);
