--- /dev/null
+++ b/src/gpl/src/pinPull.h
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#pragma once
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "boost/unordered/unordered_flat_map.hpp"
+#include "boost/unordered/unordered_flat_set.hpp"
+
+namespace odb {
+class dbObject;
+class dbNet;
+}  // namespace odb
+
+namespace sta {
+class dbSta;
+class Pin;
+}  // namespace sta
+
+namespace rsz {
+class Resizer;
+}
+
+namespace utl {
+class Logger;
+}
+
+namespace gpl {
+
+class PlacerBaseCommon;
+class NesterovBaseCommon;
+
+struct PinPullVars
+{
+  // A failing connection pulls this many times as hard as the heavier of its
+  // two cells' other nets together.
+  float strength = 16.0f;
+  // A connection that still fails at an update has its weight multiplied by
+  // (1 + growth).
+  float growth = 1.0f;
+  // Cap on a connection's weight; 0 means no cap.
+  float max = 0.0f;
+  // -timing_driven_nets_percentage, given back to the resizer after the
+  // capture, which reads every constrained net.
+  float nets_percentage = 10.0f;
+};
+
+// A pulled connection, driver pin to sink pin, as odb objects (dbITerm or
+// dbBTerm) so that it survives a change of gpl's netlist view.
+struct PinPullConnection
+{
+  odb::dbObject* driver = nullptr;
+  odb::dbObject* sink = nullptr;
+  float weight = 0.0f;
+};
+
+// Timing-driven pin pull.
+//
+// A net's timing weight scales the whole net, and a sink inside the net's
+// bounding box feels almost no wirelength force, so the failing sink of a
+// high-fanout net is never pulled toward its driver. PinPull adds a two-pin
+// attraction between the driver and each failing sink: in the initial
+// placement as a B2B spring, in Nesterov as the weighted-average length of
+// the two-pin net {driver, sink}.
+//
+// captureSlacks() runs inside Resizer::findResizeSlacks, while the netlist
+// is the one repair_design buffered, and records the setup slack of every
+// failing load pin. update() then builds the pulls over gpl's own netlist
+// (the pre-repair one) after the journal is restored. A connection keeps
+// its weight once pulled, even after it meets timing: the pull is what made
+// it meet timing, and dropping it would let the next pass undo it.
+class PinPull
+{
+ public:
+  PinPull(sta::dbSta* sta,
+          rsz::Resizer* rs,
+          utl::Logger* log,
+          const PinPullVars& vars);
+
+  void captureSlacks();
+
+  // Build the pulls from the slacks captured last, over the initial
+  // placement's netlist view or Nesterov's.
+  const std::vector<PinPullConnection>& update(const PlacerBaseCommon& pbc);
+  const std::vector<PinPullConnection>& update(const NesterovBaseCommon& nbc);
+
+  const std::vector<PinPullConnection>& pulls() const { return pulls_; }
+  int updateCount() const { return update_count_; }
+
+ private:
+  struct Candidate
+  {
+    odb::dbNet* net;
+    odb::dbObject* driver;
+    odb::dbObject* sink;
+    float slack;
+    bool failing;
+    // The connection's weight at the last update, 0 if it was not pulled.
+    float previous;
+    // max(other-net weight of either cell, 1)
+    float other_weight;
+  };
+  static constexpr int kMaxInferDepth = 64;
+
+  void captureLoad(const sta::Pin* pin);
+  std::optional<float> sinkSlack(odb::dbObject* pin, int depth);
+  bool isPullNet(odb::dbNet* net) const;
+  void addCandidate(std::vector<Candidate>& candidates,
+                    odb::dbNet* net,
+                    odb::dbObject* driver,
+                    odb::dbObject* sink,
+                    float other_weight);
+  void finish(const std::vector<Candidate>& candidates);
+
+  sta::dbSta* sta_ = nullptr;
+  rsz::Resizer* rs_ = nullptr;
+  utl::Logger* log_ = nullptr;
+  PinPullVars vars_;
+
+  // Setup slack of each failing load pin captured on the repaired netlist,
+  // keyed by the pin's dbITerm or dbBTerm.
+  boost::unordered::unordered_flat_map<odb::dbObject*, float> sink_slack_;
+  // Slacks found for the inputs of buffers and inverters the repaired
+  // netlist did not have (nullopt: none), cleared with sink_slack_.
+  boost::unordered::unordered_flat_map<odb::dbObject*, std::optional<float>>
+      inferred_slack_;
+
+  // Weight of each connection at the last update, looked up only.
+  boost::unordered::unordered_flat_map<
+      std::pair<odb::dbObject*, odb::dbObject*>,
+      float>
+      history_;
+  // The nets of the connections in history_.
+  boost::unordered::unordered_flat_set<odb::dbNet*> pulled_nets_;
+  std::vector<PinPullConnection> pulls_;
+  int update_count_ = 0;
+};
+
