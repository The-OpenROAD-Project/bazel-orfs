@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+// The timing-driven pin pull (src/gpl/src/pinPull.h) on the path_shape
+// designs. The pulls are given through PathShapeFixture::placePulled, as
+// timing analysis would give them for a failing path, so the tests need no
+// liberty and no STA: they check what the pull does to the placement, not
+// which connections timing analysis picks.
+//
+// Every check prints a "METRIC <test> <name>=<value> <op> <threshold>
+// pass|FAIL" line, and every placement a "SHAPE <test> ..." line.
+
+#include <cmath>
+#include <cstddef>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "gpl/Replace.h"
+#include "gpl_design_builder.h"
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "path_shape.h"
+#include "src/gpl/src/nesterovBase.h"
+#include "src/gpl/src/pinPull.h"
+#include "src/gpl/src/placerBase.h"
+
+namespace gpl::path_shape {
+namespace {
+
+// The default -timing_driven_pin_pull_strength (16) times the other-net
+// weight of a broadcast path cell (its W or E net and its S net: 2), as
+// PinPull would weight a failing connection there.
+constexpr float kBroadcastPull = 32.0f;
+// The same for a cluster path cell (four other nets).
+constexpr float kClusterPull = 64.0f;
+
+std::string sparseDense(const testing::TestParamInfo<bool>& info)
+{
+  return densityName(info.param);
+}
+
+class PinPullBroadcastTest : public PathShapeFixture,
+                             public testing::WithParamInterface<bool>
+{
+};
+
+// BroadcastWeightTest's design (6 cells, each driving 37 side loads on the
+// die edge, with side inputs), from the flow's start, with a pull on each of
+// the path's connections instead of a weight on each of its nets. A net
+// weight scales the side loads as much as the path's next cell and leaves
+// the path at 1.31 to 1.34; a pull acts on the connection alone.
+TEST_P(PinPullBroadcastTest, BroadcastPathStraightens)
+{
+  DesignBuilder builder(db_.get());
+  const Path path = makeBroadcastPath(builder, 6, 37, true);
+  if (GetParam()) {
+    addSea(builder);
+  }
+  placeStraight(builder, path);
+  const double straight_period = path.periodPs();
+  unplace(path.cells);
+  const PlaceResult result
+      = placePulled(PlaceOptions{}, pathPulls(path, kBroadcastPull));
+  std::cout << "SHAPE " << currentTest() << " detour=" << path.detour()
+            << " period=" << path.periodPs()
+            << " straight_period=" << straight_period << " hpwl=" << hpwl()
+            << runInfo(result) << "\n";
+  expectMetric("detour", path.detour(), Op::kLess, 1.3);
+  expectMetric("period_over_straight",
+               path.periodPs() / straight_period,
+               Op::kLess,
+               1.1);
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         PinPullBroadcastTest,
+                         testing::Bool(),
+                         sparseDense);
+
+class PinPullClusterTest : public PathShapeFixture,
+                           public testing::WithParamInterface<bool>
+{
+};
+
+// Two clusters seeded swapped, the initial placement run from the seed and
+// then again with the path's connections pulled: the reproducers' case,
+// where Nesterov stops at iteration 0 and only the initial placement places.
+// Expected: the path straightens. Whether it does so by swapping the
+// clusters back or by taking its own cells out of them is printed.
+TEST_P(PinPullClusterTest, SwappedSeedStraightens)
+{
+  DesignBuilder builder(db_.get());
+  const ClusterPath cp = makeClusterPath(builder, 2, 3);
+  if (GetParam()) {
+    seedSea(builder, addSea(builder));
+  }
+  seedClusters(builder, cp, {1, 0}, Seed::kCompact);
+  if (inversions(clusterOrder(cp)) != 1) {
+    constructionFailure("the seed is not swapped");
+  }
+  const double seed_detour = cp.path.detour();
+  const PlaceResult result
+      = placePulled(PlaceOptions{}, pathPulls(cp.path, kClusterPull));
+  std::cout << "SHAPE " << currentTest() << " seed_detour=" << seed_detour
+            << " order=" << str(clusterOrder(cp))
+            << " detour=" << cp.path.detour() << " hpwl=" << hpwl()
+            << runInfo(result) << "\n";
+  expectMetric("detour", cp.path.detour(), Op::kLess, 1.3);
+}
+
+INSTANTIATE_TEST_SUITE_P(Placement,
+                         PinPullClusterTest,
+                         testing::Bool(),
+                         sparseDense);
+
+class PinPullTest : public PathShapeFixture
+{
+};
+
+// Same input, same placement, with 8 threads against 1: the pulls are
+// summed in a fixed order.
+TEST_F(PinPullTest, DeterministicAcrossThreads)
+{
+  DesignBuilder builder(db_.get());
+  const Path path = makeBroadcastPath(builder, 6, 37, true);
+  addSea(builder);
+  const std::vector<CellState> input = cells();
+  placePulled(PlaceOptions{}, pathPulls(path, kBroadcastPull), 1);
+  const std::vector<CellState> first = cells();
+  restore(input);
+  placePulled(PlaceOptions{}, pathPulls(path, kBroadcastPull), 8);
+  const std::vector<CellState> second = cells();
+  int changed = 0;
+  for (std::size_t i = 0; i < first.size(); ++i) {
+    changed += !(first[i] == second[i]);
+  }
+  expectMetric("cells_differing_8_threads_vs_1", changed, Op::kEqual, 0);
+}
+
+// The pull's closed form against gpl's own weighted-average gradient of a
+// two-pin net: two cells joined by one net, the net's gradient with weight
+// 1, then the net switched off (custom weight 0) and a pull of weight 1 on
+// the same two pins. gpl's exponentials are approximate (fastExp), so the
+// two agree to a tolerance, not exactly.
+TEST_F(PinPullTest, TwoPinPullMatchesTwoPinNet)
+{
+  DesignBuilder builder(db_.get());
+  odb::dbInst* a = builder.addCell("a");
+  odb::dbInst* b = builder.addCell("b");
+  builder.connect(a, "E", "ab");
+  builder.connect(b, "W", "ab");
+  const odb::Rect core = builder.core();
+  putAt(a, core.xMin() + 2000, core.yMin() + 1000);
+  putAt(b, core.xMin() + 9000, core.yMin() + 4000);
+
+  const PlaceOptions options;
+  auto pbc = std::make_shared<PlacerBaseCommon>(
+      db_.get(), PlacerBaseVars(options), &logger_);
+  const NesterovBaseVars nb_vars(options);
+  NesterovBaseCommon nbc(nb_vars, pbc, &logger_, 1, Clusters{});
+  GCell* cell_a = nbc.dbToNb(a);
+  GCell* cell_b = nbc.dbToNb(b);
+  GNet* net = nbc.dbToNb(builder.block()->findNet("ab"));
+  if (cell_a == nullptr || cell_b == nullptr || net == nullptr) {
+    constructionFailure("the two cells or their net are not placeable");
+  }
+  for (const float gamma : {400.0f, 2000.0f, 10000.0f}) {
+    const float coeff = 1.0f / gamma;
+    net->setCustomWeight(1.0f);
+    nbc.setPinPulls({});
+    nbc.updateWireLengthForceWA(coeff, coeff);
+    const FloatPoint net_a = nbc.getWireLengthGradientWA(cell_a, coeff, coeff);
+    const FloatPoint net_b = nbc.getWireLengthGradientWA(cell_b, coeff, coeff);
+
+    net->setCustomWeight(0.0f);
+    nbc.setPinPulls({{a->findITerm("E"),
+                      b->findITerm("W"),
+                      1.0f}});
+    nbc.updateWireLengthForceWA(coeff, coeff);
+    const FloatPoint pull_a = nbc.getWireLengthGradientWA(cell_a, coeff, coeff);
+    const FloatPoint pull_b = nbc.getWireLengthGradientWA(cell_b, coeff, coeff);
+
+    const double error = std::max({std::abs(net_a.x - pull_a.x),
+                                   std::abs(net_a.y - pull_a.y),
+                                   std::abs(net_b.x - pull_b.x),
+                                   std::abs(net_b.y - pull_b.y)});
+    std::cout << "SHAPE " << currentTest() << " gamma=" << gamma
+              << " net_a=(" << net_a.x << "," << net_a.y << ") pull_a=("
+              << pull_a.x << "," << pull_a.y << ")\n";
+    expectMetric("max_gradient_difference_gamma_" + std::to_string(static_cast<int>(gamma)),
+                 error,
+                 Op::kLess,
+                 0.01);
+    // A pull that changed nothing would pass the difference check if the
+    // net's own gradient were 0: it is not.
+    expectMetric("net_gradient_x_gamma_" + std::to_string(static_cast<int>(gamma)),
+                 std::abs(net_a.x),
+                 Op::kAtLeast,
+                 0.5);
+  }
+}
