+std::vector<PinPullConnection> pathPulls(const Path& path, const float weight)
+{
+  std::vector<PinPullConnection> pulls;
+  odb::dbInst* from = path.launch;
+  for (std::size_t i = 0; i <= path.cells.size(); ++i) {
+    odb::dbInst* to = i < path.cells.size() ? path.cells[i] : path.capture;
+    pulls.push_back({from->findITerm("E"),
+                     to->findITerm("W"),
+                     weight});
+    from = to;
+  }
+  return pulls;
+}
+
+PlaceResult PathShapeFixture::placePulled(
+    const PlaceOptions& options,
+    const std::vector<PinPullConnection>& pulls,
+    const int threads)
+{
+  odb::dbDatabase* db = db_.get();
+  logger_.redirectStringBegin();
+  auto pbc = std::make_shared<PlacerBaseCommon>(
+      db, PlacerBaseVars(options), &logger_);
+  std::vector<std::shared_ptr<PlacerBase>> pbs{
+      std::make_shared<PlacerBase>(db, pbc, &logger_, true)};
+  {
+    InitialPlace initial(InitialPlaceVars(options, false),
+                         pbc,
+                         pbs,
+                         std::make_unique<GraphicsNone>(),
+                         &logger_);
+    initial.doBicgstabPlace(threads);
+    if (options.initialPlaceMaxIter > 0) {
+      initial.setPinPulls(pulls);
+      initial.doPinPullPass(threads);
+    }
+  }
+
+  const NesterovBaseVars nb_vars(options);
+  auto nbc = std::make_shared<NesterovBaseCommon>(
+      nb_vars, pbc, &logger_, threads, Clusters{});
+  std::vector<std::shared_ptr<NesterovBase>> nbs{
+      std::make_shared<NesterovBase>(nb_vars, pbs[0], nbc, &logger_)};
+  nbc->setPinPulls(pulls);
+  const std::size_t resolved = nbc->getPinPullCount();
+  NesterovPlaceVars np_vars(options, nbc->getHpwl());
+  nbs[0]->setNpVars(&np_vars);
+  auto rb = std::make_shared<RouteBase>(
+      RouteBaseVars(options), db, nullptr, nbc, nbs, &logger_);
+  auto tb = std::make_shared<TimingBase>(nbc, nullptr, nullptr, &logger_);
+  NesterovPlace np(np_vars,
+                   pbc,
+                   nbc,
+                   pbs,
+                   nbs,
+                   rb,
+                   tb,
+                   nullptr,
+                   nullptr,
+                   std::make_unique<GraphicsNone>(),
+                   &logger_);
+  np.setTargetOverflow(options.overflow);
+  np.setMaxIters(options.nesterovPlaceMaxIter);
+  const PlaceResult result = np.doNesterovPlace(0);
+  endLog();
+  if (resolved != pulls.size()) {
+    constructionFailure("pin pull reached " + std::to_string(resolved)
+                        + " of " + std::to_string(pulls.size())
+                        + " connections");
+  }
+  checkRan(result);
+  return result;
+}
+
