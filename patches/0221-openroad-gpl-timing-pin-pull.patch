new file mode 100644
index 0000000000..3545dd47b7
--- /dev/null
+++ b/src/gpl/src/pinPull.cpp
@@ -0,0 +1,405 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "pinPull.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "db_sta/dbNetwork.hh"
+#include "db_sta/dbSta.hh"
+#include "nesterovBase.h"
+#include "odb/db.h"
+#include "odb/dbTypes.h"
+#include "placerBase.h"
+#include "rsz/Resizer.hh"
+#include "sta/Fuzzy.hh"
+#include "sta/Graph.hh"
+#include "sta/MinMax.hh"
+#include "sta/Network.hh"
+#include "sta/NetworkClass.hh"
+#include "utl/Logger.h"
+
+namespace gpl {
+
+using utl::GPL;
+
+namespace {
+
+odb::dbObject* dbPin(const Pin* pin)
+{
+  if (pin->isITerm()) {
+    return pin->getDbITerm();
+  }
+  return pin->getDbBTerm();
+}
+
+// The one pin that drives the net: an instance output or a top-level input.
+bool isDriver(const Pin* pin)
+{
+  if (pin->isITerm()) {
+    return pin->getDbITerm()->getIoType() == odb::dbIoType::OUTPUT;
+  }
+  return pin->getDbBTerm()->getIoType() == odb::dbIoType::INPUT;
+}
+
+bool isMovable(const Pin* pin)
+{
+  return pin->isPlaceInstConnected() && !pin->getInstance()->isLocked();
+}
+
+bool isMovable(const GPin* gpin)
+{
+  const GCell* gcell = gpin->getGCell();
+  return gcell != nullptr && gcell->isInstance() && !gcell->isLocked();
+}
+
+// The pull of a movable cell's nets other than the pin's own, each net
+// counted 1.
+float otherWeight(const Pin* pin)
+{
+  if (!isMovable(pin)) {
+    return 0.0f;
+  }
+  float weight = 0.0f;
+  for (const Pin* other : pin->getInstance()->getPins()) {
+    if (other->getNet() != nullptr && other->getNet() != pin->getNet()) {
+      weight += 1.0f;
+    }
+  }
+  return weight;
+}
+
+// The pull of a movable cell's nets other than the pin's own, by net weight.
+float otherWeight(const GPin* gpin)
+{
+  if (!isMovable(gpin)) {
+    return 0.0f;
+  }
+  float weight = 0.0f;
+  for (const GPin* other : gpin->getGCell()->gPins()) {
+    if (other->getGNet() != nullptr && other->getGNet() != gpin->getGNet()) {
+      weight += other->getGNet()->getTotalWeight();
+    }
+  }
+  return weight;
+}
+
+std::string pinName(odb::dbObject* pin)
+{
+  if (pin->getObjectType() == odb::dbITermObj) {
+    return static_cast<odb::dbITerm*>(pin)->getName();
+  }
+  return static_cast<odb::dbBTerm*>(pin)->getName();
+}
+
+}  // namespace
+
+PinPull::PinPull(sta::dbSta* sta,
+                 rsz::Resizer* rs,
+                 utl::Logger* log,
+                 const PinPullVars& vars)
+    : sta_(sta), rs_(rs), log_(log), vars_(vars)
+{
+}
+
+// Runs while the netlist is the one repair_design buffered: a sink behind
+// a buffer tree reads the slack of the path through the tree, not the
+// unbuffered net's load-bound slack. A driver's slack is never better than
+// that of any load it drives, so every failing load sits on a net whose
+// driver fails.
+void PinPull::captureSlacks()
+{
+  sink_slack_.clear();
+  inferred_slack_.clear();
+
+  // Every constrained net, by increasing slack.
+  rs_->setWorstSlackNetsPercent(100.0f);
+  const sta::NetSeq nets = rs_->resizeWorstSlackNets();
+  rs_->setWorstSlackNetsPercent(vars_.nets_percentage);
+
+  sta::dbNetwork* network = sta_->getDbNetwork();
+  size_t net_count = 0;
+  for (const sta::Net* net : nets) {
+    if (rs_->resizeNetSlack(net).value() >= 0.0f) {
+      break;
+    }
+    ++net_count;
+    // A net's pins are its instance pins; its top-level ports are terms.
+    std::unique_ptr<sta::NetPinIterator> pin_iter(network->pinIterator(net));
+    while (pin_iter->hasNext()) {
+      captureLoad(pin_iter->next());
+    }
+    std::unique_ptr<sta::NetTermIterator> term_iter(network->termIterator(net));
+    while (term_iter->hasNext()) {
+      captureLoad(network->pin(term_iter->next()));
+    }
+  }
+  debugPrint(log_,
+             GPL,
+             "pinPull",
+             1,
+             "Pin pull: {} failing sinks on {} failing nets of {}.",
+             sink_slack_.size(),
+             net_count,
+             nets.size());
+}
+
+void PinPull::captureLoad(const sta::Pin* pin)
+{
+  sta::dbNetwork* network = sta_->getDbNetwork();
+  if (pin == nullptr || !network->isLoad(pin)) {
+    return;
+  }
+  sta::Vertex* vertex = sta_->graph()->pinLoadVertex(pin);
+  if (vertex == nullptr) {
+    return;
+  }
+  const sta::Slack slack = sta_->slack(vertex, sta::MinMax::max());
+  if (sta::fuzzyInf(slack) || slack >= 0.0f) {
+    return;
+  }
+  odb::dbITerm* iterm = nullptr;
+  odb::dbBTerm* bterm = nullptr;
+  odb::dbModITerm* moditerm = nullptr;
+  network->staToDb(pin, iterm, bterm, moditerm);
+  odb::dbObject* key = iterm != nullptr ? static_cast<odb::dbObject*>(iterm)
+                                        : static_cast<odb::dbObject*>(bterm);
+  if (key == nullptr) {
+    return;
+  }
+  auto [it, inserted] = sink_slack_.try_emplace(key, slack);
+  if (!inserted) {
+    it->second = std::min(it->second, static_cast<float>(slack));
+  }
+}
+
+// The slack of a sink pin of gpl's netlist, if it fails. Rebuffering inside
+// findResizeSlacks removes buffers and inverters the netlist already had, so
+// the input of such a cell has no slack captured. A buffer's or inverter's
+// input carries the worst path through any of its loads, so its slack is
+// the worst of its output net's sinks', found through any chain of them.
+std::optional<float> PinPull::sinkSlack(odb::dbObject* pin, const int depth)
+{
+  if (const auto it = sink_slack_.find(pin); it != sink_slack_.end()) {
+    return it->second;
+  }
+  if (pin->getObjectType() != odb::dbITermObj || depth > kMaxInferDepth) {
+    return std::nullopt;
+  }
+  if (const auto it = inferred_slack_.find(pin); it != inferred_slack_.end()) {
+    return it->second;
+  }
+  // Marks the pin while it is resolved, so a loop ends.
+  inferred_slack_[pin] = std::nullopt;
+  odb::dbITerm* input = static_cast<odb::dbITerm*>(pin);
+  odb::dbITerm* output = nullptr;
+  for (odb::dbITerm* iterm : input->getInst()->getITerms()) {
+    if (iterm == input || iterm->getNet() == nullptr
+        || iterm->getSigType().isSupply()) {
+      continue;
+    }
+    if (!iterm->isOutputSignal() || output != nullptr) {
+      // Not a one-input, one-output cell.
+      return std::nullopt;
+    }
+    output = iterm;
+  }
+  if (output == nullptr) {
+    return std::nullopt;
+  }
+  std::optional<float> slack;
+  for (odb::dbITerm* load : output->getNet()->getITerms()) {
+    if (load == output || !load->isInputSignal()) {
+      continue;
+    }
+    if (const std::optional<float> s = sinkSlack(load, depth + 1)) {
+      slack = slack ? std::min(*slack, *s) : *s;
+    }
+  }
+  for (odb::dbBTerm* port : output->getNet()->getBTerms()) {
+    if (const std::optional<float> s = sinkSlack(port, depth + 1)) {
+      slack = slack ? std::min(*slack, *s) : *s;
+    }
+  }
+  inferred_slack_[pin] = slack;
+  return slack;
+}
+
+// A net is visited if its driver fails (its slack is never better than any
+// of its sinks') or if it carried a pull before.
+bool PinPull::isPullNet(odb::dbNet* net) const
+{
+  if (pulled_nets_.contains(net)) {
+    return true;
+  }
+  const std::optional<sta::Slack> net_slack = rs_->resizeNetSlack(net);
+  return !net_slack || *net_slack < 0.0f;
+}
+
+void PinPull::addCandidate(std::vector<Candidate>& candidates,
+                           odb::dbNet* net,
+                           odb::dbObject* driver,
+                           odb::dbObject* sink,
+                           const float other_weight)
+{
+  const std::optional<float> slack = sinkSlack(sink, 0);
+  float previous = 0.0f;
+  if (const auto it = history_.find(std::make_pair(driver, sink));
+      it != history_.end()) {
+    previous = it->second;
+  }
+  if (!slack && previous <= 0.0f) {
+    return;
+  }
+  candidates.push_back({net,
+                        driver,
+                        sink,
+                        slack.value_or(std::numeric_limits<float>::infinity()),
+                        slack.has_value(),
+                        previous,
+                        other_weight});
+}
+
+const std::vector<PinPullConnection>& PinPull::update(
+    const PlacerBaseCommon& pbc)
+{
+  std::vector<Candidate> candidates;
+  for (const Net* net : pbc.getNets()) {
+    odb::dbNet* db_net = net->getDbNet();
+    if (!isPullNet(db_net)) {
+      continue;
+    }
+    const Pin* driver = nullptr;
+    int drivers = 0;
+    for (const Pin* pin : net->getPins()) {
+      if (isDriver(pin)) {
+        driver = pin;
+        ++drivers;
+      }
+    }
+    if (drivers != 1) {
+      continue;
+    }
+    for (const Pin* sink : net->getPins()) {
+      if (sink == driver
+          || (sink->getInstance() != nullptr
+              && sink->getInstance() == driver->getInstance())
+          || (!isMovable(driver) && !isMovable(sink))) {
+        continue;
+      }
+      addCandidate(candidates,
+                   db_net,
+                   dbPin(driver),
+                   dbPin(sink),
+                   std::max({otherWeight(driver), otherWeight(sink), 1.0f}));
+    }
+  }
+  finish(candidates);
+  return pulls_;
+}
+
+const std::vector<PinPullConnection>& PinPull::update(
+    const NesterovBaseCommon& nbc)
+{
+  std::vector<Candidate> candidates;
+  for (const GNet* gnet : nbc.getGNets()) {
+    if (gnet->getGPins().size() < 2) {
+      continue;
+    }
+    odb::dbNet* db_net = gnet->getPbNet()->getDbNet();
+    if (!isPullNet(db_net)) {
+      continue;
+    }
+    const GPin* driver = nullptr;
+    int drivers = 0;
+    for (const GPin* gpin : gnet->getGPins()) {
+      if (isDriver(gpin->getPbPin())) {
+        driver = gpin;
+        ++drivers;
+      }
+    }
+    if (drivers != 1) {
+      continue;
+    }
+    for (const GPin* sink : gnet->getGPins()) {
+      if (sink == driver
+          || (sink->getGCell() != nullptr
+              && sink->getGCell() == driver->getGCell())
+          || (!isMovable(driver) && !isMovable(sink))) {
+        continue;
+      }
+      addCandidate(candidates,
+                   db_net,
+                   dbPin(driver->getPbPin()),
+                   dbPin(sink->getPbPin()),
+                   std::max({otherWeight(driver), otherWeight(sink), 1.0f}));
+    }
+  }
+  finish(candidates);
+  return pulls_;
+}
+
+// A failing connection pulls strength times as hard as its cells' other
+// nets, and harder each update it still fails. A connection that meets
+// timing keeps its weight.
+void PinPull::finish(const std::vector<Candidate>& candidates)
+{
+  ++update_count_;
+  pulls_.clear();
+  boost::unordered::unordered_flat_map<
+      std::pair<odb::dbObject*, odb::dbObject*>,
+      float>
+      history;
+  history.reserve(candidates.size());
+  pulled_nets_.clear();
+  float min_weight = std::numeric_limits<float>::max();
+  float max_weight = 0.0f;
+  size_t failing = 0;
+  for (const Candidate& candidate : candidates) {
+    float weight = candidate.previous;
+    if (candidate.failing) {
+      weight = std::max(vars_.strength * candidate.other_weight,
+                        candidate.previous * (1.0f + vars_.growth));
+      ++failing;
+    }
+    if (vars_.max > 0.0f) {
+      weight = std::min(weight, vars_.max);
+    }
+    pulls_.push_back({candidate.driver, candidate.sink, weight});
+    history[std::make_pair(candidate.driver, candidate.sink)] = weight;
+    pulled_nets_.insert(candidate.net);
+    min_weight = std::min(min_weight, weight);
+    max_weight = std::max(max_weight, weight);
+    debugPrint(log_,
+               GPL,
+               "pinPull",
+               2,
+               "pull {} -> {} slack {} weight {}",
+               pinName(candidate.driver),
+               pinName(candidate.sink),
+               candidate.slack,
+               weight);
+  }
+  history_ = std::move(history);
+  if (pulls_.empty()) {
+    min_weight = 0.0f;
+  }
+  log_->info(GPL,
+             198,
+             "Timing-driven pin pull: {} connections ({} failing) on {} nets, "
+             "weight {:.2f} to {:.2f}.",
+             pulls_.size(),
+             failing,
+             pulled_nets_.size(),
+             min_weight,
+             max_weight);
+}
+
+}  // namespace gpl
