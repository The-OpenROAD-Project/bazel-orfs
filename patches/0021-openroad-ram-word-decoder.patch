From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] ram: generate_ram -decoder word, a balanced tree per
 word
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

-decoder word decodes each word's whole address through a balanced
AND2 tree, the banks' decoders (the -banks commit) without banks. The default,
row, is generate_ram's decoder per row, an AND2 chain over the row
address: four AND2 deep for 32 rows where a tree is three. On riscv32i's
register file the chain is about 60 ps of the read path's 220.

Tested: src/ram/test/decoder_word_asap7.tcl.

Commit 11 of 23 in OpenROAD #11723, carried here from it. Not
upstreamed; retires at a //:bump onto an OpenROAD that has it.
---
 src/ram/README.md                   |  2 ++
 src/ram/include/ram/ram.h           |  3 ++-
 src/ram/src/ram.cpp                 |  7 +++++--
 src/ram/src/ram.i                   |  5 +++--
 src/ram/src/ram.tcl                 | 21 +++++++++++++++----
 src/ram/test/BUILD                  |  5 +++++
 src/ram/test/CMakeLists.txt         |  1 +
 src/ram/test/decoder_word_asap7.tcl | 32 +++++++++++++++++++++++++++++
 src/ram/test/regression_tests.tcl   |  1 +
 9 files changed, 68 insertions(+), 9 deletions(-)
 create mode 100644 src/ram/test/decoder_word_asap7.tcl

diff --git a/src/ram/README.md b/src/ram/README.md
index 683015ddab..4e17cb1167 100644
--- a/src/ram/README.md
+++ b/src/ram/README.md
@@ -54,6 +54,7 @@ generate_ram [-mask_size bits]
              [-write_style clock_gate|mux]
              [-cells {role master ...}]
              [-name name]
+             [-decoder row|word]
              [-inv_cell name]
              [-power_net_name name]
              [-ground_net_name name]
@@ -89,6 +90,7 @@ generate_ram [-mask_size bits]
 | `-periphery`, `-pin_layer` | `generate_ram_netlist` only. `unplaced` leaves the periphery (address inverters and registers, decoders, select buffers, each word's select cell, the input buffers) for a parent to place, size and buffer; the outline is the placed core and a row, and each pin sits where its connections land, on `-pin_layer`'s tracks, for a macro placer before the parent dissolves the core into its rows. Default: `placed`. |
 | `-cells` | The cell for a role (`inv`, `and2`, `buffer`, `clock_gate`, `aoi22`, `ao22`, `or2`, `nand2`, `nor2`, `tie`, `addr_flop`), instead of the smallest the libraries have of its function. An AOI22 or AO22 given is checked by its truth table. Default: the smallest of each. |
 | `-name` | The block's and the behavioral model's name. Default: `RAM<words>x<bits>`. |
+| `-decoder` | `row`: a decoder per row, an AND2 chain over the row address, the column mux selecting within the row. `word`: a balanced AND2 tree over each word's whole address, as with banks; shallower for the read path. Default: `row`. |
 | `-inv_cell` | Name of the master to use for inverters. Default: auto-select from the loaded cell library. |
 | `-routing_layer` | A list of the metal layer and metal width (in microns) for generating standard cell power tracks (followpins). Example: `{met1 0.48}`. |
 | `-power_net_name` | Name of the power net to create. Default: `VDD`. |
diff --git a/src/ram/include/ram/ram.h b/src/ram/include/ram/ram.h
index eea3100f24..d253b23818 100644
--- a/src/ram/include/ram/ram.h
+++ b/src/ram/include/ram/ram.h
@@ -122,7 +122,8 @@ class RamGen
                 const std::string& periphery = "placed",
                 const std::string& pin_layer = "",
                 const std::string& cells = "",
-                const std::string& name = "");
+                const std::string& name = "",
+                const std::string& decoder = "row");
 
   void ramPdngen(const char* power_net_name,
                  const char* ground_net_name,
diff --git a/src/ram/src/ram.cpp b/src/ram/src/ram.cpp
index ab935f6238..cf0f024bda 100644
--- a/src/ram/src/ram.cpp
+++ b/src/ram/src/ram.cpp
@@ -1914,12 +1914,15 @@ void RamGen::generate(const int mask_size,
                       const std::string& periphery,
                       const std::string& pin_layer,
                       const std::string& cells,
-                      const std::string& name)
+                      const std::string& name,
+                      const std::string& decoder)
 {
   // Banks: every port decodes every word's whole address, and a row holds
   // bank_columns words, laid out as the column mux lays out its words;
   // without banks, the column mux as it was.
-  banked_ = banks > 1 || bank_columns > 1;
+  // -decoder word: each port decodes every word's whole address through
+  // a balanced AND2 tree per word, the banks' decoders, banks or none
+  banked_ = banks > 1 || bank_columns > 1 || decoder == "word";
   banks_ = std::max(banks, 1);
   bank_columns_ = std::max(bank_columns, 1);
   bank_interleaved_ = bank_order == "interleaved";
diff --git a/src/ram/src/ram.i b/src/ram/src/ram.i
index bc76a2c750..41f4ec7c5c 100644
--- a/src/ram/src/ram.i
+++ b/src/ram/src/ram.i
@@ -54,7 +54,8 @@ generate_ram_netlist_cmd(int mask_size,
                          const char* periphery,
                          const char* pin_layer,
                          const char* cells,
-                         const char* name)
+                         const char* name,
+                         const char* decoder)
 {
   RamGen* ram_gen = ord::getRamGen();
   odb::dbDatabase* db = ord::getDb();
@@ -109,7 +110,7 @@ generate_ram_netlist_cmd(int mask_size,
                     tapcell, max_tap_dist, read_style, zero_word,
                     reset_value, banks, bank_columns, bank_order, rb_ports,
                     read_latency, write_style, periphery, pin_layer, cells,
-                    name);
+                    name, decoder);
 }
 
 void ram_pdngen(const char* power_net_name, const char* ground_net_name,
diff --git a/src/ram/src/ram.tcl b/src/ram/src/ram.tcl
index 93ed30dc07..61a0297a92 100644
--- a/src/ram/src/ram.tcl
+++ b/src/ram/src/ram.tcl
@@ -18,6 +18,7 @@ sta::define_cmd_args "generate_ram_netlist" {[-mask_size bits]
                                              [-write_style clock_gate|mux]
                                              [-cells {role master ...}]
                                              [-name name]
+                                             [-decoder row|word]
                                              [-periphery placed|unplaced]
                                              [-pin_layer layer]
                                              [-inv_cell name]
@@ -34,7 +35,7 @@ proc generate_ram_netlist { args } {
       -rw_ports -r_ports -w_ports -use_latch -tapcell -max_tap_dist
       -write_behavioral_verilog -read_style -zero_word -reset_value
       -banks -bank_columns -bank_order -rb_ports -read_latency -write_style
-      -periphery -pin_layer -cells -name } flags {}
+      -periphery -pin_layer -cells -name -decoder } flags {}
 
   set column_mux_ratio 1
   if { [info exists keys(-column_mux_ratio)] } {
@@ -206,6 +207,17 @@ proc generate_ram_netlist { args } {
     set name $keys(-name)
   }
 
+  # The address decoders: row, a decoder per row (an AND2 chain), the
+  # column mux selecting within it; or word, a balanced AND2 tree over
+  # each word's whole address.
+  set decoder row
+  if { [info exists keys(-decoder)] } {
+    set decoder $keys(-decoder)
+    if { $decoder ni {row word} } {
+      utl::error RAM 82 "-decoder is row or word, not $decoder."
+    }
+  }
+
   # How a word holds its value between writes: a clock gate per word
   # (clock_gate), or a mux per bit (mux).
   set write_style clock_gate
@@ -238,7 +250,8 @@ proc generate_ram_netlist { args } {
   ram::generate_ram_netlist_cmd $mask_size $word_size $num_words $rw_ports $r_ports $w_ports \
     $column_mux_ratio $use_latch $storage_cell $tristate_cell $inv_cell $tapcell $max_tap_dist \
     $read_style $zero_word $reset_value $banks $bank_columns $bank_order \
-    $rb_ports $read_latency $write_style $periphery $pin_layer $cells $name
+    $rb_ports $read_latency $write_style $periphery $pin_layer $cells $name \
+    $decoder
 }
 
 sta::define_cmd_args "generate_ram" {[-mask_size bits]
@@ -274,7 +287,7 @@ proc generate_ram { args } {
            -hor_layer -filler_cells -tapcell -max_tap_dist
            -write_behavioral_verilog -read_style -zero_word -reset_value
            -banks -bank_columns -bank_order -rb_ports -read_latency -write_style
-           -cells -name } flags {}
+           -cells -name -decoder } flags {}
 
   sta::check_argc_eq0 "generate_ram" $args
 
@@ -324,7 +337,7 @@ proc generate_ram { args } {
   }
 
   foreach key {-banks -bank_columns -bank_order -rb_ports -read_latency -write_style
-               -cells -name} {
+               -cells -name -decoder} {
     if { [info exists keys($key)] } {
       lappend ram_netlist_args $key $keys($key)
     }
