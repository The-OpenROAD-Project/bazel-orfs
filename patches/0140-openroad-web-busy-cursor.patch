diff --git a/src/web/src/ui-utils.js b/src/web/src/ui-utils.js
index a4f98cbb6..b71b1f386 100644
--- a/src/web/src/ui-utils.js
+++ b/src/web/src/ui-utils.js
@@ -204,6 +204,24 @@ export function onSelectionReset(app, fn) {
     app.selectionResetters.push(fn);
 }
 
+// A busy cursor over the whole page while `fn` runs, as the Qt GUI sets a
+// wait cursor while it builds a timing report: a click whose answer takes
+// seconds on a large design otherwise looks ignored.  Counted, so overlapping
+// requests keep it until the last one ends; cleared when `fn` throws.
+// `root` is the element that carries the class (document.body in the page).
+export async function withBusyCursor(fn, root = document.body) {
+    root.busyCount = (root.busyCount || 0) + 1;
+    root.classList.add('op-busy');
+    try {
+        return await fn();
+    } finally {
+        root.busyCount -= 1;
+        if (root.busyCount === 0) {
+            root.classList.remove('op-busy');
+        }
+    }
+}
+
 // Leaflet map options for the 2D layout viewer.
 //
 // zoomSnap:1 + zoomDelta:1 force the map to rest only at INTEGER zoom levels,
diff --git a/src/web/test/js/test-ui-utils.js b/src/web/test/js/test-ui-utils.js
index 16ed17ccb..d4ceecd63 100644
--- a/src/web/test/js/test-ui-utils.js
+++ b/src/web/test/js/test-ui-utils.js
@@ -6,7 +6,7 @@ import assert from 'node:assert/strict';
 import { applyArrowStep, boundsEqual, computeBoundsTransforms, computeScaleBar,
          cssColorToHex, fittedTileSizeCss, installWheelPanning, isValidHexColor,
          kArrowStepDefault, kZoomMargin, maxUsefulZoom, MAX_TILE_ZOOM,
-         niceRoundParts, websocketUrlFrom }
+         niceRoundParts, websocketUrlFrom, withBusyCursor }
     from '../../src/ui-utils.js';
 import { isDeviceExactTileSize, TILE_SIZE_CSS, TILE_SIZE_QUANTUM }
     from '../../src/tile-request.js';
@@ -553,3 +553,45 @@ describe('websocketUrlFrom', () => {
         assert.equal(websocketUrlFrom({ host: '' }), 'ws://localhost:8080/ws');
     });
 });
+
+// A stand-in for document.body: just the class list withBusyCursor touches.
+function fakeRoot() {
+    const classes = new Set();
+    return { classList: { add: (c) => classes.add(c),
+                          remove: (c) => classes.delete(c) },
+             has: (c) => classes.has(c) };
+}
+
+describe('withBusyCursor', () => {
+    it('is busy while the request runs and clears after it', async () => {
+        const root = fakeRoot();
+        let during;
+        const result = await withBusyCursor(async () => {
+            during = root.has('op-busy');
+            return 42;
+        }, root);
+        assert.equal(during, true);
+        assert.equal(result, 42);
+        assert.equal(root.has('op-busy'), false);
+    });
+
+    it('stays busy until the last overlapping request ends', async () => {
+        const root = fakeRoot();
+        let finishFirst;
+        const first = withBusyCursor(
+            () => new Promise((resolve) => { finishFirst = resolve; }), root);
+        await withBusyCursor(async () => {}, root);
+        assert.equal(root.has('op-busy'), true);
+        finishFirst();
+        await first;
+        assert.equal(root.has('op-busy'), false);
+    });
+
+    it('clears when the request fails', async () => {
+        const root = fakeRoot();
+        await assert.rejects(withBusyCursor(async () => {
+            throw new Error('timing report failed');
+        }, root));
+        assert.equal(root.has('op-busy'), false);
+    });
+});
