From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Subject: [PATCH] web: the slack histogram names its clocks and periods
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Qt GUI's endpoint-slack histogram titles its axis "Slack [ps],
Clocks: <name> <period>, ...", two clocks on the first line and three
on each after: the period is what every slack is measured against. The
web viewer wrote "Slack [ps]" alone.

The slack histogram reply now carries `clocks` (the filter's clock, or
every clock), each with its period in the reply's time unit, and the
chart draws the title as Qt does, in at most two lines, the second then
saying how many clocks it left out.

Upstream: The-OpenROAD-Project/OpenROAD#11857 (draft).

---
diff --git a/src/web/src/charts-widget.js b/src/web/src/charts-widget.js
index d3fbce5..f831fe0 100644
--- a/src/web/src/charts-widget.js
+++ b/src/web/src/charts-widget.js
@@ -162,6 +162,31 @@ function computeLogYAxis(maxCount) {
     return { yMax: topDecade, yTicks: ticks };
 }
 
+// The slack axis title, as the Qt GUI writes it: the unit, then every clock
+// the endpoints are timed against with its period, two clocks on the first
+// line and three on each after.  Returns the lines; at most `maxLines`, the
+// last one then saying how many clocks it left out.
+export function slackAxisTitle(unit, clocks, maxLines = 2) {
+    let first = `Slack [${unit}]`;
+    if (!clocks || clocks.length === 0) return [first];
+    const fmt = (c) => {
+        const p = Math.abs(c.period) < 1
+            ? Math.round(c.period * 1000) / 1000 : c.period;
+        return `${c.name} ${Number(p.toFixed(3))}`;
+    };
+    const lines = [`${first}, Clocks: ` + clocks.slice(0, 2).map(fmt).join(', ')];
+    for (let i = 2; i < clocks.length; i += 3) {
+        lines.push(clocks.slice(i, i + 3).map(fmt).join(', '));
+    }
+    if (lines.length > maxLines) {
+        const shown = 2 + 3 * (maxLines - 1) - 3;
+        const kept = lines.slice(0, maxLines - 1);
+        kept.push(`… and ${clocks.length - shown} more clocks`);
+        return kept;
+    }
+    return lines;
+}
+
