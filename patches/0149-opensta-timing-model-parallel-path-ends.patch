From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Mon, 26 Oct 2026 18:28:02 +0100
Subject: [PATCH 5/5] write_timing_model: visit an input's path ends on every
 thread
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

findTimingFromInput visited the path ends at each of an input's
filtered endpoints on the main thread, one endpoint after the other,
while the arrival search before it runs on every thread. On a 64 x 256
register file at 32 threads (OpenROAD#11999) that serial visit was the
largest part of what the main thread did alone.

With more than one thread the endpoints are now dispatched, as
PathGroups::makeGroupPathEnds does, each thread with a MakeEndTimingArcs
and a VisitPathEnds of its own, and the margins are merged after
finishTasks. A margin is the max over the path ends, so the merge gives
the same margin whichever thread found them.

Not upstreamed. Carried in bazel-orfs; retires on the //:bump onto an
OpenROAD whose OpenSTA carries it.

Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 search/MakeTimingModel.cc | 54 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 51 insertions(+), 3 deletions(-)

diff --git a/src/sta/search/MakeTimingModel.cc b/src/sta/search/MakeTimingModel.cc
index a984aae8..97dc8661 100644
--- a/src/sta/search/MakeTimingModel.cc
+++ b/src/sta/search/MakeTimingModel.cc
@@ -33,6 +33,7 @@
 #include <string>
 #include <string_view>
 #include <utility>
+#include <vector>
 
 #include "ArcDelayCalc.hh"
 #include "ClkDelays.hh"
@@ -40,6 +41,7 @@
 #include "ContainerHelpers.hh"
 #include "Debug.hh"
 #include "Delay.hh"
+#include "DispatchQueue.hh"
 #include "FuncExpr.hh"
 #include "Graph.hh"
 #include "GraphClass.hh"
@@ -325,6 +327,8 @@ public:
   void visit(PathEnd *path_end) override;
   void setInputRf(const RiseFall *input_rf);
   const ClockEdgeDelays &margins() const { return margins_; }
+  // Take the larger margin of this and other's, as visit does.
+  void mergeMargins(const MakeEndTimingArcs &other);
 
 private:
   const RiseFall *input_rf_{nullptr};
@@ -384,6 +388,28 @@ MakeEndTimingArcs::visit(PathEnd *path_end)
   }
 }
 
+void
+MakeEndTimingArcs::mergeMargins(const MakeEndTimingArcs &other)
+{
+  for (const auto &[clk_edge, other_margins] : other.margins_) {
+    RiseFallMinMax &margins = margins_[clk_edge];
+    for (const RiseFall *rf : RiseFall::range()) {
+      for (const MinMax *min_max : MinMax::range()) {
+        float other_margin;
+        bool other_exists;
+        other_margins.value(rf, min_max, other_margin, other_exists);
+        if (other_exists) {
+          float margin;
+          bool exists;
+          margins.value(rf, min_max, margin, exists);
+          margins.setValue(rf, min_max,
+                           exists ? std::max(margin, other_margin) : other_margin);
+        }
+      }
+    }
+  }
+}
+
 // input -> register setup/hold
 // input -> output combinational paths
 // Use default input arrival (set_input_delay with no clock) from inputs
@@ -426,9 +452,31 @@ MakeTimingModel::findTimingFromInput(Port *input_port)
 
       end_visitor.setInputRf(input_rf);
       VertexSeq endpoints = search_->filteredEndpoints();
-      VisitPathEnds visit_ends(sta_);
-      for (Vertex *end : endpoints)
-        visit_ends.visitPathEnds(end, scenes_, MinMaxAll::all(), true, &end_visitor);
+      if (thread_count_ == 1) {
+        VisitPathEnds visit_ends(sta_);
+        for (Vertex *end : endpoints)
+          visit_ends.visitPathEnds(end, scenes_, MinMaxAll::all(), true,
+                                   &end_visitor);
+      }
+      else {
+        // One visitor per thread, merged after: a margin is the max over
+        // the path ends, whichever thread found them.
+        std::vector<MakeEndTimingArcs> end_visitors(thread_count_,
+                                                    MakeEndTimingArcs(sta_));
+        std::vector<VisitPathEnds> visit_ends(thread_count_,
+                                              VisitPathEnds(sta_));
+        for (MakeEndTimingArcs &visitor : end_visitors)
+          visitor.setInputRf(input_rf);
+        for (Vertex *end : endpoints) {
+          dispatch_queue_->dispatch([this, end, &end_visitors, &visit_ends](size_t i) {
+            visit_ends[i].visitPathEnds(end, scenes_, MinMaxAll::all(), true,
+                                        &end_visitors[i]);
+          });
+        }
+        dispatch_queue_->finishTasks();
+        for (const MakeEndTimingArcs &visitor : end_visitors)
+          end_visitor.mergeMargins(visitor);
+      }
       // OpenROAD fork: write_timing_model O(cone) output delays.
       findOutputDelays(input_rf, endpoints, output_delays);
       search_->deleteFilteredArrivals();
