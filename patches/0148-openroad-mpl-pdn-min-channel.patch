+std::optional<PackingProblem> HierRTLMP::tilingProblemAtChannel(
+    Cluster* parent,
+    const odb::Rect& outline,
+    const Channel& channel)
+{
+  PackingProblem problem{outline.dx(), outline.dy(), {}};
+  for (auto& cluster : parent->getChildren()) {
+    if (cluster->getNumMacro() == 0) {
+      continue;
+    }
+    if (cluster->getClusterType() != HardMacroCluster
+        && !cluster->isFixedMacro()) {
+      return std::nullopt;  // shaped by annealing standard cells too
+    }
+    const std::vector<HardMacro*> hard_macros = cluster->getHardMacros();
+    odb::dbInst* inst = hard_macros.front()->getInst();
+    HardMacro macro(inst, clustering_engine_->macroHaloAt(inst, channel));
+    PackingBlock block;
+    block.name = cluster->getName();
+    if (cluster->isFixedMacro()) {
+      macro.setRealLocation(inst->getLocation());
+      block.shapes.emplace_back(macro.getWidth(), macro.getHeight());
+      block.fixed_x = macro.getX() - outline.xMin();
+      block.fixed_y = macro.getY() - outline.yMin();
+    } else {
+      const int count = static_cast<int>(hard_macros.size());
+      TilingList tilings = generateTilingsForMacroCluster(
+          macro.getWidth(), macro.getHeight(), count);
+      if (tilings.empty()) {
+        tilings = generateTilingsForMacroCluster(
+            macro.getWidth(), macro.getHeight(), count + 1);
+      }
+      if (tilings.empty()) {
+        // No array of these macros fits the core at all; a block no
+        // shape of which fits says so.
+        tilings.emplace_back(macro.getWidth() * count, macro.getHeight());
+      }
+      block.shapes = tilings;
+    }
+    problem.blocks.push_back(block);
+  }
+  return problem;
+}
+
+std::string HierRTLMP::explainChannel(Cluster* parent, const odb::Rect& outline)
+{
+  const double dbu = block_->getDbUnitsPerMicron();
+  auto um = [dbu](int value) { return fmt::format("{:.3f}", value / dbu); };
+  const std::string current
+      = um(min_channel_.width) + " " + um(min_channel_.height);
+  if (pdn_min_channel_.width == 0 && pdn_min_channel_.height == 0) {
+    return "\n  Channel: -min_channel_size is " + current
+           + " um; set -pdn_min_channel_size to the narrowest channel the PDN"
+             " can repair to get a channel proposal.";
+  }
+  const std::string floor
+      = um(pdn_min_channel_.width) + " " + um(pdn_min_channel_.height);
+  if (pdn_min_channel_.width >= min_channel_.width
+      && pdn_min_channel_.height >= min_channel_.height) {
+    return "\n  Channel: -min_channel_size " + current
+           + " um is already at or below the PDN's minimum " + floor + " um.";
+  }
+  const std::optional<PackingProblem> problem
+      = tilingProblemAtChannel(parent, outline, pdn_min_channel_);
+  if (!problem) {
+    return "\n  Channel: no proposal; some clusters hold standard cells, "
+           "whose shapes depend on annealing.";
+  }
+  const PackingResult fit = checkPacking(*problem);
+  if (fit.status == PackingStatus::kFits) {
+    return "\n  Channel: -min_channel_size " + floor
+           + " um, the PDN's minimum, fits in this outline.";
+  }
+  if (fit.status == PackingStatus::kDoesNotFit) {
+    std::string text = explainOutline(*problem, fit);
+    return "\n  Channel: even at the PDN's minimum, -min_channel_size " + floor
+           + " um, the outline must grow:"
+           + text.substr(text.find("\n  It fits with any one of:")
+                         + std::string("\n  It fits with any one of:").size());
+  }
+  return "\n  Channel: undecided at the PDN's minimum " + floor + " um.";
+}
