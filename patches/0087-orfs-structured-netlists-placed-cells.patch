From 80615340b3e70e579b9651836124a00cfc3020d4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=98yvind=20Harboe?= <oyvind.harboe@zylin.com>
Date: Thu, 1 Oct 2026 05:55:08 +0200
Subject: [PATCH] memories: a placed netlist's cell may be PLACED, as its
 generator says
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A placed netlist's cells were all FIRM. Some are the parent's to resize:
the address inverters at an array's boundary, which the parent's
repair_design upsizes when it repairs the wide nets they drive. The
generator left one spare site after each for INVx1 to INVx2. Timing-
driven global placement repairs early, on the long wires of a spread
placement, and keeps the result: on XiangShan's XSTile it upsized
RobEntryFile's address inverters to INVx13 and CKINVDCx8 in place, over
their FIRM neighbours, and detailed placement failed check_placement
(DPL-0033) after two and a half hours of global placement.

A cell the resizer may change is one the legaliser may move, and which
cells those are is the generator's to say. gen_memories.py keeps each
cell's DEF placement status in the .place file; the floorplan makes a
PLACED cell PLACED, starting where the generator put it, and every
other cell FIRM as before.

Not upstreamed (builds on carried patches 0078 and 0084). Retires with
them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Øyvind Harboe <oyvind.harboe@zylin.com>
---
 flow/scripts/memories/gen_memories.py |  5 +++--
 flow/scripts/structured_netlists.tcl  | 19 +++++++++++++++----
 2 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/flow/scripts/memories/gen_memories.py b/flow/scripts/memories/gen_memories.py
index a3b312d..5d87282 100644
--- a/flow/scripts/memories/gen_memories.py
+++ b/flow/scripts/memories/gen_memories.py
@@ -74,7 +74,8 @@ _DEF_ORIENT = {"N": "R0", "S": "R180", "W": "R90", "E": "R270",
 
 
 def _def_placement(def_path: Path, out_path: Path) -> dict:
-    """The placed cells of the generator's DEF as `name x y orient` lines,
+    """The placed cells of the generator's DEF as `name x y orient status`
+    lines (status FIRM, or PLACED for a cell the parent may move),
     plus the die and the first row's orientation and height, so the
     parent's floorplan can drop the array onto its own rows."""
     text = def_path.read_text()
@@ -99,7 +100,7 @@ def _def_placement(def_path: Path, out_path: Path) -> dict:
             pm = re.search(r"\+\s*(PLACED|FIXED|FIRM|COVER)\s*\(\s*(-?\d+)\s+(-?\d+)\s*\)\s*(\w+)", entry)
             if pm:
                 orient = _DEF_ORIENT.get(pm.group(4), pm.group(4))
-                lines.append(f"{e[1]} {pm.group(2)} {pm.group(3)} {orient}")
+                lines.append(f"{e[1]} {pm.group(2)} {pm.group(3)} {orient} {pm.group(1)}")
     out_path.write_text("".join(l + "\n" for l in lines))
     return {"die": die, "row0_orient": row0, "row_height": row_h, "cells": len(lines)}
 
diff --git a/flow/scripts/structured_netlists.tcl b/flow/scripts/structured_netlists.tcl
index ca01db4..ef7d05d 100644
--- a/flow/scripts/structured_netlists.tcl
+++ b/flow/scripts/structured_netlists.tcl
@@ -104,9 +104,10 @@ if { 1 } {
       set n 0
       set missing 0
       set placed_insts {}
+      set loose 0
       set first_missing ""
       while { [gets $pf pl] >= 0 } {
-        lassign $pl name cx cy orient
+        lassign $pl name cx cy orient status
         if { $name eq "" } { continue }
         set inst [$block findInst "$path/$name"]
         if { $inst == "NULL" } {
@@ -116,6 +117,18 @@ if { 1 } {
         }
         $inst setOrient $orient
         $inst setLocation [expr { $X + $cx - $dx0 }] [expr { $Y + $cy - $dy0 }]
+        lappend placed_insts $inst
+        incr n
+        # A cell the generator left PLACED is one the parent may resize, so
+        # one the parent may move: the generator's location is where global
+        # placement starts it, and the legaliser takes whatever size it ends
+        # up (XiangShan's ROB address inverters, upsized to INVx13 by
+        # timing-driven global placement, overlapped FIRM neighbours).
+        if { $status eq "PLACED" } {
+          $inst setPlacementStatus PLACED
+          incr loose
+          continue
+        }
         $inst setPlacementStatus FIRM
         # The generator's cell is final: FIRM keeps the legaliser off it,
         # dont_touch keeps the resizer off it. Without the second,
@@ -133,8 +146,6 @@ if { 1 } {
         if { ![[$inst getMaster] isSequential] && ![netlist_boundary_cell $inst $path] } {
           $inst setDoNotTouch 1
         }
-        lappend placed_insts $inst
-        incr n
       }
       close $pf
       # The wires between the array's own cells are the generator's too.
@@ -163,7 +174,7 @@ if { 1 } {
         utl::info FLW 8 "structured netlist $module at $path: $missing of [expr {$n + $missing}] placed cells are not in the design (removed as dead logic, e.g. $first_missing); their sites stay empty"
       }
       lappend placed_modules $module
-      utl::info FLW 6 "structured netlist $module at $path: $n cells FIRM at [expr {$X/double($dbu)}] [expr {$Y/double($dbu)}] um, $internal_nets internal nets dont_touch"
+      utl::info FLW 6 "structured netlist $module at $path: $n cells at [expr {$X/double($dbu)}] [expr {$Y/double($dbu)}] um, FIRM but $loose PLACED, $internal_nets internal nets dont_touch"
     }
     foreach m $netlist_modules {
       if { [lsearch -exact $placed_modules $m] < 0 } {
-- 
